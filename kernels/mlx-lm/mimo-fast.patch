+    def __call__(self, embeds, hidden, mask, cache):
+        x = mx.concatenate([self.enorm(embeds), self.hnorm(hidden)], axis=-1)
+        x = self.eh_proj(x)
+        x = x + self.self_attn(self.input_layernorm(x), mask, cache)
+        return x + self.mlp(self.pre_mlp_layernorm(x))
