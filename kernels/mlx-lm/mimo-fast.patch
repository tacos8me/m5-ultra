+def speculative_sample(
+    draft_tokens: mx.array,
+    draft_logits: mx.array,
+    target_logits: mx.array,
+) -> Tuple[mx.array, mx.array]:
+    """
+    Verify draft tokens with speculative sampling.
+
+    Draft token ``i`` is accepted with probability ``min(1, p_i / q_i)``. After
+    the first rejection the next token is sampled from ``max(0, p - q)``. If
+    all drafts are accepted, the next token is sampled from the last ``p``.
+    The output tokens then have the target distribution. See
+    https://arxiv.org/abs/2211.17192 and https://arxiv.org/abs/2302.01318.
+
+    Args:
+        draft_tokens (mx.array): The ``k`` draft tokens.
+        draft_logits (mx.array): The ``(k, V)`` logits the draft tokens were
+          sampled from.
+        target_logits (mx.array): The ``(k + 1, V)`` target logits at the
+          same positions and one position after the last draft.
+
+    Returns:
+        Tuple[mx.array, mx.array]: The number of accepted draft tokens and the
+          token that follows them.
+    """
+    k = draft_tokens.size
+    p = mx.softmax(target_logits.astype(mx.float32), axis=-1)
+    q = mx.softmax(draft_logits.astype(mx.float32), axis=-1)
+    idx = draft_tokens.reshape(k, 1)
+    p_draft = mx.take_along_axis(p[:k], idx, axis=-1).squeeze(-1)
+    q_draft = mx.take_along_axis(q, idx, axis=-1).squeeze(-1)
+    accept = mx.random.uniform(shape=(k,)) * q_draft < p_draft
+    num_accepted = mx.cumprod(accept.astype(mx.int32)).sum()
+
+    # A zero draft row after the last draft makes the last residual p itself.
+    q = mx.concatenate([q, mx.zeros_like(p[:1])])
+    residual = mx.maximum(p - q, 0.0)
+    next_tokens = mx.random.categorical(mx.log(residual))
+    return num_accepted, next_tokens[num_accepted]
+
