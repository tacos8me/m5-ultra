+    threadgroup T tile[64][72];
+    const uint n0 = threadgroup_position_in_grid.x * 64;
+    const uint k0 = threadgroup_position_in_grid.y * 64;
+    const uint t = thread_index_in_threadgroup;
+    const uint r = t / 4;
+    const uint c = (t % 4) * 16;
