+    def test_gather_qmm_sorted_uneven_experts(self):
+        # Sorted rows with uneven, sometimes empty or long, expert segments.
+        E, N, K = 64, 256, 512
+        mx.random.seed(0)
+        w = mx.random.normal((E, N, K)) / K**0.5
+        for mode in ("mxfp4", "mxfp8", "nvfp4"):
+            qw, s = mx.quantize(w, mode=mode)
+            w_hat = mx.dequantize(qw, s, mode=mode)
+            for name, M in (("few", 100), ("odd", 1000), ("skewed", 3000)):
+                with self.subTest(mode=mode, case=name):
+                    if name == "skewed":
+                        u = mx.random.uniform(shape=(M,)) ** 4
+                        idx = (u * E).astype(mx.uint32)
+                    else:
+                        idx = mx.random.randint(0, E, (M,)).astype(mx.uint32)
+                    idx = mx.sort(idx)
+                    x = (mx.random.normal((M, 1, K)) / K**0.5).astype(mx.bfloat16)
+                    y = mx.gather_qmm(
+                        x,
+                        qw,
+                        s,
+                        rhs_indices=idx,
+                        transpose=True,
+                        mode=mode,
+                        sorted_indices=True,
+                    )
+                    y_hat = mx.gather_mm(
+                        x.astype(mx.float32),
+                        w_hat.swapaxes(-1, -2),
+                        rhs_indices=idx,
+                        sorted_indices=True,
+                    )
+                    self.assertLess((y.astype(mx.float32) - y_hat).abs().max(), 2e-2)
+
