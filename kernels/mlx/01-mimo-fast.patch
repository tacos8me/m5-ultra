+    def test_sdpa_window(self):
+        def window_mask(qL, kL, window, causal):
+            q_idx = mx.arange(kL - qL, kL)[:, None]
+            k_idx = mx.arange(kL)[None]
+            mask = (q_idx - k_idx) < window
+            if causal:
+                mask = mask & (q_idx >= k_idx)
+            return mask
+
+        for (qL, kL, D, V, H, kH, window, causal, sinks, dtype) in [
+            (256, 383, 192, 128, 16, 2, 128, True, True, mx.float16),
+            (300, 300, 192, 128, 8, 4, 64, True, False, mx.bfloat16),
+            (130, 500, 128, 128, 8, 2, 100, True, True, mx.float16),
+            (100, 100, 64, 64, 4, 4, 33, False, False, mx.float16),
+            (4, 300, 192, 128, 16, 2, 64, True, True, mx.float16),
+            (1, 128, 192, 128, 16, 2, 128, False, True, mx.float16),
+            (65, 200, 64, 64, 4, 1, 50, True, False, mx.float32),
+        ]:
+            with self.subTest(qL=qL, kL=kL, D=D, V=V, window=window):
+                mx.random.seed(0)
+                q = mx.random.normal((1, H, qL, D)).astype(dtype)
+                k = mx.random.normal((1, kH, kL, D)).astype(dtype)
+                v = mx.random.normal((1, kH, kL, V)).astype(dtype)
+                s = mx.random.normal((H,)).astype(dtype) if sinks else None
+                scale = D**-0.5
+                ref = mlx_ref_attn(
+                    q.astype(mx.float32),
+                    k.astype(mx.float32),
+                    v.astype(mx.float32),
+                    scale=scale,
+                    mask=window_mask(qL, kL, window, causal),
+                    sinks=None if s is None else s.astype(mx.float32),
+                )
+                out = mx.fast.scaled_dot_product_attention(
+                    q,
+                    k,
+                    v,
+                    scale=scale,
+                    mask="causal" if causal else None,
+                    sinks=s,
+                    window_size=window,
+                )
+                self.assertTrue(mx.allclose(ref, out, rtol=1e-2, atol=1e-2))
+
+        with self.assertRaises(ValueError):
+            mx.fast.scaled_dot_product_attention(
+                q, k, v, scale=1.0, mask="causal", window_size=0
+            )
+
+    def test_sdpa_vector_long_qk192_v128(self):
+        # Long-KV single-query decode with query head dim 192, value 128
+        for B, Hq, Hk, kL, sinks, dtype in [
+            (1, 64, 4, 4096, False, mx.bfloat16),
+            (1, 64, 4, 9001, True, mx.float16),
+            (2, 32, 4, 5000, False, mx.bfloat16),
+            (1, 16, 8, 8192, True, mx.bfloat16),
+        ]:
+            with self.subTest(B=B, Hq=Hq, Hk=Hk, kL=kL, sinks=sinks):
+                mx.random.seed(0)
+                q = mx.random.normal((B, Hq, 1, 192)).astype(dtype)
+                k = mx.random.normal((B, Hk, kL, 192)).astype(dtype)
+                v = mx.random.normal((B, Hk, kL, 128)).astype(dtype)
+                s = mx.random.normal((Hq,)).astype(dtype) if sinks else None
+                ref = mlx_ref_attn(
+                    q.astype(mx.float32),
+                    k.astype(mx.float32),
+                    v.astype(mx.float32),
+                    scale=192**-0.5,
+                    sinks=None if s is None else s.astype(mx.float32),
+                )
+                out = mx.fast.scaled_dot_product_attention(
+                    q, k, v, scale=192**-0.5, sinks=s
+                )
+                self.assertTrue(mx.allclose(ref, out, rtol=1e-2, atol=2e-3))
+
+    def test_sdpa_multi_query_qk192_v128(self):
+        # A few causal queries against a long KV (speculative decoding verify)
+        for B, Hq, Hk, qL, kL in [
+            (1, 64, 4, 3, 1000),
+            (1, 64, 4, 4, 5000),
+            (2, 32, 4, 8, 3000),
+        ]:
+            with self.subTest(B=B, qL=qL, kL=kL):
+                mx.random.seed(0)
+                q = mx.random.normal((B, Hq, qL, 192)).astype(mx.bfloat16)
+                k = mx.random.normal((B, Hk, kL, 192)).astype(mx.bfloat16)
+                v = mx.random.normal((B, Hk, kL, 128)).astype(mx.bfloat16)
+                ref = mlx_ref_attn(
+                    q.astype(mx.float32),
+                    k.astype(mx.float32),
+                    v.astype(mx.float32),
+                    scale=192**-0.5,
+                    mask="causal",
+                )
+                out = mx.fast.scaled_dot_product_attention(
+                    q, k, v, scale=192**-0.5, mask="causal"
+                )
+                self.assertTrue(mx.allclose(ref, out, rtol=1e-2, atol=2e-3))
+
+    def test_sdpa_full_qk192_v128(self):
+        for qL, kL, mask, sinks in [
+            (128, 128, "causal", False),
+            (200, 1000, "causal", False),
+            (256, 256, None, True),
+            (97, 97, "array", True),
+        ]:
+            with self.subTest(qL=qL, kL=kL, mask=mask, sinks=sinks):
+                mx.random.seed(0)
+                q = mx.random.normal((2, 32, qL, 192)).astype(mx.float16)
+                k = mx.random.normal((2, 4, kL, 192)).astype(mx.float16)
+                v = mx.random.normal((2, 4, kL, 128)).astype(mx.float16)
+                s = mx.random.normal((32,)).astype(mx.float16) if sinks else None
+                if mask == "array":
+                    mask = mx.random.uniform(shape=(qL, kL)) < 0.8
+                ref = mlx_ref_attn(
+                    q.astype(mx.float32),
+                    k.astype(mx.float32),
+                    v.astype(mx.float32),
+                    scale=192**-0.5,
+                    mask=mask,
+                    sinks=None if s is None else s.astype(mx.float32),
+                )
+                out = mx.fast.scaled_dot_product_attention(
+                    q, k, v, scale=192**-0.5, mask=mask, sinks=s
+                )
+                self.assertEqual(out.shape, (2, 32, qL, 128))
+                self.assertTrue(mx.allclose(ref, out, rtol=1e-2, atol=1e-2))
