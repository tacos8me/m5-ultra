+    def wrapped(*a, **k):
+        kern = make(*a, **k)
+        name = k.get('name', a[0] if a else '?')
+
+        def call(*ca, **ck):
+            _KCOUNT[name] = _KCOUNT.get(name, 0) + 1
+            return kern(*ca, **ck)
+        return call
+    mx.fast.metal_kernel = wrapped
+
+
