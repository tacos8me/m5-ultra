+"""Warm-server before/after gate; new argument values after completed seed requests."""
+import json,urllib.request,concurrent.futures
+import source_bench as lib
+lib.control('/cost-policy/1')
+def cases(start):
+ result=[]
+ for j in range(start,start+4):
+  result.extend([(f'read{j}',f'Read src/component_{j}.py from line {10+7*j} through line {40+9*j}. Use read_file.',lib.tools),(f'test{j}',f'Run tests/test_component_{j}.py with verbose=true and timeout_seconds={60+30*j}. Use run_tests.',lib.tools),(f'search{j}',f'Search for handle_event_{j} under src/component_{j}/ with case_sensitive=true. Use search_code.',lib.tools)])
+ return result
+# Warm the bounded completed-response bank with distinct requests. The measured
+# requests have unseen paths, symbols, line numbers and timeout values.
+lib.control('/extra-source/both')
+for name,prompt,tools in lib.cases[:12]:lib.chat(name,prompt,tools)
+with (lib.A/f'{lib.label}.jsonl').open('w') as f:
+ def run(mode,rep,name,prompt,tools):
+  r=lib.chat(name,prompt,tools);r.update(mode=mode,rep=rep)
+  r['sources']=json.loads(urllib.request.urlopen(lib.base+'/extra-source-counts').read())
+  f.write(json.dumps(r)+'\n');f.flush();print(json.dumps({k:v for k,v in r.items() if k not in ('content','calls')}),flush=True)
+ for rep,(mode,start) in enumerate((('off',4),('both',4),('off',8),('both',8))):
+  lib.control('/extra-source/'+mode)
+  for name,prompt,tools in cases(start)+lib.cases[12:]:run(mode,rep,name,prompt,tools)
+ for mode in ('off','both'):
+  lib.control('/extra-source/'+mode)
+  run(mode,'short','short','Say hello in one sentence.',None)
+  with concurrent.futures.ThreadPoolExecutor(2) as pool:
+   futures=[pool.submit(lib.chat,name,prompt,ts) for name,prompt,ts in cases(12)[:2]]
+   for future in futures:
+    r=future.result();r.update(mode=mode,rep='c2');f.write(json.dumps(r)+'\n');f.flush()
diff --git a/benchmarks/og/attn_bench.py b/benchmarks/og/attn_bench.py
