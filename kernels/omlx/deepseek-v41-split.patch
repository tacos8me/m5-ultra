+def exp_qmvform():
+    # Find an R=1 formulation of fast_qmv's rows kernel that is bitwise R=2 (and faster).
+    from omlx.patches.deepseek_v41 import fast_qmv as FQ
+    inner = {
+        'dot': 'for (int v = 0; v < M; v++) acc[r][v] += dot(w4, xq[v]);',
+        'fma_xyzw': 'for (int v = 0; v < M; v++) { float a = acc[r][v]; a = fma(w4.x, xq[v].x, a); a = fma(w4.y, xq[v].y, a); a = fma(w4.z, xq[v].z, a); a = fma(w4.w, xq[v].w, a); acc[r][v] = a; }',
+        'fma_wzyx': 'for (int v = 0; v < M; v++) { float a = acc[r][v]; a = fma(w4.w, xq[v].w, a); a = fma(w4.z, xq[v].z, a); a = fma(w4.y, xq[v].y, a); a = fma(w4.x, xq[v].x, a); acc[r][v] = a; }',
+        'dotsep': 'for (int v = 0; v < M; v++) { const float d = dot(w4, xq[v]); acc[r][v] = acc[r][v] + d; }',
+        'chain': 'for (int v = 0; v < M; v++) acc[r][v] = fma(w4.w, xq[v].w, fma(w4.z, xq[v].z, fma(w4.y, xq[v].y, fma(w4.x, xq[v].x, acc[r][v]))));',
+        'mulchain': 'for (int v = 0; v < M; v++) acc[r][v] += fma(w4.w, xq[v].w, fma(w4.z, xq[v].z, fma(w4.y, xq[v].y, w4.x * xq[v].x)));',
+    }
+    old = 'for (int v = 0; v < M; v++) acc[r][v] += dot(w4, xq[v]);'
+    assert old in FQ._SOURCE
+    kernels = {name: mx.fast.metal_kernel(name='ogs_qmv_' + name, input_names=['w', 'scales', 'x'], output_names=['y'],
+                                          source=FQ._SOURCE.replace(old, body), header=FQ._HEADER)
+               for name, body in inner.items()}
+
+    def run(kernel, x, p, R):
+        k, n, m = x.shape[-1], p.weight.shape[0], x.size // x.shape[-1]
+        rows = 4 * R
+        return kernel(inputs=[p.weight, p.scales, x], template=[('T', x.dtype), ('K', k), ('N', n), ('M', m), ('R', R)],
+                      grid=(32, (n + rows - 1) // rows * 2, 1), threadgroup=(32, 2, 1),
