new file mode 100644
index 00000000..2283175a
--- /dev/null
+++ b/benchmarks/ds41_sprint3_sources/source_analysis.py
@@ -0,0 +1,39 @@
+"""Offline draft availability; capture timings are intentionally ignored."""
+import json,sys,collections
+from pathlib import Path
+import numpy as np
+A=Path(sys.argv[1]);bank=collections.defaultdict(list);report=[]
+def prefix(a,b):
+ n=0
+ for x,y in zip(a,b):
+  if x!=y:break
+  n+=1
+ return n
+for name in [x for j in range(4) for x in (f'read{j}',f'test{j}',f'search{j}')]+['rewrite','edit']:
+ obj=json.loads((A/f'source-{name}.json').read_text())
+ for uid,r in obj['requests'].items():
+  tokens=r['tokens'];steps=r['steps'];valid=0;baseline=0;retrieved=0;hits=0;bestgain=0;new=[];alignment=[]
+  for step in steps:
+   start=step['start'];committed=step['committed'];fs=np.asarray(step['features'],np.float32)
+   alignment.append(tokens[start:min(start+len(committed),len(tokens))]==committed[:max(0,len(tokens)-start)])
+   for off,(token,feature) in enumerate(zip(committed,fs)):
+    pos=start+off
+    suffix=tokens[pos+1:pos+5]
+    if len(suffix)<4:continue
+    norm=feature/max(float(np.linalg.norm(feature)),1e-12)
+    new.append((token,norm,suffix))
+   pos=start+len(committed)-1;truth=tokens[pos+1:pos+5]
+   if len(truth)<4:continue
+   valid+=1;old=prefix(step['drafts'],truth);baseline+=old
+   feature=fs[-1];norm=feature/max(float(np.linalg.norm(feature)),1e-12)
+   candidates=bank.get(committed[-1],[])
+   scored=sorted([(float(np.dot(norm,f)),s) for f,s in candidates],key=lambda t:t[0],reverse=True)
+   if scored:
+    score,draft=scored[0];hit=prefix(draft,truth)
+    if score>=.9:
+     hits+=1;retrieved+=hit;bestgain+=max(0,hit-old)
+   # Bank only contains completed previous requests, never this response.
+  row=dict(name=name,tokens=len(tokens),steps=valid,aligned=all(alignment),baseline_accept=baseline,retrieval_hits=hits,retrieval_accept=retrieved,optimistic_extra_accept=bestgain,stats=r.get('stats'))
+  report.append(row);print(json.dumps(row))
+  for token,feature,suffix in new:bank[token].append((feature,suffix))
+(A/'source-analysis.json').write_text(json.dumps(report,indent=2))
diff --git a/benchmarks/ds41_sprint3_sources/source_bench.py b/benchmarks/ds41_sprint3_sources/source_bench.py
