+"""Client: decode a set of prompts through the private worker (server started with DS41_PIPE_CALIB)."""
+import json
+import sys
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parent.parent/'og'))
+from bench import request  # noqa: E402
+
+HOME = Path.home()
+base, label = sys.argv[1], sys.argv[2]
+which = sys.argv[3] if len(sys.argv) > 3 else 'all'
+prompts = [(f'code-{n}', json.loads((HOME/f'llm/ds41/split-wire/ids-{n}.json').read_text()), True)
+           for n in (8192, 131072, 524288)]
+prompts += [(f'chat-{p.stem}', json.loads(p.read_text()), False)
+            for p in sorted((HOME/'llm/ds41/og-speed/ids-chat').glob('*.json'))]
+prompts = [p for p in prompts if which == 'all' or p[0].startswith(which)]
+out = (HOME/f'llm/ds41/og-speed/{label}.calib-runs.jsonl').open('a')
+for name, tokens, ignore_eos in prompts:
+    tokens = tokens['prompt_ids'] if isinstance(tokens, dict) else tokens
+    r = request(base, dict(tokens=tokens, max_tokens=512, request_id=name, ignore_eos=ignore_eos))
+    rec = dict(name=name, n=len(tokens), decode_tok_s=r['decode_tok_s'], generated=len(r['tokens']),
+               steps=r['summary']['steps'], tokens=r['tokens'])
+    out.write(json.dumps(rec) + '\n'); out.flush()
+    print(name, len(tokens), round(r['decode_tok_s'] or 0, 1), len(r['tokens']), flush=True)
