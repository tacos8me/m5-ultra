+"""Locked loading/replay smoke only; no throughput or quality claim."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+home=Path.home();here=Path(__file__).parent
+sys.path.insert(0,str(home/'src/wt/ds41-pipe1'))
+label=os.environ.get('PIPE1_PROBE_LABEL','load-probe')
+watch=subprocess.Popen(['/opt/homebrew/bin/python3',str(here/'watch.py'),str(os.getpid()),str(here/(label+'.memory.json'))])
+import mlx.core as mx
+from omlx.patches.deepseek_v41.pipe_decoder import load_decoder
+
+mx.set_wired_limit(min(245<<30,mx.device_info()['max_recommended_working_set_size']))
+mx.set_cache_limit(512<<20);mx.set_memory_limit(230<<30)
+model=load_decoder(home/'models/DeepSeek-V4.1-Flash-pipe1-mlx')
+fixture=home/'llm/ds41/split-nv/states/mine-8192.safetensors'
+arrays,metadata=mx.load(str(fixture),return_metadata=True)
+manifest=json.loads(metadata['manifest']);tokens=arrays['tokens'].tolist()
+cache=model.import_prefill(arrays,manifest,tokens,identity=manifest['identity'])
+mx.eval([v for c in cache for v in c.cache if v is not None])
+ctx=getattr(cache[0],'_omlx_mtp_prime_ctx',None)
+assert ctx is not None and ctx.expected_target_offset==len(tokens)-1
+# Boundary fixture inputs are reused as synthetic rows solely to execute and
+# validate the loaded operators. This is not an end-to-end continuation.
+before=len(tokens)-1
+h=arrays['tail.hidden'][:,-5:];pre=arrays['tail.pre'][:,-5:]
+logits,hidden=model.forward_boundary(h,pre,cache,start=before,verify=True)
+mx.eval(logits,hidden)
+assert bool(mx.all(mx.isfinite(logits)).item())
+assert bool(mx.all(mx.isfinite(hidden)).item())
+model.rollback_boundary(cache,2)
+assert all(c.size()==before+2 for c in cache)
+print(json.dumps(dict(event='load_replay_smoke',passed=True,prompt_tokens=len(tokens),logits_shape=logits.shape,
+                      hidden_shape=hidden.shape,active_gib=mx.get_active_memory()/2**30,peak_gib=mx.get_peak_memory()/2**30)),flush=True)
