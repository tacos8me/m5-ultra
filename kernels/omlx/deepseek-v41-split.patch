+"""Small CPU cache test: every 1..5-row accepted prefix, including wraparound."""
+import os
+os.environ['DS41_GROWTH']='1'
+from pathlib import Path
+import sys
+sys.path.insert(0,str(Path.home()/'src/wt/ds41-pipe1'))
+import mlx.core as mx
+mx.set_default_device(mx.cpu)
+from types import SimpleNamespace
+from omlx.patches.deepseek_v41.cache import DeepseekV41Cache
+from omlx.patches.deepseek_v41.pipe_decoder import DecoderHalf
+from omlx.patches.deepseek_v41 import growth
+
+checked=0
+for before in (3,127,128,129):
+    for length in range(1,6):
+        for keep in range(1,length+1):
+            caches=[DeepseekV41Cache(1 if i==20 else 0) for i in range(40)]
+            snapshots=[];states=[{} for _ in caches]
+            for i,c in enumerate(caches):
+                c[0]=mx.array([before+length],mx.int32)
+                snapshots.append(([],None,None))
+                window=mx.arange(max(0,before-128),before+length)[None,:,None]
+                c[1]=window[:,-128:]
+                states[i]['window']=window
+                if i==20:
+                    for slot in (2,3):
+                        c[slot]=mx.arange(before)[None,:,None]
+                        c[slot]=growth.append(c,slot,c[slot],mx.arange(before,before+length)[None,:,None],before)
+            caches[0]._pipe1_verify=(before,length,snapshots,states)
+            host=SimpleNamespace(_config=SimpleNamespace(window_size=128))
+            DecoderHalf.rollback_boundary(host,caches,keep)
+            end=before+keep
+            assert all(c.size()==end for c in caches)
+            for c in caches[20:]:
+                assert c[1].reshape(-1).tolist()==list(range(max(0,end-128),end))
+            for slot in (2,3):
+                c=caches[20]
+                assert c[slot].reshape(-1).tolist()==list(range(end))
+                c[slot]=growth.append(c,slot,c[slot],mx.array([[[999]]]),end)
+                assert c[slot].reshape(-1).tolist()==list(range(end))+[999]
+            checked+=1
+print({'accepted_prefix_cases':checked,'device':'cpu','passed':True})
