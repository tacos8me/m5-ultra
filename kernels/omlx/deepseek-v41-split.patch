+"""og-speed lab: load the Mac half once and run named experiments. Speed/bitwise only.
+
+Run under gpu-exec via benchmarks/og/lease.py --direct ../ogs/lab.py; OGS_EXPERIMENTS=forward,moe,...
+Sessions come from a disk snapshot of one real 8K box OPEN plus five STEP
+boundary rows (made on the first run with the box up), so the Mac-only
+experiments do not need the box.
+"""
+import json
+import os
+from pathlib import Path
+import statistics
+import subprocess
+import sys
+import time
+
+HOME = Path.home()
+TREE = Path(os.environ.get('DS41_TREE', str(HOME/'src/wt/ds41-og-speed')))
+sys.path.insert(0, str(TREE))
+LOGS = Path(os.environ.get('OG_LOGS', str(HOME/'llm/ds41/og-speed')))
+label = os.environ.get('OG_LABEL', 'ogs-lab')
+watch = subprocess.Popen(['/opt/homebrew/bin/python3', str(TREE/'benchmarks/og/watch.py'), str(os.getpid()),
+                          str(LOGS/(label+'.memory.json')), os.environ.get('OG_LEASE', '600')])
+import mlx.core as mx  # noqa: E402
+from omlx.patches.deepseek_v41.pipe_decoder import load_decoder  # noqa: E402
+from omlx.patches.deepseek_v41.pipe_wire import EncoderSession, mlx_state, mlx_step  # noqa: E402
+from omlx.patches.deepseek_v41 import language as LG  # noqa: E402
+from omlx.patches.deepseek_v41 import dspark as DS  # noqa: E402
+from omlx.patches.deepseek_v41.quantization import quantize_activation  # noqa: E402
+from omlx.patches.mlx_lm_mtp.deepseek_v4_dspark import capture_prompt  # noqa: E402
+
+mx.set_wired_limit(min(245 << 30, mx.device_info()['max_recommended_working_set_size']))
+mx.set_cache_limit(512 << 20); mx.set_memory_limit(230 << 30)
+out = (LOGS/(label+'.jsonl')).open('a')
+EXPERIMENTS = os.environ.get('OGS_EXPERIMENTS', 'forward,moe').split(',')
+SNAP = LOGS/'snap-8k'
+
+
+def emit(record):
+    out.write(json.dumps(record)+'\n'); out.flush(); print(json.dumps(record), flush=True)
+
+
+def med(xs):
+    return round(1000*statistics.median(xs), 3)
+
+
+t0 = time.perf_counter()
+model = load_decoder(HOME/'models/DeepSeek-V4.1-Flash-pipe1-mlx')
+emit(dict(event='loaded', s=time.perf_counter()-t0))
+tokens = json.loads((HOME/'llm/ds41/split-wire/ids-8192.json').read_text())
+
+if not (SNAP/'step.safetensors').exists():
+    enc = EncoderSession()
+    try:
+        tensors, manifest = enc.open(tokens)
+        state = mlx_state(tensors)
+        enc.send_step([tokens[-1], 223, 1001, 5000, 17], len(tokens)-1)
+        raw, _ = enc.recv_step()
+        step = mlx_step(raw, 5)
+    finally:
+        enc.close()
+    SNAP.mkdir(parents=True, exist_ok=True)
+    mx.save_safetensors(str(SNAP/'state.safetensors'), state)
+    mx.save_safetensors(str(SNAP/'step.safetensors'), step)
+    (SNAP/'manifest.json').write_text(json.dumps(manifest))
+    emit(dict(event='snapshot_saved'))
+STATE = mx.load(str(SNAP/'state.safetensors'))
+FULL = mx.load(str(SNAP/'step.safetensors'))
+MANIFEST = json.loads((SNAP/'manifest.json').read_text())
+IDENTITY = MANIFEST.get('identity')
+
+
+class Session:
+    def __init__(self):
+        self.cache = model.import_prefill(dict(STATE), MANIFEST, tokens, identity=IDENTITY)
+        mx.eval([x for item in self.cache for x in item.cache if x is not None])
+
+
+S = Session()
+
+
+def forward_outputs(L, s=None):
+    s = S if s is None else s
+    arrays = {k: v[:, :L] for k, v in FULL.items()}
+    start = s.cache[0].size()
+    logits, hidden = model.forward_boundary(**arrays, cache=s.cache, start=start, verify=True)
+    mx.eval(logits, hidden)
+    model.rollback_boundary(s.cache, 1)
+    return logits, hidden
+
+
+def fwd(L, reps=12, warm=3):
+    totals = []
+    for it in range(reps+warm):
+        a = time.perf_counter()
+        forward_outputs(L)
+        if it >= warm:
+            totals.append(time.perf_counter()-a)
+    return med(totals)
+
+
+def bench(fn, reps=10, warm=3):
+    totals = []
+    for it in range(reps+warm):
+        a = time.perf_counter()
+        mx.eval(fn())
+        if it >= warm:
+            totals.append(time.perf_counter()-a)
+    return med(totals)
+
+
+def bits_equal(a, b):
+    a, b = a.astype(mx.float32), b.astype(mx.float32)
+    return int((a.view(mx.uint32) != b.view(mx.uint32)).sum().item())
+
+
+caps = {}
+orig_moe = LG.MoE.__call__
+layer_of = {id(model.layers[i].ffn): i for i in range(20, 40)}
+
+
+def moe_rec(self, x, image_mask):
+    caps[layer_of[id(self)]] = x
+    return orig_moe(self, x, image_mask)
+
+
+def capture(L):
+    LG.MoE.__call__ = moe_rec
+    try:
+        forward_outputs(L)
+    finally:
+        LG.MoE.__call__ = orig_moe
+    got = dict(caps); caps.clear()
+    return got
+
+
+def routed(i, x):
+    f = model.layers[i].ffn
+    idx, w = f.gate(x, None)
+    q = quantize_activation(x)
+    return f.experts(q[..., None, None, :], idx, w, input_quantized=True)
+
+
+def exp_forward():
+    # Two identical sessions in lockstep: reference kernels on S, new on S2.
+    from omlx.patches.deepseek_v41 import moe_decode
+    s2 = Session()
+    for L in (1, 2, 3, 4, 5, 5, 3):
+        moe_decode.ENABLED = False
+        a_l, a_h = forward_outputs(L)
+        moe_decode.ENABLED = True
+        b_l, b_h = forward_outputs(L, s2)
+        emit(dict(exp='forward_bits', rows=L, logits_mismatch=bits_equal(a_l, b_l), hidden_mismatch=bits_equal(a_h, b_h)))
+    del s2
+    for L in (1, 2, 3, 4, 5):
+        moe_decode.ENABLED = False
+        t_old = fwd(L)
+        moe_decode.ENABLED = True
+        t_new = fwd(L)
+        emit(dict(exp='forward', rows=L, old_ms=t_old, new_ms=t_new))
+
+
+def exp_moe():
+    from omlx.patches.deepseek_v41 import moe_decode
+    for L in (5, 4, 3, 2, 1):
+        cap = capture(L)
+        bad = 0
+        for i in range(20, 40):
+            moe_decode.ENABLED = False
+            a = routed(i, cap[i]); mx.eval(a)
+            moe_decode.ENABLED = True
+            b = routed(i, cap[i]); mx.eval(b)
+            bad += bits_equal(a, b)
+
+        def chain():
+            prev, outs = None, []
+            for i in range(20, 40):
+                x = cap[i]
+                if prev is not None:
+                    x = x + (prev.reshape(-1)[:1]*0).astype(x.dtype)
+                y = routed(i, x)
+                prev = y
+                outs.append(y)
+            return outs
+        moe_decode.ENABLED = False
+        t_old = bench(chain)
+        moe_decode.ENABLED = True
+        t_new = bench(chain)
+        emit(dict(exp='moe', rows=L, mismatched_values=bad, old_ms=t_old, new_ms=t_new))
+
+
+def _old_dspark_attention(self, x, cache):
+    """DSparkAttention.__call__ as of ds41-og 8f1ab521 (reference)."""
+    c = self._config
+    batch, length, _ = x.shape
+    positions = mx.arange(cache.offset, cache.offset + length)
+    q = LG.rope(self.wq_b(self.q_norm(self.wq_a(x))).reshape(batch, length, c.n_heads, c.head_dim), positions, c, False)
+    draft_kv = quantize_activation(LG.rope(self.kv_norm(self.wkv(x)), positions, c, False))
+    kv = mx.concatenate([cache.keys[:, 0], draft_kv], axis=1)
+    o = (mx.fast.scaled_dot_product_attention(
+        q.astype(mx.float32).transpose(0, 2, 1, 3), kv[:, None].astype(mx.float32), kv[:, None].astype(mx.float32),
+        scale=c.head_dim**-0.5, sinks=self.attn_sink.astype(mx.float32)).transpose(0, 2, 1, 3).astype(q.dtype))
+    o = LG.rope(o, positions, c, False, inverse=True)
+    grouped = o.reshape(batch, length, c.o_groups, -1)
+    weight = self.wo_a.weight.reshape(c.o_groups, c.o_lora_rank, -1)
+    return self.wo_b(mx.einsum("bsgd,grd->bsgr", grouped, weight).flatten(-2))
+
+
+def primed_drafter():
+    """A session with a primed DSpark ring (Mac-only, from the snapshot rows)."""
+    s = Session()
+    rows1 = {k: v[:, :1] for k, v in FULL.items()}
+    start = s.cache[0].size()
+    logits, hidden = model.forward_boundary(**rows1, cache=s.cache, start=start, verify=True)
+    mx.eval(logits, hidden)
+    model.rollback_boundary(s.cache, 1)
+    capture_prompt(model, mx.array([[tokens[-1]]], mx.uint32), hidden, s.cache)
+    first = int(mx.argmax(logits[0, -1]).item())
+    logits, hidden = forward_outputs(1, s)
+    mtp_cache, _ = model.mtp_take_primed(s.cache, first)
+    return s, mtp_cache, hidden[:, :1], int(mx.argmax(logits[0, -1]).item())
+
+
+def exp_draft():
+    from omlx.patches.deepseek_v41 import moe_decode
+    s, mtp_cache, h1, anchor = primed_drafter()
+    model.dspark_append_context(h1, mtp_cache)
+    mx.eval([x.keys for x in mtp_cache])
+    anchor_ids = mx.array([[anchor]], mx.uint32)
+    new_attn = DS.DSparkAttention.__call__
+    for width in (4, 3, 2):
+        DS.DSparkAttention.__call__ = _old_dspark_attention
+        moe_decode.ENABLED = False
+        a, _ = DS.proposal_forward(model, anchor_ids, mtp_cache, width); mx.eval(a)
+        DS.DSparkAttention.__call__ = new_attn
+        moe_decode.ENABLED = True
+        b, _ = DS.proposal_forward(model, anchor_ids, mtp_cache, width); mx.eval(b)
+        emit(dict(exp='draft_bits', width=width, logits_mismatch=bits_equal(a, b)))
+    for name, attn, fused in (('old', _old_dspark_attention, False), ('new', new_attn, True)):
+        DS.DSparkAttention.__call__ = attn
+        moe_decode.ENABLED = fused
+        builds, totals = [], []
+        for it in range(15):
+            a0 = time.perf_counter()
+            lg, _ = model.dspark_forward(h1, anchor_ids, mtp_cache, draft_length=4)
+            previous = anchor_ids.reshape(1)
+            toks, probs = [], []
+            for i in range(4):
+                bias, _ = model.dspark_markov(previous)
+                scores = lg[:, i] + bias
+                previous = mx.argmax(scores, -1).astype(mx.uint32)
+                toks.append(previous)
+                probs.append(mx.exp(mx.max(scores)-mx.logsumexp(scores)))
+            chosen = mx.concatenate(toks)
+            a1 = time.perf_counter()
+            mx.eval(chosen, probs)
+            [float(p.item()) for p in probs]
+            a2 = time.perf_counter()
+            if it >= 3:
+                builds.append(a1-a0); totals.append(a2-a0)
+        emit(dict(exp='draft', variant=name, build_ms=med(builds), total_ms=med(totals)))
+    DS.DSparkAttention.__call__ = new_attn
+    moe_decode.ENABLED = True
+
+
+def exp_moeshape():
+    from omlx.patches.deepseek_v41 import moe_decode
+    caps_by_L = {L: capture(L) for L in (5, 3, 1)}
+    refs = {}
+    moe_decode.ENABLED = False
+    for L, cap in caps_by_L.items():
+        refs[L] = [routed(i, cap[i]) for i in range(20, 40)]
+        mx.eval(refs[L])
+    moe_decode.ENABLED = True
+
+    def chain(cap):
+        def run():
+            prev, outs = None, []
+            for i in range(20, 40):
+                x = cap[i]
+                if prev is not None:
+                    x = x + (prev.reshape(-1)[:1]*0).astype(x.dtype)
+                y = routed(i, x)
+                prev = y
+                outs.append(y)
+            return outs
+        return run
+
+    def trial(gu, dn):
+        moe_decode.GATE_UP_SHAPE, moe_decode.DOWN_SHAPE = gu, dn
+        rec = dict(exp='moeshape', gate_up=gu, down=dn)
+        for L, cap in caps_by_L.items():
+            outs = [routed(i, cap[i]) for i in range(20, 40)]
+            mx.eval(outs)
+            rec[f'bad{L}'] = sum(bits_equal(a, b) for a, b in zip(refs[L], outs))
+            rec[f'ms{L}'] = bench(chain(cap))
+        emit(rec)
+        return rec['ms5'] + rec['ms1']
+    best_gu = min(((2, 4), (2, 8), (4, 4), (1, 8), (4, 2), (1, 16)), key=lambda gu: trial(gu, (2, 4)))
+    best_dn = min(((2, 8), (4, 4), (2, 16), (4, 8), (1, 16), (8, 4)), key=lambda dn: trial(best_gu, dn))
+    emit(dict(exp='moeshape_best', gate_up=best_gu, down=best_dn))
+
+
+def exp_overhead():
+    # Cost of one dependent dispatch: chains of tiny kernels (MLX op and custom kernel).
+    k = mx.fast.metal_kernel(name='ogs_add1', input_names=['x'], output_names=['y'],
+                             source='uint i = thread_position_in_grid.x; y[i] = x[i] + T(1);')
+    x0 = mx.zeros((1, 5, 5120), mx.bfloat16)
+    mx.eval(x0)
+    for n in (100, 500):
+        def mlx_chain():
+            y = x0
+            for _ in range(n):
+                y = y + 1
+            return y
+
+        def ck_chain():
+            y = x0
+            for _ in range(n):
+                y = k(inputs=[y], template=[('T', mx.bfloat16)], grid=(y.size, 1, 1), threadgroup=(256, 1, 1),
+                      output_shapes=[y.shape], output_dtypes=[y.dtype])[0]
+            return y
+
+        def indep():
+            return [x0 + i for i in range(n)]
+        def split(fn):
+            evals = []
+            for it in range(8):
+                r = fn()
+                a = time.perf_counter(); mx.eval(r); evals.append(time.perf_counter()-a)
+            return round(1e6*statistics.median(evals[2:])/n, 2)
+        emit(dict(exp='overhead', n=n, mlx_chain_eval_us=split(mlx_chain), custom_chain_eval_us=split(ck_chain),
+                  independent_eval_us=split(indep)))
+
+
+_COMBINE = {
+    'seq': 'float acc = 0.0f; for (int j = 0; j < TOPK; j++) acc += float(routed[(r * TOPK + j) * D + d]);',
+    'seq0': 'float acc = float(routed[(r * TOPK) * D + d]); for (int j = 1; j < TOPK; j++) acc += float(routed[(r * TOPK + j) * D + d]);',
+    'pair': 'float a0 = float(routed[(r*TOPK+0)*D+d]) + float(routed[(r*TOPK+1)*D+d]); float a1 = float(routed[(r*TOPK+2)*D+d]) + float(routed[(r*TOPK+3)*D+d]); float a2 = float(routed[(r*TOPK+4)*D+d]) + float(routed[(r*TOPK+5)*D+d]); float acc = (a0 + a1) + a2;',
+    'pair2': 'float a0 = float(routed[(r*TOPK+0)*D+d]) + float(routed[(r*TOPK+1)*D+d]); float a1 = float(routed[(r*TOPK+2)*D+d]) + float(routed[(r*TOPK+3)*D+d]); float a2 = float(routed[(r*TOPK+4)*D+d]) + float(routed[(r*TOPK+5)*D+d]); float acc = a0 + (a1 + a2);',
+    'half': 'float a0 = (float(routed[(r*TOPK+0)*D+d]) + float(routed[(r*TOPK+1)*D+d])) + float(routed[(r*TOPK+2)*D+d]); float a1 = (float(routed[(r*TOPK+3)*D+d]) + float(routed[(r*TOPK+4)*D+d])) + float(routed[(r*TOPK+5)*D+d]); float acc = a0 + a1;',
+}
+
+
+def exp_combine():
+    # Which fp32 summation order reproduces MLX's (routed.astype(f32).sum(-2) + shared.astype(f32)).astype(bf16)?
+    from omlx.patches.deepseek_v41 import moe_decode  # noqa: F401
+    cap = capture(5)
+    cases = []
