+++ b/benchmarks/og/cache_gate.py
@@ -0,0 +1,220 @@
+"""ds41-og prefix-reuse exactness gate (run under gpu-exec via lease.py --direct).
+
+For multi-turn conversations built on the frozen split-wire prompts, every turn
+is served twice through the real box and the Mac decoder half:
+
+  cached  OPEN {cache, lean, delta_from} + og import_state() with the Mac's
+          stored layer-20 rows (the served og path)
+  fresh   plain OPEN (full state, box prefill from token 0) + import_prefill()
+          (the pre-cache path)
+
+and compared bit for bit: every layers 20-39 cache array and the DSpark prime
+ring after import, then greedy DSpark decode (ignore_eos) with a sha256 of
+every verify step's FP32 logits, the committed tokens and the draft
+acceptance. When the box does not (yet) send a delta, OG_EMULATE_DELTA=1 cuts
+the received layer-20 rows to [P, N-1) on the Mac, so the Mac reassembly is
+exercised on real data either way.
+
+Turns alternate the two chat-template shapes: chat (the next prompt extends
+the whole previous prompt) and thinking (the next prompt replaces the final
+<think> with </think>, so the common prefix ends at N-1).
+"""
+import hashlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+HOME = Path.home()
+TREE = Path(os.environ.get('DS41_TREE', str(HOME/'src/wt/ds41-og-cache')))
+sys.path.insert(0, str(TREE))
+LOGS = Path(os.environ.get('OG_LOGS', str(HOME/'llm/ds41/og-cache')))
+LOGS.mkdir(parents=True, exist_ok=True)
+label = os.environ.get('OG_LABEL', 'ogc-gate')
+here = Path(__file__).parent
+watch = subprocess.Popen(['/opt/homebrew/bin/python3', str(here/'watch.py'), str(os.getpid()),
+                          str(LOGS/(label+'.memory.json')), os.environ.get('OG_LEASE', '840')])
+import mlx.core as mx  # noqa: E402
+import numpy as np  # noqa: E402
+from transformers import PreTrainedTokenizerFast  # noqa: E402
+from omlx.patches.deepseek_v41 import og_cache  # noqa: E402
+from omlx.patches.deepseek_v41.pipe_decoder import load_decoder  # noqa: E402
+from omlx.patches.deepseek_v41.pipe_session import PipelineDepthController, PipelineRequest  # noqa: E402
+from omlx.patches.deepseek_v41.pipe_wire import EncoderSession, mlx_state  # noqa: E402
+
+mx.set_wired_limit(min(245 << 30, mx.device_info()['max_recommended_working_set_size']))
+mx.set_cache_limit(512 << 20)
+mx.set_memory_limit(230 << 30)
+out = (LOGS/(label+'.gate.jsonl')).open('a')
+MODEL = HOME/'models/DeepSeek-V4.1-Flash-pipe1-mlx'
+BOX = os.environ.get('DS41_OG_BOX', '10.10.10.1:10052').rsplit(':', 1)
+SIZES = [int(x) for x in os.environ.get('OG_GATE_SIZES', '8192,131072').split(',')]
+TURNS = int(os.environ.get('OG_GATE_TURNS', '3'))
+GEN = int(os.environ.get('OG_GATE_GEN', '48'))
+EMULATE = os.environ.get('OG_EMULATE_DELTA', '0') == '1'
+FRESH = os.environ.get('OG_GATE_FRESH', '1') == '1'
+STREAM = os.environ.get('OG_GATE_STREAM', '1') == '1'
+REPEATS = [x for x in os.environ.get('OG_GATE_REPEATS', 'repeat_stream,repeat_plain').split(',') if x]
+EOS, USER, ASSISTANT, THINK, THINK_END = 1, 128803, 128804, 128821, 128822
+
+
+def emit(record):
+    out.write(json.dumps(record)+'\n')
+    out.flush()
+    print(json.dumps(record), flush=True)
+
+
+def digest(value):
+    if value is None:
+        return None
+    if value.dtype == mx.bfloat16:
+        value = value.view(mx.uint16)
+    host = np.array(value)
+    return hashlib.sha256(host.tobytes() + str(host.shape).encode()).hexdigest()[:16]
+
+
+def fingerprint(model, cache):
+    """Every Mac-owned state array after import: layers 20-39 slots and the DSpark prime ring."""
+    parts = []
+    for i in range(20, 40):
+        parts += [digest(x) for x in cache[i].cache]
+    for i in range(20):
+        parts.append(int(cache[i].size()))
+    ctx = getattr(cache[0], '_omlx_mtp_prime_ctx', None) or getattr(model, '_omlx_mtp_prime_ctx', None)
+    if ctx is not None:
+        parts += [(stage.offset, digest(stage.keys)) for stage in ctx.caches]
+        parts.append(ctx.expected_target_offset)
+    return hashlib.sha256(json.dumps(parts).encode()).hexdigest()[:16], parts
+
+
+class GateRequest(PipelineRequest):
+    """PipelineRequest with a selectable import path and per-step logits hashes."""
+
+    def __init__(self, model, tokens, encoder, opened, *, use_state, base_rows=None):
+        self.model, self.tokens = model, list(tokens)
+        self.encoder = encoder
+        self.cache = self.mtp_cache = None
+        self.steps, self.hashes = [], []
+        self.accepted = self.proposed = self.copy_accepted = self.copy_proposed = 0
+        self.controller = PipelineDepthController(4)
+        self.copy = None
+        self._pending = None
+        self.rows = None
+        tensors, manifest, self.prefill_remote_s = opened
+        start = time.perf_counter()
+        if use_state:
+            self.cache, self.rows = model.import_state(tensors, manifest, tokens, identity=encoder.identity,
+                                                       base_rows=base_rows)
+        else:
+            self.cache = model.import_prefill(mlx_state(tensors), manifest, tokens, identity=encoder.identity)
+        mx.eval([x for item in self.cache for x in item.cache if x is not None])
+        self.replay_s = time.perf_counter() - start
+
+    def complete(self, *, verify=False, greedy=False):
+        # Always hash the full FP32 logits; hand greedy callers their argmax targets.
+        logits, hidden = super().complete(verify=verify)
+        self.hashes.append(digest(logits.astype(mx.float32)))
+        return (mx.argmax(logits[0], -1), hidden) if greedy else (logits, hidden)
+
+
+def cut_delta(tensors, manifest, base):
+    """Emulate the box's delta_from on a full state: keep layer-20 rows [base, N-1)."""
+    manifest = dict(manifest, delta_from=base)
+    tensors = dict(tensors)
+    for slot, width in ((2, 288), (3, 68)):
+        name = manifest['layers'][20]['slots'][slot]
+        kind, shape, data, _ = tensors[name]
+        rows = shape[1] - base
+        tensors[name] = [kind, [1, rows, width], memoryview(data)[base*width:], rows*width]
+    return tensors, manifest
+
+
+def serve(model, tokens, *, cached, store, stream=False):
+    t0 = time.perf_counter()
+    encoder = EncoderSession(BOX[0], int(BOX[1]))
+    entry, base = store.lookup(tokens[:-1]) if cached else (None, 0)
+    if base < 4096:
+        entry, base = None, 0
+    options = dict(cache=True, state='lean', delta_from=base, stream=stream) if cached else {}
+    start = time.perf_counter()
+    tensors, manifest = encoder.open(tokens, 'ogc-gate', **options)
+    opened_s = time.perf_counter() - start
+    emulated = False
+    if cached and base and not manifest.get('delta_from') and EMULATE:
+        tensors, manifest = cut_delta(tensors, manifest, base)
+        emulated = True
+    base_rows = (entry.kv, entry.index) if cached and manifest.get('delta_from') else None
+    request = GateRequest(model, tokens, encoder, (tensors, manifest, opened_s), use_state=cached, base_rows=base_rows)
+    imported_at = time.perf_counter()
+    fp, _ = fingerprint(model, request.cache)
+    if cached:
+        store.record(tokens[:-1], *request.rows, og_cache.numerics_key(manifest))
+    gen_start = time.perf_counter()
+    gen = request.generate(GEN, ignore_eos=True)
+    committed, first_at = [], None
+    try:
+        for batch in gen:
+            if batch and first_at is None:
+                first_at = time.perf_counter()
+            committed += batch
+    finally:
+        gen.close()
+    info = encoder.open_info
+    return dict(fingerprint=fp, tokens=committed, logits=hashlib.sha256(json.dumps(request.hashes).encode()).hexdigest()[:16],
+                steps=len(request.hashes), dspark=[request.accepted, request.proposed],
+                copy=[request.copy_accepted, request.copy_proposed],
+                ttft_s=round(imported_at - t0 + first_at - gen_start, 3), open_s=round(opened_s, 3),
+                import_s=round(request.replay_s, 3), first_step_s=round(first_at - gen_start, 3), resumed=info.get('resumed_tokens', 0),
+                state_mb=round((info.get('state_bytes') or 0)/1e6, 1), box_prefill_s=info.get('box_prefill_s'),
+                delta_from=int(manifest.get('delta_from') or 0), emulated=emulated)
+
+
+def words(tok, text):
+    return tok.encode(text, add_special_tokens=False)
+
+
+def main():
+    tok = PreTrainedTokenizerFast.from_pretrained(str(MODEL))
+    t = time.perf_counter()
+    model = load_decoder(MODEL)
+    emit(dict(event='loaded', s=round(time.perf_counter()-t, 1), active_gib=round(mx.get_active_memory()/2**30, 1)))
+    questions = ['Now name the single most complex function and explain why.',
+                 'Which invariants does the cache code rely on? Be brief.',
+                 'Rewrite the first function more simply.', 'List three risks in this design.',
+                 'Summarize our discussion in two sentences.']
+    ok = True
+    for size in SIZES:
+        store = og_cache.RowStore(8 << 30)
+        prompt = json.loads((HOME/f'llm/ds41/split-wire/ids-{size}.json').read_text())
+        for turn in range(1, TURNS+1):
+            record = dict(event='turn', size=size, turn=turn, prompt_tokens=len(prompt))
+            cached = serve(model, prompt, cached=True, store=store, stream=STREAM)
+            record['cached'] = {k: v for k, v in cached.items() if k != 'tokens'}
+            variants = {}
+            for name in REPEATS:
+                # An exact repeat (regenerate/retry): box resumes at N-1, delta_from = N-1 (zero new rows).
+                variants[name] = serve(model, prompt, cached=True, store=store, stream=name == 'repeat_stream')
+                record[name] = {k: v for k, v in variants[name].items() if k != 'tokens'}
+            if FRESH:
+                fresh = serve(model, prompt, cached=False, store=store)
+                record['fresh'] = {k: v for k, v in fresh.items() if k != 'tokens'}
+                keys = ('fingerprint', 'tokens', 'logits', 'dspark', 'copy')
+                same = all(run[k] == fresh[k] for run in (cached, *variants.values()) for k in keys)
+                record['identical'] = same
+                ok &= same
+            record['text'] = tok.decode(cached['tokens'])[:120]
+            emit(record)
+            reply = cached['tokens']
+            thinking_next = turn % 2 == 0
+            question = words(tok, questions[turn % len(questions)])
+            if prompt[-1] == THINK:
+                prompt = prompt[:-1] + [THINK_END]
+            prompt = prompt + reply + [EOS, USER] + question + [ASSISTANT, THINK if thinking_next else THINK_END]
+        emit(dict(event='store', size=size, **store.summary()))
+    emit(dict(event='done', all_identical=ok))
+
+
+if __name__ == '__main__':
+    main()
