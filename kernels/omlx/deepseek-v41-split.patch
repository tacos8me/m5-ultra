+  glm53:
+    name: GLM-5.3-Flash · oQ5e + MTP (oMLX)
+    description: 320B MoE (288 experts, top-8), 34 linear-attention + 11 sparse MLA layers, 1M context; vogel61 oQ5e 5-bit + Vontra native MTP head (grafted); stock oMLX 0.7.0.dev4
+    cmd: |
