@@ -0,0 +1,39 @@
+"""Layered prefill's first exactness gate, actual q3g128 expert weights.
+This is a numerical gate, not a serving speed benchmark. Must own gpu.lock.
+"""
+import os,sys,time,json,subprocess,gc,hashlib
+from pathlib import Path
+A=Path(__file__).resolve().parent;H=Path.home()
+sys.path.insert(0,str(H/'src/wt/ds41-sprint3-ds41o'))
+os.environ.update(MLX_ENABLE_TF32='0',GPUTIME='0',GUARD_GIB='245',FPWATCH_GIB='245')
+subprocess.Popen(['/opt/homebrew/bin/python3',str(H/'llm/ds41/sprint2-resume/watchdog.py'),str(os.getpid()),str(A/'rows.memory.json'),'840'])
+from common_d import setup_memory,emit,mem
+import mlx.core as mx
+from omlx.patches.deepseek_v41.quantization import quantize_activation
+setup_memory();log=(A/'rows.jsonl').open('w');root=H/'models/DeepSeek-V4.1-Flash-ds41-q3g128-lsq-q8-ssd-original'
+index=json.loads((root/'model.safetensors.index.json').read_text())['weight_map']
+for proj,K in [('w1',5120),('w2',2304)]:
+ prefix='language_model.layers.0.ffn.experts.'+proj+'.'
+ loaded=mx.load(str(root/index[prefix+'weight']))
+ w,s,b=[loaded[prefix+k] for k in ('weight','scales','biases')];del loaded;mx.eval(w,s,b)
+ for n in [512,8192]:
+  mx.random.seed(41+n);top=6
+  # For w2, each routed expert gets its own activation row.
+  count=n if proj=='w1' else n*top
+  x=quantize_activation(mx.random.normal((2*count,1,K)).astype(mx.bfloat16));mx.eval(x)
+  ids=mx.random.randint(0,384,(2*n,top),dtype=mx.int32)
+  def run(x,ids):
+   flat=ids.reshape(-1);order=mx.argsort(flat);inverse=mx.argsort(order)
+   lhs=(order//top if proj=='w1' else order).astype(mx.uint32)
+   out=mx.gather_qmm(x,w,s,b,lhs_indices=lhs,rhs_indices=flat[order].astype(mx.uint32),transpose=True,bits=3,group_size=128,mode='affine',sorted_indices=True)
+   return out[inverse]
+  left=run(x[:count],ids[:n]);right=run(x[count:],ids[n:]);mx.eval(left,right)
+  joined=run(x,ids);mx.eval(joined)
+  reference=mx.concatenate([left,right],axis=0)
+  different=int(mx.sum(reference!=joined).item());diff=float(mx.max(mx.abs(reference.astype(mx.float32)-joined.astype(mx.float32))).item())
+  emit(log,event='row_independence',projection=proj,prompt_rows=n,combined_rows=2*n,different=different,max_abs=diff,**mem())
+  del x,ids,left,right,joined,reference;gc.collect();mx.clear_cache()
+  if different:
+   emit(log,event='drop_layered_prefill',reason='Actual quantized projection changes rows when chunks are combined');sys.exit(0)
+ del w,s,b;gc.collect();mx.clear_cache()
+emit(log,event='gate_passed',**mem())
