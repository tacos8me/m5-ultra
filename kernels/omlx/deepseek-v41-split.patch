+++ b/benchmarks/pipe1/report_bench.py
@@ -0,0 +1,34 @@
+"""Summarize only completed, warmed private HTTP benchmark observations."""
+import argparse
+import json
+from pathlib import Path
+import statistics
+
+
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('records');args=ap.parse_args()
+    rows=[json.loads(x) for x in Path(args.records).read_text().splitlines()]
+    if not rows or rows[0]['kind']!='warmup':raise ValueError('Missing warm-up')
+    result=[]
+    for n in (8192,131072,524288):
+        c1=[r['result'] for r in rows if r['kind']=='bench' and r['n']==n and r['concurrency']==1]
+        c2=[r for r in rows if r['kind']=='bench' and r['n']==n and r['concurrency']==2]
+        if len(c1)!=3 or len(c2)!=1:raise ValueError(f'Incomplete benchmark at {n}')
+        for r in c1+c2[0]['pair']:
+            if len(r['tokens'])!=256:raise ValueError('Short decode observation')
+        steps=[s for r in c1 for s in r['summary']['steps'][2:]]
+        widths={}
+        for width in sorted({s['rows'] for s in steps}):
+            group=[s for s in steps if s['rows']==width]
+            widths[width]=dict(count=len(group),**{
+                key+'_ms':1000*statistics.mean(s.get(key,0) for s in group)
+                for key in ('box_s','transport_host_s','mac_s','draft_s')})
+        result.append(dict(prompt_tokens=n,c1_median_tok_s=statistics.median(r['decode_tok_s'] for r in c1),
+                           c1_all_tok_s=[r['decode_tok_s'] for r in c1],
+                           c2_total_tok_s=c2[0]['decode_total_tok_s'],
+                           c1_ttft_s=[r['ttft_s'] for r in c1],verify_by_rows=widths))
+    out=Path(args.records).with_suffix('.bench.json')
+    out.write_text(json.dumps(result,indent=2)+'\n');print(json.dumps(result,indent=2))
+
+
+if __name__=='__main__':main()
