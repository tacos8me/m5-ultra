diff --git a/benchmarks/ds41_sprint3_eviction/exact_policy.py b/benchmarks/ds41_sprint3_eviction/exact_policy.py
new file mode 100644
index 00000000..a4c82b75
--- /dev/null
+++ b/benchmarks/ds41_sprint3_eviction/exact_policy.py
@@ -0,0 +1,32 @@
+"""Verify L=2..5 chunk/rollback independence on real contexts, including raw caches/logits/taps."""
+import os,sys,subprocess,time,gc,hashlib,json
+from pathlib import Path
+A=Path(__file__).resolve().parent;H=Path.home();sys.path[:0]=[str(H/'src/wt/ds41-sprint3-ds41o')]
+os.environ.update(GPUTIME='0',GUARD_GIB='245',FPWATCH_GIB='245',MLX_ENABLE_TF32='0')
+subprocess.Popen(['/opt/homebrew/bin/python3',str(H/'llm/ds41/sprint2-resume/watchdog.py'),str(os.getpid()),str(A/(os.environ.get('LABEL','exact-policy')+'.memory.json')),'840'])
+from common_d import *
+import numpy as np
+setup_memory();model,processor,s=load_full();lm=model.language_model;tok=processor.tokenizer
+log=(A/(os.environ.get('LABEL','exact-policy')+'.jsonl')).open('w');ids=tok.encode(corpus_text(tok,200000),add_special_tokens=False)
+def harray(a):return np.array(a.astype(mx.float32) if a.dtype==mx.bfloat16 else a).tobytes()
+def walk(base,seq,pattern):
+ cache=deep_cache(lm,base,0);pos=0;i=0;logits=hashlib.sha256();hidden=hashlib.sha256()
+ while pos<40:
+  L,keep=pattern[i%len(pattern)];keep=min(keep,40-pos);out=model(mx.array([seq[pos:pos+L]],mx.uint32),cache=cache,return_hidden=True,n_confirmed=1);mx.eval(out)
+  logits.update(harray(out[0][:,:keep]));hidden.update(harray(out[1][:,:keep]))
+  assert lm.mtp_partial_rollback(cache,keep-1,L-1)
+  pos+=keep;i+=1
+ d=hashlib.sha256()
+ for c in cache:
+  for x in c.cache:
+   if x is None:d.update(b'none')
+   else:d.update(str((x.shape,x.dtype)).encode());d.update(harray(x))
+ del cache,out;gc.collect();mx.clear_cache()
+ return dict(logits=logits.hexdigest(),hidden=hidden.hexdigest(),cache=d.hexdigest())
+for ctx in map(int,os.environ.get('CONTEXTS','8192,131072').split(',')):
+ prompt=(ids*(ctx//len(ids)+1))[:ctx];cache=prefill(lm,prompt[:-1]);base=snapshot(cache);del cache
+ seq=(prompt[-100:]);reference=walk(base,seq,[(5,5)])
+ for pattern in ([(2,2)],[(3,3)],[(4,4)],[(2,1),(5,4),(3,2),(4,1)]):
+  result=walk(base,seq,pattern);emit(log,ctx=ctx,pattern=pattern,equal=result==reference,reference=reference,result=result,**mem());assert result==reference
+ del base;gc.collect();mx.clear_cache()
+model.close();emit(log,event='done',**mem())
diff --git a/benchmarks/ds41_sprint3_eviction/http_bench.py b/benchmarks/ds41_sprint3_eviction/http_bench.py
