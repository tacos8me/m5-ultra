+import os,sys,time,subprocess,signal,urllib.request,json
+from pathlib import Path
+H=Path.home();A=Path(__file__).resolve().parent;PY=H/'llm/.venv-ds41-omlx-tiles/bin/python'
+label=sys.argv[1];port='10051';base='http://127.0.0.1:'+port
+env=os.environ.copy();env.update(LEG=label,DS41_TREE=str(H/'src/wt/ds41-sprint3-ds41o'),GPU_LOCK_WAIT='3600',MLX_ENABLE_TF32='0',OMLX_BONJOUR='0',OMLX_DISCOVERY='0',DS41_NATIVE_VERIFY='0',DS41_MHC='1',DS41_GROWTH='1',DS41_GATHER='1',DS41_INDEX_NAX='1',DS41_SPARSE='1',DS41_NATIVE_DECODE='1',DS41_PREFILL_CHUNK='8192',DS41_PREFILL_POOL_GIB='3',DS41_PREFIX_CACHE_GIB='2',DS41_VERIFY_TILE='0',DS41_MTP_COST_POLICY='0')
+log=(A/f'{label}.server.log').open('w')
+srv=subprocess.Popen([str(H/'llm/bin/gpu-exec'),str(PY),'-u',str(A/'server.py'),'serve','--base-path',str(A/'profile-c2'),'--model-dir',str(H/'llm/ds41/resume/models'),'--no-hf-cache','--no-cache','--max-concurrent-requests','2','--host','127.0.0.1','--port',port],env=env,stdout=log,stderr=subprocess.STDOUT)
+def stop(*args):raise SystemExit(143)
+for sig in (signal.SIGTERM,signal.SIGINT,signal.SIGHUP):signal.signal(sig,stop)
+try:
+ for _ in range(3900):
+  if srv.poll() is not None:raise RuntimeError('server exited')
+  try:
+   urllib.request.urlopen(base+'/health',timeout=2)
+   owner=json.loads(urllib.request.urlopen(base+'/lease-owner',timeout=2).read())
+   assert owner['pid']==srv.pid
+   break
+  except Exception:time.sleep(1)
+ else:raise TimeoutError('health')
+ print('warm health',srv.pid,flush=True)
+ for context in (sys.argv[2:] or ['8192']):
+  subprocess.run([str(PY),'-u',str(A/os.environ.get('BENCH_SCRIPT','http_bench.py')),label+'-'+context,port,context],env=env,check=True,timeout=740)
+finally:
+ srv.terminate()
+ try:srv.wait(timeout=20)
+ except subprocess.TimeoutExpired:srv.kill();srv.wait()
+ print('server exited',srv.returncode,flush=True)
