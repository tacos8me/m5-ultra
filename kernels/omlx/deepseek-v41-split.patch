+++ b/benchmarks/ds41_sprint3_followups/ssv_probe.py
@@ -0,0 +1,37 @@
+"""Synthetic exactness and attainable headroom only; never serving claims."""
+import os,sys,time,statistics,subprocess,gc
+from pathlib import Path
+H=Path.home();A=Path(__file__).resolve().parent;sys.path.insert(0,str(H/'src/wt/ds41-sprint3-ds41o'))
+os.environ.update(GPUTIME='0',GUARD_GIB='245',FPWATCH_GIB='245',MLX_ENABLE_TF32='0')
+subprocess.Popen(['/opt/homebrew/bin/python3',str(H/'llm/ds41/sprint2-resume/watchdog.py'),str(os.getpid()),str(A/'ssv.memory.json'),'840'])
+from common_d import setup_memory,emit,mem
+import mlx.core as mx
+from omlx.patches.deepseek_v41.kernels import packed_sparse_attention
+from ssv import attention
+setup_memory();f=(A/'ssv.jsonl').open('w');mx.random.seed(421)
+for NC in (131072,524288):
+ pooled=mx.concatenate([mx.random.randint(0,256,(1,NC,256)).astype(mx.uint8),mx.full((1,NC,32),64,mx.uint8)],axis=-1);mx.eval(pooled)
+ for L in (2,5):
+  window=mx.concatenate([mx.random.randint(0,256,(1,128+L,512)).astype(mx.uint8),mx.full((1,128+L,16),127,mx.uint8)],axis=-1)
+  q=(mx.random.normal((1,L,64,512))*.01).astype(mx.bfloat16);sink=mx.zeros((64,),mx.float32)
+  wi=mx.arange(128)[None,None,:]+mx.arange(L)[None,:,None]
+  for shift in (0,64,256):
+   ci=((mx.arange(512)[None,None,:]+shift*mx.arange(L)[None,:,None])*997%NC).astype(mx.int32)
+   args=[window,pooled,wi,ci,sink,512**-.5];mx.eval(q,args)
+   ref=packed_sparse_attention(q,*args);out=attention(q,*args);mx.eval(ref,out)
+   count=int(mx.sum(ref.view(mx.uint16)!=out.view(mx.uint16)).item());delta=float(mx.max(mx.abs(ref.astype(mx.float32)-out.astype(mx.float32))).item())
+   timings={}
+   for label,func in [('baseline',packed_sparse_attention),('ssv',attention),('baseline2',packed_sparse_attention)]:
+    samples=[]
+    for rep in range(4):
+     current=q;mx.synchronize();t=time.perf_counter()
+     for _ in range(24):
+      # Serial calls, as in consecutive transformer layers; no inter-call parallelism.
+      y=func(current,*args);current=mx.depends(q,y)
+     mx.eval(y)
+     if rep:samples.append((time.perf_counter()-t)*1000/24)
+    timings[label]=statistics.median(samples)
+   emit(f,event='ssv',pooled_rows=NC,L=L,shift=shift,different=count,max_abs=delta,ms=timings,**mem())
+   if count:raise RuntimeError('SSV numerical gate failed')
+ del pooled;gc.collect();mx.clear_cache()
+emit(f,event='done',**mem())
