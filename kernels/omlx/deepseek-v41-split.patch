@@ -0,0 +1,99 @@
+import hashlib
+import importlib.util
+import json
+from pathlib import Path
+import socket
+import struct
+import threading
+import unittest
+
+p = Path(__file__).parent/'pipe_wire.py'
+if not p.exists():
+    p = Path(__file__).parents[2]/'omlx/patches/deepseek_v41/pipe_wire.py'
+spec = importlib.util.spec_from_file_location('pipe_wire',p)
+w = importlib.util.module_from_spec(spec); spec.loader.exec_module(w)
+
+
+class WireTests(unittest.TestCase):
+    def session(self):
+        a,b = socket.socketpair()
+        self.addCleanup(a.close); self.addCleanup(b.close)
+        s = object.__new__(w.EncoderSession)
+        s.sock,s.session,s.length,s.identity = a,7,128,w.IDENTITY
+        return s,b
+
+    def test_step_widths_and_rollback(self):
+        for rows in range(1,6):
+            s,b = self.session()
+            received=[]
+            def peer():
+                tag,hlen,plen=w.FRAME.unpack(w.receive(b,w.FRAME.size))
+                received.append((tag,w.STEP.unpack(w.receive(b,hlen)),bytes(w.receive(b,plen))))
+                data=bytes([rows])*(rows*w.ROW_BYTES)
+                w.send(b,b'STPR',w.STPR.pack(7,126+rows,rows,len(data),.002),data)
+            t=threading.Thread(target=peer); t.start()
+            raw,info=s.step([9]*rows,126)
+            t.join()
+            self.assertEqual(received,[(b'STEP',(7,126,rows),struct.pack('<%dI'%rows,*([9]*rows)))])
+            self.assertEqual(s.length,126+rows)
+            self.assertEqual(raw,bytes([rows])*(rows*w.ROW_BYTES))
+
+    def test_stale_response_rejected(self):
+        s,b=self.session()
+        w.send(b,b'STPR',w.STPR.pack(8,129,1,w.ROW_BYTES,.001),b'')
+        with self.assertRaisesRegex(ValueError,'boundary mismatch'):
+            s.step([2],128)
+        self.assertEqual(s.length,128)
+
+    def test_invalid_local_step(self):
+        s,_=self.session()
+        for tokens,keep in [([],128),([1]*6,128),([1],129),([1],-1)]:
+            with self.assertRaises(ValueError):s.step(tokens,keep)
+
+    def test_truncated_payload(self):
+        s,b=self.session()
+        h=w.STPR.pack(7,129,1,w.ROW_BYTES,.001)
+        b.sendall(w.FRAME.pack(b'STPR',len(h),w.ROW_BYTES)+h)
+        b.shutdown(socket.SHUT_WR)
+        with self.assertRaises(ConnectionError):s.step([1],128)
+        self.assertEqual(s.length,128)
+
+    def test_open_complete(self):
+        s,b=self.session();s.session=None
+        tokens=[3,4,5];raw=struct.pack('<3I',*tokens)
+        digest=hashlib.sha256(raw).hexdigest()
+        w.send(b,b'ACK ',{'ok':True,'session':8})
+        w.send(b,b'TENS',{'name':'tokens','dtype':'U32','shape':[3],'offset':0},raw)
+        w.send(b,b'MANI',{'bytes':12,'identity':w.IDENTITY,'token_sha256':digest})
+        w.send(b,b'END ',{'bytes':12})
+        arrays,manifest=s.open(tokens)
+        self.assertEqual(s.length,2);self.assertEqual(s.session,8)
+        self.assertEqual(arrays['tokens'][2],raw)
+
+    def test_tensor_overlap_rejected(self):
+        s,b=self.session();s.session=None
+        w.send(b,b'ACK ',{'ok':True,'session':8})
+        w.send(b,b'TENS',{'name':'tokens','dtype':'U32','shape':[3],'offset':0},bytes(4))
+        w.send(b,b'TENS',{'name':'tokens','dtype':'U32','shape':[3],'offset':0},bytes(4))
+        with self.assertRaisesRegex(ValueError,'part order'):
+            s.open([3,4,5])
+
+    def test_stat_open_and_truncation(self):
+        s,b=self.session();s.session=None
+        tokens=[3,4,5];raw=struct.pack('<3I',*tokens)
+        manifest=dict(bytes=len(raw),identity=w.IDENTITY,
+                      token_sha256=hashlib.sha256(raw).hexdigest())
+        header=json.dumps({'tokens':dict(dtype='U32',shape=[3],data_offsets=[0,12]),
+                           '__metadata__':dict(manifest=json.dumps(manifest))}).encode()
+        blob=struct.pack('<Q',len(header))+header+raw
+        w.send(b,b'ACK ',{'ok':True,'session':8})
+        w.send(b,b'STAT',{'bytes':len(blob)},blob)
+        tensors,got=s.open(tokens)
+        self.assertEqual(got,manifest)
+        self.assertEqual(bytes(tensors['tokens'][2]),raw)
+        self.assertEqual(s.length,2)
+        with self.assertRaisesRegex(ValueError,'range'):
+            w.parse_state_blob(blob[:-1])
+
+
+if __name__=='__main__':unittest.main()
