@@ -0,0 +1,45 @@
+"""CPU tests on recorded actual traces: schema parsing, bounded bank, and availability."""
+import json,sys
+from pathlib import Path
+from types import SimpleNamespace
+import numpy as np
+H=Path.home();A=Path(__file__).resolve().parent;sys.path.insert(0,str(H/'src/wt/ds41-sprint3-ds41o'))
+from transformers import PreTrainedTokenizerFast
+from omlx.patches.deepseek_v41 import draft_sources as ds
+from omlx.patches.deepseek_v41.encoding import render_tools,tools_from_openai_format
+sys.argv=['gate','gate','0'];import source_bench as lib
+T=PreTrainedTokenizerFast.from_pretrained(H/'models/DeepSeek-V4.1-Flash-ds41-q3g128-lsq-q8-ssd-original')
+host=SimpleNamespace(_ds41_draft_tokenizer=T);schemas=tools_from_openai_format(lib.tools)
+prompt=T.encode(render_tools(schemas),add_special_tokens=False)
+ds.MODE='both';rows=[]
+def prefix(a,b):
+ n=0
+ for x,y in zip(a,b):
+  if x!=y:break
+  n+=1
+ return n
+for name,_,tools in lib.cases:
+ if tools is None:continue
+ r=next(iter(json.loads((A/f'source-{name}.json').read_text())['requests'].values()));tokens=r['tokens']
+ copy=SimpleNamespace(_buf=np.asarray(prompt+[tokens[0]],np.int64),n=len(prompt)+1)
+ tracker=ds.create(host,copy);assert tracker and tracker.templates
+ sources={};baseline=accepted=steps=0
+ for step in r['steps']:
+  ids=step['committed'];features=np.repeat(np.asarray(step['features'],np.float32),64,axis=-1)[None,:,:]
+  tracker.append(ids,features)
+  copy._buf=np.concatenate([copy._buf,ids]);copy.n+=len(ids)
+  draft,source=tracker.propose(copy._buf[-64:].tolist(),4)
+  start=step['start']+len(ids);truth=tokens[start:start+4]
+  if len(truth)<4:continue
+  old=prefix(step['drafts'],truth);baseline+=old;steps+=1
+  if draft:
+   assert 1<=len(draft)<=4;sources[source]=sources.get(source,0)+1;accepted+=prefix(draft,truth)
+  else:accepted+=old
+ tracker.finish(len(tokens),tool_filter=True);assert tracker.done;size=sum(len(bucket) for bucket in host._ds41_draft_bank.rows.values());assert size<=8192
+ row=dict(name=name,steps=steps,baseline_accept=baseline,proposed_accept=accepted,sources=sources,bank_entries=size);rows.append(row);print(json.dumps(row),flush=True)
+# No completed row may read past the emitted suffix.
+b=ds.Bank();b.add(b'x',[1,2,3,4],[(0,np.ones(2)),(3,np.ones(2))]);assert not b.rows
+# Empty/disabled/non-tool paths do not create a tracker.
+ds.MODE='off';assert ds.create(host,copy) is None
+ds.MODE='both';assert ds.create(host,SimpleNamespace(_buf=np.array([1,2,3]),n=3)) is None
+(A/'source-cpu.json').write_text(json.dumps(rows,indent=2));print('CPU gate passed')
