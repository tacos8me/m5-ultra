+"""Rebuild wire_gate's 128K think/chat prompts and compare two FRESH OPENs (no cache) row by row."""
+import json, random, sys
+from pathlib import Path
+import numpy as np
+sys.path.insert(0, 'omlx/patches/deepseek_v41')
+sys.path.insert(0, 'benchmarks/og')
+import pipe_wire as W
+from wire_gate import arrays, EOS, USER, ASSISTANT, THINK, THINK_END
+
+rng = random.Random(1)
+prompts = None
+for size in (8192, 131072):
+    path = Path(f'/home/ian/mac/ds41/split-wire/split-wire/ids-{size}.json')
+    base = json.loads(path.read_text()) if path.exists() else [0] + [rng.randrange(1000, 100000) for _ in range(size)]
+    base = base[:-1] + [THINK]
+    nonce = [rng.randrange(1000, 100000) for _ in range(8)]
+    base = base[:2] + nonce + base[2:]
+    prev = base
+    got = {}
+    for name in ('regen', 'think', 'chat', 's1', 's57', 's300', 's9000', 'edit'):
+        reply = [rng.randrange(1000, 100000) for _ in range(40)]
+        user = [rng.randrange(1000, 100000) for _ in range(30)]
+        if name == 'regen':
+            prompt = prev
+        elif name == 'think':
+            prompt = prev[:-1] + [THINK_END] + reply + [EOS, USER] + user + [ASSISTANT, THINK]
+        elif name == 'chat':
+            prompt = prev + reply + [EOS, USER] + user + [ASSISTANT, THINK_END]
+        elif name == 'edit':
+            prompt = base[:len(base) * 3 // 4] + user + [ASSISTANT, THINK]
+        else:
+            prompt = prev + [rng.randrange(1000, 100000) for _ in range(int(name[1:]))]
+        got[name] = prompt
+        if name != 'edit':
+            prev = prompt
+    prompts = got
+states = {}
+for name in ('think', 'chat'):
+    s = W.EncoderSession('127.0.0.1', 10052)
+    t, m = s.open(prompts[name], 'ogc-pair')
+    states[name] = arrays(t)
+    s.close()
+a, b = states['think'], states['chat']
+for L, r in ((2, 2), (8, 2), (14, 2), (20, 1)):
+    n = (len(prompts['think']) - 1) // r
+    for slot in (2, 3):
+        x, y = a[f'layer.{L}.slot.{slot}'][0, :n], b[f'layer.{L}.slot.{slot}'][0, :n]
+        bad = np.flatnonzero((x != y).any(-1))
+        print(L, slot, 'rows', n, 'differ', bad[:5].tolist())
