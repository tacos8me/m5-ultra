+++ b/benchmarks/ds41_sprint3_sources/source_bench.py
@@ -0,0 +1,46 @@
+"""Warm tool/copy baseline plus untimed semantic-source diagnostic captures."""
+import json,sys,time,urllib.request,hashlib
+from pathlib import Path
+A=Path(__file__).resolve().parent;H=Path.home();label,port=sys.argv[1:3];base='http://127.0.0.1:'+port
+specs=[('read_file',{'path':'string','start_line':'integer','end_line':'integer'}),('run_tests',{'target':'string','verbose':'boolean','timeout_seconds':'integer'}),('search_code',{'query':'string','path':'string','case_sensitive':'boolean'}),('list_files',{'path':'string','pattern':'string','recursive':'boolean'}),('apply_patch',{'path':'string','old_text':'string','new_text':'string'}),('git_status',{'path':'string','include_untracked':'boolean'}),('inspect_symbol',{'name':'string','path':'string','include_references':'boolean'}),('format_file',{'path':'string','check_only':'boolean'})]
+tools=[{'type':'function','function':{'name':name,'description':'Use this repository operation only when requested. Return exact user-specified argument values. Relative paths resolve from the project root. Do not invent results or run unrelated operations.','parameters':{'type':'object','properties':{k:{'type':v,'description':f'The requested {k.replace("_"," ")}. Preserve the exact value from the user request.'} for k,v in props.items()},'required':list(props),'additionalProperties':False}}} for name,props in specs]
+system='You are a coding assistant. Call exactly the requested tool with all specified arguments. Do not answer with prose and do not claim a tool has already executed.\n' + '\n'.join(f'Project convention {i}: code lives in src/, tests in tests/, configuration in config/. Keep changes scoped and preserve existing interfaces.' for i in range(18))
+cases=[]
+for j in range(4):
+ cases.extend([(f'read{j}',f'Read src/component_{j}.py from line {10+7*j} through line {40+9*j}. Use read_file.',tools),(f'test{j}',f'Run tests/test_component_{j}.py with verbose=true and timeout_seconds={60+30*j}. Use run_tests.',tools),(f'search{j}',f'Search for handle_event_{j} under src/component_{j}/ with case_sensitive=true. Use search_code.',tools)])
+src=H/'src/wt/ds41-sprint3-ds41o/omlx/patches/deepseek_v41'
+for name,file in [('rewrite','dspark.py'),('edit','batched_verify.py')]:
+ text=(src/file).read_text().replace('｜','|').replace('<think>','[think]').replace('</think>','[/think]')
+ task='Rename MarkovHead to MarkovBias' if name=='rewrite' else 'Add a one-line docstring to routed_forward'
+ cases.append((name,f'```python\n{text}\n```\n{task}. Return the complete file unchanged otherwise, in one code block.',None))
+
+def control(path):return json.loads(urllib.request.urlopen(urllib.request.Request(base+path,b'',method='POST')).read())
+def chat(name,prompt,ts):
+ body={'model':'ds41-q3g128','messages':[{'role':'system','content':system if ts else 'Follow the user instruction exactly.'},{'role':'user','content':prompt}],'max_tokens':256 if ts else 512,'temperature':0,'stream':True,'stream_options':{'include_usage':True},'chat_template_kwargs':{'enable_thinking':False}}
+ if ts:body['tools']=ts
+ req=urllib.request.Request(base+'/v1/chat/completions',json.dumps(body).encode(),{'Content-Type':'application/json'})
+ t=time.perf_counter();first=None;usage=None;content='';calls={}
+ with urllib.request.urlopen(req,timeout=180) as response:
+  for line in response:
+   if not line.startswith(b'data: ') or line.strip()==b'data: [DONE]':continue
+   d=json.loads(line[6:]);usage=d.get('usage') or usage
+   for choice in d.get('choices',[]):
+    delta=choice.get('delta',{})
+    if delta.get('content') or delta.get('tool_calls'):first=first or time.perf_counter()
+    content+=delta.get('content') or ''
+    for call in delta.get('tool_calls') or []:
+     rec=calls.setdefault(call.get('index',0),{'name':'','arguments':''})
+     for k in rec:rec[k]+=call.get('function',{}).get(k) or ''
+ return dict(name=name,elapsed_s=time.perf_counter()-t,ttft_s=None if first is None else first-t,usage=usage,content=content,calls=list(calls.values()))
+if __name__ == '__main__':
+ control('/cost-policy/1')
+ with (A/f'{label}.jsonl').open('w') as f:
+  for capture in (False,True):
+   for name,prompt,ts in cases:
+    control('/source-probe/'+(name if capture else 'off'))
+    r=chat(name,prompt,ts);r['capture']=capture
+    if capture:
+     trace=json.loads(urllib.request.urlopen(base+'/source-probe-result').read())
+     (A/f'source-{name}.json').write_text(json.dumps(trace))
+    f.write(json.dumps(r)+'\n');f.flush();print(json.dumps({k:v for k,v in r.items() if k not in ('content','calls')}),flush=True)
+ control('/source-probe/off')
