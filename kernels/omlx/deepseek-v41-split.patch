+log=(A/'headroom.jsonl').open('w');emit(log,event='loaded',s=load_s)
+prompt=code_prompt(tok);cache=prefill(lm,prompt[:-1]);base=snapshot(cache);real_len=cache[0].size();del cache
+mode='base';records={};indices={};capture=False
+
+def hook(module,name,kind):
+ orig=getattr(module,name)
+ def wrapped(*a,**kw):
+  if capture:
+   saved=records.setdefault(kind,[]);i=len(saved);saved.append(None)
+   result=orig(*a,**kw);saved[i]=(result,len(saved)-i);return result
+  if mode==kind:
+   i=indices.get(kind,0);out,span=records[kind][i];indices[kind]=i+span
+   deps=[x for x in (*a,*kw.values()) if isinstance(x,mx.array)]
+   return mx.depends(out,deps)
+  return orig(*a,**kw)
+ setattr(module,name,wrapped)
+hook(language,'packed_sparse_attention','attention')
+hook(decode_topk,'selection','topk');hook(kernels,'_tile_topk','topk');hook(prefill_index,'topk','topk')
+
+def digest(out):return hashlib.sha256(np.array(out[0].astype(mx.float32)).tobytes()).hexdigest()
+for depth in (262144,524288,1048576):
+ deep=deep_cache(lm,base,(depth-real_len)//16*16);deepbase=snapshot(deep);del deep;gc.collect();mx.clear_cache()
+ for phase in ('decode','prefill'):
+  if phase=='prefill' and depth==524288:continue
+  records.clear();indices.clear();capture=True;cache=deep_cache(lm,deepbase,0)
+  x=mx.array([prompt[-5:]],mx.uint32) if phase=='decode' else mx.array([(prompt*2)[:8192]],mx.uint32)
+  if phase=='decode':out=model(x,cache=cache,return_hidden=True,n_confirmed=1);mx.eval(out);ref=digest(out)
+  else:lm._omlx_prefill(x,cache=cache);mx.eval([a for c in cache for a in c.state]);ref=None
+  capture=False;del cache
+  emit(log,event='capture',phase=phase,depth=depth,ops={k:len(v) for k,v in records.items()},**mem())
+  # Do not retain huge attention outputs during prefill: capture is disabled there below.
+  for mode in (('base','attention','topk','base') if phase=='decode' else ('base','topk','base')):
+   times=[];cpu=[];process_cpu=[];same=True
+   for rep in range(6 if phase=='decode' else 3):
+    cache=deep_cache(lm,deepbase,0);indices.clear();mx.synchronize();t=time.perf_counter();ct=time.thread_time();pc=time.process_time()
+    if phase=='decode':out=model(x,cache=cache,return_hidden=True,n_confirmed=1);mx.eval(out)
+    else:lm._omlx_prefill(x,cache=cache);mx.eval([a for c in cache for a in c.state])
+    elapsed=time.perf_counter()-t;cpu_t=time.thread_time()-ct;pc_t=time.process_time()-pc
+    if phase=='decode':same &= digest(out)==ref
+    if rep:times.append(elapsed*1000);cpu.append(cpu_t*1000);process_cpu.append(pc_t*1000)
+    del cache;gc.collect()
+   emit(log,event='ablation',depth=depth,phase=phase,mode=mode,ms=statistics.median(times),cpu_thread_ms=statistics.median(cpu),cpu_process_ms=statistics.median(process_cpu),exact_logits=same if phase=='decode' else None,samples=times,**mem())
+  records.clear();del out,x;gc.collect();mx.clear_cache()
+ del deepbase;gc.collect();mx.clear_cache()
+model.close();emit(log,event='done',**mem())
