+"""Check copied shard completeness against the independent planned schema."""
+import json
+from pathlib import Path
+import struct
+
+root=Path.home()/'models/DeepSeek-V4.1-Flash-pipe1-mlx'
+plan=json.loads((Path(__file__).parent/'planned-layout.json').read_text())['outputs']
+index=json.loads((root/'model.safetensors.index.json').read_text())['weight_map']
+receipt=json.loads((root/'conversion-receipt.json').read_text())
+seen=set();total=0
+for name in set(index.values()):
+    path=root/name
+    with path.open('rb') as f:
+        size=struct.unpack('<Q',f.read(8))[0];head=json.loads(f.read(size))
+    end=0
+    for key,value in head.items():
+        if key=='__metadata__':continue
+        assert key not in seen and index[key]==name
+        assert value['shape']==plan[key]['shape'] and value['dtype']==plan[key]['dtype']
+        a,b=value['data_offsets'];assert b-a==plan[key]['bytes']==receipt[key]['bytes']
+        assert a==end;end=b;seen.add(key);total+=b-a
+    assert path.stat().st_size==8+size+end
+assert seen==set(plan)==set(index)==set(receipt)
+print(json.dumps(dict(shards=len(set(index.values())),tensors=len(seen),tensor_bytes=total,complete=True)))
