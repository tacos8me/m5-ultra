+"""og-speed profile 1: where do layers 20-39 + head and the drafter spend time? Speed only.
+
+Run under gpu-exec via benchmarks/og/lease.py --direct ../ogs/prof1.py (owns its watchdog).
+Opens one real 8K box session for realistic caches, then:
+  * Mac-only forward_boundary L=1..5 back to back (async 4 and 0; build vs total),
+  * in-situ ablations (MoE / routed experts stubbed out),
+  * chained per-component micro-benchmarks over the 20 real layers,
+  * the DSpark drafter and its parts.
+"""
+import json
+import os
+from pathlib import Path
+import statistics
+import subprocess
+import sys
+import time
+
+HOME = Path.home()
+TREE = Path(os.environ.get('DS41_TREE', str(HOME/'src/wt/ds41-og-speed')))
+sys.path.insert(0, str(TREE))
+LOGS = Path(os.environ.get('OG_LOGS', str(HOME/'llm/ds41/og-speed')))
+label = os.environ.get('OG_LABEL', 'ogs-prof1')
+watch = subprocess.Popen(['/opt/homebrew/bin/python3', str(TREE/'benchmarks/og/watch.py'), str(os.getpid()),
+                          str(LOGS/(label+'.memory.json')), os.environ.get('OG_LEASE', '600')])
+import mlx.core as mx  # noqa: E402
+from omlx.patches.deepseek_v41.pipe_decoder import load_decoder  # noqa: E402
+from omlx.patches.deepseek_v41.pipe_session import PipelineRequest  # noqa: E402
+from omlx.patches.deepseek_v41.pipe_wire import EncoderSession, mlx_step  # noqa: E402
+from omlx.patches.deepseek_v41 import language as LG  # noqa: E402
+from omlx.patches.deepseek_v41 import decode_fusions  # noqa: E402
+from omlx.patches.deepseek_v41.quantization import quantize_activation  # noqa: E402
+from omlx.patches.deepseek_v41.head import project_logits  # noqa: E402
+from omlx.patches.deepseek_v41.dspark import proposal_forward  # noqa: E402
+from omlx.patches.mlx_lm_mtp.deepseek_v4_dspark import capture_prompt  # noqa: E402
+
+mx.set_wired_limit(min(245 << 30, mx.device_info()['max_recommended_working_set_size']))
+mx.set_cache_limit(512 << 20); mx.set_memory_limit(230 << 30)
+out = (LOGS/(label+'.jsonl')).open('a')
+
+
+def emit(record):
+    out.write(json.dumps(record)+'\n'); out.flush(); print(json.dumps(record), flush=True)
+
+
+t0 = time.perf_counter()
+model = load_decoder(HOME/'models/DeepSeek-V4.1-Flash-pipe1-mlx')
+emit(dict(event='loaded', s=time.perf_counter()-t0))
+tokens = json.loads((HOME/'llm/ds41/split-wire/ids-8192.json').read_text())
+req = PipelineRequest(model, tokens, encoder=EncoderSession())
+emit(dict(event='opened', prefill_remote_s=req.prefill_remote_s, replay_s=req.replay_s))
+start0 = req.cache[0].size()
+req.encoder.send_step([req.tokens[-1], 223, 1001, 5000, 17], start0)
+raw, _ = req.encoder.recv_step()
+FULL = mlx_step(raw, 5)
+mx.eval(FULL)
+
+
+def med(xs):
+    return round(1000*statistics.median(xs), 3)
+
+
+def fwd(L, reps=12, warm=3):
+    builds, totals = [], []
+    for it in range(reps+warm):
+        arrays = {k: v[:, :L] for k, v in FULL.items()}
+        s = req.cache[0].size()
+        a = time.perf_counter()
+        logits, hidden = model.forward_boundary(**arrays, cache=req.cache, start=s, verify=True)
+        b = time.perf_counter()
+        mx.eval(logits, hidden)
+        c = time.perf_counter()
+        model.rollback_boundary(req.cache, 1)
+        if it >= warm:
+            builds.append(b-a); totals.append(c-a)
+    return med(builds), med(totals)
+
+
+# 1. Mac-only forward back to back.
+for asyn in (4, 0):
+    model._async_every = asyn
+    for L in (1, 2, 3, 4, 5):
+        b, t = fwd(L)
+        emit(dict(part='forward', async_every=asyn, rows=L, build_ms=b, total_ms=t))
+model._async_every = 4
+
+# 2. In-situ ablations.
+orig_moe = LG.MoE.__call__
+
+
+def moe_shared_only(self, x, image_mask):
+    idx, weights = self.gate(x, image_mask)
+    shared = self.shared_experts(x)
+    return (shared.astype(mx.float32) + weights.sum()*0).astype(x.dtype)
+
+
+def moe_none(self, x, image_mask):
+    return x * 0
+
+
+for name, fn in (('no_routed', moe_shared_only), ('no_ffn', moe_none)):
+    LG.MoE.__call__ = fn
+    for L in (1, 5):
+        b, t = fwd(L, reps=8)
+        emit(dict(part='ablate', variant=name, rows=L, build_ms=b, total_ms=t))
+LG.MoE.__call__ = orig_moe
+
+# 3. Capture per-layer inputs for L=5 and L=1.
+caps = {}
+orig_block, orig_attn = LG.Block.__call__, LG.Attention.__call__
+layer_of = {id(model.layers[i].ffn): i for i in range(20, 40)}
+
+
+def block_rec(self, h, pre, *a, **k):
+    caps[('block', self.attn._layer)] = (h, pre)
+    return orig_block(self, h, pre, *a, **k)
+
+
+def attn_rec(self, x, *a, **k):
+    caps[('attn', self._layer)] = x
+    return orig_attn(self, x, *a, **k)
+
+
+def moe_rec(self, x, image_mask):
+    caps[('ffn', layer_of[id(self)])] = x
+    return orig_moe(self, x, image_mask)
+
+
+def capture(L):
+    LG.Block.__call__, LG.Attention.__call__, LG.MoE.__call__ = block_rec, attn_rec, moe_rec
+    try:
+        arrays = {k: v[:, :L] for k, v in FULL.items()}
+        s = req.cache[0].size()
+        logits, hidden = model.forward_boundary(**arrays, cache=req.cache, start=s, verify=True)
+        mx.eval(logits, hidden, [v for v in caps.values()])
+        model.rollback_boundary(req.cache, 1)
+    finally:
+        LG.Block.__call__, LG.Attention.__call__, LG.MoE.__call__ = orig_block, orig_attn, orig_moe
+    got = dict(caps); caps.clear()
+    return got
+
+
+def bench(fn, reps=10, warm=3):
+    builds, totals = [], []
+    for it in range(reps+warm):
+        a = time.perf_counter()
+        r = fn()
+        b = time.perf_counter()
+        mx.eval(r)
+        c = time.perf_counter()
+        if it >= warm:
+            builds.append(b-a); totals.append(c-a)
+    return med(builds), med(totals)
+
+
+def chain(op, key, cap):
+    def run():
+        prev, outs = None, []
+        for i in range(20, 40):
+            x = cap[(key, i)]
+            if prev is not None:
+                x = x + (prev.reshape(-1)[:1] * 0).astype(x.dtype)
+            y = op(i, x)
+            y = y if isinstance(y, (list, tuple)) else [y]
+            prev = y[0]
+            outs.extend(y)
+        return outs
+    return run
+
+
+def op_null(i, x):
+    return x * 1
+
+
+def op_attn_proj(i, x):
+    at = model.layers[i].attn
+    q = quantize_activation(x)
+    a = at.wq_a.project_quantized(q)
+    kv = at.wkv.project_quantized(q)
+    return [at.wq_b(at.q_norm(a)), kv]
+
+
+def op_wqa_wkv(i, x):
+    at = model.layers[i].attn
+    q = quantize_activation(x)
+    return [at.wq_a.project_quantized(q), at.wkv.project_quantized(q)]
+
+
+def op_wq_b(i, x):
+    at = model.layers[i].attn
+    return at.wq_b(x[..., :1280])
+
+
+GROUPED = {}
+
+
+def op_wo(i, x):
+    at = model.layers[i].attn
+    L = x.shape[1]
+    g = GROUPED.setdefault(L, (mx.random.normal((1, L, 8, 4096))*0.05).astype(mx.bfloat16))
+    g = g + (x.reshape(-1)[:1]*0).astype(g.dtype)
+    w = at.wo_a.weight.reshape(8, 1024, -1)
+    p = decode_fusions.grouped_gemv(g, w) if decode_fusions.grouped_gemv_supported(g, w) else mx.einsum('bsgd,grd->bsgr', g, w)
+    return at.wo_b(p.flatten(-2))
+
+
+def op_wo_a(i, x):
+    at = model.layers[i].attn
+    L = x.shape[1]
+    g = GROUPED.setdefault(L, (mx.random.normal((1, L, 8, 4096))*0.05).astype(mx.bfloat16))
+    g = g + (x.reshape(-1)[:1]*0).astype(g.dtype)
+    w = at.wo_a.weight.reshape(8, 1024, -1)
+    return decode_fusions.grouped_gemv(g, w) if decode_fusions.grouped_gemv_supported(g, w) else mx.einsum('bsgd,grd->bsgr', g, w)
+
+
+def op_wo_b(i, x):
+    at = model.layers[i].attn
+    return at.wo_b(mx.concatenate([x, x[..., :8192-5120]], -1))
+
+
+def op_gate(i, x):
+    idx, w = model.layers[i].ffn.gate(x, None)
+    return [w, idx]
+
+
+ROUTES = {}
+
+
+def op_routed(i, x):
+    f = model.layers[i].ffn
+    idx, w = ROUTES[(i, x.shape[1])]
+    q = quantize_activation(x)
+    return f.experts(q[..., None, None, :], idx, w, input_quantized=True).squeeze(-2).astype(mx.float32).sum(-2)
+
+
+def op_shared(i, x):
+    return model.layers[i].ffn.shared_experts(x)
+
+
+def op_moe(i, x):
+    return model.layers[i].ffn(x, None)
+
+
+def op_hc(i, hp):
+    h, pre = hp
+    blk = model.layers[i]
+    c = model._config
+    ap, ao, ac = LG.hc_mixes(h, blk.hc_attn_fn, blk.hc_attn_scale, blk.hc_attn_base, c)
+    x = LG.hc_pre_norm(h, pre, blk.attn_norm.weight, blk.attn_norm.eps)
+    h = LG.hc_post(x, h, ao, ac)
+    fp, fo, fc = LG.hc_mixes(h, blk.hc_ffn_fn, blk.hc_ffn_scale, blk.hc_ffn_base, c)
+    x2 = LG.hc_pre_norm(h, ap, blk.ffn_norm.weight, blk.ffn_norm.eps)
+    return [LG.hc_post(x2, h, fo, fc), fp]
+
+
+def chain_hc(cap):
+    def run():
+        prev, outs = None, []
+        for i in range(20, 40):
+            h, pre = cap[('block', i)]
+            if prev is not None:
+                h = h + (prev.reshape(-1)[:1] * 0).astype(h.dtype)
+            y = op_hc(i, (h, pre))
+            prev = y[0]
+            outs.extend(y)
+        return outs
+    return run
+
+
+for L in (5, 1, 3):
+    cap = capture(L)
+    for i in range(20, 40):
+        ROUTES[(i, L)] = model.layers[i].ffn.gate(cap[('ffn', i)], None)
+        mx.eval(ROUTES[(i, L)])
+    distinct = [len(set(ROUTES[(i, L)][0].reshape(-1).tolist())) for i in range(20, 40)]
+    emit(dict(part='routes', rows=L, distinct_experts_per_layer=distinct, mean=statistics.mean(distinct)))
+    null_b, null_t = bench(chain(op_null, 'attn', cap))
+    emit(dict(part='micro', op='null', rows=L, build_ms=null_b, total_ms=null_t))
+    for name, op, key in (('attn_proj', op_attn_proj, 'attn'), ('wqa_wkv', op_wqa_wkv, 'attn'),
+                          ('wq_b', op_wq_b, 'attn'), ('wo', op_wo, 'attn'), ('wo_a', op_wo_a, 'attn'),
+                          ('wo_b', op_wo_b, 'attn'), ('gate', op_gate, 'ffn'), ('routed', op_routed, 'ffn'),
+                          ('shared', op_shared, 'ffn'), ('moe', op_moe, 'ffn')):
+        b, t = bench(chain(op, key, cap))
+        emit(dict(part='micro', op=name, rows=L, build_ms=b, total_ms=t, net_ms=round(t-null_t, 3)))
+    b, t = bench(chain_hc(cap))
+    emit(dict(part='micro', op='hc', rows=L, build_ms=b, total_ms=t, net_ms=round(t-null_t, 3)))
+    h39, pre39 = cap[('block', 39)]
+
+    def head_once(h=h39, pre=pre39):
+        # the real tail: layer 39 output approximated by its input
+        return project_logits(model.norm(LG.hc_pre(h, pre)), model.head)
+    b, t = bench(head_once)
+    emit(dict(part='micro', op='head', rows=L, build_ms=b, total_ms=t))
+    empty_b, empty_t = bench(lambda: [h39 * 1])
+    emit(dict(part='micro', op='empty_eval', rows=L, build_ms=empty_b, total_ms=empty_t))
+
+# 4. Drafter (fresh session: the benchmarks above advanced the Mac cache past the box).
+req.close()
+req = PipelineRequest(model, tokens, encoder=EncoderSession())
+logits, hidden = req.forward([req.tokens[-1]])
+capture_prompt(model, mx.array([[req.tokens[-1]]], mx.uint32), hidden, req.cache)
+first = int(mx.argmax(logits[0, -1]).item())
+logits, hidden = req.forward([first])
+anchor = int(mx.argmax(logits[0, -1]).item())
+mtp_cache, _ = model.mtp_take_primed(req.cache, first)
+H1 = hidden[:, :1]
+mx.eval(H1)
+
+
+def draft(width, sync_probs=True):
+    lg, _ = model.dspark_forward(H1, mx.array([[anchor]], mx.uint32), mtp_cache, draft_length=width)
+    previous = mx.array([anchor], mx.uint32)
+    toks, probs = [], []
+    for i in range(width):
+        bias, _ = model.dspark_markov(previous)
+        scores = lg[:, i] + bias
+        previous = mx.argmax(scores, -1).astype(mx.uint32)
+        toks.append(previous)
+        probs.append(mx.exp(mx.max(scores)-mx.logsumexp(scores)))
+    chosen = mx.concatenate(toks)
+    mx.eval(chosen, probs)
+    if sync_probs:
+        [float(p.item()) for p in probs]
+    return chosen
+
+
+def timed(fn, reps=12, warm=3):
+    ts = []
+    for it in range(reps+warm):
+        a = time.perf_counter(); fn(); b = time.perf_counter()
+        if it >= warm:
+            ts.append(b-a)
+    return med(ts)
+
+
+for width in (4, 3, 2, 1):
+    emit(dict(part='draft', op='full', width=width, total_ms=timed(lambda: draft(width))))
+# parts at width 4 (the context append grows the ring; fine for timing)
+first_stage = model.mtp[0]
+
+
+def part_append():
+    model.dspark_append_context(H1, mtp_cache)
+    mx.eval([x.keys for x in mtp_cache])
+
+
+emit(dict(part='draft', op='append_context', width=4, total_ms=timed(part_append)))
+
+
+def part_proposal():
+    lg, h = proposal_forward(model, mx.array([[anchor]], mx.uint32), mtp_cache, 4)
+    mx.eval(lg)
+
+
+emit(dict(part='draft', op='proposal_incl_head', width=4, total_ms=timed(part_proposal)))
+X4 = (mx.random.normal((1, 4, 5120))*0.3).astype(mx.bfloat16)
+mx.eval(X4)
+emit(dict(part='draft', op='head_only', width=4, total_ms=timed(lambda: mx.eval(project_logits(X4, model.head)))))
+
+
+def part_markov():
+    previous = mx.array([anchor], mx.uint32)
+    toks = []
+    for i in range(4):
+        bias, _ = model.dspark_markov(previous)
+        previous = mx.argmax(bias, -1).astype(mx.uint32)
+        toks.append(previous)
+    mx.eval(toks)
+
+
+emit(dict(part='draft', op='markov4', width=4, total_ms=timed(part_markov)))
+for s, stage in enumerate(model.mtp):
+    x = (mx.random.normal((1, 4, 5120))*0.3).astype(mx.bfloat16)
+    mx.eval(x)
+    emit(dict(part='draft', op=f'stage{s}_moe', width=4, total_ms=timed(lambda: mx.eval(stage.ffn(x, None)))))
+    emit(dict(part='draft', op=f'stage{s}_shared', width=4, total_ms=timed(lambda: mx.eval(stage.ffn.shared_experts(x)))))
+emit(dict(part='draft', op='empty_eval', width=4, total_ms=timed(lambda: mx.eval(X4*1))))
+req.close()
+emit(dict(event='done', peak_gib=mx.get_peak_memory()/2**30))
+watch.kill()
