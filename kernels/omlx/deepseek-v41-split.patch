@@ -0,0 +1,26 @@
+"""External 50 ms RSS/footprint and lease watchdog; PID + process UUID bound."""
+import ctypes
+import json
+import os
+from pathlib import Path
+import signal
+import sys
+import time
+
+pid=int(sys.argv[1]); path=Path(sys.argv[2]); limit=float(sys.argv[3]) if len(sys.argv)>3 else 840; lib=ctypes.CDLL('/usr/lib/libSystem.B.dylib')
+buf=ctypes.create_string_buffer(512); start=time.monotonic(); identity=None; peak_rss=peak_fp=0; saved=0
+while lib.proc_pid_rusage(pid,2,buf)==0:
+    raw=buf.raw
+    if identity is None:identity=raw[:16]
+    if identity != raw[:16]:break
+    peak_rss=max(peak_rss,int.from_bytes(raw[64:72],'little'))
+    peak_fp=max(peak_fp,int.from_bytes(raw[72:80],'little'))
+    elapsed=time.monotonic()-start
+    stop=max(peak_fp,peak_rss)>245*2**30 or (limit>0 and elapsed>limit)
+    if elapsed-saved>1 or stop:
+        path.write_text(json.dumps(dict(pid=pid,elapsed=elapsed,peak_rss_gib=peak_rss/2**30,peak_footprint_gib=peak_fp/2**30,stop=stop)))
+        saved=elapsed
+    if stop:
+        os.kill(pid,signal.SIGKILL)
+        break
+    time.sleep(.05)
diff --git a/benchmarks/og/wire_gate.py b/benchmarks/og/wire_gate.py
new file mode 100644
index 00000000..7fd023b9
--- /dev/null
+++ b/benchmarks/og/wire_gate.py
@@ -0,0 +1,156 @@
+"""Box-side prefix cache gate over the step API (CPU only; run next to the box).
+
+For each scenario a prompt is OPENed fresh (no cache flag: box prefill from
+token 0) and cached (`cache:1`, after earlier turns populated snapshots). The
+two state blobs must be byte-identical tensor by tensor. Both sessions then
+run the same STEP sequence (5-row verifies with a rejected tail, 1-row
+kickoff) and every STPR payload must be byte-identical. With --lean / --delta
+the cached OPEN also requests `state:"lean"` / `delta_from`, and the returned
+rows are checked against the matching rows of the fresh full state.
+
+Scenarios per size (turn shapes of the DS41 chat template):
+  regen    same prompt again (suffix 0)
+  think    prompt[:-1] + </think> + reply + next user turn (resume at N-1)
+  chat     previous prompt + reply + next user turn
+  edit     a prefix of 3/4 of the prompt + different tokens (8K-boundary snapshot)
+  s1/s57/s300/s9000  previous prompt + k tokens
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import random
+import sys
+import time
+
+import numpy as np
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[2]/'omlx/patches/deepseek_v41'))
+import pipe_wire as W  # noqa: E402
+
+EOS, USER, ASSISTANT, THINK, THINK_END = 1, 128803, 128804, 128821, 128822
+NP = {'U8': np.uint8, 'I32': np.int32, 'I64': np.int64, 'F32': np.float32, 'BF16': np.uint16, 'U32': np.uint32}
+
+
+def arrays(tensors):
+    return {k: np.frombuffer(v[2], NP[v[0]]).reshape(v[1]) for k, v in tensors.items()}
+
+
+def opened(host, port, tokens, **options):
+    s = W.EncoderSession(host, port)
+    t0 = time.perf_counter()
+    tensors, manifest = s.open(tokens, 'ogc-wire', **options)
+    return s, arrays(tensors), manifest, time.perf_counter() - t0
+
+
+def compare(fresh, cached, manifest, delta):
+    """Differences of the cached state against the fresh one (names -> reason)."""
+    bad = {}
+    for name, value in cached.items():
+        ref = fresh.get(name)
+        if ref is None:
+            bad[name] = 'missing in fresh'
+            continue
+        if delta and name.startswith('layer.20.slot.') and name[-1] in '23':
+            ref = ref[:, delta:]
+        if value.shape != ref.shape:
+            if value.size == 0 and name.startswith('layer.') and int(name.split('.')[1]) < 20:
+                continue  # lean: layers 0-19 omitted
+            bad[name] = f'shape {value.shape} != {ref.shape}'
+        elif value.tobytes() != ref.tobytes():
+            rows = np.flatnonzero((value.reshape(value.shape[0] * value.shape[1], -1) !=
+                                   ref.reshape(ref.shape[0] * ref.shape[1], -1)).any(-1)) if value.ndim >= 2 else []
+            bad[name] = f'{len(rows)} rows differ, first {list(rows[:3])}'
+    return bad
+
+
+def steps(session, tokens, rng):
+    """Kickoff + 6 verify cycles with rejections; returns the STPR payload digests."""
+    keep = len(tokens) - 1
+    out = []
+    raw, _ = session.step([tokens[-1]], keep)
+    out.append(hashlib.sha256(raw).hexdigest()[:16])
+    keep += 1
+    for _ in range(6):
+        ids = [rng.randrange(1000, 100000) for _ in range(5)]
+        raw, _ = session.step(ids, keep)
+        out.append(hashlib.sha256(raw).hexdigest()[:16])
+        keep += rng.randrange(1, 6)  # accepted rows; the rest are rewound by the next STEP
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--host', default='127.0.0.1')
+    ap.add_argument('--port', type=int, default=10052)
+    ap.add_argument('--sizes', default='8192,131072')
+    ap.add_argument('--scenarios', default='regen,think,chat,s1,s57,s300,s9000,edit')
+    ap.add_argument('--lean', action='store_true')
+    ap.add_argument('--delta', action='store_true')
+    ap.add_argument('--fixtures', default='/home/ian/mac/ds41/split-wire/split-wire')
+    ap.add_argument('--out', default='wire-gate.jsonl')
+    ap.add_argument('--seed', type=int, default=1)
+    args = ap.parse_args()
+    log = open(args.out, 'a')
+    rng = random.Random(args.seed)
+    ok = True
+
+    def emit(rec):
+        log.write(json.dumps(rec) + '\n')
+        log.flush()
+        print(json.dumps(rec), flush=True)
+
+    for size in [int(x) for x in args.sizes.split(',')]:
+        path = Path(args.fixtures)/f'ids-{size}.json'
+        base = json.loads(path.read_text()) if path.exists() else [0] + [rng.randrange(1000, 100000) for _ in range(size)]
+        base = base[:-1] + [THINK]  # thinking-mode generation prompt
+        nonce = [rng.randrange(1000, 100000) for _ in range(8)]
+        base = base[:2] + nonce + base[2:]  # a prompt the box has never cached
+        # Turn 1 populates the snapshots.
+        s, _, m, dt = opened(args.host, args.port, base, cache=True)
+        emit(dict(size=size, scenario='turn1', prompt=len(base), resumed=s.open_info['resumed_tokens'], open_s=round(dt, 3)))
+        s.close()
+        prev = base
+        for name in args.scenarios.split(','):
+            reply = [rng.randrange(1000, 100000) for _ in range(40)]
+            user = [rng.randrange(1000, 100000) for _ in range(30)]
+            if name == 'regen':
+                prompt = prev
+            elif name == 'think':
+                prompt = prev[:-1] + [THINK_END] + reply + [EOS, USER] + user + [ASSISTANT, THINK]
+            elif name == 'chat':
+                prompt = prev + reply + [EOS, USER] + user + [ASSISTANT, THINK_END]
+            elif name == 'edit':
+                prompt = base[:len(base) * 3 // 4] + user + [ASSISTANT, THINK]
+            else:
+                k = int(name[1:])
+                prompt = prev + [rng.randrange(1000, 100000) for _ in range(k)]
+            fs, fresh, fm, fdt = opened(args.host, args.port, prompt)
+            options = dict(cache=True)
+            if args.lean:
+                options['state'] = 'lean'
+            delta = 0
+            if args.delta and name != 'edit':
+                delta = min(len(prev), len(prompt)) - 1
+                options['delta_from'] = delta
+            cs, cached, cm, cdt = opened(args.host, args.port, prompt, **options)
+            got_delta = int(cm.get('delta_from') or 0)
+            bad = compare(fresh, cached, cm, got_delta)
+            fsteps, csteps = steps(fs, prompt, random.Random(7)), steps(cs, prompt, random.Random(7))
+            same = not bad and fsteps == csteps
+            ok &= same
+            emit(dict(size=size, scenario=name, prompt=len(prompt), resumed=cs.open_info['resumed_tokens'],
+                      fresh_resumed=fs.open_info['resumed_tokens'], delta_requested=delta, delta_from=got_delta,
+                      identical_state=not bad, identical_steps=fsteps == csteps, bad=dict(list(bad.items())[:4]),
+                      fresh_open_s=round(fdt, 3), cached_open_s=round(cdt, 3),
+                      fresh_mb=round(fs.open_info.get('state_bytes', 0) / 1e6, 1),
+                      cached_mb=round(cs.open_info.get('state_bytes', 0) / 1e6, 1)))
+            fs.close()
+            cs.close()
+            if name != 'edit':
+                prev = prompt
+    emit(dict(event='done', all_identical=ok))
+
+
+if __name__ == '__main__':
+    main()
