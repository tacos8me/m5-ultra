new file mode 100644
index 00000000..ee3ee261
--- /dev/null
+++ b/benchmarks/ogs/test_head.py
@@ -0,0 +1,54 @@
+"""Bitwise + speed check: multi-row BF16 head kernel vs the per-row kernel. Small GPU job (gpu-exec)."""
+import json
+import os
+from pathlib import Path
+import statistics
+import sys
+import time
+
+TREE = Path(os.environ.get('DS41_TREE', str(Path.home()/'src/wt/ds41-og-speed')))
+sys.path.insert(0, str(TREE))
+import mlx.core as mx  # noqa: E402
+from omlx.patches.deepseek_v41 import head as H  # noqa: E402
+
+
+def old(x, w):
+    rows, width = w.shape
+    return H._kernel()(inputs=[x.astype(mx.float32), w], template=[("N", rows), ("K", width), ("KL", 16)],
+                       grid=(((rows*16+63)//64)*64, x.size//width, 1), threadgroup=(64, 1, 1),
+                       output_shapes=[(*x.shape[:-1], rows)], output_dtypes=[mx.float32])[0]
+
+
+def timed(fn, reps=20):
+    ts = []
+    for i in range(reps+3):
+        a = time.perf_counter(); mx.eval(fn()); b = time.perf_counter()
+        if i >= 3:
+            ts.append(b-a)
+    return round(1000*statistics.median(ts), 3)
+
+
+mx.random.seed(0)
+res = []
+for rows, width, scale in ((129280, 5120, 0.02), (129280, 256, 0.05)):
+    w = (mx.random.normal((rows, width))*scale).astype(mx.bfloat16)
+    mx.eval(w)
+    for M in (1, 2, 3, 4, 5):
+        bad = 0
+        for trial in range(5):
+            x = (mx.random.normal((1, M, width))*(1+trial)).astype(mx.bfloat16)
+            a = old(x, w)
+            b = H.project_logits(x, w)
+            mx.eval(a, b)
+            bad += int((a.view(mx.uint32) != b.view(mx.uint32)).sum().item())
+            # each row equals the single-row call too (row-count invariance)
+            for q in range(M):
+                c = old(x[:, q:q+1], w)
+                bad += int((c.view(mx.uint32) != b[:, q:q+1].view(mx.uint32)).sum().item())
+        x = (mx.random.normal((1, M, width))).astype(mx.bfloat16)
+        mx.eval(x)
+        r = dict(rows=rows, width=width, M=M, mismatches=bad, old_ms=timed(lambda: old(x, w)), new_ms=timed(lambda: H.project_logits(x, w)))
+        print(json.dumps(r), flush=True)
+        res.append(r)
+    del w
+Path(os.environ.get('OUT', str(Path.home()/'llm/ds41/og-speed/test_head.json'))).write_text(json.dumps(res))
