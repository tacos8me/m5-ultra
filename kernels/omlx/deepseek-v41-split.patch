+"""Greedy text sanity on frozen chat prompts vs the q3 baseline text (not a quality gate)."""
+import argparse
+import json
+import os
+from pathlib import Path
+import sys
+
+sys.path.insert(0, str(Path(__file__).parent))
+from bench import request  # noqa: E402
+
+SPLIT = Path.home()/'llm/ds41/split1'
+LOGS = Path(os.environ.get('OG_LOGS', str(Path.home()/'llm/ds41/og-mac')))
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--base', default='http://127.0.0.1:12143')
+    ap.add_argument('--label', required=True)
+    ap.add_argument('--cases', default='python,security,probability,json')
+    ap.add_argument('--max-tokens', type=int, default=96)
+    args = ap.parse_args()
+    from tokenizers import Tokenizer
+    tok = Tokenizer.from_file(str(Path.home()/'models/DeepSeek-V4.1-Flash-pipe1-mlx/tokenizer.json'))
+    baseline = {}
+    for line in (SPLIT/'quality-baseline.jsonl').read_text().splitlines():
+        row = json.loads(line)
+        if row.get('event') == 'result' and row.get('mode') == 'baseline':
+            baseline[row['case']] = row['response']['choices'][0]['message']['content']
+    inputs = {json.loads(p.read_text())['case']: json.loads(p.read_text()) for p in (SPLIT/'quality-inputs').glob('*.input.json')}
+    out = (LOGS/(args.label+'.smoke.jsonl')).open('a')
+    for case in args.cases.split(','):
+        item = inputs[case]
+        r = request(args.base, dict(tokens=item['prompt_ids'], max_tokens=args.max_tokens, request_id='smoke-'+case))
+        text = tok.decode(r['tokens'], skip_special_tokens=True)
+        ref = baseline.get(case, '')
+        common = next((i for i, (a, b) in enumerate(zip(text, ref)) if a != b), min(len(text), len(ref)))
+        record = dict(case=case, prompt_tokens=len(item['prompt_ids']), n=len(r['tokens']), decode_tok_s=r['decode_tok_s'],
+                      ttft_s=r['ttft_s'], same_prefix_chars=common, text=text, q3=ref[:len(text)+40],
+                      dspark=f"{r['summary']['dspark_accepted']}/{r['summary']['dspark_proposed']}",
+                      copy=f"{r['summary']['copy_accepted']}/{r['summary']['copy_proposed']}")
+        out.write(json.dumps(record)+'\n'); out.flush()
+        print(json.dumps(record, ensure_ascii=False), flush=True)
+
+
+if __name__ == '__main__':
+    main()
