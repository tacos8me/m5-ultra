+"""Two FRESH OPENs of the same prompt, the first kept open so the second gets other pages; compare every tensor."""
+import json, random, sys
+from pathlib import Path
+import numpy as np
+sys.path.insert(0, str(Path(__file__).resolve().parent))
+from wire_gate import opened, steps, THINK
+
+size, seed = int(sys.argv[1]), int(sys.argv[2])
+rng = random.Random(seed)
+p = [0] + [rng.randrange(1000, 100000) for _ in range(size)] + [128804, THINK]
+a, sa, ma, ta = opened('127.0.0.1', 10052, p)
+b, sb, mb, tb = opened('127.0.0.1', 10052, p)
+bad = {}
+for k, v in sa.items():
+    w = sb[k]
+    if v.tobytes() != w.tobytes():
+        r = np.flatnonzero((v.reshape(v.shape[0] * v.shape[1], -1) != w.reshape(w.shape[0] * w.shape[1], -1)).any(-1))
+        bad[k] = [int(r.size), r[:3].tolist(), r[-1:].tolist()]
+print(json.dumps(dict(prompt=len(p), open_s=[round(ta, 1), round(tb, 1)], identical=not bad, bad=bad,
+                      steps_identical=steps(a, p, random.Random(7)) == steps(b, p, random.Random(7)))))
+a.close(); b.close()
