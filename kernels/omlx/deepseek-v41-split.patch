@@ -0,0 +1,39 @@
+"""Optional diagnostic capture for copy/schema headroom; never use capture rates as serving claims."""
+import json
+from pathlib import Path
+import mlx.core as mx
+from omlx import server
+from omlx.patches.mlx_lm_mtp import batch_generator as bg
+A=Path(__file__).resolve().parent
+active=None;records={};positions={}
+orig_drafts=bg._dspark_next_drafts;orig_emit=bg._emit_response;orig_stats=bg._log_mtp_stats
+
+def record(uid):
+ return records.setdefault(str(uid),{'tokens':[],'steps':[],'stats':None})
+
+def drafts(gen,state,hidden,committed,prev):
+ result=orig_drafts(gen,state,hidden,committed,prev)
+ if active is not None:
+  uid=gen.uids[0];r=record(uid);start=positions.get(str(uid),1);ids=committed.tolist();positions[str(uid)]=start+len(ids)
+  # Downsample existing target taps, without changing target or drafter arithmetic.
+  features=hidden[0,:,::64].astype(mx.float32).tolist()
+  r['steps'].append(dict(start=start,committed=ids,features=features,drafts=state.drafts.tolist(),source=state.draft_source,context=state.hist_offset))
+ return result
+
+def emit(gen,token,lp,stats=None):
+ if active is not None:record(gen.uids[0])['tokens'].append(int(token))
+ return orig_emit(gen,token,lp,stats)
+
+def stats(uid,s,finish):
+ if active is not None:
+  record(uid)['stats']={k:v for k,v in vars(s).items() if isinstance(v,(int,float,str,list))}
+ return orig_stats(uid,s,finish)
+
+bg._dspark_next_drafts=drafts;bg._emit_response=emit;bg._log_mtp_stats=stats
+@server.app.post('/source-probe/{tag}')
+async def set_probe(tag:str):
+ global active,records,positions
+ active=None if tag=='off' else tag;records={};positions={};return {'tag':active}
+@server.app.get('/source-probe-result')
+async def get_probe():
+ return dict(tag=active,requests=records)
