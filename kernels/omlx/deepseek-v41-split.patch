+                    x = quantize_activation((mx.random.normal((1, M, K)) * (0.5 + trial)).astype(mx.bfloat16))
+                    ref = run(kernels['dot'], x, p, 2)
+                    out = run(kernel, x, p, 1)
+                    mx.eval(ref, out)
+                    bad += bits_equal(ref, out); total += ref.size
+        emit(dict(exp='qmvform', form=name, mismatched=bad, of=total))
