+
+_SPIN = mx.fast.metal_kernel(
+    name='attn_bench_spin', input_names=['n'], output_names=['y'],
+    source="""
+    float acc = 0.0f;
+    for (int i = 0; i < n[0]; ++i) acc = metal::fma(acc, 0.999f, 1.0f);
+    y[0] = acc;
+    """)
