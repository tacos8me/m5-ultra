index 00000000..18063ba5
--- /dev/null
+++ b/benchmarks/og/server.py
@@ -0,0 +1,173 @@
+"""Private HTTP pipe1 server. Run via gpu-exec; watchdog kills this same PID.
+
+/generate accepts exact token IDs and returns NDJSON committed tokens + summary.
+/score teacher-forces a common continuation at L4 and writes local FP32 logits.
+One GPU worker alternates active decode sessions (cap2); no two Metal threads.
+"""
+import argparse
+from collections import deque
+import json
+import os
+from pathlib import Path
+import queue
+import signal
+import socket
+import subprocess
+import sys
+import threading
+import time
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+
+TREE = Path(os.environ.get('DS41_TREE',str(Path.home()/'src/wt/ds41-og')))
+LOGS = Path(os.environ.get('OG_LOGS',str(Path.home()/'llm/ds41/og-mac')))
+sys.path.insert(0,str(TREE))
+
+
+def main():
+    ap=argparse.ArgumentParser()
+    ap.add_argument('--model',default=str(Path.home()/'models/DeepSeek-V4.1-Flash-pipe1-mlx'))
+    ap.add_argument('--port',type=int,default=12143)
+    ap.add_argument('--label',default='pipe1')
+    ap.add_argument('--encoder-host',default='10.10.10.1')
+    ap.add_argument('--encoder-port',type=int,default=10052)
+    ap.add_argument('--max-active',type=int,default=2)
+    ap.add_argument('--lease-seconds',type=int,default=840)
+    ap.add_argument('--score-dir',default=str(LOGS/'scores'))
+    args=ap.parse_args()
+    here=Path(__file__).parent
+    # Exit before loading 148 GiB if the dependency disappeared in the queue.
+    with socket.create_connection((args.encoder_host,args.encoder_port),timeout=3):pass
+    watch=subprocess.Popen(['/opt/homebrew/bin/python3',str(here/'watch.py'),str(os.getpid()),str(LOGS/(args.label+'.memory.json')),str(args.lease_seconds)])
+    import mlx.core as mx
+    import numpy as np
+    from omlx.patches.deepseek_v41.pipe_decoder import load_decoder
+    from omlx.patches.deepseek_v41.pipe_session import PipelineRequest
+    from omlx.patches.deepseek_v41.pipe_wire import EncoderSession
+    mx.set_wired_limit(mx.device_info()['max_recommended_working_set_size'])
+    mx.set_cache_limit(512<<20)
+    mx.set_memory_limit(230<<30)
+    jobs=queue.Queue(); ready=threading.Event(); stopping=threading.Event(); failure=[]
+    score_dir=Path(args.score_dir);score_dir.mkdir(parents=True,exist_ok=True)
+
+    def worker():
+        # One MLX thread. Admission's box prefill/state transfer runs on a
+        # network-only thread pool; import/replay and all steps stay here.
+        from concurrent.futures import ThreadPoolExecutor
+        from omlx.patches.deepseek_v41.pipe_session import open_remote
+        active=deque(); opening=[]; pool=ThreadPoolExecutor(2)
+        def fail(out,e):
+            out.put(dict(event='error',error=f'{type(e).__name__}: {e}'));out.put(None)
+        try:
+            model=load_decoder(args.model)
+            ready.set()
+            while not stopping.is_set():
+                while len(active)+len(opening)<args.max_active:
+                    try:body,out,cancel=jobs.get(timeout=.05 if not (active or opening) else 0)
+                    except queue.Empty:break
+                    try:
+                        encoder=EncoderSession(args.encoder_host,args.encoder_port)
+                    except Exception as e:
+                        fail(out,e);continue
+                    if body.get('score'):
+                        try:
+                            request=PipelineRequest(model,body['tokens'],encoder=encoder,request_id=body.get('request_id',''))
+                            try:
+                                logits=request.teacher_force(body['targets'])
+                                name=body['name']
+                                if Path(name).name != name or not name.endswith('.npy'):
+                                    raise ValueError('Score name must be a .npy basename')
+                                np.save(score_dir/name,np.asarray(logits))
+                                out.put(dict(event='summary',file=str(score_dir/name),**request.summary()))
+                                del logits
+                            finally:request.close()
+                            out.put(None)
+                        except Exception as e:
+                            encoder.close();fail(out,e)
+                        continue
+                    opening.append((pool.submit(open_remote,encoder,body['tokens'],body.get('request_id','')),body,out,cancel,encoder))
+                for item in [x for x in opening if x[0].done()]:
+                    opening.remove(item)
+                    future,body,out,cancel,encoder=item
+                    try:
+                        request=PipelineRequest(model,body['tokens'],encoder=encoder,opened=future.result())
+                        gen=request.generate(body['max_tokens'],ignore_eos=body.get('ignore_eos',False))
+                        next(gen)
+                        out.put(dict(event='admitted',prefill_remote_s=request.prefill_remote_s,
+                                     replay_s=request.replay_s,t=time.perf_counter()))
+                        active.append((request,gen,out,cancel))
+                    except Exception as e:
+                        encoder.close();fail(out,e)
+                if active:
+                    request,gen,out,cancel=active.popleft()
+                    try:
+                        if cancel.is_set():
+                            gen.close();out.put(None);continue
+                        tokens=next(gen)
+                        out.put(dict(event='tokens',tokens=tokens,t=time.perf_counter()))
+                        active.append((request,gen,out,cancel))
+                    except StopIteration:
+                        out.put(dict(event='summary',**request.summary()));out.put(None)
+                    except Exception as e:
+                        gen.close();request.close();fail(out,e)
+                elif opening:time.sleep(.002)
+                else:mx.clear_cache()
+        except BaseException as e:
+            failure.append(str(e));ready.set()
+            raise
+        finally:
+            for request,gen,out,cancel in active:
+                gen.close();request.close();out.put(None)
+
+    engine=threading.Thread(target=worker,daemon=True);engine.start()
+
+    class Handler(BaseHTTPRequestHandler):
+        def do_GET(self):
+            ok=ready.is_set() and not failure
+            raw=json.dumps(dict(ready=ok,failure=failure,pid=os.getpid())).encode()
+            self.send_response(200 if ok else 503);self.send_header('Content-Type','application/json')
+            self.send_header('Content-Length',str(len(raw)));self.end_headers();self.wfile.write(raw)
+
+        def do_POST(self):
+            if not ready.is_set() or failure:
+                self.send_error(503);return
+            if self.path not in ('/generate','/score'):
+                self.send_error(404);return
+            try:
+                size=int(self.headers['Content-Length'])
+                if not 0<size<=16<<20:raise ValueError('Request exceeds limit')
+                body=json.loads(self.rfile.read(size))
+                tokens=body['tokens']
+                if not isinstance(tokens,list) or not 2<=len(tokens)<=1048576 or any(type(x) is not int or not 0<=x<129280 for x in tokens):
+                    raise ValueError('Invalid tokens')
+                if self.path=='/score':
+                    body['score']=True
+                    if not isinstance(body['targets'],list) or not 1<=len(body['targets'])<=512 or any(type(x) is not int or not 0<=x<129280 for x in body['targets']):
+                        raise ValueError('Invalid targets')
+                else:
+                    if type(body['max_tokens']) is not int or not 1<=body['max_tokens']<=4096:raise ValueError('Invalid max_tokens')
+                if len(tokens)+len(body.get('targets',[]))+body.get('max_tokens',0)>1048576:
+                    raise ValueError('Context limit exceeded')
+            except Exception as e:
+                self.send_error(400,str(e));return
+            out,cancel=queue.Queue(),threading.Event()
+            self.send_response(200);self.send_header('Content-Type','application/x-ndjson');self.end_headers()
+            jobs.put((body,out,cancel))
+            try:
+                while True:
+                    event=out.get(timeout=800)
+                    if event is None:break
+                    self.wfile.write(json.dumps(event).encode()+b'\n');self.wfile.flush()
+            except (BrokenPipeError,ConnectionResetError,queue.Empty):pass
+            finally:cancel.set()
+
+    http=ThreadingHTTPServer(('127.0.0.1',args.port),Handler)
+    def terminate(*_):
+        # Exit the memory-owning PID; the inherited lock dies with its memory.
+        os._exit(0)
+    signal.signal(signal.SIGTERM,terminate)
+    try:http.serve_forever()
+    finally:
+        stopping.set();http.server_close()
+
+
+if __name__=='__main__':main()
diff --git a/benchmarks/og/shared_bench.py b/benchmarks/og/shared_bench.py
new file mode 100644
index 00000000..84e86fd6
--- /dev/null
+++ b/benchmarks/og/shared_bench.py
@@ -0,0 +1,111 @@
+"""Shared-expert gate/up (+SwiGLU/FP8) layouts: bitwise + chain timing (shared weights of 3 layers, ~110 MB)."""
+import json
+import os
+import statistics
+import sys
+import time
+import types
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+os.environ.setdefault('MLX_ENABLE_TF32', '0')
+os.environ.setdefault('DS41_MHC', '1')
+import mlx.core as mx
+
+from omlx.patches.deepseek_v41 import ffn_fuse, fast_qmv
+from omlx.patches.deepseek_v41.activation import quantize_swiglu_activation
+from omlx.patches.deepseek_v41.loading import _load_shard
+from omlx.patches.deepseek_v41.quantization import QuantizedProjection, quantize_activation
+
+HOME = Path.home()
+MODEL = HOME/'models/DeepSeek-V4.1-Flash-pipe1-mlx'
+OUT = open(str(HOME/'llm/ds41/ffn/shared.jsonl'), 'a')
+
+
+def emit(**r):
+    line = json.dumps(r); OUT.write(line + '\n'); OUT.flush(); print(line, flush=True)
+
+
+def variant_source(sg_count):
+    src = ffn_fuse._SHARED_UP.replace('ROUTER\n', '')
+    half = sg_count // 2
+    rps = 64 // sg_count
+    src = src.replace('const bool second = sg >= 8;', f'const bool second = sg >= {half};')
+    src = src.replace('const int base_row = grp * 32 + (sg % 8) * 4;', f'const int base_row = grp * 32 + (sg % {half}) * {rps};')
+    src = src.replace('float result[4] = {0, 0, 0, 0};\n        for (int k = 0; k < K; k += 256)',
+                      f'float result[{rps}] = {{0}};\n        for (int k = 0; k < K; k += 256)')
+    src = src.replace('for (int row = 0; row < 4; row++) {\n                const int out_row',
+                      f'for (int row = 0; row < {rps}; row++) {{\n                const int out_row')
+    src = src.replace('for (int row = 0; row < 4; row++) {\n            const float v = simd_sum(result[row]);\n            if (simd_lid == 0) out[(sg % 8) * 4 + row]',
+                      f'for (int row = 0; row < {rps}; row++) {{\n            const float v = simd_sum(result[row]);\n            if (simd_lid == 0) out[(sg % {half}) * {rps} + row]')
+    src = src.replace('constexpr int R = 2;', f'constexpr int R = {rps // 2};')
+    src = src.replace('out[v * 32 + (sg % 8) * 4 + half_id * R + r]', f'out[v * 32 + (sg % {half}) * {rps} + half_id * R + r]')
+    assert src.count(f'sg % {half}') >= 3, src
+    return src
+
+
+def main():
+    wm = json.loads((MODEL/'model.safetensors.index.json').read_text())['weight_map']
+    raw = json.loads((MODEL/'config.json').read_text())
+    specs = raw['omlx_deepseek_v41']['quantized_modules']
+    layers = []
+    for i in (20, 21, 22):
+        ns = {}
+        for name in ('w1', 'w3', 'w2'):
+            key = f'language_model.layers.{i}.ffn.shared_experts.{name}'
+            v = _load_shard(MODEL/wm[key + '.weight'])
+            ns[name] = QuantizedProjection(v[key + '.weight'], v[key + '.scales'], **specs[key])
+        ns['_limit'] = 10.0
+        layers.append(types.SimpleNamespace(**ns))
+    mx.eval([[p.weight, p.scales] for L in layers for p in (L.w1, L.w3, L.w2)])
+    kernels = {sgc: mx.fast.metal_kernel(name=f'shared_up_sg{sgc}', input_names=['x', 'sw1', 'ss1', 'sw3', 'ss3', 'limit'],
+                                         output_names=['ys'], header=ffn_fuse._qmv8_header(full=True) + ffn_fuse._ROUND,
+                                         source=variant_source(sgc)) for sgc in (16, 32)}
+
+    def run_variant(sgc, L, xq):
+        m, k = xq.shape
+        n = L.w1.weight.shape[0]
+        return kernels[sgc](inputs=[xq, L.w1.weight, L.w1.scales, L.w3.weight, L.w3.scales, ffn_fuse._limit(10.0)],
+                            template=[('T', xq.dtype), ('K', k), ('N', n), ('M', m), ('RTG', 0)],
+                            grid=(32 * (n // 32), sgc, 1), threadgroup=(32, sgc, 1),
+                            output_shapes=[(m, n)], output_dtypes=[xq.dtype])[0]
+
+    def reference(L, xq):
+        g = L.w1.project_quantized(xq[None])[0]
+        u = L.w3.project_quantized(xq[None])[0]
+        return quantize_swiglu_activation(g, u, None, xq.dtype, 10.0)
+
+    tiny = mx.array(1e-30, mx.bfloat16)
+    for m in (1, 2, 3, 5):
+        x = (mx.random.normal((m, 5120)) * 1.3).astype(mx.bfloat16)
+        xq = quantize_activation(x)
+        ref = reference(layers[0], xq)
+        outs = {sgc: run_variant(sgc, layers[0], xq) for sgc in kernels}
+        mx.eval(ref, outs)
+        emit(test='bitwise', m=m, **{f'sg{k}': bool(mx.array_equal(ref, v).item()) for k, v in outs.items()})
+
+        def chain(kind):
+            def run():
+                acc = None
+                for c in range(60):
+                    L = layers[c % 3]
+                    xx = xq if acc is None else xq + acc
+                    y = reference(L, xx) if kind == 'ref' else (xx[:, :1] if kind == 'glue' else run_variant(kind, L, xx))
+                    acc = y[:, :1] * tiny
+                return acc
+            return run
+        specs_ = ['glue', 'ref', 16, 32]
+        t = {s: [] for s in specs_}
+        for rep in range(12):
+            for s in (specs_ if rep % 2 == 0 else specs_[::-1]):
+                fn = chain(s)
+                mx.synchronize()
+                t0 = time.perf_counter()
+                mx.eval(fn())
+                if rep >= 2:
+                    t[s].append((time.perf_counter() - t0) * 1000)
+        emit(test='chain', m=m, per_call_us={str(k): round(statistics.median(v) / 60 * 1000, 1) for k, v in t.items()})
+
+
+main()
