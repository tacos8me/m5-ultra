+import os,sys,subprocess,gc,time,json,statistics
+from pathlib import Path
+A=Path(__file__).resolve().parent; H=Path.home()
+sys.path[:0]=[str(H/'src/wt/ds41-sprint3-ds41o')]
+os.environ.update(GPUTIME='0',GUARD_GIB='245',FPWATCH_GIB='245',MLX_ENABLE_TF32='0')
+subprocess.Popen(['/opt/homebrew/bin/python3',str(H/'llm/ds41/sprint2-resume/watchdog.py'),str(os.getpid()),str(A/'curve.memory.json'),'840'])
+from common_d import *
+setup_memory(); model,processor,load_s=load_full();lm=model.language_model;tok=processor.tokenizer
+from omlx.patches.deepseek_v41.cache import DeepseekV41Cache
+log=(A/'curve.jsonl').open('w');emit(log,event='loaded',s=load_s,**mem())
+text=corpus_text(tok,200000);ids=tok.encode(text,add_special_tokens=False)
+for ctx in (8192,131072,524288):
+ arr=(ids*(ctx//len(ids)+1))[:ctx];t=time.perf_counter(); cache=prefill(lm,arr[:-1]);base=snapshot(cache);del cache
+ emit(log,event='prefill',ctx=ctx,seconds=time.perf_counter()-t,**mem())
+ for B in (1,2):
+  for L in (2,3,4,5):
+   rows=[deep_cache(lm,base,0) for _ in range(B)]; samples=[]; builds=[]
+   for rep in range(12):
+    x=[mx.array([arr[-L:]],mx.uint32) for _ in rows]
+    t=time.perf_counter()
+    if B==1: out=[model(x[0],cache=rows[0],return_hidden=True,n_confirmed=1)]
+    else: out=lm.mtp_verify_requests(x,rows)
+    t1=time.perf_counter();mx.eval([r[:2] for r in out]); t2=time.perf_counter()
+    for row in rows: lm.mtp_partial_rollback(row,0,L-1)
+    if rep>=3:samples.append((t2-t)*1000);builds.append((t1-t)*1000)
+   emit(log,event='curve',ctx=ctx,B=B,L=L,verify_ms=statistics.median(samples),build_ms=statistics.median(builds),samples=samples,**mem())
+   del rows,out,x;gc.collect();mx.clear_cache()
+ del base;gc.collect();mx.clear_cache()
+model.close();emit(log,event='done',**mem())
