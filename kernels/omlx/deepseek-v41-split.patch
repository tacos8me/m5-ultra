+"""CPU-only model schema check; constructs lazy shapes, loads no model weights."""
+import json
+from pathlib import Path
+import sys
+sys.path.insert(0, str(Path.home() / 'src/wt/ds41-pipe1'))
+import mlx.core as mx
+mx.set_default_device(mx.cpu)
+from mlx.utils import tree_flatten
+from omlx.patches.deepseek_v41.pipe_decoder import DecoderContainer
+from omlx.patches.deepseek_v41.config import ModelConfig
+
+layout = json.loads((Path(__file__).parent/'planned-layout.json').read_text())
+checkpoint = Path.home()/'models/DeepSeek-V4.1-Flash-pipe1-mlx'
+c = ModelConfig.from_dict(json.loads((checkpoint/'config.json').read_text()))
+c.preserve_mtp = True
+model = DecoderContainer(c)
+expected = {k: tuple(v.shape) for k,v in tree_flatten(model.parameters())}
+covered = set()
+for name, spec in layout['specs'].items():
+    logical = expected[name+'.weight']
+    assert tuple(layout['outputs'][name+'.weight']['shape']) == (*logical[:-1],logical[-1]*spec['bits']//32), name
+    assert tuple(layout['outputs'][name+'.scales']['shape']) == (*logical[:-1],logical[-1]//32), name
+    covered.update((name+'.weight',name+'.scales'))
+for name, entry in layout['outputs'].items():
+    if name not in covered:
+        assert tuple(entry['shape']) == expected[name], name
+assert set(expected) == (set(layout['outputs']) - {k for k in covered if k.endswith('.scales')})
+print(json.dumps({'lazy_parameters':len(expected),'output_tensors':len(layout['outputs']),'quantized_modules':len(layout['specs']),'all_shapes_match':True}))
