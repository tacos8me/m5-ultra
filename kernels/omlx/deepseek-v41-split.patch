+                    self._drop()
+                    raise BoxLost(f'box refused STEP at {keep} tokens after {rebuilds} rebuilt sessions: {exc!r}'[:300]) from exc
+                since = since or time.monotonic()
+                self.recover(tokens, keep, exc, since)
+                rebuilds += 1
+
