+import json,sys,statistics,collections
+from pathlib import Path
+p=Path(sys.argv[1]);rows=[json.loads(line) for line in p.read_text().splitlines()]
+byname=collections.defaultdict(list)
+for r in rows:byname[(r['name'],'c2' if r['rep']=='c2' else 'c1')].append(r)
+errors=[]
+for name,rs in byname.items():
+ modes={r['mode'] for r in rs}
+ if modes!={'off','both'}:errors.append((name,'missing mode'));continue
+ keys={json.dumps([r['content'],r['calls']],sort_keys=True) for r in rs}
+ if len(keys)!=1:errors.append((name,'different text/tool calls'))
+print('responses',len(rows),'pairs',len(byname),'errors',errors)
+summary={}
+for kind in ('tools','copy','c2','short'):
+ summary[kind]={}
+ for mode in ('off','both'):
+  rs=[r for r in rows if r['mode']==mode and ((kind=='tools' and isinstance(r['rep'],int) and r['name'] not in ('edit','rewrite')) or (kind=='copy' and r['name'] in ('edit','rewrite')) or (kind in ('c2','short') and r['rep']==kind))]
+  if not rs:continue
+  summary[kind][mode]=dict(n=len(rs),mean_tps=statistics.mean(r['usage']['generation_tokens_per_second'] for r in rs),weighted_tps=sum(r['usage']['completion_tokens'] for r in rs)/sum(r['usage']['generation_duration'] for r in rs),mean_completion_s=statistics.mean(r['elapsed_s'] for r in rs),mean_ttft_s=statistics.mean(r['usage']['time_to_first_token'] for r in rs))
+ print(kind,json.dumps(summary[kind]))
+print('last counters',[(r['mode'],r['rep'],r['sources']) for r in rows if r['name']=='edit'])
+p.with_suffix('.summary.json').write_text(json.dumps(dict(responses=len(rows),errors=errors,summary=summary),indent=2))
+assert not errors
