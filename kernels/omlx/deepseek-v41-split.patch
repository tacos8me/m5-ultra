@@ -0,0 +1,121 @@
+"""Bounded original-weight Metal encoder diagnostic; no checkpoint is written."""
+import json
+import logging
+import os
+from pathlib import Path
+import re
+import subprocess
+import sys
+import time
+
+home = Path.home()
+here = home / 'src/wt/ds41-pipe1/benchmarks/pipe1'
+# Same reference tree as split1's successful original-encoder probe.
+tree = Path(os.environ.get('PIPE1_TRACE_TREE', str(home / 'src/wt/ds41-split-wire')))
+sys.path.insert(0, str(tree))
+label = 'native-encoder-trace-8k'
+watch = subprocess.Popen(['/opt/homebrew/bin/python3', str(here / 'watch.py'),
+                          str(os.getpid()), str(here / (label + '.memory.json'))])
+logging.basicConfig(level=logging.INFO)
+import mlx.core as mx
+from omlx.patches.deepseek_v41 import language
+from omlx.patches.deepseek_v41.loading import load
+from omlx.patches.deepseek_v41.encoder_export import export_encoder_state
+from omlx.patches.deepseek_v41.prefix_cache import compact_copy, cache_arrays
+
+mx.set_wired_limit(min(245 << 30, mx.device_info()['max_recommended_working_set_size']))
+mx.set_memory_limit(230 << 30)
+mx.set_cache_limit(512 << 20)
+source = home / 'models/DeepSeek-V4.1-Flash-original'
+view = home / 'llm/ds41/pipe1/native-encoder-view'
+view.mkdir(exist_ok=True)
+raw = json.loads((source / 'config.json').read_text())
+cfg = raw.get('text_config', raw)
+cfg['num_hidden_layers'] = 21
+cfg['n_layers'] = 21
+cfg['num_nextn_predict_layers'] = 0
+cfg['n_mtp_layers'] = 0
+cfg['dspark_block_size'] = 0
+cfg['dspark_target_layer_ids'] = []
+raw.pop('vision_config', None)
+mapping = json.loads((source / 'model.safetensors.index.json').read_text())['weight_map']
+def keep(key):
+    if key.endswith('.bias_vl'):
+        return False  # Vision routing bias is not part of a text-only model.
+    match = re.match(r'layers\.(\d+)\.', key)
+    return int(match[1]) <= 20 if match else key in ('embed.weight', 'head.weight', 'norm.weight')
+mapping = {k: v for k, v in mapping.items() if keep(k)}
+(view / 'config.json').write_text(json.dumps(raw))
+(view / 'model.safetensors.index.json').write_text(json.dumps({'weight_map': mapping}))
+for name in set(mapping.values()) | {'tokenizer.json', 'tokenizer_config.json'}:
+    dst = view / name
+    if not dst.exists():
+        dst.symlink_to(source / name)
+started = time.monotonic()
+model, processor = load(view, engram_ssd_offload=True, preserve_mtp=False)
+lm = model.language_model
+print(json.dumps(dict(event='loaded', seconds=time.monotonic()-started,
+                      active_gib=mx.get_active_memory()/2**30)), flush=True)
+fixture = home / 'llm/ds41/split-nv/states/mine-8192.safetensors'
+arrays, metadata = mx.load(str(fixture), return_metadata=True)
+tokens = arrays['tokens'].tolist()
+del arrays
+assert 8192 <= len(tokens) < 8300
+tails = []
+trace = {}
+trace_start = len(tokens)-1-8
+current = {'layer': 0, 'start': 0, 'rows': 0}
+def record(key, x):
+    if current['start'] + current['rows'] <= trace_start:
+        return
+    take = min(current['rows'], current['start'] + current['rows'] - trace_start)
+    trace[key] = compact_copy(x[:, -take:])
+
+attn_call = language.Attention.__call__
+def attention(self, x, *a, **kw):
+    i = self._layer
+    record(f'{i}.input_layernorm', x)
+    out = attn_call(self, x, *a, **kw)
+    record(f'{i}.self_attn', out)
+    return out
+language.Attention.__call__ = attention
+moe_call = language.MoE.__call__
+def moe(self, x, *a, **kw):
+    i = current['layer']
+    record(f'{i}.post_attention_layernorm', x)
+    record(f'{i}.mlp.gate', x.astype(mx.float32) @ self.gate.weight.astype(mx.float32).T)
+    out = moe_call(self, x, *a, **kw)
+    record(f'{i}.mlp', out)
+    return out
+language.MoE.__call__ = moe
+
+call = language.Block.__call__
+def capture(self, h, pre, cache, shared, start, image_mask, *a, **kw):
+    current.update(layer=self.attn._layer, start=start, rows=h.shape[1])
+    record(str(self.attn._layer), h)
+    record(f'{self.attn._layer}.pre', pre)
+    if self.attn._layer == 20:
+        k = min(256, h.shape[1])
+        tails.append((compact_copy(h[:, -k:]), compact_copy(pre[:, -k:])))
+        if h.shape[1] > 128:
+            kw['ced_tail'] = 128
+    return call(self, h, pre, cache, shared, start, image_mask, *a, **kw)
+language.Block.__call__ = capture
+cache = lm.make_cache()
+for start in range(0, len(tokens)-1, 8192):
+    ids = mx.array(tokens[start:min(start+8192, len(tokens)-1)], mx.uint32)[None]
+    lm.prefetch_ple(ids, mx.zeros((1, 0), mx.uint32))
+    logits = lm._forward(ids, cache=cache)
+    mx.eval(cache_arrays(cache), tails, trace)
+    del logits
+    mx.clear_cache()
+    print(json.dumps(dict(event='chunk', start=start, rows=ids.shape[1],
+                          active_gib=mx.get_active_memory()/2**30)), flush=True)
+hidden = mx.concatenate([x[0] for x in tails], axis=1)[:, -256:]
+pre = mx.concatenate([x[1] for x in tails], axis=1)[:, -256:]
+manifest = export_encoder_state(here / (label+'.safetensors'), cache, tokens, hidden, pre,
+                                identity='mac:original-native:enc0-20')
+print(json.dumps(dict(event='complete', manifest=manifest, seconds=time.monotonic()-started,
+                      peak_gib=mx.get_peak_memory()/2**30)), flush=True)
+mx.save_safetensors(str(here / (label+'.trace.safetensors')), trace)
+model.close()
