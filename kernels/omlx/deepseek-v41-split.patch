@@ -0,0 +1,62 @@
+"""Bounded SSV prototype: union decode, row-slot map, unchanged per-row reduction."""
+from functools import cache
+import mlx.core as mx
+from omlx.patches.deepseek_v41 import kernels as k
+
+@cache
+def union_kernel():
+ return mx.fast.metal_kernel(name='ds41_ssv_union',input_names=['window','pooled','keys','order','meta'],output_names=['decoded','rowmap'],header=k._HEADER,source=r'''
+ const uint slot=threadgroup_position_in_grid.x, lane=thread_index_in_threadgroup;
+ const uint original=order[slot]; const int key=keys[original];
+ const uint N=meta[0], NW=meta[1];
+ uint lo=0, hi=slot;
+ while(lo<hi){uint mid=(lo+hi)/2; if(keys[order[mid]]<key)lo=mid+1;else hi=mid;}
+ if(lane==0)rowmap[original]=lo;
+ if(slot!=lo || key<0)return;
+ const bool compressed=key>=int(NW);const uint row=compressed?key-NW:key;
+ const uint first=lane*16;
+ float values[16];
+ if(compressed){
+  const size_t base=size_t(row)*288;
+  const uint2 packed=*(const device uint2*)(pooled+base+first/2);
+  const float scale=v41_fp8_bits(pooled[base+256+first/16]);
+  for(int v=0;v<16;++v){
+   const uint byte=((v<8?packed.x:packed.y)>>(8*((v/2)%4)))&255u;
+   const uchar code=uchar((byte>>((v%2)*4))&15u);
+   values[v]=v41_fp4_lut(code)*scale;
+  }
+ }else{
+  const size_t base=size_t(row)*528;
+  const uint4 packed=*(const device uint4*)(window+base+first);
+  const int e=int(window[base+512+first/32])-127;
+  if(e>=-117 && e<=118){
+   const float scale=as_type<float>(uint(e+127)<<23);
+   for(int v=0;v<16;++v)values[v]=v41_fp8_bits(uchar((packed[v/4]>>(8*(v%4)))&255u))*scale;
+  }else{
+   for(int v=0;v<16;++v)values[v]=ldexp(v41_fp8_bits(uchar((packed[v/4]>>(8*(v%4)))&255u)),e);
+  }
+ }
+ for(int v=0;v<16;++v)decoded[size_t(slot)*512+first+v]=values[v];
+ ''')
+
+@cache
+def attention_kernel():
+ src=k._ATTENTION_FASTDEC
+ first=src.index('        if (compressed) {',src.index('float values[D / 32]'))
+ last=src.index('        const float score',first)
+ src=src[:first]+r'''
+        const uint map=rowmap[query*(W+C)+j];
+        for(int v=0;v<D/32;++v){
+            const float value=decoded[size_t(map)*D+first+v];
+            values[v]=value; dot+=query_values[v]*value;
+        }
+'''+src[last:]
+ return mx.fast.metal_kernel(name='ds41_ssv_attention',input_names=['q','decoded','rowmap','wi','ci','meta','scalep'],output_names=['partial'],source=src,header=k._HEADER)
+
+def attention(q,window,pooled,wi,ci,sink,scale):
+ _,L,H,D=q.shape;W=wi.shape[-1];C=ci.shape[-1];NW=window.shape[1];N=L*(W+C);S=(W+C+31)//32
+ keys=mx.concatenate([wi,mx.where(ci>=0,ci+NW,-1)],axis=-1).reshape(-1).astype(mx.int32)
+ order=mx.argsort(keys).astype(mx.uint32)
+ decoded,rowmap=union_kernel()(inputs=[window,pooled,keys,order,mx.array([N,NW],mx.uint32)],grid=(N*32,1,1),threadgroup=(32,1,1),output_shapes=[(N,D),(N,)],output_dtypes=[mx.float32,mx.uint32])
+ partial=attention_kernel()(inputs=[q,decoded,rowmap,wi.astype(mx.int32),ci.astype(mx.int32),mx.array([H,W,C,NW,pooled.shape[1],S],mx.int32),mx.array([scale])],template=[('D',D),('CHUNK',32)],grid=((H+3)//4*128,L,S),threadgroup=(128,1,1),output_shapes=[(1,L,H,S,D+2)],output_dtypes=[mx.float32])[0]
+ return k._kernel('merge')(inputs=[partial,sink,mx.array([H,S],mx.int32)],template=[('D',D),('T',q.dtype)],grid=((H+3)//4*128,L,1),threadgroup=(128,1,1),output_shapes=[q.shape],output_dtypes=[q.dtype])[0]
