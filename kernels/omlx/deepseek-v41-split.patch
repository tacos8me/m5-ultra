new file mode 100644
index 00000000..8f3b8054
--- /dev/null
+++ b/benchmarks/pipe1/report_quality.py
@@ -0,0 +1,59 @@
+"""Score the completed phase3 gate. Refuse partial or duplicate observations."""
+import argparse
+import json
+from pathlib import Path
+import sys
+import numpy as np
+
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument('records');ap.add_argument('--scores',required=True)
+    args=ap.parse_args()
+    root=Path.home()/'llm/ds41/split1'
+    sys.path.insert(0,str(root))
+    from quality_math import compare_logits
+    from transformers import PreTrainedTokenizerFast
+    tok=PreTrainedTokenizerFast.from_pretrained(Path.home()/'models/DeepSeek-V4.1-Flash-pipe1-mlx')
+    records=[json.loads(x) for x in Path(args.records).read_text().splitlines()]
+    inputs={json.loads(p.read_text())['case']:json.loads(p.read_text()) for p in (root/'quality-inputs').glob('*.input.json')}
+    greedy=[x for x in records if x['kind']=='greedy']
+    if len(greedy)!=len(inputs) or {x['case'] for x in greedy}!=set(inputs):raise ValueError('Incomplete/duplicate greedy cases')
+    scores=[x for x in records if x['kind']=='score']
+    expected={p.name.removesuffix('.meta.json')+'.npy' for p in (root/'quality-logits').glob('*.meta.json')}
+    if len(scores)!=len(expected) or {x['name'] for x in scores}!=expected:raise ValueError('Incomplete/duplicate logit cases')
+    detail=[];kl=[];rnll=[];cnll=[];matches=total=0;accepted=proposed=0
+    mixed_accepted=mixed_proposed=0;mixed_kl=[]
+    for r in greedy:
+        case=r['case'];stem=inputs[case]['prompt_sha256']
+        ref=json.loads((root/'quality-reference'/(stem+'.tokens.json')).read_text())
+        got=r['result']['tokens']
+        if not case.startswith('reference-'):
+            total+=1;matches+=tok.decode(ref)==tok.decode(got)
+            mixed_accepted+=r['result']['summary']['dspark_accepted']
+            mixed_proposed+=r['result']['summary']['dspark_proposed']
+        detail.append(dict(case=case,ids_equal=ref==got,text_equal=tok.decode(ref)==tok.decode(got),
+                           reference_tokens=len(ref),candidate_tokens=len(got)))
+        accepted+=r['result']['summary']['dspark_accepted'];proposed+=r['result']['summary']['dspark_proposed']
+    for r in scores:
+        name=r['name'];refpath=root/'quality-logits'/name
+        meta=json.loads(refpath.with_suffix('.meta.json').read_text())
+        p=np.load(refpath,mmap_mode='r');q=np.load(Path(args.scores)/name,mmap_mode='r')
+        result=compare_logits(p,q,meta['target_ids'])
+        if '.source.' in name:
+            rnll.extend(result['reference_nll_per_token']);cnll.extend(result['candidate_nll_per_token'])
+        else:
+            kl.extend(result['kl_per_token'])
+            if not r['case'].startswith('reference-'):mixed_kl.extend(result['kl_per_token'])
+        detail.append(dict(case=r['case'],file=name,mean_kl=float(np.mean(result['kl_per_token'])),
+                           max_logit_diff=result['max_abs_logit_diff'],argmax_match=float(np.mean(result['argmax_equal_per_token']))))
+    report=dict(mixed_text_match=[matches,total],mean_kl=float(np.mean(kl)),max_token_kl=float(np.max(kl)),
+                mixed_mean_kl=float(np.mean(mixed_kl)),mixed_kl_positions=len(mixed_kl),
+                mixed_dspark_accepted=mixed_accepted,mixed_dspark_all_proposed=mixed_proposed,
+                mixed_dspark_acceptance=mixed_accepted/max(mixed_proposed,1),
+                reference_nll=float(np.mean(rnll)),candidate_nll=float(np.mean(cnll)),
+                nll_delta=float(np.mean(cnll)-np.mean(rnll)),reference_ppl=float(np.exp(np.mean(rnll))),
+                candidate_ppl=float(np.exp(np.mean(cnll))),dspark_acceptance=accepted/max(proposed,1),
+                dspark_accepted=accepted,dspark_all_proposed=proposed,detail=detail)
+    out=Path(args.records).with_suffix('.quality.json');out.write_text(json.dumps(report,indent=2)+'\n')
+    print(json.dumps({k:v for k,v in report.items() if k!='detail'}))
+
+if __name__=='__main__':main()
