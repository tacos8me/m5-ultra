@@ -0,0 +1,89 @@
+"""Warm HTTP measurements and phase3 quality runs against frozen Mac references."""
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import hashlib
+import json
+from pathlib import Path
+import time
+import urllib.request
+
+HERE=Path(__file__).parent
+BASE='http://127.0.0.1:12143'
+SPLIT=Path.home()/'llm/ds41/split1'
+
+
+def request(body,endpoint='/generate'):
+    data=json.dumps(body).encode()
+    start=time.perf_counter();first=last=None;tokens=[];summary=None
+    with urllib.request.urlopen(urllib.request.Request(BASE+endpoint,data,{'Content-Type':'application/json'}),timeout=780) as r:
+        for line in r:
+            event=json.loads(line)
+            if event['event']=='error':raise RuntimeError(event['error'])
+            if event['event']=='tokens':
+                now=time.perf_counter();first=first or now;last=now;tokens.extend(event['tokens'])
+            if event['event']=='summary':summary=event
+    if summary is None:raise ValueError('Response has no completion summary')
+    elapsed=time.perf_counter()-start
+    return dict(tokens=tokens,ttft_s=None if first is None else first-start,total_s=elapsed,
+                first_at=first,last_at=last,
+                decode_tok_s=(len(tokens)-1)/(last-first) if first is not None and last>first else None,
+                summary=summary)
+
+
+def inputs():
+    return [(p,json.loads(p.read_text())) for p in sorted((SPLIT/'quality-inputs').glob('*.input.json'))]
+
+
+def main():
+    p=argparse.ArgumentParser();p.add_argument('mode',choices=['smoke','quality','bench','needle128','needle1m'])
+    p.add_argument('--label',required=True);args=p.parse_args()
+    out=(HERE/(args.label+'.jsonl')).open('w')
+    def emit(record):out.write(json.dumps(record)+'\n');out.flush();print(json.dumps({k:v for k,v in record.items() if k not in ('result',)}),flush=True)
+    records=inputs()
+    warm=next(x for _,x in records if x['case']=='json')
+    result=request(dict(tokens=warm['prompt_ids'],max_tokens=32,request_id='warmup'))
+    emit(dict(kind='warmup',case=warm['case'],result=result))
+    if args.mode=='smoke':
+        for _,item in records[:3]:
+            result=request(dict(tokens=item['prompt_ids'],max_tokens=64,request_id=item['case']))
+            emit(dict(kind='smoke',case=item['case'],result=result))
+    elif args.mode=='quality':
+        cases={x['id']:x for name in ('mixed.cases.json','reference.cases.json')
+               for x in json.loads((SPLIT/name).read_text())}
+        for _,item in records:
+            stem=item['prompt_sha256'];case=item['case']
+            if case.startswith('needle'):continue
+            result=request(dict(tokens=item['prompt_ids'],max_tokens=cases[case]['max_tokens'],request_id=case))
+            emit(dict(kind='greedy',case=case,prompt_sha256=stem,result=result))
+            for meta_path in sorted((SPLIT/'quality-logits').glob(stem+'.*.meta.json')):
+                meta=json.loads(meta_path.read_text())
+                name=meta_path.name.removesuffix('.meta.json')+'.npy'
+                result=request(dict(tokens=item['prompt_ids'],targets=meta['target_ids'],name=name,request_id=case),'/score')
+                emit(dict(kind='score',case=case,name=name,result=result))
+    elif args.mode.startswith('needle'):
+        wanted=1048497 if args.mode=='needle1m' else 131072
+        pool=[]
+        for path in (SPLIT/'quality-reference').glob('*.input.json'):
+            item=json.loads(path.read_text())
+            if str(item.get('case','')).startswith('needle'):pool.append(item)
+        item=min(pool,key=lambda x:abs(len(x['prompt_ids'])-wanted))
+        result=request(dict(tokens=item['prompt_ids'],max_tokens=64,request_id=item['case']))
+        emit(dict(kind='needle',case=item['case'],prompt_tokens=len(item['prompt_ids']),result=result))
+    else:
+        # The same frozen real-code prompts used by split-wire's warm HTTP legs.
+        root=Path.home()/'llm/ds41/split-wire'
+        for n in (8192,131072,524288):
+            tokens=json.loads((root/f'ids-{n}.json').read_text())
+            if isinstance(tokens,dict):tokens=tokens['prompt_ids']
+            for rep in range(3):
+                result=request(dict(tokens=tokens,max_tokens=256,request_id=f'c1-{n}-{rep}',ignore_eos=True))
+                emit(dict(kind='bench',concurrency=1,n=len(tokens),rep=rep,result=result))
+            start=time.perf_counter()
+            with ThreadPoolExecutor(2) as pool:
+                pair=list(pool.map(lambda i:request(dict(tokens=tokens,max_tokens=256,request_id=f'c2-{n}-{i}',ignore_eos=True)),range(2)))
+            span=max(x['last_at'] for x in pair)-min(x['first_at'] for x in pair)
+            emit(dict(kind='bench',concurrency=2,n=len(tokens),pair=pair,total_s=time.perf_counter()-start,
+                      decode_total_tok_s=(sum(len(x['tokens']) for x in pair)-2)/span))
+
+
+if __name__=='__main__':main()
diff --git a/benchmarks/pipe1/convert_native.py b/benchmarks/pipe1/convert_native.py
new file mode 100644
index 00000000..6527ba74
--- /dev/null
+++ b/benchmarks/pipe1/convert_native.py
@@ -0,0 +1,224 @@
+"""CPU-only, bounded-memory extraction of original DS41 decoder weights.
+
+No requantization: packed expert/FP8 value bytes remain unchanged. FP8 UE8M0
+block scales are replicated onto MLX's row/group32 layout. wo_a is decoded to
+BF16 exactly, as required by the served grouped output projection.
+"""
+import argparse
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import shutil
+import struct
+
+import numpy as np
+
+SIZES = {"F32": 4, "BF16": 2, "F16": 2, "I8": 1, "U8": 1,
+         "F8_E8M0": 1, "F8_E4M3": 1, "U32": 4}
+
+
+def header(path):
+    with open(path, "rb") as f:
+        size = struct.unpack("<Q", f.read(8))[0]
+        return json.loads(f.read(size)), size + 8
+
+
+def selected(key):
+    m = re.match(r"layers\.(\d+)\.", key)
+    return bool(m and 20 <= int(m[1]) < 40) or key.startswith("mtp.") or key in (
+        "embed.weight", "head.weight", "norm.weight")
+
+
+def fp8_values(raw):
+    x = raw.astype(np.uint8)
+    exponent, mantissa = (x >> 3) & 15, x & 7
+    out = np.ldexp(np.where(exponent == 0, mantissa, 8 + mantissa).astype(np.float32),
+                   np.where(exponent == 0, -9, exponent.astype(np.int32) - 10))
+    out = np.copysign(out, np.where(x & 128, -1., 1.))
+    if np.any((x & 127) == 127):
+        raise ValueError("NaN FP8 weight")
+    return out.astype(np.float32)
+
+
+class Source:
+    def __init__(self, root):
+        self.root = Path(root)
+        self.config = json.loads((self.root / "config.json").read_text())
+        index = json.loads((self.root / "model.safetensors.index.json").read_text())["weight_map"]
+        self.entries = {}
+        for filename in dict.fromkeys(v for k, v in index.items() if selected(k)):
+            h, offset = header(self.root / filename)
+            for key, entry in h.items():
+                if key != "__metadata__" and selected(key):
+                    assert index[key] == filename
+                    self.entries[key] = (filename, offset, entry)
+
+    def read(self, key):
+        filename, offset, entry = self.entries[key]
+        a, b = entry["data_offsets"]
+        with open(self.root / filename, "rb") as f:
+            f.seek(offset + a)
+            raw = f.read(b - a)
+        if len(raw) != b - a:
+            raise ValueError("Truncated input: " + key)
+        return raw
+
+    def array(self, key):
+        entry = self.entries[key][2]
+        return np.frombuffer(self.read(key), np.uint8).reshape(entry["shape"])
+
+
+def plan(source):
+    """Each output is a list of source pieces, shape, dtype, transform."""
+    groups, specs = {}, {}
+    for key, (_, _, entry) in source.entries.items():
+        if key.endswith(".scale"):
+            continue
+        match = re.match(r"((?:layers|mtp)\.\d+\.ffn\.experts)\.(\d+)\.(w[123])\.weight$", key)
+        output = key if not match else f"{match[1]}.{match[3]}.weight"
+        output = "language_model." + output
+        dtype, shape = entry["dtype"], entry["shape"]
+        transform = "copy"
+        scale_key = key.removesuffix(".weight") + ".scale"
+        scale = source.entries.get(scale_key)
+        if dtype in ("I8", "F8_E4M3"):
+            if not scale or scale[2]["dtype"] != "F8_E8M0":
+                raise ValueError("Missing UE8M0 scale: " + key)
+            rows, cols = shape
+            sr, sc = scale[2]["shape"]
+            bits = 4 if dtype == "I8" else 8
+            width = cols * 8 // bits
+            if dtype == "I8" and (sr, sc) != (rows, width // 32):
+                raise ValueError("Unexpected FP4 layout")
+            if dtype == "F8_E4M3" and (rows % sr or width % sc or width // sc not in (32, 128)):
+                raise ValueError("Unexpected FP8 block layout")
+            dense = key.endswith(("wo_a.weight", ".markov_head.embed.weight", ".markov_head.head.weight"))
+            if dense:
+                dtype, shape, transform = "BF16", [rows, width], "dense"
+            else:
+                dtype, shape = "U32", [rows, cols // 4]
+                prefix = output.removesuffix(".weight")
+                specs[prefix] = {"bits": bits, "mode": f"mxfp{bits}", "group_size": 32}
+                sout = prefix + ".scales"
+                groups.setdefault(sout, []).append((scale_key, "U8", [rows, width // 32], "scale", key))
+        groups.setdefault(output, []).append((key, dtype, shape, transform, scale_key))
+    result = {}
+    for key, pieces in groups.items():
+        pieces.sort(key=lambda p: int(p[0].split(".experts.")[1].split(".")[0]) if ".experts." in p[0] else 0)
+        dtype, shape = pieces[0][1:3]
+        if any(p[1:3] != (dtype, shape) for p in pieces):
+            raise ValueError("Mixed projection pieces")
+        if ".experts." in key:
+            expected = 128 if key.startswith("language_model.mtp.") else 384
+            if len(pieces) != expected:
+                raise ValueError("Missing expert")
+            shape = [expected, *shape]
+        result[key] = dict(dtype=dtype, shape=shape, pieces=pieces,
+                           bytes=math.prod(shape) * SIZES[dtype])
+    return result, specs
+
+
+def piece_bytes(source, piece):
+    key, dtype, shape, transform, sibling = piece
+    if transform == "copy":
+        return source.read(key)
+    if transform == "scale":
+        scales = source.array(key)
+        if np.any(scales == 255):
+            raise ValueError("NaN scale: " + key)
+        rows, groups = shape
+        return np.repeat(np.repeat(scales, rows // scales.shape[0], 0),
+                         groups // scales.shape[1], 1).tobytes()
+    if transform == "dense":
+        raw, scales = source.array(key), source.array(sibling)
+        if np.any(scales == 255):
+            raise ValueError("NaN scale: " + sibling)
+        row_block = raw.shape[0] // scales.shape[0]
+        col_block = raw.shape[1] // scales.shape[1]
+        output = np.empty(raw.shape, '<u2')
+        for a in range(0, raw.shape[0], row_block):
+            exponent = np.repeat(scales[a // row_block], col_block).astype(np.int32) - 127
+            values = np.ldexp(fp8_values(raw[a:a+row_block]), exponent[None])
+            bits = values.view(np.uint32)
+            if np.any(bits & 65535) or not np.all(np.isfinite(values)):
+                raise ValueError("BF16 output is not lossless: " + key)
+            output[a:a+row_block] = (bits >> 16).astype('<u2')
+        return output.tobytes()
+    raise ValueError(transform)
+
+
+def convert(source, destination, outputs, specs):
+    destination = Path(destination)
+    if destination.exists():
+        raise FileExistsError(destination)
+    need = sum(v["bytes"] for v in outputs.values())
+    if shutil.disk_usage(destination.parent).free < need + 12 * 2**30:
+        raise ValueError("Insufficient disk: retain 12 GiB free")
+    destination.mkdir()
+    marker = destination / "conversion.inprogress.json"
+    marker.write_text(json.dumps({"bytes": need}))
+    batches = {}
+    for key, entry in outputs.items():
+        parts = key.split(".")
+        batch = ".".join(parts[1:3]) if parts[1] in ("layers", "mtp") else parts[1]
+        batches.setdefault(batch, {})[key] = entry
+    mapping, receipts = {}, {}
+    for number, (batch, entries) in enumerate(sorted(batches.items())):
+        name = f"model-{number+1:05d}-of-{len(batches):05d}.safetensors"
+        h, offset = {"__metadata__": {"format": "mlx"}}, 0
+        for key, entry in sorted(entries.items()):
+            h[key] = dict(dtype=entry["dtype"], shape=entry["shape"], data_offsets=[offset, offset+entry["bytes"]])
+            offset += entry["bytes"]
+        raw = json.dumps(h, separators=(",", ":")).encode()
+        raw += b" " * (-len(raw) % 8)
+        partial = destination / (name + ".partial")
+        with partial.open("wb") as f:
+            f.write(struct.pack("<Q", len(raw))); f.write(raw)
+            for key, entry in sorted(entries.items()):
+                digest, count = hashlib.sha256(), 0
+                for piece in entry["pieces"]:
+                    data = piece_bytes(source, piece)
+                    digest.update(data); f.write(data); count += len(data)
+                if count != entry["bytes"]:
+                    raise ValueError("Wrong output size: " + key)
+                receipts[key] = {"bytes": count, "sha256": digest.hexdigest(), "pieces": len(entry["pieces"])}
+                mapping[key] = name
+            f.flush(); os.fsync(f.fileno())
+        partial.rename(destination / name)
+        print(json.dumps({"shard": name, "group": batch, "bytes": offset}), flush=True)
+    config = source.config.copy()
+    config.pop("quantization_config", None)
+    # Keep vision metadata: it declares the original router bias_vl tensors.
+    # DecoderContainer constructs no vision modules or image processing path.
+    config["omlx_deepseek_v41"] = dict(version=1, quantized_modules=specs, engram_tables={}, preserve_mtp=True)
+    config["pipe1"] = dict(version=1, first_layer=20, end_layer=40, source="DeepSeek-V4.1-Flash-original",
+                           precision="original FP4/FP8/BF16/F32; byte-preserving MX repack", tensor_bytes=need)
+    for name in ("tokenizer.json", "tokenizer_config.json", "LICENSE"):
+        shutil.copyfile(source.root / name, destination / name)
+    (destination / "config.json").write_text(json.dumps(config, indent=2)+"\n")
+    (destination / "model.safetensors.index.json").write_text(json.dumps({"weight_map": mapping}, indent=2)+"\n")
+    (destination / "conversion-receipt.json").write_text(json.dumps(receipts, indent=2)+"\n")
+    marker.unlink()
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("source"); p.add_argument("--output"); p.add_argument("--plan-json")
+    args = p.parse_args()
+    source = Source(args.source)
+    outputs, specs = plan(source)
+    summary = dict(tensors=len(outputs), modules=len(specs), bytes=sum(x["bytes"] for x in outputs.values()),
+                   source_block=source.config["quantization_config"]["weight_block_size"],
+                   shard_max_bytes=max(sum(e["bytes"] for k,e in outputs.items() if k.startswith("language_model.layers."+str(i)+".")) for i in range(20,40)))
+    print(json.dumps(summary), flush=True)
+    if args.plan_json:
+        Path(args.plan_json).write_text(json.dumps(summary, indent=2)+"\n")
+    if args.output:
+        convert(source, args.output, outputs, specs)
+
+
+if __name__ == "__main__":
+    main()
