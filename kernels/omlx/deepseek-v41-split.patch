@@ -0,0 +1,158 @@
+"""Depth-agent harness bits: served flags, in-process memory guard (SIGKILL), GPU timestamps,
+model load, the 8K code prompt and synthetic deep caches. Run under lockf -k gpu.lock."""
+import ctypes, json, os, signal, threading, time
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+GT = None
+if os.environ.get('GPUTIME', '1') == '1':
+    GT = ctypes.CDLL(str(HERE / 'libgputime3.dylib'))
+    GT.gt_start.restype = ctypes.c_double
+    GT.gt_end.restype = ctypes.c_double
+    GT.gt_name.restype = ctypes.c_char_p
+    GT.gt_last_pso.restype = ctypes.c_char_p
+
+os.environ.update(MLX_ENABLE_TF32='0', DS41_MHC='1', DS41_GROWTH='1', DS41_GATHER='1', DS41_INDEX_NAX='1',
+                  DS41_SPARSE='1', DS41_NATIVE_DECODE='1', DS41_NATIVE_VERIFY='0', DS41_PREFILL_CHUNK='8192')
+import mlx.core as mx
+from omlx.utils import proc_memory
+from omlx.utils.proc_memory import get_phys_footprint, get_lifetime_max_phys_footprint
+
+CKPT = Path.home() / 'models/DeepSeek-V4.1-Flash-ds41-q3g128-lsq-q8-ssd-original'
+OUT = HERE
+LIMIT = float(os.environ.get('GUARD_GIB', '240')) * 1024**3
+state = {'max_rss': 0}
+
+
+def rss():
+    info = proc_memory._RusageInfoV4()
+    if proc_memory._proc_pid_rusage(os.getpid(), 4, ctypes.byref(info)):
+        return 0
+    return int(info.ri_resident_size)
+
+
+def guard_loop():
+    while True:
+        r, f = rss(), get_phys_footprint()
+        state['max_rss'] = max(state['max_rss'], r)
+        if r > LIMIT or f > LIMIT:
+            print(f'SAFETY STOP footprint {f/2**30:.2f} rss {r/2**30:.2f} GiB', flush=True)
+            os.kill(os.getpid(), signal.SIGKILL)
+        time.sleep(.05)
+
+
+def setup_memory():
+    mx.set_wired_limit(min(mx.device_info()['max_recommended_working_set_size'], 240 * 1024**3))
+    mx.set_memory_limit(234 * 1024**3)
+    mx.set_cache_limit(512 * 1024**2)
+    threading.Thread(target=guard_loop, daemon=True).start()
+    import subprocess
+    subprocess.Popen(['/opt/homebrew/bin/python3', str(Path.home() / 'llm/qwen38/fpwatch.py'), str(os.getpid()),
+                      os.environ.get('FPWATCH_GIB', '242'), str(OUT / 'fpwatch.log')])
+
+
+def load_full():
+    from omlx.patches.mlx_lm_mtp import set_mtp_active, set_mtp_depth
+    set_mtp_active(True)
+    set_mtp_depth(4)
+    from omlx.patches.deepseek_v41.loading import load
+    t = time.perf_counter()
+    model, processor = load(CKPT, engram_ssd_offload=True, ced_prefill=True)
+    return model, processor, time.perf_counter() - t
+
+
+def emit(log, **kw):
+    kw['t'] = round(time.time(), 1)
+    line = json.dumps(kw)
+    print(line, flush=True)
+    if log is not None:
+        log.write(line + '\n')
+        log.flush()
+
+
+def mem():
+    return dict(foot_GiB=round(get_phys_footprint() / 2**30, 2),
+                max_foot_GiB=round(get_lifetime_max_phys_footprint() / 2**30, 2),
+                max_rss_GiB=round(state['max_rss'] / 2**30, 2))
+
+
+def corpus_text(tok, n_tokens):
+    src = Path.home() / 'src/omlx-runtime-v070dev4/omlx/patches/deepseek_v41'
+    corpus = '\n\n'.join(f'File: {f.name}\n{f.read_text()}' for f in sorted(src.glob('*.py')))
+    for special in tok.all_special_tokens:
+        corpus = corpus.replace(special, '[special token literal]')
+    corpus = corpus.replace('｜', '|').replace('<think>', '[think tag]').replace('</think>', '[/think tag]')
+    return tok.decode(tok.encode(corpus, add_special_tokens=False)[:n_tokens])
+
+
+def code_prompt(tok, n_tokens=8000):
+    msgs = [{'role': 'user', 'content': corpus_text(tok, n_tokens) + '\n\nSummarize what this code does, file by file.'}]
+    return list(tok.apply_chat_template(msgs, add_generation_prompt=True, tokenize=True, enable_thinking=False))
+
+
+def prefill(lm, ids, chunk=8192):
+    """Scheduler-style CED prefill: fixed chunks with the Engram lookahead for the next chunk."""
+    cache = lm.make_cache()
+    arr = mx.array([ids])
+    n = len(ids)
+    lm.prefetch_ple(arr[:, :chunk], arr[:, :0])
+    for pos in range(0, n, chunk):
+        m = min(chunk, n - pos)
+        if pos + m < n:
+            lm.prefetch_ple(arr[:, pos + m:pos + m + min(chunk, n - pos - m)], arr[:, pos:pos + m])
+        lm._omlx_prefill(arr[:, pos:pos + m], cache=cache)
+        mx.eval([a for c in cache for a in c.state])
+    return cache
+
+
+def snapshot(cache):
+    return [list(item.cache) for item in cache]
+
+
+def deep_cache(lm, base, extra):
+    """Timing proxy: prepend `extra` tokens' worth of compressed KV / index keys (tiled real rows) to a
+    real cache and move every offset. Kernels see the right key counts and positions; values are copies."""
+    assert extra % 16 == 0
+    cache = lm.make_cache()
+    for item, arrays in zip(cache, base):
+        arrays = list(arrays)
+        arrays[0] = mx.array([int(arrays[0].item()) + extra], mx.int32)
+        ratio = item.compress_ratio
+        if ratio and extra:
+            for slot in (2, 3):
+                a = arrays[slot]
+                need = extra // ratio
+                reps = -(-need // a.shape[1])
+                arrays[slot] = mx.concatenate([mx.tile(a, (1, reps, 1))[:, :need], a], 1)
+        item.cache = arrays
+    mx.eval([a for it in cache for a in it.cache if a is not None])
+    return cache
+
+
+def gt_begin():
+    mx.synchronize()
+    GT.gt_reset()
+    GT.gt_enable(1)
+
+
+def gt_end(t0):
+    mx.synchronize()
+    GT.gt_enable(0)
+    n = GT.gt_count()
+    recs = sorted((GT.gt_start(i), GT.gt_end(i), GT.gt_name(i).decode(errors='replace')) for i in range(n))
+    busy, cur_s, cur_e = 0.0, None, None
+    for s, e, _ in recs:
+        if cur_e is None or s > cur_e:
+            if cur_e is not None:
+                busy += cur_e - cur_s
+            cur_s, cur_e = s, e
+        else:
+            cur_e = max(cur_e, e)
+    if cur_e is not None:
+        busy += cur_e - cur_s
+    return recs, busy
+
+
+def median(xs):
+    xs = sorted(xs)
+    return xs[len(xs) // 2]
