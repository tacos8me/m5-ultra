+++ b/benchmarks/ds41_sprint3_eviction/http_bench.py
@@ -0,0 +1,42 @@
+import json,os,sys,time,urllib.request,hashlib,concurrent.futures
+from pathlib import Path
+from transformers import AutoTokenizer
+A=Path(__file__).resolve().parent;H=Path.home();label,port=sys.argv[1:3];ctx=int(sys.argv[3]) if len(sys.argv)>3 else 8192
+base='http://127.0.0.1:'+port
+log=(A/f'{label}.jsonl').open('w')
+tok=AutoTokenizer.from_pretrained(str(H/'llm/ds41/resume/models/ds41-q3g128'))
+src=H/'src/omlx-runtime-v070dev4/omlx/patches/deepseek_v41'
+text='\n\n'.join(f'File: {p.name}\n{p.read_text()}' for p in sorted(src.glob('*.py')))
+for s in tok.all_special_tokens:text=text.replace(s,'[special]')
+text=text.replace('｜','|').replace('<think>','[think]').replace('</think>','[/think]')
+ids=tok.encode(text,add_special_tokens=False);doc=f'[sprint3 cost-policy context {ctx}]\n'+tok.decode((ids*(ctx//len(ids)+1))[:ctx])
+questions=['Summarize the code above in five bullet points.','Explain how the Engram tables are used, in detail.','Describe the prefill path step by step.']
+prompts=[doc+'\n\n'+q for q in questions]
+if ctx==8192:prompts+=['Explain in detail how TCP congestion control works, covering slow start, congestion avoidance, fast retransmit and BBR.','Write a thread-safe LRU cache in Python with TTL expiry, full type hints, and pytest tests.']
+def chat(i,mode,rep,concurrency):
+ body=json.dumps(dict(model='ds41-q3g128',messages=[dict(role='user',content=prompts[i])],max_tokens=256,temperature=0,stream=True,stream_options={'include_usage':True},chat_template_kwargs={'enable_thinking':False},logprobs=True,top_logprobs=1)).encode()
+ t0=time.perf_counter();first=last=None;usage=None;parts=[];probs=[]
+ with urllib.request.urlopen(urllib.request.Request(base+'/v1/chat/completions',body,{'Content-Type':'application/json'}),timeout=700) as r:
+  for line in r:
+   if not line.startswith(b'data: ') or line.strip()==b'data: [DONE]':continue
+   d=json.loads(line[6:]);usage=d.get('usage') or usage
+   for ch in d.get('choices',[]):
+    content=ch.get('delta',{}).get('content')
+    if content:
+     now=time.perf_counter();first=first or now;last=now;parts.append(content)
+    if ch.get('logprobs'):probs.extend(ch['logprobs'].get('content',[]))
+ text=''.join(parts);rec=dict(mode=mode,rep=rep,prompt=i,ctx=ctx,c=concurrency,tokens=usage['completion_tokens'],prompt_tokens=usage['prompt_tokens'],ttft_s=first-t0,decode_tok_s=(usage['completion_tokens']-1)/(last-first),text=text,text_hash=hashlib.sha256(text.encode()).hexdigest(),logprobs_hash=hashlib.sha256(json.dumps(probs,sort_keys=True).encode()).hexdigest(),nlogprobs=len(probs))
+ return rec
+# A/B repeated after /health's full warmup; prefix reuse is intentional for decode samples.
+for rep in range(2):
+ for mode in (0,1):
+  urllib.request.urlopen(urllib.request.Request(base+f'/cost-policy/{mode}',b'',method='POST')).read()
+  for i in range(len(prompts)):
+   rec=chat(i,mode,rep,1);log.write(json.dumps(rec)+'\n');log.flush();print(json.dumps({k:v for k,v in rec.items() if k!='text'}),flush=True)
+if ctx==8192:
+ for mode in (0,1):
+  urllib.request.urlopen(urllib.request.Request(base+f'/cost-policy/{mode}',b'',method='POST')).read()
+  with concurrent.futures.ThreadPoolExecutor(2) as pool:
+   for rec in pool.map(lambda i:chat(i,mode,0,2),[0,1]):
+    log.write(json.dumps(rec)+'\n');log.flush();print(json.dumps({k:v for k,v in rec.items() if k!='text'}),flush=True)
+print(urllib.request.urlopen(base+'/cost-stats').read().decode(),flush=True)
