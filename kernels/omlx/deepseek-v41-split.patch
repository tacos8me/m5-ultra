new file mode 100644
index 00000000..9d47ee04
--- /dev/null
+++ b/benchmarks/og/host_wire.py
@@ -0,0 +1,62 @@
+"""Mac-side STEP exchange overhead (no GPU): roundtrip - box_s, payload time, per socket option set.
+
+Opens one lean box session on the 8K prompt, then STEPs 1 and 5 rows at a fixed keep (rewinds each time).
+Variants toggle per-socket options only (no sysctls). Run only while production is idle.
+"""
+import json, os, socket, statistics, sys, time
+from pathlib import Path
+sys.path.insert(0, os.environ.get('DS41_TREE', str(Path.home()/'src/wt/ds41-host')))
+from omlx.patches.deepseek_v41 import pipe_wire as pw
+
+HOME = Path.home()
+tokens = json.loads((HOME/'llm/ds41/split-wire/ids-8192.json').read_text())
+N = int(os.environ.get('WIRE_STEPS', '60'))
+variants = os.environ.get('WIRE_VARIANTS', 'base,rcvbuf,base,rcvbuf').split(',')
+SLEEP = float(os.environ.get('WIRE_SLEEP_MS', '0')) / 1000
+ADVANCE = os.environ.get('WIRE_ADVANCE', '0') == '1'
+GAP = float(os.environ.get('WIRE_GAP_MS', '0')) / 1000  # idle before each send (the Mac forward + draft)
+TCP_SENDMOREACKS = 0x10A
+
+
+def apply(sock, v):
+    if v in ('rcvbuf', 'both'):
+        sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 4 << 20)
+    if v in ('moreacks', 'both'):
+        sock.setsockopt(socket.IPPROTO_TCP, TCP_SENDMOREACKS, 1)
+    if v == 'base':
+        sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 131072)
+
+
+enc = pw.EncoderSession()
+t = time.perf_counter()
+tensors, manifest = enc.open(tokens, 'host-wire', cache=True, state='lean', stream=True)
+print(json.dumps(dict(event='open', s=round(time.perf_counter() - t, 2))), flush=True)
+keep = enc.length
+out = []
+try:
+    for v in variants:
+        apply(enc.sock, v)
+        for rows in (1, 5):
+            recs = []
+            for i in range(N + 3):
+                ids = [tokens[-1]] + [tokens[(i * 7 + j) % 8000] for j in range(rows - 1)]
+                if ADVANCE and i:
+                    keep = min(enc.length, keep + 1 + (i % rows))  # commit 1..rows rows, like accept+rollback
+                if GAP:
+                    end = time.perf_counter() + GAP
+                    while time.perf_counter() < end:
+                        pass
+                enc.send_step(ids, keep)
+                if SLEEP:
+                    time.sleep(SLEEP)
+                raw, tm = enc.recv_step()
+                if i >= 3:
+                    recs.append(tm)
+            m = lambda k: round(1000 * statistics.median(r[k] for r in recs), 3)
+            rec = dict(variant=v, advance=ADVANCE, gap_ms=GAP * 1000, rows=rows, box_ms=m('box_s'), roundtrip_ms=m('roundtrip_s'),
+                       overhead_ms=round(1000 * statistics.median(r['roundtrip_s'] - r['box_s'] for r in recs), 3),
+                       payload_ms=m('payload_s'), rcvbuf=enc.sock.getsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF))
+            print(json.dumps(rec), flush=True)
+            out.append(rec)
+finally:
+    enc.close()
diff --git a/benchmarks/og/idle_guard.py b/benchmarks/og/idle_guard.py
new file mode 100644
index 00000000..f72b031f
--- /dev/null
+++ b/benchmarks/og/idle_guard.py
@@ -0,0 +1,56 @@
+"""Run one bounded Mac partial-load experiment; terminate its PID on production traffic."""
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+import urllib.request
+
+
+def read(url):
+    with urllib.request.urlopen(url, timeout=0.5) as r:
+        return json.load(r)
+
+
+def idle():
+    h = read('http://127.0.0.1:10001/health')
+    r = read('http://127.0.0.1:8080/running')
+    return (h.get('status') == 'ok' and h.get('inflight') == 0
+            and any(m['model'] == 'ds41' and m['state'] == 'ready' for m in r['running'])), h
+
+
+ok, initial = idle()
+if not ok:
+    print('GUARD busy; skipped', flush=True)
+    sys.exit(75)
+p = subprocess.Popen(sys.argv[1:])
+print(json.dumps(dict(guard='start', pid=p.pid, health=initial)), flush=True)
+deadline = time.monotonic() + float(os.environ.get('DECODE_MAX_SECONDS', '90'))
+reason = None
+try:
+    while p.poll() is None:
+        time.sleep(.1)
+        ok, h = idle()
+        if not ok:
+            reason = {'production_not_idle': h}
+            break
+        if time.monotonic() > deadline:
+            reason = 'deadline'
+            break
+        rss = subprocess.check_output(['ps','-o','rss=','-p',str(p.pid)],text=True).strip()
+        if rss and int(rss)*1024 > 35_000_000_000:
+            reason = {'rss_limit_bytes':int(rss)*1024}
+            break
+except BaseException as e:
+    reason = repr(e)
+finally:
+    if p.poll() is None:
+        p.send_signal(signal.SIGTERM)
+        try:
+            p.wait(timeout=2)
+        except subprocess.TimeoutExpired:
+            p.kill()
+            p.wait()
+    print(json.dumps(dict(guard='end', pid=p.pid, reason=reason, returncode=p.returncode)), flush=True)
+sys.exit(75 if reason else p.returncode)
diff --git a/benchmarks/og/lease.py b/benchmarks/og/lease.py
new file mode 100644
index 00000000..00f5e711
--- /dev/null
+++ b/benchmarks/og/lease.py
@@ -0,0 +1,175 @@
+"""One guarded Mac GPU lease for the og worker.
+
+Stops the served llama-swap ds41 by its own listening PID (never a lockf
+wrapper), starts server.py through gpu-exec (the server PID owns the lock and
+the memory), waits for /health, runs the clients, then TERMs that same PID and
+waits for it to exit before returning. server.py starts its own 245 GiB/lease
+watchdog on its PID.
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import shlex
+import socket
+import subprocess
+import sys
+import time
+import urllib.error
+import urllib.request
+
+HOME = Path.home()
+HERE = Path(__file__).parent
+LOGS = Path(os.environ.get('OG_LOGS', str(HOME/'llm/ds41/og-mac')))
+PY = str(HOME/'llm/.venv-ds41-omlx-tiles/bin/python')
+SERVED = {'ds41', 'ds41-c1'}
+ENV = dict(MLX_ENABLE_TF32='0', DS41_NATIVE_VERIFY='0', DS41_MHC='1', DS41_GROWTH='1',
+           DS41_GATHER='1', DS41_INDEX_NAX='1', DS41_SPARSE='1', DS41_NATIVE_DECODE='1',
+           DS41_PREFILL_POOL_GIB='3', DS41_MTP_COST_POLICY='1', DS41_COPY_DRAFT='1')
+
+
+def box_up(host, port):
+    try:
+        with socket.create_connection((host, port), timeout=3):
+            return True
+    except OSError:
+        return False
+
+
+def _ps(pid, field):
+    return subprocess.run(['ps', '-o', field+'=', '-p', str(pid)], capture_output=True, text=True).stdout.strip()
+
+
+def stop_served(log):
+    """TERM the served llama-swap ds41 by its own PID and wait (llama-swap reloads on demand).
+
+    The PID comes from the /running proxy port's listener or, while it is still
+    loading, from the gpu.lock holder; either way it must be a direct child of
+    llama-swap running the ds41 server (gpu-exec execs in place, so this is the
+    memory owner, never a lockf wrapper).
+    """
+    with urllib.request.urlopen('http://127.0.0.1:8080/running', timeout=5) as r:
+        running = json.load(r).get('running', [])
+    swap = subprocess.run(['pgrep', '-x', 'llama-swap'], capture_output=True, text=True).stdout.split()
+    pids = set()
+    for item in running:
+        if item.get('model') not in SERVED:
+            continue
+        port = item['proxy'].rsplit(':', 1)[1]
+        pids.update(map(int, subprocess.run(['lsof', '-t', f'-iTCP:{port}', '-sTCP:LISTEN'],
+                                            capture_output=True, text=True).stdout.split()))
+    holders = subprocess.run(['lsof', '-t', str(HOME/'llm/locks/gpu.lock')], capture_output=True, text=True).stdout.split()
+    for pid in map(int, holders):
+        if _ps(pid, 'ppid') in swap and 'ds41' in _ps(pid, 'command') + ' ' + json.dumps(running):
+            pids.add(pid)
+    for pid in pids:
+        if _ps(pid, 'ppid') not in swap:
+            raise RuntimeError(f'PID {pid} is not a llama-swap child: {_ps(pid, "command")[:120]}')
+        log(dict(event='stop_served', pid=pid, command=_ps(pid, 'command')[:120]))
+        os.kill(pid, 15)
+        deadline = time.monotonic() + 120
+        while time.monotonic() < deadline:
+            if not _ps(pid, 'pid'):
+                break
+            time.sleep(.5)
+        else:
+            raise TimeoutError(f'Served PID {pid} did not exit')
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument('--label', required=True)
+    ap.add_argument('--client', action='append', default=[], help='shell command; {base} expands')
+    ap.add_argument('--port', type=int, default=12143)
+    ap.add_argument('--lease-seconds', type=int, default=780)
+    ap.add_argument('--lock-wait', type=int, default=900)
+    ap.add_argument('--server-arg', action='append', default=[])
+    ap.add_argument('--env', action='append', default=[], help='KEY=VALUE for the worker')
+    ap.add_argument('--hold', type=float, default=0, help='keep serving N s after clients (manual tests)')
+    ap.add_argument('--direct', help='run this script under gpu-exec instead of server.py (it owns its watchdog)')
+    ap.add_argument('--og-worker', action='store_true', help='run og_serve/og_server.py (omlx API) instead of server.py')
+    ap.add_argument('--no-box', action='store_true', help='Mac-only --direct script: skip the box check')
+    args = ap.parse_args()
+    LOGS.mkdir(parents=True, exist_ok=True)
+    events = (LOGS/(args.label+'.lease.jsonl')).open('a')
+    def log(record):
+        record = dict(t=time.time(), **record)
+        events.write(json.dumps(record)+'\n'); events.flush(); print(json.dumps(record), flush=True)
+    if not args.no_box and not box_up('10.10.10.1', 10052):
+        raise SystemExit('box step service 10.10.10.1:10052 is down; not starting a lease')
+    env = os.environ.copy(); env.update(ENV); env['GPU_LOCK_WAIT'] = str(args.lock_wait)
+    env.update(dict(x.split('=', 1) for x in args.env))
+    stop_served(log)
+    cmd = [str(HOME/'llm/bin/gpu-exec'), PY, '-u', str(HERE/'server.py'), '--label', args.label,
+           '--port', str(args.port), '--lease-seconds', str(args.lease_seconds), *args.server_arg]
+    if args.direct:
+        env.update(OG_LABEL=args.label, OG_LEASE=str(args.lease_seconds))
+        cmd = [str(HOME/'llm/bin/gpu-exec'), PY, '-u', str(HERE/args.direct)]
+        with (LOGS/(args.label+'.server.log')).open('a') as out:
+            proc = subprocess.Popen(cmd, env=env, stdout=out, stderr=subprocess.STDOUT)
+            log(dict(event='direct_started', pid=proc.pid, cmd=cmd))
+            try:
+                proc.wait(timeout=args.lock_wait + args.lease_seconds + 60)
+            finally:
+                if proc.poll() is None:
+                    proc.terminate()
+                    try:
+                        proc.wait(timeout=30)
+                    except subprocess.TimeoutExpired:
+                        proc.kill(); proc.wait()
+                log(dict(event='direct_stopped', pid=proc.pid, rc=proc.returncode))
+        return
+    if args.og_worker:
+        env['DS41_OG_LEASE_S'] = str(args.lease_seconds)
+        cmd = [str(HOME/'llm/bin/gpu-exec'), PY, '-u', str(HERE.parent.parent/'og_serve/og_server.py'),
+               '--host', '127.0.0.1', '--port', str(args.port)]
+    base = f'http://127.0.0.1:{args.port}'
+    with (LOGS/(args.label+'.server.log')).open('a') as out:
+        proc = subprocess.Popen(cmd, env=env, stdout=out, stderr=subprocess.STDOUT)
+        log(dict(event='server_started', pid=proc.pid, cmd=cmd))
+        try:
+            deadline = time.monotonic() + args.lock_wait + 300
+            while True:
+                if proc.poll() is not None:
+                    raise RuntimeError(f'server exited {proc.returncode}')
+                if time.monotonic() > deadline:
+                    raise TimeoutError('server did not become healthy')
+                try:
+                    with urllib.request.urlopen(base+'/health', timeout=2) as r:
+                        status = json.load(r)
+                    if args.og_worker:
+                        break
+                    if status.get('pid') != proc.pid:
+                        raise RuntimeError('port belongs to another PID')
+                    if status.get('ready'):
+                        break
+                except urllib.error.HTTPError as e:
+                    try:
+                        status = json.load(e)
+                    except ValueError:
+                        status = {}
+                    if status.get('failure'):
+                        raise RuntimeError(status['failure'])
+                except urllib.error.URLError:
+                    pass
+                time.sleep(1)
+            log(dict(event='healthy', pid=proc.pid))
+            for command in args.client:
+                command = command.format(base=base, label=args.label, logs=LOGS)
+                started = time.monotonic()
+                result = subprocess.run(command, shell=True, env=env, timeout=args.lease_seconds)
+                log(dict(event='client_done', command=command, rc=result.returncode, seconds=time.monotonic()-started))
+            if args.hold:
+                time.sleep(args.hold)
+        finally:
+            if proc.poll() is None:
+                proc.terminate()
+                try:
+                    proc.wait(timeout=30)
+                except subprocess.TimeoutExpired:
+                    proc.kill(); proc.wait()
+            log(dict(event='server_stopped', pid=proc.pid, rc=proc.returncode))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/benchmarks/og/moe_fused_bench.py b/benchmarks/og/moe_fused_bench.py
new file mode 100644
index 00000000..7115cd23
--- /dev/null
+++ b/benchmarks/og/moe_fused_bench.py
@@ -0,0 +1,168 @@
+"""Routed-MoE microbench + bitwise check, 3 real layers' experts (layers 20-22 ffn only, ~21 GB, no gpu.lock;
+run only while production is idle).
+
+Modes: prod = f56f7ffa limits (fused pair kernels for <= 5 rows, gather_qmm above); pair = fused pair kernels
+for <= 16 rows (DS41_MOE_FUSED_ROWS). Per-layer us = 60 serialized expert calls (rotating the 3 layers, forced
+routing at the measured real per-layer unions) per eval, incl. SwiGLU quant and the serializing glue.
+MOE_BENCH_OUT: jsonl path. MOE_BENCH_ROWS: comma list (default 1,2,3,4,5,6,8,10). MOE_BENCH_TESTS: check,bench.
+"""
+import json, os, statistics, sys, time
+from pathlib import Path
+
+TREE = Path(os.environ.get('DS41_TREE', str(Path.home()/'src/wt/ds41-moe')))
+sys.path.insert(0, str(TREE))
+for key, value in dict(MLX_ENABLE_TF32='0', DS41_MHC='1', DS41_GROWTH='1', DS41_GATHER='1',
+                       DS41_NATIVE_DECODE='1').items():
+    os.environ.setdefault(key, value)
+import mlx.core as mx
+import numpy as np
+
+mx.set_memory_limit(40 << 30)
+mx.set_cache_limit(512 << 20)
+from omlx.patches.deepseek_v41 import language, moe_decode
+from omlx.patches.deepseek_v41.config import ModelConfig
+from omlx.patches.deepseek_v41.loading import _load_shard, set_module
+from omlx.patches.deepseek_v41.quantization import QuantizedProjection, quantize_activation
+
+MODEL = Path.home()/'models/DeepSeek-V4.1-Flash-pipe1-mlx'
+LAYERS = (20, 21, 22)
+OUT = open(os.environ.get('MOE_BENCH_OUT', str(Path.home()/'llm/ds41/moe/bench.jsonl')), 'a')
+EXPERT = 18.80e6
+BW = 1.17e12
+# Measured real per-layer unions (REPORT.md, 8K; k=10 = two 5-row streams).
+UNION = {1: 6, 2: 10, 3: 14, 4: 17, 5: 20, 6: 25, 8: 29, 10: 37}
+UNION.update({int(k): int(v) for k, v in (kv.split(':') for kv in os.environ.get('MOE_BENCH_UNION', '').split(',') if kv)})
+
+
+assert language.glm_fast.has_symbol("deepseek_v41_grouped_expert"), "native ext missing: copy build artifacts"
+_calls = {}
+_gate_up = moe_decode.gate_up
+
+
+def _counted(*a, **kw):
+    _calls['fused'] = _calls.get('fused', 0) + 1
+    return _gate_up(*a, **kw)
+
+
+moe_decode.gate_up = _counted
+
+
+def emit(r):
+    line = json.dumps(r); OUT.write(line + '\n'); OUT.flush(); print(line, flush=True)
+
+
+def load():
+    raw = json.loads((MODEL/'config.json').read_text())
+    c = ModelConfig.from_dict(raw)
+    specs = raw['omlx_deepseek_v41']['quantized_modules']
+    wm = json.loads((MODEL/'model.safetensors.index.json').read_text())['weight_map']
+    mods = {}
+    for i in LAYERS:
+        pre = f'language_model.layers.{i}.'
+        keys = [k for k in wm if k.startswith(pre + 'ffn.') or k == pre + 'ffn_norm.weight']
+        vals = {}
+        for f in sorted({wm[k] for k in keys}):
+            v = _load_shard(MODEL/f)
+            vals.update({k[len(pre):]: v[k] for k in keys if k in v})
+            del v
+        m = language.MoE(c)
+        for name in ('experts.w1', 'experts.w2', 'experts.w3', 'shared_experts.w1', 'shared_experts.w2', 'shared_experts.w3'):
+            spec = specs[pre + 'ffn.' + name]
+            set_module(m, name, QuantizedProjection(vals['ffn.' + name + '.weight'], vals['ffn.' + name + '.scales'], **spec))
+        m.load_weights([(k[4:], v) for k, v in vals.items() if k.startswith('ffn.gate.')], strict=False)
+        mx.eval(m.parameters())
+        mods[i] = (m, vals['ffn_norm.weight'])
+        mx.clear_cache()
+    return c, mods
+
+
+def real_inputs(norm_w):
+    h = mx.load(str(Path.home()/'llm/ds41/og-speed/snap-8k/step.safetensors'))['h'][0]  # (5, 4, 5120)
+    v = h.transpose(1, 0, 2).reshape(-1, h.shape[-1]).astype(mx.float32)  # stream-major: 20 real vectors
+    v = v * mx.rsqrt((v * v).mean(-1, keepdims=True) + 1e-6)
+    return (v * norm_w.astype(mx.float32)).astype(mx.bfloat16)
+
+
+def experts_out(m, x, idx, w):
+    q = quantize_activation(x)
+    return m.experts(q[..., None, None, :], idx, w, input_quantized=True, max_grouped_tokens=16).squeeze(-2)
+
+
+def set_mode(mode):
+    moe_decode.MAX_ROWS = {'prod': 5, 'pair': 16}[mode]
+
+
+def check(c, mods, rows_list):
+    for i, (m, nw) in mods.items():
+        xs = real_inputs(nw)
+        for rows in rows_list:
+            x = xs[:rows][None]
+            idx, w = m.gate(x, None)
+            sets = [('real', idx, w)]
+            rng = np.random.default_rng(rows)
+            for u in sorted({UNION[rows], max(6, UNION[rows] // 2)}):
+                pool = rng.choice(384, u, replace=False)
+                fi = mx.array(np.array([[int(pool[(6 * j + t) % u]) for t in range(6)] for j in range(rows)], np.uint32)[None])
+                sets.append((f'forced{u}', fi, w))
+            for label, idx, w in sets:
+                set_mode('prod'); a = experts_out(m, x, idx, w); fa = m(x, None) if label == 'real' else None
+                set_mode('pair'); b = experts_out(m, x, idx, w); fb = m(x, None) if label == 'real' else None
+                mx.eval(a, b, *(t for t in (fa, fb) if t is not None))
+                d = (a.astype(mx.float32) - b.astype(mx.float32)).abs()
+                rec = dict(test='check', layer=i, rows=rows, routing=label,
+                           union=len(set(np.array(idx).reshape(-1).tolist())),
+                           bitwise=bool(mx.array_equal(a, b).item()), max_abs=float(d.max().item()),
+                           max_rel=float((d / (a.astype(mx.float32).abs() + 1e-30)).max().item()))
+                if fa is not None:
+                    rec['moe_out_bitwise'] = bool(mx.array_equal(fa, fb).item())
+                    rec['moe_out_max_abs'] = float((fa.astype(mx.float32) - fb.astype(mx.float32)).abs().max().item())
+                rec['kernel_calls'] = dict(_calls); _calls.clear()
+                emit(rec)
+
+
+def bench(c, mods, rows_list, modes, calls=60, reps=int(os.environ.get('MOE_BENCH_REPS', '6'))):
+    layers = [mods[i][0] for i in LAYERS]
+    rng = np.random.default_rng(0)
+    for rows in rows_list:
+        u = UNION[rows]
+        x = mx.random.normal((1, rows, c.dim)).astype(mx.bfloat16)
+        q = quantize_activation(x)
+        w = mx.full((1, rows, 6), 1 / 6, mx.float32)
+        idx_sets = []
+        for _ in range(calls):
+            pool = rng.choice(384, u, replace=False)
+            idx_sets.append(mx.array(np.array([[int(pool[(6 * j + t) % u]) for t in range(6)] for j in range(rows)], np.uint32)[None]))
+        mx.eval(idx_sets)
+        res = {}
+        for mode in modes:
+            set_mode(mode)
+
+            def run():
+                h = q
+                for k, ids in enumerate(idx_sets):
+                    y = layers[k % 3].experts(h[..., None, None, :], ids, w, input_quantized=True, max_grouped_tokens=16).squeeze(-2)
+                    h = quantize_activation(y.sum(-2).astype(mx.bfloat16))
+                return h
+            for _ in range(2):
+                mx.eval(run())
+            ts = []
+            for _ in range(reps):
+                t = time.perf_counter(); mx.eval(run()); ts.append(time.perf_counter() - t)
+            per = statistics.median(ts) / calls
+            res[mode] = per
+            floor = u * EXPERT / BW
+            emit(dict(test='bench', mode=mode, rows=rows, union=u, per_layer_us=round(per * 1e6, 1),
+                      floor_us=round(floor * 1e6, 1), pct_floor=round(100 * floor / per, 1), kernel_calls=dict(_calls)))
+            _calls.clear()
+        set_mode('pair')
+
+
+if __name__ == '__main__':
+    rows_list = [int(r) for r in os.environ.get('MOE_BENCH_ROWS', '1,2,3,4,5,6,8,10').split(',')]
+    t = time.time()
+    c, mods = load()
+    print('loaded', round(time.time() - t, 1), 's', round(mx.get_active_memory() / 2**30, 1), 'GiB', flush=True)
+    if 'check' in os.environ.get('MOE_BENCH_TESTS', 'check,bench'):
+        check(c, mods, rows_list)
+    if 'bench' in os.environ.get('MOE_BENCH_TESTS', 'check,bench'):
+        bench(c, mods, rows_list, os.environ.get('MOE_BENCH_MODES', 'prod,pair').split(','))
diff --git a/benchmarks/og/prof.py b/benchmarks/og/prof.py
new file mode 100644
index 00000000..763b7faa
--- /dev/null
+++ b/benchmarks/og/prof.py
@@ -0,0 +1,180 @@
+"""Mac-half step profile (run under gpu-exec via lease.py --direct). Speed only.
+
+Opens one real 8K box session, then runs fixed-width verify cycles with
+instrumentation: recv wait, host->MLX conversion, graph build, GPU eval,
+drafter; variants: blocking recv, spin recv, GPU keep-alive during the box
+wait, async_eval every N layers, and Mac-only back-to-back forwards.
+"""
+import json
+import os
+from pathlib import Path
+import select
+import statistics
+import subprocess
+import sys
+import time
+
+HOME = Path.home()
+TREE = Path(os.environ.get('DS41_TREE', str(HOME/'src/wt/ds41-og')))
+sys.path.insert(0, str(TREE))
+LOGS = Path(os.environ.get('OG_LOGS', str(HOME/'llm/ds41/og-mac')))
+label = os.environ.get('OG_LABEL', 'og-prof')
+here = Path(__file__).parent
+watch = subprocess.Popen(['/opt/homebrew/bin/python3', str(here/'watch.py'), str(os.getpid()),
+                          str(LOGS/(label+'.memory.json')), os.environ.get('OG_LEASE', '600')])
+import mlx.core as mx  # noqa: E402
+from omlx.patches.deepseek_v41.pipe_decoder import load_decoder  # noqa: E402
+from omlx.patches.deepseek_v41.pipe_session import PipelineRequest  # noqa: E402
+from omlx.patches.deepseek_v41.pipe_wire import EncoderSession, mlx_step  # noqa: E402
+from omlx.patches.deepseek_v41 import pipe_decoder  # noqa: E402
+from omlx.patches.mlx_lm_mtp.deepseek_v4_dspark import capture_prompt  # noqa: E402
+from omlx.patches.mlx_lm_mtp.copy_draft import CopyIndex  # noqa: E402
+
+mx.set_wired_limit(min(245 << 30, mx.device_info()['max_recommended_working_set_size']))
+mx.set_cache_limit(512 << 20); mx.set_memory_limit(230 << 30)
+out = (LOGS/(label+'.prof.jsonl')).open('a')
+
+
+def emit(record):
+    out.write(json.dumps(record)+'\n'); out.flush(); print(json.dumps(record), flush=True)
+
+
+model = load_decoder(HOME/'models/DeepSeek-V4.1-Flash-pipe1-mlx')
+tokens = json.loads((HOME/'llm/ds41/split-wire/ids-8192.json').read_text())
+keepalive = mx.zeros((256, 256))
+
+
+def recv(enc, mode):
+    if mode == 'spin':
+        enc.sock.setblocking(False)
+        while True:
+            r, _, _ = select.select([enc.sock], [], [], 0)
+            if r:
+                break
+        enc.sock.settimeout(30)
+    elif mode == 'gpu':
+        while True:
+            r, _, _ = select.select([enc.sock], [], [], 0.0005)
+            if r:
+                break
+            mx.eval(keepalive @ keepalive)
+    return enc.recv_step()
+
+
+def run(req, steps, mode, width):
+    """Fixed-width verify loop (drafts from DSpark at `width`, no cost policy)."""
+    rec = []
+    logits, hidden = req.forward([req.tokens[-1]])
+    capture_prompt(model, mx.array([[req.tokens[-1]]], mx.uint32), hidden, req.cache)
+    first = int(mx.argmax(logits[0, -1]).item())
+    logits, hidden = req.forward([first])
+    anchor = int(mx.argmax(logits[0, -1]).item())
+    req.mtp_cache, _ = model.mtp_take_primed(req.cache, first)
+    req.copy = CopyIndex(req.tokens+[first])
+    drafts, committed = None, [anchor]
+    for n in range(steps):
+        t0 = time.perf_counter()
+        if drafts is None:
+            h = hidden
+        drafts = draft(req, h, committed, width)
+        t1 = time.perf_counter()
+        start = req.cache[0].size()
+        req.encoder.send_step([committed[-1], *drafts], start)
+        raw, timing = recv(req.encoder, mode)
+        t2 = time.perf_counter()
+        arrays = mlx_step(raw, len(drafts)+1)
+        t3 = time.perf_counter()
+        logits, hidden = model.forward_boundary(**arrays, cache=req.cache, start=start, verify=True)
+        t4 = time.perf_counter()
+        mx.eval(logits, hidden)
+        t5 = time.perf_counter()
+        targets = mx.argmax(logits[0], -1).tolist()
+        acc = 0
+        while acc < len(drafts) and drafts[acc] == targets[acc]:
+            acc += 1
+        committed = drafts[:acc]+[targets[acc]]
+        model.rollback_boundary(req.cache, acc+1)
+        h = hidden[:, :acc+1]
+        t6 = time.perf_counter()
+        rec.append(dict(draft=t1-t0, wait=t2-t1, box=timing['box_s'], convert=t3-t2, build=t4-t3, gpu=t5-t4,
+                        accept=t6-t5, total=t6-t0, acc=acc))
+    return rec
+
+
+def draft(req, hidden, committed, width):
+    req.copy.append(committed)
+    logits, _ = model.dspark_forward(hidden, mx.array([[committed[-1]]], mx.uint32), req.mtp_cache, draft_length=width)
+    previous = mx.array([committed[-1]], mx.uint32)
+    toks = []
+    for i in range(width):
+        bias, _ = model.dspark_markov(previous)
+        previous = mx.argmax(logits[:, i]+bias, -1).astype(mx.uint32)
+        toks.append(previous)
+    chosen = mx.concatenate(toks)
+    mx.eval(chosen)
+    return chosen.tolist()
+
+
+def summarize(name, rec):
+    rec = rec[3:]
+    emit(dict(variant=name, n=len(rec), **{k+'_ms': round(1000*statistics.median(r[k] for r in rec), 2)
+                                              for k in ('draft', 'wait', 'box', 'convert', 'build', 'gpu', 'accept', 'total')},
+              tokens_per_step=statistics.mean(r['acc']+1 for r in rec)))
+
+
+def session():
+    enc = EncoderSession()
+    return PipelineRequest(model, tokens, encoder=enc)
+
+
+def set_qos():
+    import ctypes
+    lib = ctypes.CDLL('/usr/lib/libSystem.B.dylib')
+    return lib.pthread_set_qos_class_self_np(0x21, 0)  # QOS_CLASS_USER_INTERACTIVE
+
+
+for name, mode, width, async_every in [('block-w4', 'block', 4, 0), ('spin-w4', 'spin', 4, 0), ('gpu-w4', 'gpu', 4, 0),
+                                        ('block-w4-async4', 'block', 4, 4), ('block-w4-async2', 'block', 4, 2),
+                                        ('block-w1', 'block', 1, 0), ('block-w2', 'block', 2, 0),
+                                        ('QOS', None, 0, 0),
+                                        ('qos-block-w4', 'block', 4, 0), ('qos-block-w4-async4', 'block', 4, 4),
+                                        ('qos-spin-w4-async4', 'spin', 4, 4), ('qos-gpu-w4-async4', 'gpu', 4, 4)]:
+    if name == 'QOS':
+        emit(dict(event='qos', rc=set_qos()))
+        continue
+    model._async_every = async_every
+    req = session()
+    try:
+        summarize(name, run(req, 40, mode, width))
+    finally:
+        req.close()
+
+# Mac-only: repeat the same boundary rows back to back (no box), and with an idle gap.
+req = session()
+try:
+    start = req.cache[0].size()
+    req.encoder.send_step([req.tokens[-1], 1, 2, 3, 4], start)
+    raw, _ = req.encoder.recv_step()
+    full = mlx_step(raw, 5)
+    model._async_every = 0
+    for L in (1, 2, 3, 4, 5):
+        for gap in (0.0, 0.017):
+            times = []
+            for it in range(12):
+                arrays = {k: v[:, :L] for k, v in full.items()}
+                s = req.cache[0].size()
+                t0 = time.perf_counter()
+                logits, hidden = model.forward_boundary(**arrays, cache=req.cache, start=s, verify=True)
+                t1 = time.perf_counter()
+                mx.eval(logits, hidden)
+                t2 = time.perf_counter()
+                model.rollback_boundary(req.cache, 1)
+                times.append((t1-t0, t2-t1))
+                if gap:
+                    time.sleep(gap)
+            times = times[3:]
+            emit(dict(variant='mac-only', rows=L, gap_ms=gap*1000, build_ms=round(1000*statistics.median(t[0] for t in times), 2),
+                      gpu_ms=round(1000*statistics.median(t[1] for t in times), 2)))
+finally:
+    req.close()
+emit(dict(event='done', peak_gib=mx.get_peak_memory()/2**30))
