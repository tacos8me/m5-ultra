+++ b/benchmarks/pipe1/check_mapping.py
@@ -0,0 +1,33 @@
+"""Check the byte representation with MLX on the CPU, without model/GPU load."""
+import json
+from pathlib import Path
+import numpy as np
+import mlx.core as mx
+
+mx.set_default_device(mx.cpu)
+
+def check(bits):
+    if bits == 4:
+        codes = np.arange(256, dtype=np.uint8).reshape(16, 16)
+        nibbles = np.stack([codes & 15, codes >> 4], -1).reshape(16, 32)
+        levels = np.array([0, .5, 1, 1.5, 2, 3, 4, 6], np.float32)
+        ref = np.copysign(levels[nibbles & 7], np.where(nibbles & 8, -1., 1.)).astype(np.float32)
+    else:
+        codes = np.arange(256, dtype=np.uint8).reshape(8, 32)
+        # E4M3 NaN codes are excluded from the numerical equality test.
+        codes = np.where((codes & 127) == 127, 126, codes).astype(np.uint8)
+        from convert_native import fp8_values
+        ref = fp8_values(codes)
+    for exponent in (-20, -10, 0, 10):
+        scales = np.full((codes.shape[0], 1), exponent + 127, np.uint8)
+        result = mx.dequantize(mx.array(codes.copy().view('<u4')), mx.array(scales),
+                               group_size=32, bits=bits, mode=f'mxfp{bits}')
+        mx.eval(result)
+        got = np.asarray(result.astype(mx.float32))
+        expected = np.ldexp(ref, exponent)
+        # Signed zero is also part of the packed representation.
+        assert np.array_equal(got.view(np.uint32), expected.view(np.uint32)), (bits, exponent, str(result.dtype), [(float(a),float(b),int(c),int(d)) for a,b,c,d in zip(got.ravel(),expected.ravel(),got.view(np.uint32).ravel(),expected.view(np.uint32).ravel()) if c!=d][:10])
+    return dict(bits=bits, exponents=4, raw_bits_equal=True)
+
+results = [check(4), check(8)]
+print(json.dumps(dict(device=str(mx.default_device()), results=results)))
