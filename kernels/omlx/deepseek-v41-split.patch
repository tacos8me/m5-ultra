+    sys.argv = [sys.argv[0], 'serve', '--base-path', str(OG/'profile'), '--model-dir', str(OG/'models'),
+                '--no-hf-cache', '--no-cache', '--max-concurrent-requests',
+                os.environ.get('DS41_OG_CONCURRENCY', '2'), *args]
+    from omlx.cli import main as cli
