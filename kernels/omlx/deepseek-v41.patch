+
+class QuantizedEmbedding(QuantizedProjection):
+    """Gather only requested affine rows; never dequantize the whole vocabulary."""
+
+    def __call__(self, indices):
+        if self.mode != "affine" or self.quantize_input:
+            raise ValueError(
