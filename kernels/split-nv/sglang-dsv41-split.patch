+docker run --rm --gpus '"device=1"' -v $SRC:/sgl-workspace/sglang/python/sglang:ro \
+  -v /mnt/nvme-1/dsv41-sglang-jit:/root/.cache/sglang -v /home/ian/models/DeepSeek-V4.1-Flash:/models/ckpt:ro \
+  local/sglang-dsv41:base python /sgl-workspace/sglang/python/sglang/kernels/jit/tests/test_dsv41_wo_a_fp8.py
+# in situ: boot with EXTRA_ENV="-e SGLANG_DSV41_DECODE_DENSE_GEMV=1 -e SGLANG_DSV41_LMHEAD_FP8_GEMV=1 -e SGLANG_DSV41_LINEARS_FP8_GEMV=1",
