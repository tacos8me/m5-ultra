diff --git a/sglang/kernels/ops/moe/sm120_flat_mxfp4_moe.py b/sglang/kernels/ops/moe/sm120_flat_mxfp4_moe.py
new file mode 100644
index 0000000..023b476
--- /dev/null
+++ b/sglang/kernels/ops/moe/sm120_flat_mxfp4_moe.py
@@ -0,0 +1,250 @@
+"""SM120 flat persistent MXFP4 MoE for decode (csrc/moe/sm120_flat_mxfp4_moe.cuh).
+
+Serves one MoE layer for M <= 64 tokens with three launches after the
+activation quantize: a job builder, a gate/up streaming GEMM with fused SwiGLU
+and MXFP8 re-quantization, and a down streaming GEMM with the routing-weighted
+combine and bf16 conversion. Both GEMMs run on the SM120 block-scaled tensor
+core (``mma.sync.kind::mxf8f6f4.block_scale``, e4m3 activations x e2m1 weights,
+ue8m0 scales applied in hardware), so the numerics stay W4A8 like the FlashInfer
+CUTLASS path while the weights are read from HBM exactly once per step through
+a cp.async ring spread over all SMs.
+
+Weights are the layer's parameters exactly as FlashInfer CUTLASS SM120 stores
+them: ``w13`` = ``[E, 2I, H/2]`` packed e2m1 (up rows first, then gate), ``w2``
+= ``[E, H, I/2]``, and the ue8m0 scales after ``block_scale_interleave`` (the
+kernel reads the 128x4 swizzle in place; no extra copy).
+
+Builds persist in the JIT cache; ``prebuild_flat_mxfp4_moe`` compiles a layer
+shape at weight-load time so no decode call compiles.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Dict, Optional, Tuple
+
+import torch
+
+from sglang.kernels.jit.utils import cache_once, load_jit, make_cpp_args
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+MAX_TOKENS = 64
+MAX_TOPK = 8
+MAX_PAIRS = MAX_TOKENS * MAX_TOPK
+MAX_EXPERTS = 512
+_TILE_N = 64
+
+
+def _pick_bk1(hidden: int) -> int:
+    """K split of the gate/up GEMM: whole 128-wide chunks, 3-4 splits for H=5120."""
+    for cand in (1280, 1024, 2560, 640, 512, 384, 256, 128):
+        if hidden % cand == 0 and cand // 32 <= 64:
+            return cand
+    raise ValueError(f"hidden={hidden} is not a multiple of 128")
+
+
+def _pick_bk2(inter: int) -> int:
+    """K split of the down GEMM: whole 64-wide chunks, 2 splits for I=1152."""
+    for cand in (576, 512, 640, 384, 320, 256, 192, 128, 64):
+        if inter % cand == 0 and cand // 32 <= 64:
+            return cand
+    raise ValueError(f"intermediate={inter} is not a multiple of 64")
+
+
+def supports_flat_mxfp4_moe(hidden: int, inter: int) -> bool:
+    """Whether the kernel serves this layer shape (hidden = K of gate/up,
+    inter = per-rank intermediate size)."""
+    return (
+        hidden % 128 == 0
+        and inter % 32 == 0
+        and (hidden // 32) % 4 == 0
+        and (inter // 32) % 4 == 0
+        and inter % 64 == 0
+    )
+
+
+@cache_once
+def _jit_module(hidden: int, inter: int, bk1: int, bk2: int, clamp: bool) -> Module:
+    args = make_cpp_args(hidden, inter, bk1, bk2, clamp)
+    cls = f"sglang::flat_moe::FlatMxfp4Moe<{args}>"
+    return load_jit(
+        "sm120_flat_mxfp4_moe",
+        *args,
+        cuda_files=["moe/sm120_flat_mxfp4_moe.cuh"],
+        cuda_wrappers=[
+            ("run", f"{cls}::run"),
+            ("occupancy", f"{cls}::occupancy"),
+            ("smem_bytes", f"{cls}::smem_bytes"),
+        ],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+def _module(hidden: int, inter: int, clamp: bool) -> Module:
+    if not supports_flat_mxfp4_moe(hidden, inter):
+        raise ValueError(
+            f"flat MXFP4 MoE does not support hidden={hidden}, intermediate={inter}"
+        )
+    return _jit_module(hidden, inter, _pick_bk1(hidden), _pick_bk2(inter), clamp)
+
+
+def prebuild_flat_mxfp4_moe(hidden: int, inter: int, clamp: bool) -> None:
+    """Build (or load from the JIT cache) the module for one layer shape.
+
+    :param hidden: hidden size (K of the gate/up projection, N of the down projection).
+    :param inter: per-rank intermediate size.
+    :param clamp: whether SwiGLU applies the model's swiglu_limit clamp.
+    """
+    _module(hidden, inter, clamp)
+
+
+class _Workspace:
+    """Per-device scratch sized for the kernel's static bounds (M <= 64, topk <= 8)."""
+
+    def __init__(self, hidden: int, inter: int, device: torch.device):
+        splits1 = hidden // _pick_bk1(hidden)
+        splits2 = inter // _pick_bk2(inter)
+        self.ws1 = torch.empty((splits1, MAX_PAIRS, 2 * inter), dtype=torch.float32, device=device)
+        self.hq = torch.empty((MAX_PAIRS, inter), dtype=torch.uint8, device=device)
+        self.hsf = torch.empty((MAX_PAIRS, inter // 32), dtype=torch.uint8, device=device)
+        self.outp = torch.empty((splits2, MAX_PAIRS, hidden), dtype=torch.float32, device=device)
+        tables = (
+            MAX_PAIRS
+            + MAX_PAIRS * 16
+            + MAX_PAIRS
+            + MAX_PAIRS
+            + MAX_PAIRS
+            + MAX_TOKENS
+            + 64
+            + MAX_PAIRS * (inter // 32)
+            + MAX_TOKENS * (hidden // _TILE_N)
+        )
+        self.tables = torch.zeros((tables,), dtype=torch.int32, device=device)
+
+
+_WORKSPACES: Dict[Tuple[int, int, int], _Workspace] = {}
+
+
+def _workspace(hidden: int, inter: int, device: torch.device) -> _Workspace:
+    key = (hidden, inter, device.index if device.index is not None else torch.cuda.current_device())
+    ws = _WORKSPACES.get(key)
+    if ws is None:
+        ws = _Workspace(hidden, inter, device)
+        _WORKSPACES[key] = ws
+    return ws
+
+
+def occupancy_report(hidden: int, inter: int, clamp: bool = True) -> Dict[str, int]:
+    """Resident blocks per SM and dynamic shared memory per block of the two
+    streaming kernels, as measured by the CUDA occupancy API on this device."""
+    mod = _module(hidden, inter, clamp)
+    return {
+        "gateup_blocks_per_sm": int(mod.occupancy(0)),
+        "gateup_smem_bytes": int(mod.smem_bytes(0)),
+        "down_blocks_per_sm": int(mod.occupancy(1)),
+        "down_smem_bytes": int(mod.smem_bytes(1)),
+    }
+
+
+def quantize_activations(x: torch.Tensor) -> Tuple[torch.Tensor, torch.Tensor]:
+    """MXFP8 (e4m3, ue8m0 per 32) quantization of ``x`` with the linear scale
+    layout the kernel reads: returns (uint8 [M, K], uint8 [M, K/32])."""
+    from flashinfer import mxfp8_quantize
+
+    m, k = x.shape
+    xq, xsf = mxfp8_quantize(x, is_sf_swizzled_layout=False, alignment=32)
+    return xq.view(torch.uint8), xsf.view(torch.uint8).reshape(m, k // 32)
+
+
+def flat_mxfp4_moe_quantized(
+    xq: torch.Tensor,
+    xsf: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    w13: torch.Tensor,
+    w13_sf: torch.Tensor,
+    w2: torch.Tensor,
+    w2_sf: torch.Tensor,
+    *,
+    limit: float,
+    clamp: bool,
+    use_pdl: bool,
+    out: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    """Run the MoE on already-quantized activations.
+
+    :param xq: uint8 [M, H] e4m3 activations (M <= 64).
+    :param xsf: uint8 [M, H/32] ue8m0 scales, linear layout.
+    :param topk_ids: int32 [M, topk] expert slot ids (topk <= 8; -1 skips a slot).
+    :param topk_weights: fp32 [M, topk] routing weights (routed scaling included).
+    :param w13: uint8 [E, 2I, H/2] packed e2m1, up rows then gate rows.
+    :param w13_sf: uint8 [E, 2I, H/32] ue8m0 after ``block_scale_interleave``.
+    :param w2: uint8 [E, H, I/2] packed e2m1.
+    :param w2_sf: uint8 [E, H, I/32] ue8m0 after ``block_scale_interleave``.
+    :param limit: swiglu_limit; used only when ``clamp``.
+    :param clamp: apply SGLang's DSv4 clamp (gate <= limit, |up| <= limit) before SiLU.
+    :param use_pdl: launch with programmatic dependent launch.
+    :param out: optional bf16 [M, H] output.
+    :returns: bf16 [M, H].
+    """
+    m, hidden = xq.shape
+    num_experts, two_i, _ = w13.shape
+    inter = two_i // 2
+    mod = _module(hidden, inter, clamp)
+    ws = _workspace(hidden, inter, xq.device)
+    if out is None:
+        out = torch.empty((m, hidden), dtype=torch.bfloat16, device=xq.device)
+    mod.run(
+        xq,
+        xsf,
+        topk_ids,
+        topk_weights,
+        w13,
+        w13_sf,
+        w2,
+        w2_sf,
+        out,
+        ws.ws1,
+        ws.hq,
+        ws.hsf,
+        ws.outp,
+        ws.tables,
+        float(limit),
+        bool(use_pdl),
+    )
+    return out
+
+
+def flat_mxfp4_moe(
+    x: torch.Tensor,
+    topk_ids: torch.Tensor,
+    topk_weights: torch.Tensor,
+    w13: torch.Tensor,
+    w13_sf: torch.Tensor,
+    w2: torch.Tensor,
+    w2_sf: torch.Tensor,
+    *,
+    limit: float,
+    clamp: bool,
+    use_pdl: bool,
+) -> torch.Tensor:
+    """Quantize bf16 ``x`` [M, H] to MXFP8 and run the MoE; see
+    :func:`flat_mxfp4_moe_quantized` for the other parameters.
+
+    :returns: bf16 [M, H].
+    """
+    xq, xsf = quantize_activations(x)
+    return flat_mxfp4_moe_quantized(
+        xq,
+        xsf,
+        topk_ids.to(torch.int32).contiguous(),
+        topk_weights.to(torch.float32).contiguous(),
+        w13.view(torch.uint8),
+        w13_sf.view(torch.uint8),
+        w2.view(torch.uint8),
+        w2_sf.view(torch.uint8),
+        limit=limit,
+        clamp=clamp,
+        use_pdl=use_pdl,
+    )
