+++ b/sglang/kernels/jit/tests/test_dsv41_wo_a_fp8.py
@@ -0,0 +1,58 @@
+"""Numerics and timing of the grouped block-FP8 GEMV for DeepSeek-V4.1 ``wo_a``
+against the production bf16 einsum, on the real layer weights (rank-0 shard at TP2).
+
+Run inside the SM120 image with the checkpoint at /models/ckpt:
+  python test_dsv41_wo_a_fp8.py [--layer 3] [--tp 2]
+"""
+import argparse, json, os, time
+import torch
+from safetensors import safe_open
+
+from sglang.kernels.ops.gemm.sm120_block_fp8_grouped_gemv import sm120_block_fp8_grouped_gemv
+
+ap = argparse.ArgumentParser(); ap.add_argument("--layer", type=int, default=3); ap.add_argument("--tp", type=int, default=2)
+ap.add_argument("--ckpt", default="/models/ckpt"); ap.add_argument("--copies", type=int, default=8)
+args = ap.parse_args()
+dev = torch.device("cuda")
+idx = json.load(open(os.path.join(args.ckpt, "model.safetensors.index.json")))["weight_map"]
+def load(name):
+    with safe_open(os.path.join(args.ckpt, idx[name]), "pt", device="cpu") as f:
+        return f.get_tensor(name)
+key = next(k for k in idx if k.endswith(f"layers.{args.layer}.attn.wo_a.weight"))
+w_full = load(key); s_full = load(key.replace(".weight", ".scale"))
+print("checkpoint wo_a", tuple(w_full.shape), w_full.dtype, "scale", tuple(s_full.shape), s_full.dtype)
+n_total, d = w_full.shape; n_local = n_total // args.tp
+G = 8 // args.tp; R = n_local // G           # o_groups = 8 on V4.1-Flash
+w8 = w_full[:n_local].contiguous().to(dev)
+s32 = s_full[: n_local // 32].to(torch.float32).contiguous().to(dev)
+# bf16 dequant exactly as the loader does
+blocks = w8.float().view(n_local // 32, 32, d // 32, 32)
+w16 = (blocks * s32[:, None, :, None]).view(n_local, d).to(torch.bfloat16)
+w32 = (blocks * s32[:, None, :, None]).view(n_local, d)  # fp32 reference weight
+assert torch.equal(w16.float(), w32), "bf16 dequant of e4m3 x 2^e must be exact"
+print(f"rank-0 shard: G={G} R={R} D={d}; fp8 {w8.numel()/1e6:.1f} MB, bf16 {w16.numel()*2/1e6:.1f} MB")
+
+gen = torch.Generator(device=dev).manual_seed(0)
+print(f"{'M':>3} {'max|d| gemv-bf16':>17} {'relRMS gemv vs fp32':>20} {'relRMS bf16 vs fp32':>20}")
+for m in (1, 2, 3, 4, 8, 16, 24, 32):
+    o = (torch.randn(m, G, d, device=dev, generator=gen) * 0.5).to(torch.bfloat16)
+    y_gemv = sm120_block_fp8_grouped_gemv(o, w8, s32, G)
+    y_bf16 = torch.einsum("tgd,grd->tgr", o, w16.view(G, R, d))
+    y_ref = torch.einsum("tgd,grd->tgr", o.float(), w32.view(G, R, d))
+    rel = lambda a: ((a.float() - y_ref).pow(2).mean().sqrt() / y_ref.pow(2).mean().sqrt()).item()
+    print(f"{m:3d} {(y_gemv.float()-y_bf16.float()).abs().max().item():17.4g} {rel(y_gemv):20.3e} {rel(y_bf16):20.3e}")
+
+# timing with weights rotated past L2
+w8s = [w8.clone() for _ in range(args.copies)]; s32s = [s32.clone() for _ in range(args.copies)]; w16s = [w16.clone() for _ in range(args.copies)]
+print(f"\n{'M':>3} {'fp8 grouped GEMV':>17} {'bf16 einsum':>13} {'speedup':>8}  (us per call, {args.copies} rotated copies)")
+for m in (1, 2, 3, 4, 8, 16, 24, 32):
+    o = (torch.randn(m, G, d, device=dev, generator=gen) * 0.5).to(torch.bfloat16)
+    def bench(fn, iters=64):
+        for i in range(8): fn(i % args.copies)
+        torch.cuda.synchronize(); e0 = torch.cuda.Event(enable_timing=True); e1 = torch.cuda.Event(enable_timing=True)
+        e0.record()
+        for i in range(iters): fn(i % args.copies)
+        e1.record(); torch.cuda.synchronize(); return e0.elapsed_time(e1) * 1e3 / iters
+    t_g = bench(lambda i: sm120_block_fp8_grouped_gemv(o, w8s[i], s32s[i], G))
+    t_b = bench(lambda i: torch.einsum("tgd,grd->tgr", o, w16s[i].view(G, R, d)))
+    print(f"{m:3d} {t_g:17.1f} {t_b:13.1f} {t_b/t_g:8.2f}")
diff --git a/sglang/kernels/jit/tests/test_sm120_flat_mxfp4_moe.py b/sglang/kernels/jit/tests/test_sm120_flat_mxfp4_moe.py
new file mode 100644
index 0000000..ae9ecca
--- /dev/null
+++ b/sglang/kernels/jit/tests/test_sm120_flat_mxfp4_moe.py
@@ -0,0 +1,282 @@
+"""Numerical test of the SM120 flat MXFP4 MoE against an fp32 torch reference.
+
+Synthetic MXFP4 experts (random e2m1 codes, random ue8m0 scales) in the exact
+FlashInfer SM120 layout (packed rows, up before gate, 128x4-swizzled scales),
+bf16 activations quantized with FlashInfer's ``mxfp8_quantize``. The reference
+dequantizes both, runs the two projections in fp32, rounds the gate/up sums to
+bf16 (the CUTLASS gemm1 output dtype), applies SwiGLU with the same MXFP8
+re-quantization rule as the kernel, and combines with the routing weights.
+
+Run inside the SM120 image (< 500 MB of GPU memory):
+    docker run --rm --gpus all -v $SRC:/sgl-workspace/sglang/python/sglang:ro \
+      -v /mnt/nvme-1/dsv41-sglang-jit:/root/.cache/sglang local/sglang-dsv41:base \
+      python /sgl-workspace/sglang/python/sglang/kernels/jit/tests/test_sm120_flat_mxfp4_moe.py
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+import time
+
+import torch
+
+from sglang.kernels.ops.moe.sm120_flat_mxfp4_moe import (
+    flat_mxfp4_moe_quantized,
+    occupancy_report,
+    quantize_activations,
+)
+
+DEV = "cuda"
+E2M1 = torch.tensor([0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0])
+
+
+def dequant_fp4(packed: torch.Tensor, sf: torch.Tensor) -> torch.Tensor:
+    """One expert: packed uint8 [N, K/2] (low nibble = even k), sf uint8 ue8m0
+    [N, K/32] -> fp32 [N, K]. Memory-light (int16 indices) so it runs beside a
+    loaded GPU."""
+    n, k2 = packed.shape
+    codes = torch.stack([packed & 0x0F, packed >> 4], dim=-1).view(n, 2 * k2)
+    table = torch.cat([E2M1, -E2M1]).to(packed.device)  # code 0..15 with the sign bit
+    val = table[codes.to(torch.int16).long()] if codes.numel() < (1 << 22) else torch.cat(
+        [table[c.to(torch.int16).long()] for c in codes.split(256, dim=0)]
+    )
+    scale = torch.exp2(sf.float() - 127.0)
+    return (val.view(n, -1, 32) * scale.unsqueeze(-1)).view(n, 2 * k2)
+
+
+def dequant_mxfp8(xq: torch.Tensor, xsf: torch.Tensor) -> torch.Tensor:
+    m, k = xq.shape
+    vals = xq.view(torch.float8_e4m3fn).float()
+    scale = torch.exp2(xsf.float() - 127.0)
+    return (vals.view(m, k // 32, 32) * scale.unsqueeze(-1)).view(m, k)
+
+
+def ue8m0_for_amax(amax: torch.Tensor) -> torch.Tensor:
+    """Kernel rule: smallest power of two s with amax / s <= 448 (biased exponent)."""
+    r = amax / 448.0
+    bits = r.view(torch.int32)
+    e = ((bits >> 23) & 0xFF) - 127
+    e = e + ((bits & 0x7FFFFF) != 0).int()
+    e = torch.clamp(e, -127, 127) + 127
+    return torch.where(amax > 0, e, torch.full_like(e, 127))
+
+
+def quantize_mxfp8_ref(h: torch.Tensor) -> torch.Tensor:
+    """Round-trip h [M, I] through MXFP8 with the kernel's rule; returns fp32."""
+    m, i = h.shape
+    blocks = h.view(m, i // 32, 32)
+    amax = blocks.abs().amax(dim=-1)
+    sf = ue8m0_for_amax(amax)
+    scale = torch.exp2(sf.float() - 127.0).unsqueeze(-1)
+    q = (blocks / scale).to(torch.float8_e4m3fn).float() * scale
+    return q.view(m, i)
+
+
+def reference(x_deq, ids, weights, w13, w13_sf, w2, w2_sf, inter, limit, clamp):
+    """fp32 MoE on dequantized operands, one expert dequantized at a time."""
+    m = x_deq.shape[0]
+    out = torch.zeros((m, x_deq.shape[1]), dtype=torch.float32, device=DEV)
+    for ex in ids.unique().tolist():
+        if ex < 0:
+            continue
+        w13_deq = dequant_fp4(w13[ex], w13_sf[ex])
+        w2_deq = dequant_fp4(w2[ex], w2_sf[ex])
+        for slot in range(ids.shape[1]):
+            rows = (ids[:, slot] == ex).nonzero().flatten()
+            if rows.numel() == 0:
+                continue
+            y = x_deq[rows] @ w13_deq.T  # [r, 2I]
+            up = y[:, :inter].bfloat16().float()
+            gate = y[:, inter:].bfloat16().float()
+            if clamp:
+                gate = torch.clamp(gate, max=limit)
+                up = torch.clamp(up, -limit, limit)
+            h = torch.nn.functional.silu(gate) * up
+            hq = quantize_mxfp8_ref(h)
+            z = hq @ w2_deq.T
+            out[rows] += weights[rows, slot].unsqueeze(1) * z
+        del w13_deq, w2_deq
+    return out
+
+
+def make_experts(num_experts, inter, hidden, gen):
+    from flashinfer import block_scale_interleave
+
+    w13 = torch.randint(0, 256, (num_experts, 2 * inter, hidden // 2), dtype=torch.uint8, device=DEV, generator=gen)
+    w2 = torch.randint(0, 256, (num_experts, hidden, inter // 2), dtype=torch.uint8, device=DEV, generator=gen)
+    # scales 2^-9 .. 2^-4: typical magnitude for 0.02-scale weights
+    w13_sf = torch.randint(118, 124, (num_experts, 2 * inter, hidden // 32), dtype=torch.uint8, device=DEV, generator=gen)
+    w2_sf = torch.randint(118, 124, (num_experts, hidden, inter // 32), dtype=torch.uint8, device=DEV, generator=gen)
+    w13_swz = block_scale_interleave(w13_sf).reshape_as(w13_sf)
+    w2_swz = block_scale_interleave(w2_sf).reshape_as(w2_sf)
+    return w13, w13_sf, w13_swz, w2, w2_sf, w2_swz
+
+
+def flashinfer_path(x, ids, weights, w13, w13_swz, w2, w2_swz, num_experts):
+    """The production FlashInfer CUTLASS SM120 MXFP4 call (Swiglu, no clamp)."""
+    from flashinfer import mxfp8_quantize
+    from flashinfer.fused_moe import ActivationType, cutlass_fused_moe
+
+    m, hidden = x.shape
+    xq, input_sf = mxfp8_quantize(x, is_sf_swizzled_layout=True, alignment=32)
+    ones = torch.ones(num_experts, dtype=torch.float32, device=DEV)
+    out = torch.empty((m, hidden), dtype=torch.bfloat16, device=DEV)
+    cutlass_fused_moe(
+        input=xq,
+        token_selected_experts=ids.to(torch.int32),
+        token_final_scales=weights.float(),
+        fc1_expert_weights=w13.view(torch.int64),
+        fc2_expert_weights=w2.view(torch.int64),
+        output_dtype=torch.bfloat16,
+        quant_scales=[w13_swz.view(torch.int32), ones, w2_swz.view(torch.int32), ones],
+        input_sf=input_sf,
+        fc1_expert_biases=None,
+        fc2_expert_biases=None,
+        swiglu_alpha=None,
+        swiglu_beta=None,
+        swiglu_limit=None,
+        tp_size=1,
+        tp_rank=0,
+        ep_size=1,
+        ep_rank=0,
+        use_w4_group_scaling=False,
+        use_mxfp8_act_scaling=True,
+        activation_type=ActivationType.Swiglu,
+        tune_max_num_tokens=max(1, 1 << (m - 1).bit_length()),
+        output=out,
+        use_fused_finalize=True,
+    )
+    return out
+
+
+def errors(out, ref):
+    diff = (out.float() - ref).abs()
+    scale = ref.abs().max().item()
+    return diff.max().item(), diff.mean().item(), scale
+
+
+def run_case(name, m, topk, num_experts, hidden, inter, routing, gen, limit, clamp, use_pdl, compare_fi):
+    w13, w13_sf, w13_swz, w2, w2_sf, w2_swz = make_experts(num_experts, inter, hidden, gen)
+    x = torch.randn((m, hidden), dtype=torch.float32, device=DEV, generator=gen).bfloat16()
+    if routing == "random":
+        ids = torch.stack([torch.randperm(num_experts, device=DEV, generator=gen)[:topk] for _ in range(m)])
+    elif routing == "skewed":  # every token uses expert 3 in slot 0 (jobs of 16 rows), random others
+        ids = torch.stack([torch.randperm(num_experts, device=DEV, generator=gen)[:topk] for _ in range(m)])
+        ids[:, 0] = 3
+        for r in range(m):
+            for s in range(1, topk):
+                if ids[r, s] == 3:
+                    ids[r, s] = (ids[r, 1:].max() + 1) % num_experts
+    else:
+        raise ValueError(routing)
+    ids = ids.to(torch.int32)
+    weights = torch.rand((m, topk), dtype=torch.float32, device=DEV, generator=gen) * 1.5 + 0.25
+
+    xq, xsf = quantize_activations(x)
+    x_deq = dequant_mxfp8(xq, xsf)
+    ref = reference(x_deq, ids, weights, w13, w13_sf, w2, w2_sf, inter, limit, clamp)
+
+    torch.cuda.synchronize()
+    t0 = time.time()
+    out = flat_mxfp4_moe_quantized(
+        xq, xsf, ids, weights, w13, w13_swz, w2, w2_swz, limit=limit, clamp=clamp, use_pdl=use_pdl
+    )
+    torch.cuda.synchronize()
+    dt = time.time() - t0
+    mx, mean, scale = errors(out, ref)
+    line = f"{name:28} M={m:2} topk={topk} E={num_experts:3} clamp={int(clamp)} pdl={int(use_pdl)}  max_err={mx:.4f} mean_err={mean:.5f} ref_max={scale:.3f}  ({dt*1e3:.1f} ms first call)"
+    ok = mx <= 0.02 * scale + 1e-3 and torch.isfinite(out.float()).all().item()
+    if compare_fi and not clamp:
+        try:
+            fi = flashinfer_path(x, ids, weights, w13, w13_swz, w2, w2_swz, num_experts)
+            fmx, fmean, _ = errors(fi, ref)
+            kmx, kmean, _ = errors(out, fi.float())
+            line += f"\n{'':28} flashinfer vs ref: max={fmx:.4f} mean={fmean:.5f}; kernel vs flashinfer: max={kmx:.4f} mean={kmean:.5f}"
+        except Exception as exc:  # the comparison is informational
+            line += f"\n{'':28} flashinfer path unavailable: {type(exc).__name__}: {str(exc)[:160]}"
+    print(("PASS " if ok else "FAIL ") + line, flush=True)
+    return ok, out
+
+
+def graph_capture_check(m, topk, num_experts, hidden, inter, gen, use_pdl):
+    """Capture the three launches in a CUDA graph (with PDL attributes) and replay."""
+    w13, w13_sf, w13_swz, w2, w2_sf, w2_swz = make_experts(num_experts, inter, hidden, gen)
+    x = torch.randn((m, hidden), dtype=torch.float32, device=DEV, generator=gen).bfloat16()
+    ids = torch.stack([torch.randperm(num_experts, device=DEV, generator=gen)[:topk] for _ in range(m)]).to(torch.int32)
+    weights = torch.rand((m, topk), dtype=torch.float32, device=DEV, generator=gen)
+    xq, xsf = quantize_activations(x)
+    out = torch.empty((m, hidden), dtype=torch.bfloat16, device=DEV)
+    kw = dict(limit=10.0, clamp=True, use_pdl=use_pdl, out=out)
+    eager = flat_mxfp4_moe_quantized(xq, xsf, ids, weights, w13, w13_swz, w2, w2_swz, **kw).clone()
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())  # the workspace is shared: order the streams
+    with torch.cuda.stream(s):
+        for _ in range(2):
+            flat_mxfp4_moe_quantized(xq, xsf, ids, weights, w13, w13_swz, w2, w2_swz, **kw)
+    torch.cuda.current_stream().wait_stream(s)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        flat_mxfp4_moe_quantized(xq, xsf, ids, weights, w13, w13_swz, w2, w2_swz, **kw)
+    out.zero_()
+    # New routing between replays exercises the device-side job tables.
+    ids2 = torch.stack([torch.randperm(num_experts, device=DEV, generator=gen)[:topk] for _ in range(m)]).to(torch.int32)
+    ids.copy_(ids2)
+    g.replay()
+    torch.cuda.synchronize()
+    eager2 = flat_mxfp4_moe_quantized(xq, xsf, ids, weights, w13, w13_swz, w2, w2_swz, limit=10.0, clamp=True, use_pdl=use_pdl)
+    diff = (out.float() - eager2.float()).abs().max().item()
+    ok = diff == 0.0  # no atomics on data: replay must reproduce eager bit for bit
+    print(("PASS " if ok else "FAIL ") + f"cuda-graph replay (pdl={int(use_pdl)}): max |replay - eager| = {diff:.5f}", flush=True)
+    return ok
+
+
+def run_matrix(hidden, inter, num_experts, gen, cases, compare_fi):
+    ok = True
+    print(f"--- hidden={hidden} inter={inter} experts={num_experts} occupancy={occupancy_report(hidden, inter, True)}", flush=True)
+    for name, m, topk, routing in cases:
+        for clamp in (True, False):
+            r, _ = run_case(
+                name, m, topk, num_experts, hidden, inter, routing, gen,
+                limit=1.0 if clamp else 0.0, clamp=clamp, use_pdl=True, compare_fi=compare_fi,
+            )
+            ok &= r
+    return ok
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--experts", type=int, default=8)
+    ap.add_argument("--no-flashinfer", action="store_true")
+    ap.add_argument("--skip-production-shape", action="store_true")
+    args = ap.parse_args()
+    gen = torch.Generator(device=DEV)
+    gen.manual_seed(41)
+    ok = True
+    cases = [
+        ("random m1", 1, 6, "random"),
+        ("random m4", 4, 6, "random"),
+        ("random m6", 6, 6, "random"),
+        ("random m24", 24, 6, "random"),
+        ("random m64", 64, 6, "random"),
+        ("skewed m64 (16-row jobs)", 64, 6, "skewed"),
+        ("topk3 m17", 17, 3, "random"),
+        ("topk8 m64", 64, 8, "random"),
+    ]
+    # Small shape: the whole matrix, cheap in memory.
+    ok &= run_matrix(1024, 256, args.experts, gen, cases, not args.no_flashinfer)
+    r, _ = run_case("random m6 no-pdl", 6, 6, args.experts, 1024, 256, "random", gen, 10.0, True, False, False)
+    ok &= r
+    ok &= graph_capture_check(6, 6, args.experts, 1024, 256, gen, use_pdl=True)
+    ok &= graph_capture_check(24, 6, args.experts, 1024, 256, gen, use_pdl=False)
+    # Production shape (H=5120, I=1152 per rank): the K-split constants differ.
+    if not args.skip_production_shape:
+        prod_cases = [("random m1", 1, 6, "random"), ("random m24", 24, 6, "random"), ("skewed m64 (16-row jobs)", 64, 6, "skewed")]
+        ok &= run_matrix(5120, 1152, args.experts, gen, prod_cases, not args.no_flashinfer)
+        ok &= graph_capture_check(6, 6, args.experts, 5120, 1152, gen, use_pdl=True)
+    print("ALL PASS" if ok else "SOME FAILED", flush=True)
+    sys.exit(0 if ok else 1)
+
+
+if __name__ == "__main__":
+    main()
