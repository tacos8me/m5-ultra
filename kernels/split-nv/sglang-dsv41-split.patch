index 0000000..9f6ebc1
--- /dev/null
+++ b/sglang/kernels/jit/tests/test_dsv41_dense_indexer_kv_split.py
@@ -0,0 +1,73 @@
+"""KV-split dense fp4 indexer scoring == direct DeepGEMM call (valid columns), plus timing.
+
+Runs on SM120 with the pinned DeepGEMM; needs a GPU. Invoke as a script or via pytest.
+"""
+import time
+
+import torch
+
+from sglang.srt.layers.attention.deepseek_v4_backend import (
+    _dense_fp4_mqa_logits,
+    _dense_fp4_mqa_logits_kv_split,
+)
+
+HEADS, DIM_BYTES = 32, 64  # 128 fp4 dims packed
+
+
+def _case(rows, L, chunk, ragged=False, seed=0):
+    g = torch.Generator(device="cuda").manual_seed(seed)
+    dev = torch.device("cuda")
+    q = torch.randint(-128, 128, (rows, HEADS, DIM_BYTES), dtype=torch.int8, device=dev, generator=g)
+    q_sf = torch.randint(118, 124, (rows, HEADS), dtype=torch.int32, device=dev, generator=g)
+    kv = torch.randint(-128, 128, (L, DIM_BYTES), dtype=torch.int8, device=dev, generator=g)
+    kv_sf = torch.randint(118, 124, (L,), dtype=torch.int32, device=dev, generator=g)
+    w = torch.rand(rows, HEADS, device=dev, generator=g)
+    if ragged:
+        # two requests: rows split, second starts mid-buffer; per-row causal ends
+        half = rows // 2
+        ks = torch.tensor([0] * half + [L // 3] * (rows - half), dtype=torch.int32, device=dev)
+        ends = torch.tensor([L // 3 - (half - i) * 7 for i in range(half)] + [L - (rows - half - i) * 5 for i in range(rows - half)], dtype=torch.int32, device=dev)
+        ke = ends
+    else:
+        ks = torch.zeros(rows, dtype=torch.int32, device=dev)
+        ke = torch.tensor([L - i * 3 for i in range(rows)], dtype=torch.int32, device=dev)
+    width = int(((ke - ks).max().item() + 3) // 4 * 4)
+    return (q, q_sf), (kv, kv_sf), w, ks, ke, width
+
+
+def check(rows, L, chunk, ragged=False):
+    q, kv, w, ks, ke, width = _case(rows, L, chunk, ragged)
+    ref = _dense_fp4_mqa_logits(q, kv, w, ks, ke, width)
+    out = _dense_fp4_mqa_logits_kv_split(q, kv, w, ks, ke, width, chunk)
+    torch.cuda.synchronize()
+    assert out.shape == ref.shape, (out.shape, ref.shape)
+    lens = (ke - ks).tolist()
+    for r, n in enumerate(lens):
+        a, b = ref[r, :n], out[r, :n]
+        assert torch.equal(a, b), f"row {r}: {int((a != b).sum())} of {n} columns differ (max abs {(a - b).abs().max().item():.3g})"
+
+    def t(fn, reps=10):
+        for _ in range(2):
+            fn()
+        torch.cuda.synchronize()
+        t0 = time.perf_counter()
+        for _ in range(reps):
+            fn()
+        torch.cuda.synchronize()
+        return (time.perf_counter() - t0) / reps * 1e6
+
+    t_ref = t(lambda: _dense_fp4_mqa_logits(q, kv, w, ks, ke, width))
+    t_out = t(lambda: _dense_fp4_mqa_logits_kv_split(q, kv, w, ks, ke, width, chunk))
+    print(f"rows={rows:2d} L={L:7d} ragged={int(ragged)} chunk={chunk}: direct {t_ref:8.1f} us  split {t_out:8.1f} us  x{t_ref / t_out:.1f}  OK")
+
+
+def test_kv_split_matches_direct():
+    for rows in (1, 3, 4, 7, 16):
+        for L in (20000, 131072, 400000):
+            for ragged in (False, True):
+                check(rows, L, 8192, ragged)
+
+
+if __name__ == "__main__":
+    test_kv_split_matches_direct()
+    print("ALL OK")
