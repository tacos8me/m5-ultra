diff --git a/sglang/srt/layers/dsv41_linears_fp8.py b/sglang/srt/layers/dsv41_linears_fp8.py
new file mode 100644
index 0000000..d9893ba
--- /dev/null
+++ b/sglang/srt/layers/dsv41_linears_fp8.py
@@ -0,0 +1,173 @@
+"""Block-FP8 GEMV paths for DeepSeek-V4.1 linears that the production stack runs
+in bf16 at decode on SM120.
+
+Site ``wo_a`` (the attention output absorb, ``einsum("tgd,grd->tgr")``): the
+checkpoint ships ``wo_a`` as [32, 32]-block ue8m0 fp8, but the fp8 absorb GEMM
+(DeepGEMM ``fp8_einsum``) takes 128x128 blocks only, so the loader dequantizes it
+to bf16 and decode runs one cuBLAS batched gemv per layer (~27 us for the
+[4, 1024, 4096] per-rank shard at TP2, ~1.1 ms of an 11.5 ms step). With
+``SGLANG_DSV41_LINEARS_FP8_GEMV=1`` and ``wo_a`` in the site list, the raw fp8
+weight and its scales (as fp32 powers of two, exactly the checkpoint values) are
+kept per rank and decode runs ``sm120_block_fp8_grouped_gemv``: half the bytes,
+the same numerics up to fp32 summation order (a bf16 value of e4m3 x 2^e is exact,
+so the bf16 dequant loses nothing either). Calls with more rows than
+``SGLANG_DSV41_LINEARS_FP8_GEMV_MAX_M`` (prefill, DSpark verify batches) use the
+bf16 weight if kept (``_KEEP_BF16=1``) and otherwise dequantize on the fly.
+
+Memory per rank (TP2, 40 layers): fp8 16.8 MB + scales 65 KB per layer; the
+bf16 shard (33.5 MB per layer, 1.34 GB total) is freed unless kept.
+"""
+
+from __future__ import annotations
+
+import logging
+import re
+from typing import Iterable, Iterator, Tuple
+
+import torch
+from torch import nn
+
+from sglang.kernels.ops.gemm.sm120_block_fp8_gemv import MAX_M
+from sglang.kernels.ops.gemm.sm120_block_fp8_grouped_gemv import (
+    prebuild_sm120_block_fp8_grouped_gemv,
+    sm120_block_fp8_grouped_gemv,
+)
+
+logger = logging.getLogger(__name__)
+
+BLOCK = 32
+SITES = ("wo_a",)
+_LAYER_RE = re.compile(r"(?:^|\.)layers\.(\d+)\.")
+
+
+class Fp8Stash:
+    """Raw checkpoint fp8 weights and scales captured while the loader streams."""
+
+    def __init__(self) -> None:
+        self.wo_a: dict[int, dict[str, torch.Tensor]] = {}
+
+
+def capture_wo_a_fp8(
+    weights: Iterable[Tuple[str, torch.Tensor]], stash: Fp8Stash
+) -> Iterator[Tuple[str, torch.Tensor]]:
+    """Pass ``weights`` through unchanged while recording each layer's raw
+    ``wo_a.weight`` (e4m3) and ``wo_a.scale`` (e8m0 or fp32) on the CPU.
+
+    :param weights: checkpoint (name, tensor) stream before name remapping.
+    :param stash: receives ``{layer: {"weight": fp8, "scale": scale}}``.
+    """
+    for name, tensor in weights:
+        if name.endswith(".wo_a.weight") or name.endswith(".wo_a.scale"):
+            m = _LAYER_RE.search(name)
+            if m is not None:
+                key = "weight" if name.endswith(".weight") else "scale"
+                stash.wo_a.setdefault(int(m.group(1)), {})[key] = tensor.clone()
+        yield name, tensor
+
+
+def _scale_to_fp32(scale: torch.Tensor) -> torch.Tensor:
+    if scale.dtype == torch.float8_e8m0fnu:
+        return scale.to(torch.float32)
+    if scale.dtype == torch.float32:
+        return scale
+    raise ValueError(f"wo_a scale dtype {scale.dtype}: expected e8m0 or fp32")
+
+
+def install_wo_a_fp8_gemv(
+    layers: Iterable[Tuple[int, nn.Module]],
+    stash: Fp8Stash,
+    max_m: int,
+    keep_bf16: bool,
+    use_pdl: bool,
+) -> None:
+    """Attach each attention's fp8 ``wo_a`` shard and route decode through the
+    grouped GEMV.
+
+    :param layers: (layer index, attention module) pairs; the attention exposes
+        ``wo_a`` (ColumnParallelLinear with ``tp_rank``/``tp_size``),
+        ``n_local_groups`` and ``o_lora_rank``.
+    :param stash: raw tensors captured by :func:`capture_wo_a_fp8`.
+    :param max_m: largest M served by the GEMV (clamped to the kernel limit).
+    :param keep_bf16: keep ``wo_a.weight``; otherwise free it (set to None).
+    :param use_pdl: launch the GEMV with programmatic dependent launch.
+    """
+    installed = 0
+    for layer_id, attn in layers:
+        raw = stash.wo_a.get(layer_id)
+        if raw is None or "weight" not in raw or "scale" not in raw:
+            raise RuntimeError(
+                f"SGLANG_DSV41_LINEARS_FP8_GEMV: no fp8 wo_a captured for layer {layer_id}"
+            )
+        wo_a = attn.wo_a
+        weight = raw["weight"]
+        scale = _scale_to_fp32(raw["scale"])
+        if weight.dtype != torch.float8_e4m3fn:
+            raise ValueError(f"layer {layer_id} wo_a is {weight.dtype}, expected fp8_e4m3fn")
+        n_total, d = weight.shape
+        if weight.shape[0] // scale.shape[0] != BLOCK or weight.shape[1] // scale.shape[1] != BLOCK:
+            raise ValueError(
+                f"layer {layer_id} wo_a scale {tuple(scale.shape)} is not a "
+                f"[{BLOCK}, {BLOCK}] block layout for weight {tuple(weight.shape)}"
+            )
+        tp_rank, tp_size = wo_a.tp_rank, wo_a.tp_size
+        n_local = n_total // tp_size
+        g, r = attn.n_local_groups, attn.o_lora_rank
+        if n_local != g * r or n_local % BLOCK:
+            raise ValueError(
+                f"layer {layer_id} wo_a rows {n_total}/{tp_size} != {g} groups x {r}"
+            )
+        dev = wo_a.weight.device if getattr(wo_a, "weight", None) is not None else torch.device("cuda")
+        rows = slice(tp_rank * n_local, (tp_rank + 1) * n_local)
+        fp8 = weight[rows].contiguous().to(dev)
+        sc = scale[tp_rank * n_local // BLOCK : (tp_rank + 1) * n_local // BLOCK].contiguous().to(dev)
+        bf16 = getattr(wo_a, "weight", None)
+        if bf16 is not None and tuple(bf16.shape) != (n_local, d):
+            raise ValueError(
+                f"layer {layer_id} wo_a bf16 shard {tuple(bf16.shape)} != fp8 shard {(n_local, d)}"
+            )
+        wo_a.dsv41_fp8_weight = fp8
+        wo_a.dsv41_fp8_scale = sc
+        wo_a.dsv41_fp8_groups = g
+        wo_a.dsv41_fp8_max_m = min(int(max_m), MAX_M)
+        wo_a.dsv41_fp8_pdl = bool(use_pdl)
+        prebuild_sm120_block_fp8_grouped_gemv(g, r, d, MAX_M)
+        if not keep_bf16 and bf16 is not None:
+            del wo_a._parameters["weight"]
+            wo_a.weight = None
+        installed += 1
+    torch.cuda.empty_cache()
+    stash.wo_a.clear()
+    logger.info(
+        "wo_a FP8 grouped GEMV installed on %d layers (max_m %d, bf16 %s, pdl %s)",
+        installed, min(int(max_m), MAX_M), "kept" if keep_bf16 else "freed", use_pdl,
+    )
+
+
+def _dequant_bf16(wo_a: nn.Module) -> torch.Tensor:
+    w, s = wo_a.dsv41_fp8_weight, wo_a.dsv41_fp8_scale
+    n, k = w.shape
+    blocks = w.float().view(n // BLOCK, BLOCK, k // BLOCK, BLOCK)
+    return (blocks * s[:, None, :, None]).view(n, k).to(torch.bfloat16)
+
+
+def wo_a_fp8_gemv(wo_a: nn.Module, o: torch.Tensor) -> torch.Tensor:
+    """o[T, G, D] @ wo_a[G, R, D]^T -> [T, G, R] through the fp8 shard.
+
+    :param wo_a: a ColumnParallelLinear prepared by :func:`install_wo_a_fp8_gemv`.
+    :param o: bf16 attention output [T, G, D].
+    :returns: bf16 [T, G, R].
+    """
+    t, g, d = o.shape
+    if g != wo_a.dsv41_fp8_groups:
+        raise ValueError(f"wo_a input has {g} groups, expected {wo_a.dsv41_fp8_groups}")
+    if o.dtype != torch.bfloat16:
+        o = o.to(torch.bfloat16)
+    if not o.is_contiguous():
+        o = o.contiguous()
+    if t <= wo_a.dsv41_fp8_max_m:
+        return sm120_block_fp8_grouped_gemv(
+            o, wo_a.dsv41_fp8_weight, wo_a.dsv41_fp8_scale, g, use_pdl=wo_a.dsv41_fp8_pdl
+        )
+    bf16 = getattr(wo_a, "weight", None)
+    w = bf16 if bf16 is not None else _dequant_bf16(wo_a)
+    return torch.einsum("tgd,grd->tgr", o, w.view(g, -1, d))
diff --git a/sglang/srt/layers/dsv41_lm_head_fp8.py b/sglang/srt/layers/dsv41_lm_head_fp8.py
new file mode 100644
index 0000000..d399cb7
--- /dev/null
+++ b/sglang/srt/layers/dsv41_lm_head_fp8.py
@@ -0,0 +1,112 @@
+"""Block-FP8 LM head for DeepSeek-V4.1 decode on SM120.
+
+The checkpoint ships ``head.weight`` in bf16 ([129280, 5120]); at decode the logits
+GEMM is an M <= 32 matmul against the [64640, 5120] TP shard, which cuBLAS runs as
+~45 gemvx launches at ~0.4 TB/s (1.6 ms of an 11.8 ms step at M = 1). With
+``SGLANG_DSV41_LMHEAD_FP8_GEMV=1`` the shard is quantized once at load to e4m3 with
+fp32 [32, 32]-block scales (amax / 448 per block; the kernel reads fp32 scales, so
+no ue8m0 rounding is needed) and served by the same streaming GEMV as the dense
+linears (``sm120_block_fp8_gemv``). Halves the bytes per step and drops the
+launch count to one per 32-row chunk. Weight-only quantization: logits change;
+see NOTES-fp8-lmhead.md for the measured top-1 agreement and GSM8K parity.
+
+Measured in isolation on the real shard (kernels/jit/tests/test_dsv41_lm_head_fp8.py):
+the GEMV is 2.0x faster than the bf16 cuBLAS matmul up to M = 8 (227 vs 462 us),
+level at M = 16 and 2x slower from M = 24 (its per-byte fp32 FMAs bound it), so
+``SGLANG_DSV41_LMHEAD_FP8_GEMV_MAX_M`` defaults to 8. Larger calls use the bf16
+matmul when the bf16 shard is kept (``_KEEP_BF16=1``, the right choice for the
+DSpark fast lane whose verify batches reach M = 24) and otherwise run as 32-row
+GEMV chunks (slower than cuBLAS but rare: logprob-over-prompt requests).
+Memory per rank: fp8 shard 331 MB + scales 1.3 MB; the bf16 shard (662 MB) is
+freed unless kept.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+from torch import nn
+
+from sglang.kernels.ops.gemm.sm120_block_fp8_gemv import (
+    MAX_M,
+    prebuild_sm120_block_fp8_gemv,
+    sm120_block_fp8_gemv,
+)
+
+logger = logging.getLogger(__name__)
+
+BLOCK = 32
+FP8_MAX = 448.0
+_ROWS_PER_CHUNK = 8192
+
+
+def quantize_block_fp8(weight: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+    """Quantize a bf16 [N, K] weight to e4m3 with fp32 [N / 32, K / 32] block scales.
+
+    :param weight: bf16 or fp32 weight, N and K multiples of 32.
+    :returns: (fp8 [N, K] e4m3fn, fp32 [N / 32, K / 32] scales), both contiguous.
+    """
+    n, k = weight.shape
+    if n % BLOCK or k % BLOCK:
+        raise ValueError(f"LM head shard [{n}, {k}] is not a multiple of {BLOCK}")
+    out = torch.empty((n, k), dtype=torch.float8_e4m3fn, device=weight.device)
+    scales = torch.empty((n // BLOCK, k // BLOCK), dtype=torch.float32, device=weight.device)
+    for r0 in range(0, n, _ROWS_PER_CHUNK):
+        w = weight[r0 : r0 + _ROWS_PER_CHUNK].float()
+        rows = w.shape[0]
+        blocks = w.view(rows // BLOCK, BLOCK, k // BLOCK, BLOCK)
+        amax = blocks.abs().amax(dim=(1, 3)).clamp_min_(1e-12)  # [rows/32, k/32]
+        s = amax / FP8_MAX
+        q = (blocks / s[:, None, :, None]).clamp_(-FP8_MAX, FP8_MAX)
+        out[r0 : r0 + rows] = q.view(rows, k).to(torch.float8_e4m3fn)
+        scales[r0 // BLOCK : (r0 + rows) // BLOCK] = s
+    return out, scales
+
+
+def install_lm_head_fp8_gemv(lm_head: nn.Module, max_m: int, keep_bf16: bool) -> None:
+    """Quantize ``lm_head.weight`` in place and route decode logits through the GEMV.
+
+    :param lm_head: the ParallelLMHead holding the bf16 vocab shard.
+    :param max_m: largest M served by the GEMV (clamped to the kernel limit);
+        larger calls use the bf16 matmul if kept, else 32-row GEMV chunks.
+    :param keep_bf16: keep ``lm_head.weight``; otherwise it is freed and set to
+        None so any bypassing consumer fails loudly.
+    """
+    weight = lm_head.weight
+    if weight.dtype not in (torch.bfloat16, torch.float16, torch.float32):
+        raise ValueError(f"LM head FP8 GEMV needs a float head, got {weight.dtype}")
+    n, k = weight.shape
+    fp8, scales = quantize_block_fp8(weight.data)
+    lm_head.dsv41_fp8_weight = fp8
+    lm_head.dsv41_fp8_scale = scales
+    lm_head.dsv41_fp8_max_m = min(int(max_m), MAX_M)
+    prebuild_sm120_block_fp8_gemv(n, k, MAX_M)
+    if not keep_bf16:
+        del lm_head._parameters["weight"]
+        lm_head.weight = None
+        torch.cuda.empty_cache()
+    logger.info(
+        "LM head FP8 GEMV installed: shard [%d, %d], fp8 %.0f MB, scales %.1f MB, bf16 %s",
+        n, k, fp8.numel() / 1e6, scales.numel() * 4 / 1e6, "kept" if keep_bf16 else "freed",
+    )
+
+
+def lm_head_fp8_gemv(lm_head: nn.Module, hidden_states: torch.Tensor) -> torch.Tensor:
+    """logits[M, N] = hidden_states[M, K] @ dequant(fp8 shard).T in bf16.
+
+    :param lm_head: a head prepared by :func:`install_lm_head_fp8_gemv`.
+    :param hidden_states: [M, K] activations (any float dtype; cast to bf16).
+    :returns: bf16 [M, N] logits for this rank's vocab shard.
+    """
+    x = hidden_states.to(torch.bfloat16)
+    if not x.is_contiguous():
+        x = x.contiguous()
+    w, s = lm_head.dsv41_fp8_weight, lm_head.dsv41_fp8_scale
+    m = x.shape[0]
+    if m <= lm_head.dsv41_fp8_max_m:
+        return sm120_block_fp8_gemv(x, w, s)
+    bf16 = lm_head.weight
+    if bf16 is not None:
+        return torch.matmul(x, bf16.T)
+    return torch.cat([sm120_block_fp8_gemv(x[i : i + MAX_M], w, s) for i in range(0, m, MAX_M)])
