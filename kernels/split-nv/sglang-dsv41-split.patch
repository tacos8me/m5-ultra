--- /dev/null
+++ b/sglang/kernels/jit/csrc/gemm/sm120_block_fp8_gemv.cuh
@@ -0,0 +1,272 @@
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.h>
+
+#include <sgl_kernel/type.cuh>
+#include <sgl_kernel/utils.cuh>
+
+#include <tvm/ffi/container/tensor.h>
+
+#include <cstdint>
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+
+namespace sglang {
+
+using namespace device;
+
+// Few-token block-scaled FP8 GEMV for SM120 decode:
+//   y[m, n] = sum_k x_bf16[m, k] * (W_fp8[n, k] * S[n / 32, k / 32]).
+//
+// W is the [32, 32]-block ue8m0 weight of DeepSeek-V4.1 dense linears with its
+// fp32 block scales S[ceil(N / 32), K / 32] exactly as loaded (weight_scale_inv).
+// The bf16 activations are consumed directly, so no activation quantize kernel
+// runs before the GEMV and the result is closer to the bf16 reference than the
+// MXFP8 tensor-core path, which quantizes x to e4m3 with per-32 e8m0 scales.
+//
+// The row count m is a kernel argument bounded by the compile-time bucket kMaxM
+// (1, 2, 4, 8, 16 or 32), so a decode step whose M varies per call (DSpark
+// draft-extend and verify produce every M in 1..6*bs) never compiles a new
+// variant: one build per (shape, bucket).
+//
+// Same streaming design as sm120_fp8_gemv.cuh: the activation rows are staged
+// in shared memory when the bucket fits static shared memory (kMaxM * K * 2 <=
+// 48 KB) and otherwise read through the read-only cache, one warp computes kRows
+// consecutive output rows and streams each weight row once with evict-first 16 B
+// loads (kUnroll of them in flight per lane), and the reduction is a register +
+// warp-shuffle tree. A lane's 16 consecutive K values lie inside one 32-wide
+// scale block, so each chunk dot product is scaled once. K only needs to be a
+// multiple of 16: the last warp step masks lanes past K. Work per streamed
+// weight byte grows linearly in m (m fp32 FMAs), so past m ~ 24 the CUDA-core
+// FMAs, not HBM, bound the kernel.
+
+constexpr uint32_t kChunk = 16;  // 16 fp8 values per 16 B weight load
+constexpr uint32_t kStaticSmemBytes = 48 * 1024;
+
+__device__ __forceinline__ void fp8x16_to_f32(const float4 wv, float (&f)[kChunk]) {
+  const __nv_fp8x2_e4m3* w2 = reinterpret_cast<const __nv_fp8x2_e4m3*>(&wv);
+#pragma unroll
+  for (int i = 0; i < 8; ++i) {
+    const float2 w01 = static_cast<float2>(w2[i]);
+    f[2 * i] = w01.x;
+    f[2 * i + 1] = w01.y;
+  }
+}
+
+template <bool kGlobal>
+__device__ __forceinline__ float dot16_bf16_f32(const float (&f)[kChunk], const bf16_t* xs) {
+  float4 x0, x1;
+  if constexpr (kGlobal) {
+    x0 = __ldg(reinterpret_cast<const float4*>(xs));
+    x1 = __ldg(reinterpret_cast<const float4*>(xs + 8));
+  } else {
+    x0 = *reinterpret_cast<const float4*>(xs);
+    x1 = *reinterpret_cast<const float4*>(xs + 8);
+  }
+  const __nv_bfloat162* xa = reinterpret_cast<const __nv_bfloat162*>(&x0);
+  const __nv_bfloat162* xb = reinterpret_cast<const __nv_bfloat162*>(&x1);
+  float acc = 0.0f;
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const float2 xv = __bfloat1622float2(xa[i]);
+    acc = fmaf(f[2 * i], xv.x, acc);
+    acc = fmaf(f[2 * i + 1], xv.y, acc);
+  }
+#pragma unroll
+  for (int i = 0; i < 4; ++i) {
+    const float2 xv = __bfloat1622float2(xb[i]);
+    acc = fmaf(f[8 + 2 * i], xv.x, acc);
+    acc = fmaf(f[8 + 2 * i + 1], xv.y, acc);
+  }
+  return acc;
+}
+
+template <uint32_t N, uint32_t K, uint32_t kMaxM, uint32_t kRows, uint32_t kUnroll, uint32_t kNumWarps,
+          bool kUsePDL>
+__global__ void __launch_bounds__(kNumWarps * 32) sm120_block_fp8_gemv_kernel(
+    bf16_t* __restrict__ out,
+    const bf16_t* __restrict__ x,
+    const uint8_t* __restrict__ w,
+    const float* __restrict__ scale,
+    const uint32_t m) {
+  constexpr bool kStageX = kMaxM * K * sizeof(bf16_t) <= kStaticSmemBytes;
+  constexpr uint32_t kSmemElems = kStageX ? kMaxM * K : 8;
+  __shared__ __align__(16) bf16_t sx[kSmemElems];
+  constexpr uint32_t kScaleCols = K / 32;
+  constexpr uint32_t kStep = 32 * kChunk * kUnroll;
+
+  const uint32_t tid = threadIdx.x;
+  const uint32_t warp = tid / 32;
+  const uint32_t lane = tid % 32;
+  const uint32_t r0 = (blockIdx.x * kNumWarps + warp) * kRows;
+
+  // PDL: the weight and its scales do not depend on the previous kernel, so the
+  // first k-step of every row is fetched before griddepcontrol.wait; only the
+  // activation read (x) waits. With PDL off the wait is a no-op and the loads
+  // simply move ahead of the x staging.
+  float4 wv0[kRows][kUnroll];
+  float sv0[kRows][kUnroll];
+  {
+    const uint32_t kbase = lane * kChunk * kUnroll;
+#pragma unroll
+    for (uint32_t r = 0; r < kRows; ++r) {
+      const uint32_t row = r0 + r;
+      const bool row_ok = row < N;
+      const uint8_t* wr = w + static_cast<size_t>(row_ok ? row : 0) * K + kbase;
+      const float* sr = scale + static_cast<size_t>((row_ok ? row : 0) >> 5) * kScaleCols;
+#pragma unroll
+      for (uint32_t u = 0; u < kUnroll; ++u) {
+        const uint32_t kk = kbase + u * kChunk;
+        const bool ok = row_ok && kk < K;
+        if (ok) {
+          wv0[r][u] = __ldcs(reinterpret_cast<const float4*>(wr + u * kChunk));
+          sv0[r][u] = __ldg(sr + (kk >> 5));
+        } else {
+          wv0[r][u] = make_float4(0.f, 0.f, 0.f, 0.f);
+          sv0[r][u] = 0.f;
+        }
+      }
+    }
+  }
+  PDLWaitPrimary<kUsePDL>();
+  // Let the next kernel launch now: its own pre-wait prologue overlaps this
+  // grid's streaming loop, and its griddepcontrol.wait still covers every
+  // store below (wait = full completion of this grid).
+  PDLTriggerSecondary<kUsePDL>();
+
+  if constexpr (kStageX) {
+    const uint32_t total = m * K;
+    for (uint32_t i = tid * 8; i < total; i += kNumWarps * 32 * 8) {
+      *reinterpret_cast<float4*>(sx + i) = *reinterpret_cast<const float4*>(x + i);
+    }
+    __syncthreads();
+  }
+  const bf16_t* xrows = kStageX ? sx : x;
+
+  if (r0 >= N) {
+    return;
+  }
+
+  float acc[kRows][kMaxM];
+#pragma unroll
+  for (uint32_t r = 0; r < kRows; ++r) {
+#pragma unroll
+    for (uint32_t mi = 0; mi < kMaxM; ++mi) {
+      acc[r][mi] = 0.0f;
+    }
+  }
+
+  constexpr uint32_t kSteps = (K + kStep - 1) / kStep;
+  constexpr bool kTail = (K % kStep) != 0;
+  constexpr bool kRowTail = (N % kRows) != 0;
+
+#pragma unroll
+  for (uint32_t s = 0; s < kSteps; ++s) {
+    const uint32_t kbase = s * kStep + lane * kChunk * kUnroll;
+#pragma unroll
+    for (uint32_t r = 0; r < kRows; ++r) {
+      const uint32_t row = r0 + r;
+      const bool row_ok = !kRowTail || row < N;
+      const uint8_t* wr = w + static_cast<size_t>(row) * K + kbase;
+      const float* sr = scale + static_cast<size_t>(row >> 5) * kScaleCols;
+      float4 wv[kUnroll];
+      float sv[kUnroll];
+      if (s == 0) {
+#pragma unroll
+        for (uint32_t u = 0; u < kUnroll; ++u) {
+          wv[u] = wv0[r][u];
+          sv[u] = sv0[r][u];
+        }
+      } else {
+#pragma unroll
+        for (uint32_t u = 0; u < kUnroll; ++u) {
+          const uint32_t kk = kbase + u * kChunk;
+          const bool ok = row_ok && (!kTail || kk < K);
+          if (ok) {
+            wv[u] = __ldcs(reinterpret_cast<const float4*>(wr + u * kChunk));
+            sv[u] = __ldg(sr + (kk >> 5));
+          } else {
+            wv[u] = make_float4(0.f, 0.f, 0.f, 0.f);
+            sv[u] = 0.f;
+          }
+        }
+      }
+#pragma unroll
+      for (uint32_t u = 0; u < kUnroll; ++u) {
+        const uint32_t kk = kbase + u * kChunk;
+        if (!kTail || kk < K) {
+          float f[kChunk];
+          fp8x16_to_f32(wv[u], f);
+#pragma unroll
+          for (uint32_t mi = 0; mi < kMaxM; ++mi) {
+            if (kMaxM == 1 || mi < m) {
+              acc[r][mi] =
+                  fmaf(sv[u], dot16_bf16_f32<!kStageX>(f, xrows + mi * K + kk), acc[r][mi]);
+            }
+          }
+        }
+      }
+    }
+  }
+
+#pragma unroll
+  for (uint32_t r = 0; r < kRows; ++r) {
+#pragma unroll
+    for (uint32_t mi = 0; mi < kMaxM; ++mi) {
+#pragma unroll
+      for (uint32_t off = 16; off > 0; off >>= 1) {
+        acc[r][mi] += __shfl_down_sync(0xffffffff, acc[r][mi], off);
+      }
+    }
+  }
+  if (lane == 0) {
+#pragma unroll
+    for (uint32_t r = 0; r < kRows; ++r) {
+      if (!kRowTail || r0 + r < N) {
+#pragma unroll
+        for (uint32_t mi = 0; mi < kMaxM; ++mi) {
+          if (kMaxM == 1 || mi < m) {
+            out[static_cast<size_t>(mi) * N + r0 + r] = cast<bf16_t>(acc[r][mi]);
+          }
+        }
+      }
+    }
+  }
+}
+
+template <uint32_t N, uint32_t K, uint32_t kMaxM, uint32_t kRows, uint32_t kUnroll, uint32_t kNumWarps,
+          bool kUsePDL>
+struct Sm120BlockFp8GemvKernel {
+  static_assert(K % 32 == 0, "K must be a multiple of the 32-wide scale block");
+  static_assert(kMaxM >= 1 && kMaxM <= 32, "few-token GEMV bucket");
+
+  static void
+  run(const tvm::ffi::TensorView x,
+      const tvm::ffi::TensorView w,
+      const tvm::ffi::TensorView scale,
+      const tvm::ffi::TensorView out) {
+    using namespace host;
+
+    auto M = SymbolicSize{"num_tokens"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+    constexpr uint32_t kScaleRows = (N + 31) / 32;
+    TensorMatcher({M, K}).with_dtype<bf16_t>().with_device(device).verify(x);
+    TensorMatcher({N, K}).with_dtype<fp8_e4m3_t>().with_device(device).verify(w);
+    TensorMatcher({kScaleRows, K / 32}).with_dtype<fp32_t>().with_device(device).verify(scale);
+    TensorMatcher({M, N}).with_dtype<bf16_t>().with_device(device).verify(out);
+    const auto m = static_cast<uint32_t>(M.unwrap());
+    CHECK_HOST(m >= 1 && m <= kMaxM) << "rows " << m << " outside bucket 1.." << kMaxM;
+
+    constexpr uint32_t kRowsPerBlock = kRows * kNumWarps;
+    constexpr uint32_t kNumBlocks = (N + kRowsPerBlock - 1) / kRowsPerBlock;
+    LaunchKernel(kNumBlocks, kNumWarps * 32, device.unwrap()).enable_pdl(kUsePDL)(
+        sm120_block_fp8_gemv_kernel<N, K, kMaxM, kRows, kUnroll, kNumWarps, kUsePDL>,
+        static_cast<bf16_t*>(out.data_ptr()),
+        static_cast<const bf16_t*>(x.data_ptr()),
+        static_cast<const uint8_t*>(w.data_ptr()),
+        static_cast<const float*>(scale.data_ptr()),
+        m);
+  }
+};
+
+}  // namespace sglang
diff --git a/sglang/kernels/jit/csrc/gemm/sm120_block_fp8_grouped_gemv.cuh b/sglang/kernels/jit/csrc/gemm/sm120_block_fp8_grouped_gemv.cuh
new file mode 100644
index 0000000..92772c3
--- /dev/null
+++ b/sglang/kernels/jit/csrc/gemm/sm120_block_fp8_grouped_gemv.cuh
@@ -0,0 +1,190 @@
+#include <sgl_kernel/tensor.h>
+#include <sgl_kernel/utils.h>
+#include <sgl_kernel/type.cuh>
+#include <sgl_kernel/utils.cuh>
+#include <tvm/ffi/container/tensor.h>
+
+#include <cstdint>
+#include <cuda_bf16.h>
+#include <cuda_fp8.h>
+
+#include "sm120_block_fp8_gemv.cuh"
+
+namespace sglang {
+
+using namespace device;
+
+// Grouped few-token block-scaled FP8 GEMV for SM120 decode:
+//   y[m, g, n] = sum_k x_bf16[m, g, k] * (W_fp8[g * N + n, k] * S[(g * N + n) / 32, k / 32])
+//
+// The DeepSeek-V4.1 attention output absorb ``wo_a`` (einsum "tgd,grd->tgr") is
+// G independent [N, K] linears whose inputs are G contiguous slices of one
+// activation row. The checkpoint ships wo_a as [32, 32]-block ue8m0 fp8; this
+// kernel reads that fp8 weight directly (scales as fp32 = 2^e, exactly the
+// checkpoint value), so the result equals the bf16-dequantized einsum up to
+// fp32 summation order while streaming half the bytes.
+//
+// Grid: (row blocks of one group, G). Same per-warp streaming loop as
+// sm120_block_fp8_gemv_kernel; only the activation row stride (G * K), the
+// weight/scale row base (g * N) and the output row stride (G * N) differ.
+template <uint32_t G, uint32_t N, uint32_t K, uint32_t kMaxM, uint32_t kRows, uint32_t kUnroll, uint32_t kNumWarps>
+__global__ void __launch_bounds__(kNumWarps * 32) sm120_block_fp8_grouped_gemv_kernel(
+    bf16_t* __restrict__ out,
+    const bf16_t* __restrict__ x,
+    const uint8_t* __restrict__ w,
+    const float* __restrict__ scale,
+    const uint32_t m) {
+  constexpr bool kStageX = kMaxM * K * sizeof(bf16_t) <= kStaticSmemBytes;
+  constexpr uint32_t kSmemElems = kStageX ? kMaxM * K : 8;
+  __shared__ __align__(16) bf16_t sx[kSmemElems];
+  constexpr uint32_t kScaleCols = K / 32;
+  constexpr uint32_t kXStride = G * K;  // elements between activation rows
+  constexpr uint32_t kYStride = G * N;  // elements between output rows
+
+  const uint32_t g = blockIdx.y;
+  const uint32_t tid = threadIdx.x;
+  PDLWaitPrimary<true>();  // griddepcontrol.wait is a no-op unless launched with PDL
+  const bf16_t* xg = x + static_cast<size_t>(g) * K;  // this group's slice of row 0
+  if constexpr (kStageX) {
+    // stage m rows of K contiguous elements each (rows are kXStride apart in global)
+    for (uint32_t i = tid * 8; i < m * K; i += kNumWarps * 32 * 8) {
+      const uint32_t mi = i / K;
+      const uint32_t kk = i - mi * K;
+      *reinterpret_cast<float4*>(sx + mi * K + kk) =
+          *reinterpret_cast<const float4*>(xg + static_cast<size_t>(mi) * kXStride + kk);
+    }
+    __syncthreads();
+  }
+  constexpr uint32_t kXRow = kStageX ? K : kXStride;
+  const bf16_t* xrows = kStageX ? sx : xg;
+
+  const uint32_t warp = tid / 32;
+  const uint32_t lane = tid % 32;
+  const uint32_t r0 = (blockIdx.x * kNumWarps + warp) * kRows;
+  if (r0 >= N) {
+    return;
+  }
+  const uint8_t* wg = w + static_cast<size_t>(g) * N * K;
+  const float* sg = scale + static_cast<size_t>(g) * (N / 32) * kScaleCols;
+
+  float acc[kRows][kMaxM];
+#pragma unroll
+  for (uint32_t r = 0; r < kRows; ++r) {
+#pragma unroll
+    for (uint32_t mi = 0; mi < kMaxM; ++mi) {
+      acc[r][mi] = 0.0f;
+    }
+  }
+
+  constexpr uint32_t kStep = 32 * kChunk * kUnroll;
+  constexpr uint32_t kSteps = (K + kStep - 1) / kStep;
+  constexpr bool kTail = (K % kStep) != 0;
+  constexpr bool kRowTail = (N % kRows) != 0;
+
+#pragma unroll
+  for (uint32_t s = 0; s < kSteps; ++s) {
+    const uint32_t kbase = s * kStep + lane * kChunk * kUnroll;
+#pragma unroll
+    for (uint32_t r = 0; r < kRows; ++r) {
+      const uint32_t row = r0 + r;
+      const bool row_ok = !kRowTail || row < N;
+      const uint8_t* wr = wg + static_cast<size_t>(row) * K + kbase;
+      const float* sr = sg + static_cast<size_t>(row >> 5) * kScaleCols;
+      float4 wv[kUnroll];
+      float sv[kUnroll];
+#pragma unroll
+      for (uint32_t u = 0; u < kUnroll; ++u) {
+        const uint32_t kk = kbase + u * kChunk;
+        const bool ok = row_ok && (!kTail || kk < K);
+        if (ok) {
+          wv[u] = __ldcs(reinterpret_cast<const float4*>(wr + u * kChunk));
+          sv[u] = __ldg(sr + (kk >> 5));
+        } else {
+          wv[u] = make_float4(0.f, 0.f, 0.f, 0.f);
+          sv[u] = 0.f;
+        }
+      }
+#pragma unroll
+      for (uint32_t u = 0; u < kUnroll; ++u) {
+        const uint32_t kk = kbase + u * kChunk;
+        if (!kTail || kk < K) {
+          float f[kChunk];
+          fp8x16_to_f32(wv[u], f);
+#pragma unroll
+          for (uint32_t mi = 0; mi < kMaxM; ++mi) {
+            if (kMaxM == 1 || mi < m) {
+              acc[r][mi] = fmaf(
+                  sv[u], dot16_bf16_f32<!kStageX>(f, xrows + static_cast<size_t>(mi) * kXRow + kk), acc[r][mi]);
+            }
+          }
+        }
+      }
+    }
+  }
+
+#pragma unroll
+  for (uint32_t r = 0; r < kRows; ++r) {
+#pragma unroll
+    for (uint32_t mi = 0; mi < kMaxM; ++mi) {
+#pragma unroll
+      for (uint32_t off = 16; off > 0; off >>= 1) {
+        acc[r][mi] += __shfl_down_sync(0xffffffff, acc[r][mi], off);
+      }
+    }
+  }
+  if (lane == 0) {
+#pragma unroll
+    for (uint32_t r = 0; r < kRows; ++r) {
+      if (!kRowTail || r0 + r < N) {
+#pragma unroll
+        for (uint32_t mi = 0; mi < kMaxM; ++mi) {
+          if (kMaxM == 1 || mi < m) {
+            out[static_cast<size_t>(mi) * kYStride + static_cast<size_t>(g) * N + r0 + r] =
+                cast<bf16_t>(acc[r][mi]);
+          }
+        }
+      }
+    }
+  }
+  PDLTriggerSecondary<true>();
+}
+
+template <uint32_t G, uint32_t N, uint32_t K, uint32_t kMaxM, uint32_t kRows, uint32_t kUnroll, uint32_t kNumWarps>
+struct Sm120BlockFp8GroupedGemvKernel {
+  static_assert(K % 32 == 0, "K must be a multiple of the 32-wide scale block");
+  static_assert(N % 32 == 0, "N (rows per group) must be a multiple of the 32-row scale block");
+  static_assert(kMaxM >= 1 && kMaxM <= 32, "few-token GEMV bucket");
+  static_assert(G >= 1 && G <= 64, "group count");
+
+  // x: [M, G, K] bf16, w: [G * N, K] fp8, scale: [G * N / 32, K / 32] fp32, out: [M, G, N] bf16
+  static void
+  run(const tvm::ffi::TensorView x,
+      const tvm::ffi::TensorView w,
+      const tvm::ffi::TensorView scale,
+      const tvm::ffi::TensorView out,
+      bool use_pdl) {
+    using namespace host;
+
+    auto M = SymbolicSize{"num_tokens"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+    TensorMatcher({M, G, K}).with_dtype<bf16_t>().with_device(device).verify(x);
+    TensorMatcher({G * N, K}).with_dtype<fp8_e4m3_t>().with_device(device).verify(w);
+    TensorMatcher({G * N / 32, K / 32}).with_dtype<fp32_t>().with_device(device).verify(scale);
+    TensorMatcher({M, G, N}).with_dtype<bf16_t>().with_device(device).verify(out);
+    const auto m = static_cast<uint32_t>(M.unwrap());
+    CHECK_HOST(m >= 1 && m <= kMaxM) << "rows " << m << " outside bucket 1.." << kMaxM;
+
+    constexpr uint32_t kRowsPerBlock = kRows * kNumWarps;
+    constexpr uint32_t kNumBlocks = (N + kRowsPerBlock - 1) / kRowsPerBlock;
+    LaunchKernel(dim3(kNumBlocks, G), kNumWarps * 32, device.unwrap()).enable_pdl(use_pdl)(
+        sm120_block_fp8_grouped_gemv_kernel<G, N, K, kMaxM, kRows, kUnroll, kNumWarps>,
+        static_cast<bf16_t*>(out.data_ptr()),
+        static_cast<const bf16_t*>(x.data_ptr()),
+        static_cast<const uint8_t*>(w.data_ptr()),
+        static_cast<const float*>(scale.data_ptr()),
+        m);
+  }
+};
+
+}  // namespace sglang
