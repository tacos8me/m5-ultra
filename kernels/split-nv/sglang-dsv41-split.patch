+#!/usr/bin/env python3
+"""Standalone CPU validation for the DeepSeek-V4.1 engram decode pre-gather.
+
+Runs without the GPU, the 189 GiB table, or the container-only sglang package.
+It validates the two correctness claims the optimization rests on:
+
+ 1. Static-buffer round-trip is bit-exact with the in-graph gather.
+    The in-graph Triton engram_gather dequantizes a row as
+    bf16(fp32(fp8_e4m3 row) * 2**(e8m0_exp - 127)) (see
+    sglang/kernels/ops/embeddings/engram_gather.py). _disk_gather produces the
+    same bytes from the page cache (verified bit-exact upstream, commit 86c55d7)
+    and the pre-gather stores that result into a static bf16 buffer the captured
+    graph slices. This test writes a tiny fp8+e8m0 table to a real file, maps it
+    with the _HostTable byte layout (weights then scales), reproduces _disk_gather
+    (uint8 index_select -> fp8 reinterpret -> unique/inverse dequant), stores into
+    the static buffer, and checks the sliced read equals a direct reference gather
+    and that the graph-padding rows are zero.
+
+ 2. commit=False returns the same hash ids as the in-graph (commit=True) hasher
+    and leaves the n-gram history untouched, across a multi-step decode.
+    The pre-gather computes ids eagerly before replay with commit=False; the
+    in-graph hasher owns the single per-step history commit and reads the same
+    pre-step history, so the eager ids must equal the in-graph ids. This
+    reimplements the MODE_DECODE hash (compute_engram_hash_ids) and the history
+    commit and checks both properties step by step.
+
+CPU-only on purpose: the two SM120 GPUs run a live server. Exit code 0 = PASS.
+"""
+
+from __future__ import annotations
+
+import os
+import tempfile
+
+import torch
+
+torch.manual_seed(1234)
+
+FP8_BLOCK_SIZE = 32  # matches sglang.srt.layers.attention.dsv4.torch_quant.FP8_BLOCK_SIZE
+
+
+# --------------------------------------------------------------------------
+# Part 1: static-buffer round-trip == in-graph gather (dequant arithmetic).
+# --------------------------------------------------------------------------
+
+
+def _dequant(w_fp8: torch.Tensor, s_e8m0: torch.Tensor, dim: int) -> torch.Tensor:
+    """bf16(fp32(row) * 2**(exp-127)), the arithmetic engram_gather implements
+    and _owned_rows' CPU fallback uses."""
+    rows = w_fp8.float().unflatten(-1, (-1, FP8_BLOCK_SIZE))
+    return (rows * s_e8m0.float().unsqueeze(-1)).flatten(-2).to(torch.bfloat16)
+
+
+def ref_gather(w_fp8, s_e8m0, dim, indices):
+    """Direct gather: what the in-graph engram_gather computes for `indices`."""
+    flat = indices.reshape(-1)
+    out = _dequant(w_fp8[flat], s_e8m0[flat], dim)
+    return out.view(*indices.shape, dim)
+
+
+def disk_gather_from_file(disk_w_u8, disk_s_u8, dim, indices):
+    """Reproduces EngramEmbedding._disk_gather numerics on the mmapped uint8
+    views: unique+inverse compaction, uint8 index_select, fp8 reinterpret,
+    dequant, scatter back."""
+    flat = indices.reshape(-1)
+    uniq, inverse = torch.unique(flat, return_inverse=True)
+    n = int(uniq.numel())
+    w_u8 = disk_w_u8.index_select(0, uniq)          # [n, dim] uint8
+    s_u8 = disk_s_u8.index_select(0, uniq)          # [n, dim//BLK] uint8
+    w_fp8 = w_u8.reshape(-1).view(torch.float8_e4m3fn).view(n, dim)
+    s_e8 = s_u8.reshape(-1).view(torch.float8_e8m0fnu).view(n, dim // FP8_BLOCK_SIZE)
+    out = _dequant(w_fp8, s_e8, dim)                 # [n, dim] bf16
+    return out[inverse].view(*indices.shape, dim)
+
+
+def validate_static_buffer() -> bool:
+    R, dim, n_hash_cols = 257, 128, 12  # rows, head_dim, (n-1)*n_heads
+    assert dim % FP8_BLOCK_SIZE == 0
+
+    w_fp8 = (torch.randn(R, dim) * 3).to(torch.float8_e4m3fn)
+    # e8m0 exponent bytes around 127 (2**0) so multipliers stay in a sane range.
+    s_e8m0 = torch.randint(
+        120, 135, (R, dim // FP8_BLOCK_SIZE), dtype=torch.uint8
+    ).view(torch.float8_e8m0fnu)
+
+    # Write the table to a real file with the _HostTable layout: weight bytes
+    # then scale bytes, and map it back (torch.frombuffer over the mmap).
+    w_bytes = R * dim
+    s_bytes = R * (dim // FP8_BLOCK_SIZE)
+    raw = torch.empty(w_bytes + s_bytes, dtype=torch.uint8)
+    raw[:w_bytes] = w_fp8.view(torch.uint8).reshape(-1)
+    raw[w_bytes:] = s_e8m0.view(torch.uint8).reshape(-1)
+    import mmap
+
+    path = os.path.join(tempfile.mkdtemp(), "engram_layer_0.bin")
+    with open(path, "wb") as f:
+        f.write(raw.numpy().tobytes())
+    fd = os.open(path, os.O_RDWR)
+    try:
+        mm = mmap.mmap(fd, w_bytes + s_bytes)
+        mapped = torch.frombuffer(mm, dtype=torch.uint8)
+        disk_w_u8 = mapped[:w_bytes].view(R, dim)
+        disk_s_u8 = mapped[w_bytes:].view(R, dim // FP8_BLOCK_SIZE)
+
+        ok = True
+        for step, t in enumerate([48, 1, 200, 96]):  # varied decode token counts
+            indices = torch.randint(0, R, (t, n_hash_cols), dtype=torch.int64)
+
+            ref = ref_gather(w_fp8, s_e8m0, dim, indices)                    # in-graph
+            disk = disk_gather_from_file(disk_w_u8, disk_s_u8, dim, indices)  # _disk_gather
+
+            # disk_gather must already equal the in-graph gather (bit-exact).
+            exact_disk = torch.equal(disk, ref)
+
+            # Pre-gather: store into the static buffer, zero the padding, slice.
+            cap = 256
+            buf = torch.zeros(cap, n_hash_cols, dim, dtype=torch.bfloat16)
+            buf[:t].copy_(disk)
+            buf[t:].zero_()
+            sliced = buf[:t]                                 # what the captured graph reads
+
+            exact_slice = torch.equal(sliced, ref)
+            pad_zero = (t >= cap) or torch.count_nonzero(buf[t:]).item() == 0
+
+            ok = ok and exact_disk and exact_slice and pad_zero
+            print(
+                f"  [part1] step {step} t={t:3d}: "
+                f"disk_gather==in_graph={exact_disk} "
+                f"static_slice==in_graph={exact_slice} padding_zero={pad_zero}"
+            )
+    finally:
+        os.close(fd)
+    return ok
+
+
+# --------------------------------------------------------------------------
+# Part 2: commit=False ids == commit=True ids, history untouched (decode).
+# --------------------------------------------------------------------------
+
+
+def compute_engram_hash_ids(tokens, blocked, pad_id, token_map, multipliers, primes, offsets):
+    """Verbatim port of EngramHasher.compute_engram_hash_ids (pure torch)."""
+    compressed = torch.where(blocked, pad_id, token_map[tokens])
+    products = compressed.unsqueeze(1) * multipliers
+    rolling, hashes = products[..., 0], []
+    for i in range(1, tokens.shape[-1]):
+        rolling = torch.bitwise_xor(rolling, products[..., i])
+        hashes.append(rolling.unsqueeze(-1) % primes[:, i - 1])
+    return torch.cat(hashes, dim=-1) + offsets
+
+
+def decode_hash_and_maybe_commit(
+    input_ids, positions, history, req_slots, out_cache_loc, pad_row,
+    pad_id, token_map, multipliers, primes, offsets, n, commit,
+):
+    """Port of EngramHasher.forward's MODE_DECODE path + commit, with the
+    commit flag the pre-gather adds. Returns (hash_ids, history_after)."""
+    history = history.clone()
+    hist_rows = history[req_slots].to(torch.int64)
+    tokens = torch.cat([input_ids.unsqueeze(-1), hist_rows.flip(-1)], dim=-1)
+    shifts = torch.arange(n)
+    blocked = positions.unsqueeze(-1) < shifts
+    hash_ids = compute_engram_hash_ids(
+        tokens, blocked, pad_id, token_map, multipliers, primes, offsets
+    )
+    if commit:  # the in-graph hasher owns this single per-step commit
+        commit_rows = torch.where(out_cache_loc == 0, pad_row, req_slots)
+        history[commit_rows] = tokens[:, : n - 1].flip(-1).to(history.dtype)
+    return hash_ids, history
+
+
+def validate_hash_commit() -> bool:
+    n = 4                      # max_ngram_size
+    n_heads = 3
+    n_cols = (n - 1) * n_heads
+    vocab = 200
+    num_slots = 16
+    pad_row = num_slots
+    pad_id = 0
+    bs = 5
+
+    token_map = torch.arange(vocab, dtype=torch.int64)
+    multipliers = (torch.randint(0, 1 << 20, (n,), dtype=torch.int64) * 2 + 1)
+    primes = torch.randint(101, 997, (n - 1, n_cols), dtype=torch.int64)
+    offsets = torch.randint(0, 1000, (n_cols,), dtype=torch.int64)
+    history = torch.randint(0, vocab, (num_slots + 1, n - 1), dtype=torch.int32)
+    req_slots = torch.arange(bs, dtype=torch.int64)
+
+    ok = True
+    for step in range(6):
+        input_ids = torch.randint(0, vocab, (bs,), dtype=torch.int64)
+        positions = torch.randint(n, 4096, (bs,), dtype=torch.int64)
+        out_cache_loc = torch.randint(1, 99, (bs,), dtype=torch.int64)  # all live
+
+        hist_before = history.clone()
+        # Pre-gather computes ids eagerly with commit=False.
+        eager_ids, hist_after_eager = decode_hash_and_maybe_commit(
+            input_ids, positions, history, req_slots, out_cache_loc, pad_row,
+            pad_id, token_map, multipliers, primes, offsets, n, commit=False,
+        )
+        # The captured graph's hasher recomputes from the same pre-step history
+        # and owns the commit.
+        ingraph_ids, hist_next = decode_hash_and_maybe_commit(
+            input_ids, positions, history, req_slots, out_cache_loc, pad_row,
+            pad_id, token_map, multipliers, primes, offsets, n, commit=True,
+        )
+
+        ids_match = torch.equal(eager_ids, ingraph_ids)
+        eager_no_commit = torch.equal(hist_after_eager, hist_before)
+        ingraph_committed = not torch.equal(hist_next, hist_before)
+        ok = ok and ids_match and eager_no_commit and ingraph_committed
+        print(
+            f"  [part2] step {step}: eager_ids==in_graph_ids={ids_match} "
+            f"eager_left_history_untouched={eager_no_commit} "
+            f"in_graph_committed={ingraph_committed}"
+        )
+        history = hist_next  # next step reads the committed history
+    return ok
+
+
+# --------------------------------------------------------------------------
+# Part 3: target-verify (DSpark) hash semantics.
+#   In-graph MODE_VERIFY never commits in-forward (commit_rows is None);
+#   predecessors come from the pre-verify history plus the in-batch draft
+#   block. Only the accepted prefix is committed afterwards by
+#   commit_after_verify(commit_lens), so rejected drafts never enter history.
+#   The pre-gather's eager commit=False ids must equal the in-graph ids.
+# --------------------------------------------------------------------------
+
+
+def verify_hash_and_maybe_commit(
+    input_ids, positions, history, req_slots, block,
+    pad_id, token_map, multipliers, primes, offsets, n, commit,
+):
+    """Port of EngramHasher._torch_hash_ids MODE_VERIFY + forward's commit
+    guard. Under target-verify forward sets commit_rows = None, so the commit
+    block is skipped whatever `commit` is. Returns (hash_ids, history_after)."""
+    history = history.clone()
+    num_real = input_ids.shape[0]
+    hist_rows = history[req_slots].to(torch.int64)          # [bs, n-1]
+    shifts = torch.arange(n)
+    t = torch.arange(num_real)
+    row = t // block
+    offset = t - row * block
+    # Predecessor at shift s of token t: an earlier token of the same run when
+    # s <= offset, else history[row, -(s - offset)].
+    from_batch = shifts.unsqueeze(0) <= offset.unsqueeze(-1)
+    in_batch = input_ids[(t.unsqueeze(-1) - shifts).clamp_min(0)]
+    hist_col = (n - 2 - (shifts.unsqueeze(0) - offset.unsqueeze(-1) - 1)).clamp(0, n - 2)
+    from_hist = hist_rows[row].gather(1, hist_col)
+    tokens = torch.where(from_batch, in_batch, from_hist)
+    blocked = positions.unsqueeze(-1) < shifts
+    hash_ids = compute_engram_hash_ids(
+        tokens, blocked, pad_id, token_map, multipliers, primes, offsets
+    )
+    commit_rows = None  # forward(): target-verify -> commit_rows = commit_last = None
+    if commit and commit_rows is not None:  # never taken under verify
+        raise AssertionError("unreachable under target-verify")
+    return hash_ids, history
+
+
+def commit_after_verify(history, verify_ids_2d, req_slots, commit_lens, n):
+    """Verbatim port of EngramHasher.commit_after_verify (torch path)."""
+    history = history.clone()
+    n1 = n - 1
+    window = torch.cat([history[req_slots], verify_ids_2d.to(history.dtype)], dim=1)
+    cols = commit_lens.to(torch.int64).unsqueeze(-1) + torch.arange(n1)
+    history[req_slots] = window.gather(1, cols)
+    return history
+
+
+def validate_verify_semantics() -> bool:
+    n, n_heads = 4, 3
+    n_cols = (n - 1) * n_heads
+    vocab, num_slots, bs, block = 200, 16, 3, 4   # block = num_tokens_per_req
+    pad_id = 0
+    token_map = torch.arange(vocab, dtype=torch.int64)
+    multipliers = (torch.randint(0, 1 << 20, (n,), dtype=torch.int64) * 2 + 1)
+    primes = torch.randint(101, 997, (n - 1, n_cols), dtype=torch.int64)
+    offsets = torch.randint(0, 1000, (n_cols,), dtype=torch.int64)
+    history = torch.randint(0, vocab, (num_slots + 1, n - 1), dtype=torch.int32)
+    req_slots = torch.arange(bs, dtype=torch.int64)
+
+    ok = True
+    for step in range(5):
+        verify_ids_2d = torch.randint(0, vocab, (bs, block), dtype=torch.int64)
+        input_ids = verify_ids_2d.reshape(-1)                 # bs * block tokens
+        base = torch.randint(n, 4096, (bs,), dtype=torch.int64)
+        positions = (base.unsqueeze(-1) + torch.arange(block)).reshape(-1)
+
+        hist_before = history.clone()
+        eager_ids, hist_eager = verify_hash_and_maybe_commit(
+            input_ids, positions, history, req_slots, block,
+            pad_id, token_map, multipliers, primes, offsets, n, commit=False,
+        )
+        ingraph_ids, hist_ingraph = verify_hash_and_maybe_commit(
+            input_ids, positions, history, req_slots, block,
+            pad_id, token_map, multipliers, primes, offsets, n, commit=True,
+        )
+        ids_match = torch.equal(eager_ids, ingraph_ids)
+        # Neither pass advances history in-forward under verify.
+        no_inforward_commit = torch.equal(hist_eager, hist_before) and torch.equal(
+            hist_ingraph, hist_before
+        )
+
+        # Acceptance: commit only the accepted prefix (anchor + accepted drafts).
+        commit_lens = torch.randint(0, block + 1, (bs,), dtype=torch.int64)
+        history = commit_after_verify(history, verify_ids_2d, req_slots, commit_lens, n)
+        # Expected row = last (n-1) of (old_history ++ verify_ids)[: n-1+commit_len].
+        n1 = n - 1
+        expect_ok = True
+        for b in range(bs):
+            window = torch.cat([hist_before[req_slots[b]].to(torch.int64), verify_ids_2d[b]])
+            accepted = window[: n1 + int(commit_lens[b])]
+            expect_ok = expect_ok and torch.equal(
+                history[req_slots[b]].to(torch.int64), accepted[-n1:]
+            )
+            # A rejected draft (beyond commit_len) must not be the newest entry.
+            if int(commit_lens[b]) < block:
+                rejected = int(verify_ids_2d[b, int(commit_lens[b])])
+                newest = int(history[req_slots[b], -1])
+                # Only a coincidental equal token value could match; rule it out.
+                if newest == rejected and rejected != int(accepted[-1]):
+                    expect_ok = False
+        ok = ok and ids_match and no_inforward_commit and expect_ok
+        print(
+            f"  [part3] step {step}: eager_ids==in_graph_ids={ids_match} "
+            f"no_in_forward_commit={no_inforward_commit} "
+            f"post_accept_commit_only_accepted_prefix={expect_ok}"
+        )
+    return ok
+
+
+# --------------------------------------------------------------------------
+# Part 4: per-mode static buffers are independent and address-stable.
+#   The decode and target-verify runners capture separately with different
+#   max token counts; a captured read bakes the address, so each mode owns its
+#   own buffer (sized once by its runner) instead of one shared buffer that
+#   would have to grow -- and move -- for the second runner.
+# --------------------------------------------------------------------------
+
+
+def validate_per_mode_buffers() -> bool:
+    n_hash_cols, dim = 12, 128
+    bufs: dict = {}
+
+    def enable(mode, capacity):
+        buf = bufs.get(mode)
+        if buf is not None and buf.shape[0] >= capacity and buf.shape[1] == n_hash_cols:
+            return
+        bufs[mode] = torch.zeros(capacity, n_hash_cols, dim, dtype=torch.bfloat16)
+
+    enable("decode", 256)          # decode runner: max_bs tokens
+    enable("verify", 256 * 4)      # verify runner: max_bs * num_tokens_per_req
+    distinct = bufs["decode"].data_ptr() != bufs["verify"].data_ptr()
+
+    ptr_d, ptr_v = bufs["decode"].data_ptr(), bufs["verify"].data_ptr()
+    enable("decode", 256)          # re-setup (e.g. recapture) must not move it
+    enable("verify", 256 * 4)
+    stable = bufs["decode"].data_ptr() == ptr_d and bufs["verify"].data_ptr() == ptr_v
+
+    # Filling one mode must not disturb the other.
+    bufs["decode"][:48].fill_(1.0)
+    bufs["verify"][:192].fill_(2.0)
+    isolated = (
+        torch.all(bufs["decode"][:48] == 1.0).item()
+        and torch.all(bufs["verify"][:192] == 2.0).item()
+    )
+    print(
+        f"  [part4] distinct_storage={distinct} address_stable_on_resetup={stable} "
+        f"modes_isolated={isolated}"
+    )
+    return distinct and stable and isolated
+
+
+# --------------------------------------------------------------------------
+# Part 5: sliced multi-threaded host gather == single index_select.
+#   EngramEmbedding._gather_rows_into splits the unique ids over K threads,
+#   each running one index_select slice straight into a row-slice of the
+#   pinned staging views (index_select releases the GIL, so a cold table's
+#   page faults overlap). Every row is written exactly once from the same
+#   source row, so the bytes must be bit-identical to one index_select --
+#   including n not divisible by K, n < K, n == 0 and n == 1.
+# --------------------------------------------------------------------------
+
+
+def gather_rows_into(disk_w_u8, disk_s_u8, ids, w_out, s_out, threads, pool):
+    """Verbatim port of EngramEmbedding._gather_rows_into's slicing."""
+    n = int(ids.numel())
+    k = min(max(1, threads), n)
+    if k <= 1:
+        torch.index_select(disk_w_u8, 0, ids, out=w_out)
+        torch.index_select(disk_s_u8, 0, ids, out=s_out)
+        return []
+    bounds = [(i * n // k, (i + 1) * n // k) for i in range(k)]
+
+    def part(lo, hi):
+        sub = ids[lo:hi]
+        torch.index_select(disk_w_u8, 0, sub, out=w_out[lo:hi])
+        torch.index_select(disk_s_u8, 0, sub, out=s_out[lo:hi])
+
+    list(pool.map(lambda b: part(*b), bounds))
+    return bounds
+
+
+def validate_parallel_gather() -> bool:
+    from concurrent.futures import ThreadPoolExecutor
+
+    R, dim = 20000, 128
+    sb_per = dim // FP8_BLOCK_SIZE
+    w_fp8 = (torch.randn(R, dim) * 3).to(torch.float8_e4m3fn)
+    s_e8m0 = torch.randint(120, 135, (R, sb_per), dtype=torch.uint8).view(
+        torch.float8_e8m0fnu
+    )
+    disk_w_u8 = w_fp8.view(torch.uint8).view(R, dim)      # what _disk_w_u8 is
+    disk_s_u8 = s_e8m0.view(torch.uint8).view(R, sb_per)  # what _disk_s_u8 is
+
+    ok = True
+    cases = [0, 1, 5, 16, 33, 257, 16843]  # n < K, n == K, n % K != 0, ~real 16.8K
+    for threads in (1, 3, 16):
+        pool = ThreadPoolExecutor(max_workers=max(1, threads))
+        for n in cases:
+            # Unique sorted ids, as torch.unique hands them to _disk_gather.
+            ids = torch.unique(torch.randint(0, R, (n * 2 + 1,), dtype=torch.int64))[:n]
+            n = int(ids.numel())
+            wb, need = n * dim, n * dim + n * sb_per
+            buf = torch.full((need + 64,), 0xAB, dtype=torch.uint8)  # canary tail
+            w_out = buf[:wb].view(n, dim)
+            s_out = buf[wb:need].view(n, sb_per)
+            bounds = gather_rows_into(disk_w_u8, disk_s_u8, ids, w_out, s_out, threads, pool)
+
+            single_w = torch.index_select(disk_w_u8, 0, ids)
+            single_s = torch.index_select(disk_s_u8, 0, ids)
+            exact = torch.equal(w_out, single_w) and torch.equal(s_out, single_s)
+            # The flat staging bytes (what goes H2D) equal weight-then-scale.
+            flat_ok = torch.equal(
+                buf[:need], torch.cat([single_w.reshape(-1), single_s.reshape(-1)])
+            )
+            tail_ok = bool((buf[need:] == 0xAB).all())        # no overrun
+            cover_ok = True
+            if bounds:  # slices tile [0, n) exactly, no gap / overlap
+                cover_ok = bounds[0][0] == 0 and bounds[-1][1] == n and all(
+                    bounds[i][1] == bounds[i + 1][0] for i in range(len(bounds) - 1)
+                )
+            # The staged bytes dequantize to the reference gather (Part 1 math).
+            deq_ok = True
+            if n > 0:
+                staged = _dequant(
+                    w_out.reshape(-1).view(torch.float8_e4m3fn).view(n, dim),
+                    s_out.reshape(-1).view(torch.float8_e8m0fnu).view(n, sb_per),
+                    dim,
+                )
+                deq_ok = torch.equal(staged, ref_gather(w_fp8, s_e8m0, dim, ids.view(n, 1)).view(n, dim))
+            good = exact and flat_ok and tail_ok and cover_ok and deq_ok
+            ok = ok and good
+            print(
+                f"  [part5] threads={threads:2d} n={n:5d} slices={max(1, len(bounds)):2d}: "
+                f"bytes==single_index_select={exact} flat_layout={flat_ok} "
+                f"no_overrun={tail_ok} slices_tile={cover_ok} dequant==ref={deq_ok}"
+            )
+        pool.shutdown()
+    return ok
+
+
+def main() -> int:
+    print("Engram decode pre-gather validation (CPU-only)\n")
+    print("Part 1: static buffer round-trip == in-graph engram_gather")
+    p1 = validate_static_buffer()
+    print(f"  -> {'PASS' if p1 else 'FAIL'}\n")
+    print("Part 2: decode: commit=False ids == in-graph ids, history untouched")
+    p2 = validate_hash_commit()
+    print(f"  -> {'PASS' if p2 else 'FAIL'}\n")
+    print("Part 3: target-verify: eager ids == in-graph ids; no in-forward commit;")
+    print("        post-acceptance commit advances only the accepted prefix")
+    p3 = validate_verify_semantics()
+    print(f"  -> {'PASS' if p3 else 'FAIL'}\n")
+    print("Part 4: per-mode (decode / verify) static buffers independent + stable")
+    p4 = validate_per_mode_buffers()
+    print(f"  -> {'PASS' if p4 else 'FAIL'}\n")
+    print("Part 5: sliced multi-threaded host gather == single index_select")
+    p5 = validate_parallel_gather()
+    print(f"  -> {'PASS' if p5 else 'FAIL'}\n")
+    ok = p1 and p2 and p3 and p4 and p5
+    print("OVERALL:", "PASS" if ok else "FAIL")
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
