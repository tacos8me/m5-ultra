index 0000000..5e3cf31
--- /dev/null
+++ b/sglang/benchmark/bench_sm120_block_fp8_dense.py
@@ -0,0 +1,263 @@
+"""Microbench: DeepSeek-V4.1 dense block-fp8 linears at decode M (SM120, TP2 shapes).
+
+Every dense projection of the model is a [32, 32]-block ue8m0 fp8 weight served by
+the FlashInfer CUTLASS MXFP8 GEMM (``--fp8-gemm-backend flashinfer_cutlass``): an
+activation-quantize kernel followed by ``DeviceGemmMxfp8GemmSm120``. This bench
+times that production path per real per-rank shape at decode M (``--m``) and compares
+the SM120 block-fp8 GEMV (``sglang.kernels.ops.gemm.sm120_block_fp8_gemv``), the
+GEMM alone (pre-quantized input), the cuDNN MXFP8 backend and the Triton
+block-fp8 fallback. Each shape rotates through enough distinct weight copies to
+exceed the 128 MB L2 and one graph pass touches every copy exactly once, so the
+LRU reuse distance of any copy is the whole set: HBM-streaming numbers, not L2.
+
+Run inside the SM120 image (uses < 1.5 GiB):
+
+    docker run --rm --gpus '"device=0"' -v $SRC:/sgl-workspace/sglang/python/sglang \
+      local/sglang-dsv41:base python /sgl-workspace/sglang/python/sglang/benchmark/bench_sm120_block_fp8_dense.py \
+      [--m 1,2,4,6,12,24] [--sweep]
+
+``--sweep`` additionally tunes the GEMV (rows, unroll, warps) per shape at M=1.
+"""
+
+from __future__ import annotations
+
+import argparse
+import math
+import sys
+
+import torch
+
+from sglang.kernels.ops.gemm.sm120_block_fp8_gemv import (
+    DEFAULT_CONFIG,
+    MAX_M,
+    sm120_block_fp8_gemv,
+)
+from sglang.srt.layers.quantization.fp8_utils import (
+    _raw_flashinfer_mm_mxfp8,
+    block_fp8_scale_to_mxfp8_e8m0,
+    flashinfer_mxfp8_blockscaled_linear,
+    flashinfer_mxfp8_quantize,
+    triton_w8a8_block_fp8_linear,
+)
+
+BLOCK = [32, 32]
+DEV = "cuda"
+ROOFLINE_GBS = 1600.0  # RTX PRO 6000 Blackwell sustained HBM read
+L2_BYTES = 128 << 20
+ROTATE_BYTES = 192 << 20  # per-shape weight set cycled by the graph (> L2)
+# (name, K = in_features per rank, N = out_features per rank, calls per decode step)
+# DeepSeek-V4.1-Flash at TP2: hidden 5120, q_lora 1280, head_dim 512, 64 heads,
+# o_lora 1024 x 8 groups, shared-expert intermediate 2304, 40 layers, 8 indexer layers.
+SHAPES = [
+    ("wqkv_a   5120->1792", 5120, 1792, 40),
+    ("wq_b     1280->16384", 1280, 16384, 40),
+    ("wo_b     4096->5120", 4096, 5120, 40),
+    ("sh_w13   5120->2304", 5120, 2304, 40),
+    ("sh_w2    1152->5120", 1152, 5120, 40),
+    ("idx_wq_b 1280->4096", 1280, 4096, 8),
+]
+ITERS = 40
+WARMUP = 10
+SWEEP = [
+    (rows, unroll, warps)
+    for rows in (1, 2, 4)
+    for unroll in (1, 2, 4)
+    for warps in (4, 8)
+]
+
+
+def ceil_div(a: int, b: int) -> int:
+    return (a + b - 1) // b
+
+
+def make_block_fp8_weight(n: int, k: int, gen: torch.Generator):
+    """Random weight quantized to [32, 32]-block fp8 e4m3 with ue8m0 (power-of-two)
+    fp32 scales, the checkpoint format. Returns (fp8 weight, fp32 scales)."""
+    w = torch.randn(n, k, device=DEV, dtype=torch.float32, generator=gen) * 0.02
+    bn, bk = BLOCK
+    sn, sk = ceil_div(n, bn), k // bk
+    pad_n = sn * bn - n
+    wp = torch.nn.functional.pad(w, (0, 0, 0, pad_n)) if pad_n else w
+    blocks = wp.view(sn, bn, sk, bk)
+    amax = blocks.abs().amax(dim=(1, 3), keepdim=True).clamp_min(1e-12)
+    fmax = torch.finfo(torch.float8_e4m3fn).max
+    scale = torch.exp2(torch.ceil(torch.log2(amax / fmax)))
+    wq = (blocks / scale).to(torch.float8_e4m3fn).view(sn * bn, k)[:n].contiguous()
+    return wq, scale.view(sn, sk).contiguous()
+
+
+def cutlass_swizzled_scale(scale: torch.Tensor, n: int, k: int) -> torch.Tensor:
+    """The layout Fp8LinearMethod prepares for the CUTLASS backend."""
+    from flashinfer import block_scale_interleave
+
+    scale_u8 = block_fp8_scale_to_mxfp8_e8m0(scale, (n, k), BLOCK)
+    return block_scale_interleave(scale_u8.contiguous()).contiguous()
+
+
+def bench(fn, per_call_args):
+    """Per-call us under a CUDA graph that calls `fn` once per weight copy (the
+    copies exceed L2, so every replay streams each weight from HBM, as a decode
+    step does)."""
+    ncopies = len(per_call_args)
+    for i in range(WARMUP):
+        fn(*per_call_args[i % ncopies])
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        for i in range(ncopies):
+            fn(*per_call_args[i])
+    torch.cuda.synchronize()
+    for _ in range(3):
+        g.replay()
+    torch.cuda.synchronize()
+    start = torch.cuda.Event(enable_timing=True)
+    end = torch.cuda.Event(enable_timing=True)
+    start.record()
+    for _ in range(ITERS):
+        g.replay()
+    end.record()
+    torch.cuda.synchronize()
+    return start.elapsed_time(end) / ITERS / ncopies * 1e3
+
+
+def cutlass_full(x, wq, swz):
+    return flashinfer_mxfp8_blockscaled_linear(
+        x, wq, swz, backend="cutlass", pin_tactic=True
+    )
+
+
+def cutlass_gemm_only(q, xs, wq, swz):
+    from flashinfer.autotuner import autotune
+
+    with autotune(False, skip_ops={"mxfp8_gemm"}):
+        return _raw_flashinfer_mm_mxfp8(
+            q, wq.t(), xs, swz, out_dtype=torch.bfloat16, use_8x4_sf_layout=False,
+            backend="cutlass",
+        )
+
+
+def cudnn_gemm(q, xs, wq, swz):
+    return _raw_flashinfer_mm_mxfp8(
+        q, wq.t(), xs, swz, out_dtype=torch.bfloat16, use_8x4_sf_layout=False,
+        backend="cudnn",
+    )
+
+
+def triton_fallback(x, wq, scale):
+    return triton_w8a8_block_fp8_linear(x, wq, BLOCK, scale, act_scale_ue8m0=True)
+
+
+def fmt_bw(us: float, wbytes: int) -> str:
+    gbs = wbytes / (us * 1e-6) / 1e9
+    return f"{us:7.1f}us {gbs:6.0f}GB/s {100 * gbs / ROOFLINE_GBS:4.0f}%"
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--sweep", action="store_true", help="tune GEMV config per shape")
+    ap.add_argument("--m", default="1,2,4", help="comma-separated decode M values")
+    args = ap.parse_args()
+    m_list = [int(v) for v in args.m.split(",")]
+    gen = torch.Generator(device=DEV)
+    gen.manual_seed(0)
+    cap = torch.cuda.get_device_capability()
+    print(
+        f"device={torch.cuda.get_device_name()} cap={cap} "
+        f"L2={torch.cuda.get_device_properties(0).L2_cache_size >> 20}MB "
+        f"roofline={ROOFLINE_GBS:.0f}GB/s\n"
+    )
+    step_cutlass_us = {m: 0.0 for m in m_list}
+    step_gemv_us = {m: 0.0 for m in m_list}
+    best_configs = {}
+    for name, k, n, calls in SHAPES:
+        wbytes = n * k
+        ncopies = max(2, ceil_div(ROTATE_BYTES, wbytes))
+        copies = []
+        for _ in range(ncopies):
+            wq, scale = make_block_fp8_weight(n, k, gen)
+            copies.append((wq, scale, cutlass_swizzled_scale(scale, n, k)))
+        print(f"== {name}  (K={k} N={n} {wbytes / 1e6:.1f}MB x{ncopies} copies, {calls} calls/step)")
+        for m in m_list:
+            x = torch.randn(m, k, device=DEV, dtype=torch.bfloat16, generator=gen) * 0.5
+            wq0, scale0, swz0 = copies[0]
+            # fp32 reference against the exact dequantized weight.
+            sn = ceil_div(n, 32)
+            pad = sn * 32 - n
+            wq_p = torch.nn.functional.pad(wq0.float(), (0, 0, 0, pad)) if pad else wq0.float()
+            wdq = (wq_p.view(sn, 32, k // 32, 32) * scale0.view(sn, 1, k // 32, 1)).view(sn * 32, k)[:n]
+            ref = x.float() @ wdq.T
+            out_c = cutlass_full(x, wq0, swz0)
+            d_c = (out_c.float() - ref).abs().max().item()
+            rel_c = d_c / ref.abs().max().item()
+            t_full = bench(cutlass_full, [(x, wq, swz) for wq, _, swz in copies])
+            q, xs = flashinfer_mxfp8_quantize(x, is_sf_swizzled_layout=True, alignment=32)
+            t_gemm = bench(cutlass_gemm_only, [(q, xs, wq, swz) for wq, _, swz in copies])
+            try:
+                cudnn_gemm(q, xs, wq0, swz0)
+                t_cudnn = bench(cudnn_gemm, [(q, xs, wq, swz) for wq, _, swz in copies])
+                cudnn_s = fmt_bw(t_cudnn, wbytes)
+            except Exception as e:  # backend unavailable for this shape/arch
+                cudnn_s = f"n/a ({type(e).__name__})"
+            try:
+                t_tri = bench(triton_fallback, [(x, wq, s) for wq, s, _ in copies])
+                tri_s = fmt_bw(t_tri, wbytes)
+            except Exception as e:
+                tri_s = f"n/a ({type(e).__name__})"
+            gemv_ok = m <= MAX_M
+            if gemv_ok:
+                cfg = best_configs.get((n, k)) or DEFAULT_CONFIG
+                if args.sweep and m == 1:
+                    best = None
+                    for c in SWEEP:
+                        try:
+                            t = bench(
+                                lambda x_, w_, s_, c_=c: sm120_block_fp8_gemv(x_, w_, s_, config=c_),
+                                [(x, wq, s) for wq, s, _ in copies],
+                            )
+                        except Exception as e:
+                            print(f"   cfg {c}: fail {type(e).__name__}: {str(e)[:80]}", file=sys.stderr)
+                            continue
+                        if best is None or t < best[0]:
+                            best = (t, c)
+                        print(f"   cfg rows={c[0]} unroll={c[1]} warps={c[2]}: {fmt_bw(t, wbytes)}")
+                    cfg = best[1]
+                    best_configs[(n, k)] = cfg
+                out_g = sm120_block_fp8_gemv(x, wq0, scale0, config=cfg)
+                d_g = (out_g.float() - ref).abs().max().item()
+                d_gc = (out_g.float() - out_c.float()).abs().max().item()
+                t_gemv = bench(
+                    lambda x_, w_, s_: sm120_block_fp8_gemv(x_, w_, s_, config=cfg),
+                    [(x, wq, s) for wq, s, _ in copies],
+                )
+                gemv_s = f"{fmt_bw(t_gemv, wbytes)} cfg={cfg}"
+                step_gemv_us[m] += calls * t_gemv
+            else:
+                gemv_s, d_g, d_gc = "n/a", float("nan"), float("nan")
+                step_gemv_us[m] += calls * t_full
+            step_cutlass_us[m] += calls * t_full
+            print(
+                f"  M={m}  cutlass(quant+gemm) {fmt_bw(t_full, wbytes)} | gemm-only {fmt_bw(t_gemm, wbytes)}"
+                f" | cudnn {cudnn_s} | triton {tri_s}\n"
+                f"       gemv {gemv_s}\n"
+                f"       max|d| vs fp32 ref: cutlass {d_c:.4g} ({100 * rel_c:.2f}% of max|y|)"
+                f"  gemv {d_g:.4g}  |  gemv vs cutlass {d_gc:.4g}"
+            )
+        del copies
+        torch.cuda.empty_cache()
+        print()
+    print("== per-step estimate (sum over shapes x calls/step, TP rank 0)")
+    for m in m_list:
+        c_ms = step_cutlass_us[m] / 1e3
+        g_ms = step_gemv_us[m] / 1e3
+        print(
+            f"  M={m}: cutlass {c_ms:.2f} ms/step -> gemv {g_ms:.2f} ms/step"
+            f"  (saves {c_ms - g_ms:.2f} ms/step)"
+        )
+    if best_configs:
+        print("best GEMV configs (n, k) -> (rows, unroll, warps):")
+        for key, cfg in best_configs.items():
+            print(f"  {key}: {cfg}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/sglang/benchmark/bench_sm120_flat_mxfp4_moe.py b/sglang/benchmark/bench_sm120_flat_mxfp4_moe.py
new file mode 100644
index 0000000..88a3cca
--- /dev/null
+++ b/sglang/benchmark/bench_sm120_flat_mxfp4_moe.py
@@ -0,0 +1,163 @@
+"""Microbench: DeepSeek-V4.1 routed experts at decode M on SM120 (TP2 shapes).
+
+Times one MoE layer call (E experts per rank, top-k routing) on the production
+FlashInfer CUTLASS SM120 MXFP4 path (activation quantize + grouped GEMMs +
+activation + finalize) against the flat persistent MXFP4 MoE
+(``sglang.kernels.ops.moe.sm120_flat_mxfp4_moe``). ``--copies`` distinct expert
+sets are cycled inside one CUDA graph so every call streams cold weights from
+HBM (each set is E x 8.9 MB; 8 copies of 224 experts = 16 GB), and the effective
+bandwidth is reported against the bytes of the experts each call actually
+routes to (distinct experts x per-expert bytes).
+
+Run inside the SM120 image with the GPUs idle:
+    docker run --rm --gpus '"device=0"' -v $SRC:/sgl-workspace/sglang/python/sglang:ro \
+      -v /mnt/nvme-1/dsv41-sglang-jit:/root/.cache/sglang local/sglang-dsv41:base \
+      python /sgl-workspace/sglang/python/sglang/benchmark/bench_sm120_flat_mxfp4_moe.py \
+      [--m 1,4,6,12,24,48,64] [--experts 224] [--copies 8] [--no-pdl]
+"""
+
+from __future__ import annotations
+
+import argparse
+import sys
+import time
+
+import torch
+
+from sglang.kernels.ops.moe.sm120_flat_mxfp4_moe import (
+    flat_mxfp4_moe_quantized,
+    occupancy_report,
+    quantize_activations,
+)
+
+DEV = "cuda"
+HIDDEN = 5120
+INTER = 1152  # per rank at TP2
+TOPK = 6
+ITERS = 20
+
+
+def make_set(num_experts, gen):
+    from flashinfer import block_scale_interleave
+
+    w13 = torch.randint(0, 256, (num_experts, 2 * INTER, HIDDEN // 2), dtype=torch.uint8, device=DEV, generator=gen)
+    w2 = torch.randint(0, 256, (num_experts, HIDDEN, INTER // 2), dtype=torch.uint8, device=DEV, generator=gen)
+    w13_sf = torch.randint(118, 124, (num_experts, 2 * INTER, HIDDEN // 32), dtype=torch.uint8, device=DEV, generator=gen)
+    w2_sf = torch.randint(118, 124, (num_experts, HIDDEN, INTER // 32), dtype=torch.uint8, device=DEV, generator=gen)
+    return (
+        w13,
+        block_scale_interleave(w13_sf).reshape_as(w13_sf),
+        w2,
+        block_scale_interleave(w2_sf).reshape_as(w2_sf),
+    )
+
+
+def routing(m, num_experts, gen):
+    ids = torch.stack([torch.randperm(num_experts, device=DEV, generator=gen)[:TOPK] for _ in range(m)]).int()
+    weights = torch.rand((m, TOPK), dtype=torch.float32, device=DEV, generator=gen)
+    return ids, weights
+
+
+def flashinfer_call(x, ids, weights, w13, w13_swz, w2, w2_swz, num_experts, out):
+    from flashinfer import mxfp8_quantize
+    from flashinfer.fused_moe import ActivationType, cutlass_fused_moe
+
+    xq, input_sf = mxfp8_quantize(x, is_sf_swizzled_layout=True, alignment=32)
+    ones = torch.ones(num_experts, dtype=torch.float32, device=DEV)
+    cutlass_fused_moe(
+        input=xq,
+        token_selected_experts=ids,
+        token_final_scales=weights,
+        fc1_expert_weights=w13.view(torch.int64),
+        fc2_expert_weights=w2.view(torch.int64),
+        output_dtype=torch.bfloat16,
+        quant_scales=[w13_swz.view(torch.int32), ones, w2_swz.view(torch.int32), ones],
+        input_sf=input_sf,
+        fc1_expert_biases=None,
+        fc2_expert_biases=None,
+        swiglu_alpha=None,
+        swiglu_beta=None,
+        swiglu_limit=None,
+        tp_size=1,
+        tp_rank=0,
+        ep_size=1,
+        ep_rank=0,
+        use_w4_group_scaling=False,
+        use_mxfp8_act_scaling=True,
+        activation_type=ActivationType.Swiglu,
+        tune_max_num_tokens=max(1, 1 << (x.shape[0] - 1).bit_length()),
+        output=out,
+        use_fused_finalize=True,
+    )
+
+
+def flat_call(x, ids, weights, w13, w13_swz, w2, w2_swz, out, use_pdl):
+    xq, xsf = quantize_activations(x)
+    flat_mxfp4_moe_quantized(
+        xq, xsf, ids, weights, w13, w13_swz, w2, w2_swz, limit=10.0, clamp=True, use_pdl=use_pdl, out=out
+    )
+
+
+def time_graph(fn_per_copy, copies):
+    s = torch.cuda.Stream()
+    with torch.cuda.stream(s):
+        for c in range(copies):
+            fn_per_copy(c)
+    torch.cuda.current_stream().wait_stream(s)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        for c in range(copies):
+            fn_per_copy(c)
+    for _ in range(3):
+        g.replay()
+    torch.cuda.synchronize()
+    t0 = time.perf_counter()
+    for _ in range(ITERS):
+        g.replay()
+    torch.cuda.synchronize()
+    return (time.perf_counter() - t0) / (ITERS * copies)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--m", default="1,4,6,12,24,48,64")
+    ap.add_argument("--experts", type=int, default=224)
+    ap.add_argument("--copies", type=int, default=8)
+    ap.add_argument("--no-pdl", action="store_true")
+    args = ap.parse_args()
+    gen = torch.Generator(device=DEV)
+    gen.manual_seed(1)
+    print("occupancy:", occupancy_report(HIDDEN, INTER, True), flush=True)
+    sets = [make_set(args.experts, gen) for _ in range(args.copies)]
+    per_expert_bytes = (2 * INTER * HIDDEN // 2 + 2 * INTER * HIDDEN // 32) + (HIDDEN * INTER // 2 + HIDDEN * INTER // 32)
+    print(f"{'M':>3} {'distinct E':>10} {'bytes/call MB':>13} {'flat us':>9} {'flat GB/s':>10} {'cutlass us':>11} {'cutlass GB/s':>13} {'speedup':>8}")
+    for m in [int(v) for v in args.m.split(",")]:
+        xs = [torch.randn((m, HIDDEN), dtype=torch.float32, device=DEV, generator=gen).bfloat16() for _ in range(args.copies)]
+        routes = [routing(m, args.experts, gen) for _ in range(args.copies)]
+        distinct = sum(len(torch.unique(r[0])) for r in routes) / args.copies
+        mbytes = distinct * per_expert_bytes / 1e6
+        outs = [torch.empty((m, HIDDEN), dtype=torch.bfloat16, device=DEV) for _ in range(args.copies)]
+
+        def flat(c):
+            w13, w13_swz, w2, w2_swz = sets[c]
+            flat_call(xs[c], routes[c][0], routes[c][1], w13, w13_swz, w2, w2_swz, outs[c], not args.no_pdl)
+
+        def cutlass(c):
+            w13, w13_swz, w2, w2_swz = sets[c]
+            flashinfer_call(xs[c], routes[c][0], routes[c][1], w13, w13_swz, w2, w2_swz, args.experts, outs[c])
+
+        t_flat = time_graph(flat, args.copies)
+        try:
+            t_cut = time_graph(cutlass, args.copies)
+        except Exception as exc:  # noqa: BLE001
+            print(f"cutlass path failed at M={m}: {type(exc).__name__}: {str(exc)[:120]}", file=sys.stderr)
+            t_cut = float("nan")
+        print(
+            f"{m:>3} {distinct:>10.1f} {mbytes:>13.1f} {t_flat*1e6:>9.1f} {mbytes/1e3/t_flat:>10.0f} "
+            f"{t_cut*1e6:>11.1f} {mbytes/1e3/t_cut:>13.0f} {t_cut/t_flat:>8.2f}",
+            flush=True,
+        )
+
+
+if __name__ == "__main__":
+    main()
