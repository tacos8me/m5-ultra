+                "calls": layer._expert_stats_calls,
+                "counts": counts.cpu(),
+                "weight_sum": layer._expert_weight_sum.cpu(),
+                "weight_sq": layer._expert_weight_sq.cpu(),
+                "weight_max": layer._expert_weight_max.cpu(),
+            },
+            os.path.join(_EXPERT_STATS_DIR, f"{method.prefix}.rank{rank}.pt"),
+        )
