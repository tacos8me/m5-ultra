diff --git a/sglang/srt/model_loader/expert_pack/make_keep_set.py b/sglang/srt/model_loader/expert_pack/make_keep_set.py
new file mode 100644
index 0000000..66f1458
--- /dev/null
+++ b/sglang/srt/model_loader/expert_pack/make_keep_set.py
@@ -0,0 +1,169 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Build an expert keep-set JSON from the routing statistics the MXFP4 MoE
+method logs under ``SGLANG_DSV41_EXPERT_STATS_DIR``.
+
+Each ``<prefix>.rank<r>.pt`` holds, per expert (plus one trailing padding bin):
+``counts`` (hits), ``weight_sum`` (sum of top-k gate weights), ``weight_sq``
+(sum of squared weights) and ``weight_max``. ``count`` ranks by routing
+frequency; ``weight_sum`` is the REAP-style saliency proxy
+(importance = sum over tokens of the gate weight, i.e. how much output mass the
+expert actually contributes), which usually keeps the *useful* experts rather
+than merely the *busy* ones. Stats are summed across ranks; under TP every rank
+sees the same routing, so this only rescales and leaves rankings unchanged.
+
+Two layer families share one JSON, keyed as ``SGLANG_DSV41_EXPERT_KEEP_SET``
+consumes them: target decoder layers (stats prefix ``model.layers.N.mlp.experts``,
+key ``"N"``, ``--keep``) and DSpark drafter stages (stats prefix
+``stages.N.mlp.experts``, key ``"mtp.N"``, ``--keep-draft``). Drafter stats exist
+only when the profiling boot ran DSpark eagerly (``--speculative-algorithm DSPARK``
+with ``--disable-cuda-graph``). ``--base`` carries the entries of an existing
+keep set forward, so a drafter set can be added to a target set built from an
+earlier profile. Prints, per family and criterion, the fraction of routing mass
+the chosen sets cover (worst layer / mean).
+
+Examples:
+  python3 -m sglang.srt.model_loader.expert_pack.make_keep_set \\
+    --stats /path/stats --keep 224 --keep-draft 64 --out keep224_d64.json
+  python3 -m sglang.srt.model_loader.expert_pack.make_keep_set \\
+    --stats /path/stats --base keep224.json --keep-draft 64 --out keep224_d64.json
+"""
+
+from __future__ import annotations
+
+import argparse
+import glob
+import json
+import os
+import sys
+from collections import defaultdict
+from pathlib import Path
+
+import torch
+
+from sglang.srt.layers.quantization.mxfp4_expert_store import (
+    KeepKey,
+    keep_key_of,
+    parse_keep_key,
+)
+
+CRITERIA = ("count", "weight_sum", "weight_sq", "weight_max")
+_KEY = {"count": "counts", "weight_sum": "weight_sum",
+        "weight_sq": "weight_sq", "weight_max": "weight_max"}
+_FAMILY = {int: "target", str: "draft"}
+
+
+def load_stats(stats_dir: str) -> dict[KeepKey, dict[str, torch.Tensor]]:
+    """Per keep key, each stat summed across ranks (padding bin dropped)."""
+    per_key: dict[KeepKey, dict[str, torch.Tensor]] = defaultdict(dict)
+    files = sorted(glob.glob(os.path.join(stats_dir, "*.rank*.pt")))
+    if not files:
+        raise SystemExit(f"no *.rank*.pt stats files under {stats_dir}")
+    for f in files:
+        d = torch.load(f, map_location="cpu")
+        key = keep_key_of(d["prefix"])
+        if key is None:
+            continue
+        for crit, k in _KEY.items():
+            if k not in d:
+                continue  # older stats file without weight accumulators
+            t = d[k][:-1].to(torch.float64)  # drop the padding bin
+            if crit == "weight_max":
+                per_key[key][crit] = torch.maximum(per_key[key][crit], t) \
+                    if crit in per_key[key] else t
+            else:
+                per_key[key][crit] = per_key[key][crit] + t \
+                    if crit in per_key[key] else t
+    if not per_key:
+        raise SystemExit("no layer-keyed stats found")
+    return per_key
+
+
+def select(stats: dict[str, torch.Tensor], keep: int, criterion: str) -> list[int]:
+    t = stats[criterion]
+    keep = min(keep, t.numel())
+    return sorted(torch.topk(t, keep).indices.tolist())
+
+
+def coverage(stats: dict[str, torch.Tensor], kept: list[int], criterion: str) -> float:
+    t = stats[criterion]
+    total = float(t.sum())
+    return float(t[torch.tensor(kept)].sum()) / total if total > 0 else 0.0
+
+
+def _sort_key(key: KeepKey) -> tuple[int, int]:
+    return (0, key) if isinstance(key, int) else (1, int(key.split(".", 1)[1]))
+
+
+def main(argv: list[str] | None = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__,
+                                 formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--stats", required=True, help="SGLANG_DSV41_EXPERT_STATS_DIR")
+    ap.add_argument("--keep", type=int, help="experts to keep per target layer")
+    ap.add_argument("--keep-draft", type=int,
+                    help="experts to keep per DSpark drafter stage (mtp.N)")
+    ap.add_argument("--base", type=Path,
+                    help="existing keep-set JSON whose entries are carried over "
+                         "(entries computed here take precedence)")
+    ap.add_argument("--criterion", choices=CRITERIA, default="weight_sum")
+    ap.add_argument("--out", type=Path, required=True, help="keep-set JSON to write")
+    args = ap.parse_args(argv)
+    if args.keep is None and args.keep_draft is None:
+        ap.error("at least one of --keep / --keep-draft is required")
+    keep_of = {"target": args.keep, "draft": args.keep_draft}
+
+    per_key = load_stats(args.stats)
+    missing = [k for k, s in per_key.items() if args.criterion not in s]
+    if missing:
+        raise SystemExit(
+            f"criterion {args.criterion!r} absent for layers {missing[:5]}...; the "
+            "stats were logged before weight accumulators existed -- re-profile, or "
+            "use --criterion count"
+        )
+    for family, keep in keep_of.items():
+        if keep is not None and not any(_FAMILY[type(k)] == family for k in per_key):
+            hint = (" (profile with --speculative-algorithm DSPARK and "
+                    "--disable-cuda-graph)" if family == "draft" else "")
+            raise SystemExit(f"no {family} layer stats under {args.stats}{hint}")
+
+    keep_set: dict[KeepKey, list[int]] = {}
+    if args.base is not None:
+        base = json.loads(args.base.read_text())
+        keep_set.update((parse_keep_key(k), sorted(int(x) for x in v))
+                        for k, v in base.items())
+    report: dict[tuple[str, str], list[float]] = defaultdict(list)
+    n_exp: dict[str, int] = {}
+    for key in sorted(per_key, key=_sort_key):
+        family = _FAMILY[type(key)]
+        keep = keep_of[family]
+        if keep is None:
+            continue
+        stats = per_key[key]
+        kept = select(stats, keep, args.criterion)
+        keep_set[key] = kept
+        n_exp[family] = stats[args.criterion].numel()
+        for crit in CRITERIA:
+            if crit in stats:
+                report[(family, crit)].append(coverage(stats, kept, crit))
+
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    out = {str(k): keep_set[k] for k in sorted(keep_set, key=_sort_key)}
+    args.out.write_text(json.dumps(out, indent=1) + "\n")
+
+    for family, keep in keep_of.items():
+        if keep is None:
+            continue
+        n_layers = sum(1 for k in keep_set if _FAMILY[type(k)] == family)
+        print(f"wrote {args.out}: {n_layers} {family} layers, keep {keep}/{n_exp[family]} "
+              f"by {args.criterion}", file=sys.stderr)
+        print(f"  coverage of {family} routing mass by the chosen set "
+              "(worst layer / mean):", file=sys.stderr)
+        for (fam, crit), vals in report.items():
+            if fam == family:
+                print(f"    {crit:11s} worst={min(vals):.4f}  "
+                      f"mean={sum(vals)/len(vals):.4f}", file=sys.stderr)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/sglang/srt/model_loader/expert_pack/prepare_v41_expert_pack.py b/sglang/srt/model_loader/expert_pack/prepare_v41_expert_pack.py
new file mode 100644
index 0000000..30376db
--- /dev/null
+++ b/sglang/srt/model_loader/expert_pack/prepare_v41_expert_pack.py
@@ -0,0 +1,260 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+"""Offline prebuild of DeepSeek-V4.1-Flash MXFP4 expert packs for NVMe streaming.
+
+Writes one contiguous file per (layer, rank) holding that rank's routed experts
+already in the exact layout the SM120 FlashInfer CUTLASS MXFP4 kernel consumes:
+``w13_weight`` / ``w2_weight`` packed FP4 bytes (unchanged on SM120) and the
+E8M0 block scales run once through ``block_scale_interleave`` -- the same
+transform ``Mxfp4FlashinferCutlassMoEMethod.process_weights_after_loading`` does
+at load time. Running it offline means the runtime maps the result directly with
+no load-time GPU round-trip and no anonymous host allocation (see
+``srt/layers/quantization/mxfp4_expert_store.py``).
+
+Expert sharding is EP (expert-parallel): rank ``r`` of ``--world`` owns experts
+``[r*E//world, (r+1)*E//world)`` with the full intermediate dimension, which
+matches the checkpoint's per-expert tensors directly (no intra-expert TP slice).
+``w13`` is assembled ``[up=w3 ; gate=w1]`` to match the method's
+``load_up_proj_weight_first=True``.
+
+Scales are interleaved on the GPU in bounded chunks (``--chunk-experts``) so peak
+VRAM stays well under 2 GiB; the packed weights are copied on the host only.
+
+Example (build every layer for a TP2/EP2 deployment):
+
+  python3 -m sglang.srt.model_loader.expert_pack.prepare_v41_expert_pack \
+    --checkpoint /home/ian/models/DeepSeek-V4.1-Flash \
+    --out-dir /mnt/nvme-1/dsv41-expert-pack --world 2
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import os
+import sys
+from pathlib import Path
+
+import torch
+
+try:
+    from sglang.srt.layers.quantization.mxfp4_expert_store import (
+        EXPERT_PARAM_NAMES,
+        pack_filename,
+        pack_is_complete,
+        write_expert_pack,
+    )
+except ImportError:  # allow running the file directly from its directory
+    sys.path.insert(0, str(Path(__file__).resolve().parents[4]))
+    from sglang.srt.layers.quantization.mxfp4_expert_store import (  # type: ignore
+        EXPERT_PARAM_NAMES,
+        pack_filename,
+        pack_is_complete,
+        write_expert_pack,
+    )
+
+
+def _parse_layer_set(spec: str, default: range) -> list[int]:
+    if not spec or spec == "all":
+        return list(default)
+    out: set[int] = set()
+    for part in spec.replace(" ", "").split(","):
+        if not part:
+            continue
+        if "-" in part:
+            lo, hi = part.split("-", 1)
+            out.update(range(int(lo), int(hi) + 1))
+        else:
+            out.add(int(part))
+    return sorted(out)
+
+
+class _CheckpointReader:
+    """Lazily opens safetensors shards and fetches expert tensors by key."""
+
+    def __init__(self, checkpoint: Path):
+        from safetensors import safe_open
+
+        self._root = checkpoint
+        self._safe_open = safe_open
+        index = json.loads((checkpoint / "model.safetensors.index.json").read_text())
+        self._weight_map: dict[str, str] = index["weight_map"]
+        self._open: dict[str, object] = {}
+
+    def get(self, key: str) -> torch.Tensor:
+        shard = self._weight_map[key]
+        handle = self._open.get(shard)
+        if handle is None:
+            handle = self._open[shard] = self._safe_open(
+                str(self._root / shard), framework="pt"
+            )
+        return handle.get_tensor(key)
+
+    def has(self, key: str) -> bool:
+        return key in self._weight_map
+
+
+def _build_rank_tensors(
+    reader: _CheckpointReader, layer: int, lo: int, hi: int, device: torch.device,
+    chunk: int,
+) -> dict[str, torch.Tensor]:
+    """Assemble this rank's four processed expert tensors for one layer.
+
+    w13 = [up=w3 ; gate=w1] along the intermediate axis (load_up_proj_weight_first).
+    Scales are block-interleaved on the GPU in ``chunk``-expert batches.
+    """
+    w13, w2, w13s, w2s = [], [], [], []
+    for e in range(lo, hi):
+        p = f"layers.{layer}.ffn.experts.{e}"
+        up_w, gate_w = reader.get(f"{p}.w3.weight"), reader.get(f"{p}.w1.weight")
+        up_s, gate_s = reader.get(f"{p}.w3.scale"), reader.get(f"{p}.w1.scale")
+        w13.append(torch.cat([up_w, gate_w], dim=0).view(torch.uint8).contiguous())
+        w13s.append(torch.cat([up_s, gate_s], dim=0).contiguous())
+        w2.append(reader.get(f"{p}.w2.weight").view(torch.uint8).contiguous())
+        w2s.append(reader.get(f"{p}.w2.scale").contiguous())
+    w13_t = torch.stack(w13)
+    w2_t = torch.stack(w2)
+    w13s_t = torch.stack(w13s)
+    w2s_t = torch.stack(w2s)
+    _interleave_scales_inplace(w13s_t, device, chunk)
+    _interleave_scales_inplace(w2s_t, device, chunk)
+    return {
+        "w13_weight": w13_t,
+        "w2_weight": w2_t,
+        "w13_weight_scale_inv": w13s_t,
+        "w2_weight_scale_inv": w2s_t,
+    }
+
+
+def _build_tp_rank_tensors(
+    reader: _CheckpointReader, layer: int, lo: int, hi: int, tp_rank: int,
+    tp_size: int, device: torch.device, chunk: int,
+) -> dict[str, torch.Tensor]:
+    """Assemble one TP rank's column-shard of ALL experts for one layer, exactly
+    as the normal TP loader splits them:
+
+    - w13 (gate_up, column-parallel): shard the intermediate/output dim. Each
+      rank gets rows ``[r*I/W, (r+1)*I/W)`` of w1 and w3; w13 = [up ; gate].
+    - w2 (down, row-parallel): shard the packed input dim (columns).
+    Scales follow the same split, then are block-interleaved on the SHARDED
+    tensor (what the loader interleaves), so the bytes match the live shard.
+    """
+    w13, w2, w13s, w2s = [], [], [], []
+    for e in range(lo, hi):
+        p = f"layers.{layer}.ffn.experts.{e}"
+        up_w, gate_w = reader.get(f"{p}.w3.weight"), reader.get(f"{p}.w1.weight")
+        up_s, gate_s = reader.get(f"{p}.w3.scale"), reader.get(f"{p}.w1.scale")
+        isz = up_w.shape[0] // tp_size      # intermediate rows per rank
+        ssz = up_s.shape[0] // tp_size
+        r0, r1 = tp_rank * isz, (tp_rank + 1) * isz
+        s0, s1 = tp_rank * ssz, (tp_rank + 1) * ssz
+        w13.append(
+            torch.cat([up_w[r0:r1], gate_w[r0:r1]], dim=0).view(torch.uint8).contiguous()
+        )
+        w13s.append(torch.cat([up_s[s0:s1], gate_s[s0:s1]], dim=0).contiguous())
+        w2_full = reader.get(f"{p}.w2.weight")
+        w2s_full = reader.get(f"{p}.w2.scale")
+        csz = w2_full.shape[1] // tp_size   # packed input cols per rank
+        scsz = w2s_full.shape[1] // tp_size
+        c0, c1 = tp_rank * csz, (tp_rank + 1) * csz
+        sc0, sc1 = tp_rank * scsz, (tp_rank + 1) * scsz
+        w2.append(w2_full[:, c0:c1].view(torch.uint8).contiguous())
+        w2s.append(w2s_full[:, sc0:sc1].contiguous())
+    w13_t, w2_t = torch.stack(w13), torch.stack(w2)
+    w13s_t, w2s_t = torch.stack(w13s), torch.stack(w2s)
+    _interleave_scales_inplace(w13s_t, device, chunk)
+    _interleave_scales_inplace(w2s_t, device, chunk)
+    return {
+        "w13_weight": w13_t,
+        "w2_weight": w2_t,
+        "w13_weight_scale_inv": w13s_t,
+        "w2_weight_scale_inv": w2s_t,
+    }
+
+
+def _interleave_scales_inplace(
+    scale_e8m0: torch.Tensor, device: torch.device, chunk: int
+) -> None:
+    """block_scale_interleave each expert's scale on the GPU, in place on the
+    host tensor, in bounded chunks. Mirrors process_weights_after_loading:
+    ``scale_u8.copy_(block_scale_interleave(scale_u8).reshape_as(scale_u8))``."""
+    from flashinfer import block_scale_interleave
+
+    n = scale_e8m0.shape[0]
+    for start in range(0, n, chunk):
+        end = min(start + chunk, n)
+        seg = scale_e8m0[start:end].to(device).view(torch.uint8).contiguous()
+        seg.copy_(block_scale_interleave(seg).reshape_as(seg))
+        scale_e8m0[start:end] = seg.view(scale_e8m0.dtype).cpu()
+
+
+def main() -> int:
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("--checkpoint", type=Path, required=True)
+    ap.add_argument("--out-dir", type=Path, required=True)
+    ap.add_argument("--world", type=int, default=2, help="parallel world size (# ranks)")
+    ap.add_argument("--shard-mode", choices=("ep", "tp"), default="ep",
+                    help="ep: each rank owns a disjoint slice of full experts. "
+                         "tp: each rank owns ALL experts column-sharded (half width "
+                         "at world=2) -- same VRAM holds 2x the experts.")
+    ap.add_argument("--ranks", default="all", help="rank subset, e.g. '0' or '0,1'")
+    ap.add_argument("--layers", default="all", help="layer subset, e.g. '20-39'")
+    ap.add_argument("--chunk-experts", type=int, default=96,
+                    help="experts per GPU scale-interleave batch (caps VRAM)")
+    ap.add_argument("--device", default="cuda:0")
+    ap.add_argument("--force", action="store_true", help="rebuild complete packs")
+    args = ap.parse_args()
+
+    cfg = json.loads((args.checkpoint / "config.json").read_text())["text_config"]
+    num_layers = int(cfg["num_hidden_layers"])
+    num_experts = int(cfg["n_routed_experts"])
+    if num_experts % args.world != 0:
+        raise SystemExit(f"{num_experts} experts not divisible by world {args.world}")
+    per_rank = num_experts // args.world
+    device = torch.device(args.device)
+    layers = _parse_layer_set(args.layers, range(num_layers))
+    ranks = (
+        list(range(args.world)) if args.ranks == "all"
+        else [int(x) for x in args.ranks.split(",")]
+    )
+    reader = _CheckpointReader(args.checkpoint)
+    args.out_dir.mkdir(parents=True, exist_ok=True)
+
+    total = len(layers) * len(ranks)
+    done = 0
+    for layer in layers:
+        for rank in ranks:
+            path = str(args.out_dir / pack_filename(layer, rank, args.world))
+            done += 1
+            if pack_is_complete(path) and not args.force:
+                print(f"[{done}/{total}] skip complete {os.path.basename(path)}",
+                      flush=True)
+                continue
+            if args.shard_mode == "tp":
+                lo, hi = 0, num_experts  # every rank holds all experts, sharded
+                tensors = _build_tp_rank_tensors(
+                    reader, layer, lo, hi, rank, args.world, device,
+                    args.chunk_experts,
+                )
+            else:
+                lo, hi = rank * per_rank, (rank + 1) * per_rank
+                tensors = _build_rank_tensors(
+                    reader, layer, lo, hi, device, args.chunk_experts
+                )
+            layout = write_expert_pack(
+                path, f"layers.{layer}.ffn.experts", rank, args.world, lo, hi,
+                tensors, num_experts_total=num_experts,
+            )
+            gib = layout.total_bytes / 2**30
+            shapes = " ".join(
+                f"{n}{tuple(tensors[n].shape)}" for n in EXPERT_PARAM_NAMES
+            )
+            print(f"[{done}/{total}] wrote {os.path.basename(path)} "
+                  f"[{args.shard_mode}] experts[{lo}:{hi}] {gib:.2f}GiB  {shapes}",
+                  flush=True)
+    print(f"done: {done} packs under {args.out_dir}", flush=True)
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
