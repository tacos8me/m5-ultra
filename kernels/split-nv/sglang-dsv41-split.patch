--- /dev/null
+++ b/sglang/srt/layers/attention/dsv4/dsv41_indexer_select.py
@@ -0,0 +1,216 @@
+"""Row-tiled top-k selection for the DeepSeek-V4.1 low-ratio prefill indexer.
+
+The dense fp4 logits kernel scores one prefill chunk's query rows against every
+compressed position a row can reach, so its fp32 output is
+``[rows, ceil4(max_lc)]`` and grows with context depth: a 2048-row chunk over
+262144 tokens of ratio-2 context is 2048 x 131072 x 4 B = 1 GiB, and the
+ratio-1 candidate-source layer needs twice that. Every step after scoring is
+per row, so :func:`dense_indexer_topk` splits the chunk into row tiles whose
+logits fit a byte budget and scores, candidate-filters, and reduces each tile
+before the next one is scored. Peak logits memory is
+``min(rows, budget // (width * 4)) x width x 4 B``; a chunk that fits the
+budget runs as one tile, exactly the untiled call.
+
+Candidate blocks (level one of the two-level top-k) are published as kept block
+ids, ``int32 [rows, min(topk_blocks, num_blocks)]`` with ``-1`` for picks that
+came back unreachable, and expanded to a position mask only for the rows that
+consume them: the ids cost ``rows x topk_blocks x 4 B`` at any context length,
+where the expanded mask cost ``rows x lc`` bytes.
+
+Pure torch, importable without the kernel packages so the tiling can be checked
+on CPU against reference scoring and top-k.
+"""
+
+from __future__ import annotations
+
+from typing import Callable, List, Optional, Sequence, Tuple
+
+import torch
+
+FP32_BYTES = 4
+
+
+def row_tiles(
+    num_rows: int, width: int, elem_bytes: int, budget_bytes: int
+) -> List[slice]:
+    """Consecutive row slices of a ``[num_rows, width]`` matrix such that each
+    tile holds at most ``budget_bytes`` (never fewer than one row). A matrix that
+    fits the budget yields the single slice ``[0, num_rows)``."""
+    rows_per_tile = max(1, budget_bytes // max(1, width * elem_bytes))
+    if rows_per_tile >= num_rows:
+        return [slice(0, num_rows)]
+    return [
+        slice(start, min(start + rows_per_tile, num_rows))
+        for start in range(0, num_rows, rows_per_tile)
+    ]
+
+
+def request_spans(q_lens_cpu: Sequence[int]) -> List[Tuple[int, int]]:
+    """``[start, end)`` row range of each request when requests own consecutive rows."""
+    spans, start = [], 0
+    for n in q_lens_cpu:
+        spans.append((start, start + n))
+        start += n
+    return spans
+
+
+def block_scores(scores: torch.Tensor, block_size: int) -> torch.Tensor:
+    """Max over each ``block_size``-wide column block of ``scores``; the last
+    block may be partial. Reads ``scores`` in place, without a padded copy."""
+    width = scores.size(-1)
+    assert width > 0
+    full = width - width % block_size
+    blocks = []
+    if full:
+        blocks.append(scores[..., :full].unflatten(-1, (-1, block_size)).amax(dim=-1))
+    if full < width:
+        blocks.append(scores[..., full:].amax(dim=-1, keepdim=True))
+    return blocks[0] if len(blocks) == 1 else torch.cat(blocks, dim=-1)
+
+
+def select_candidate_block_ids(
+    logits: torch.Tensor,
+    compress_lens: torch.Tensor | int,
+    topk_blocks: int,
+    block_size: int,
+) -> torch.Tensor:
+    """Level one of the two-level top-k: ids of the ``topk_blocks`` best-scoring
+    ``block_size``-position blocks per query row of the 2-D ``logits``, as
+    ``int32 [rows, min(topk_blocks, num_blocks)]``, ``-1`` where a pick came back
+    all ``-inf``. Unreachable positions must already be ``-inf`` in ``logits``, so
+    an all ``-inf`` block means not reachable yet; the block holding the row's
+    newest position (``compress_lens - 1``, broadcast against the rows) is always
+    kept."""
+    scores = block_scores(logits, block_size)
+    num_blocks = scores.size(-1)
+    last = (compress_lens - 1) // block_size
+    scores = scores.masked_fill(
+        torch.arange(num_blocks, device=logits.device) == last, torch.inf
+    )
+    top = scores.topk(min(topk_blocks, num_blocks), dim=-1)
+    return top.indices.masked_fill(~(top.values > -torch.inf), -1).to(torch.int32)
+
+
+def candidate_block_mask(
+    block_ids: torch.Tensor, block_size: int, width: int
+) -> torch.Tensor:
+    """Expand kept block ids (``-1`` = none) to a ``bool [rows, width]`` mask
+    over positions. Dropped picks land in a spare column, so no scatter target
+    is written twice."""
+    num_blocks = -(-width // block_size)
+    keep = torch.zeros(
+        block_ids.shape[0], num_blocks + 1, dtype=torch.bool, device=block_ids.device
+    )
+    keep.scatter_(-1, block_ids.masked_fill(block_ids < 0, num_blocks).long(), True)
+    return keep[:, :num_blocks].repeat_interleave(block_size, dim=-1)[:, :width]
+
+
+def select_candidate_blocks(
+    logits: torch.Tensor,
+    compress_lens: torch.Tensor | int,
+    topk_blocks: int,
+    block_size: int,
+) -> torch.Tensor:
+    """:func:`select_candidate_block_ids` expanded to a ``bool`` mask shaped like
+    the 2-D ``logits`` (the decode representation)."""
+    ids = select_candidate_block_ids(logits, compress_lens, topk_blocks, block_size)
+    return candidate_block_mask(ids, block_size, logits.size(-1))
+
+
+def mask_topk_scores(
+    scores: torch.Tensor,
+    indices: torch.Tensor,
+    offsets: Optional[torch.Tensor] = None,
+) -> torch.Tensor:
+    """Keep masked indexer scores out of attention even when top-k underfills:
+    ``-1`` replaces every selection whose column (``indices - offsets``) is out
+    of range or scores ``-inf``."""
+    columns = indices.to(torch.int64)
+    if offsets is not None:
+        columns = columns - offsets[:, None]
+    selected_scores = scores.gather(1, columns.clamp(0, scores.shape[1] - 1))
+    valid = (
+        (columns >= 0) & (columns < scores.shape[1]) & (selected_scores > -torch.inf)
+    )
+    return indices.masked_fill(~valid, -1)
+
+
+def dense_indexer_topk(
+    *,
+    score_rows: Callable[[slice], torch.Tensor],
+    topk_rows: Callable[[torch.Tensor, slice, torch.Tensor], None],
+    num_tokens: int,
+    width: int,
+    compress_lens: torch.Tensor,
+    ks: torch.Tensor,
+    q_lens_cpu: Sequence[int],
+    lc_per_req: Sequence[int],
+    topk: int,
+    budget_bytes: int,
+    publish_blocks: Optional[Tuple[int, int]] = None,
+    consume_blocks: Optional[Tuple[Sequence[torch.Tensor], int]] = None,
+) -> Tuple[torch.Tensor, Optional[List[torch.Tensor]]]:
+    """Score, candidate-filter, and top-k every query row of one prefill chunk,
+    one row tile of at most ``budget_bytes`` fp32 logits at a time.
+
+    ``score_rows(rows)`` returns the fp32 ``[len(rows), width]`` logits of those
+    rows: row ``t``'s column ``j`` scores compressed position ``j`` of its
+    request, and columns at or past ``compress_lens[t]`` hold garbage.
+    ``topk_rows(logits, rows, out)`` writes the ``topk`` best columns of each
+    logits row plus ``ks[rows]`` into ``out``, ``-1`` padded, reading only
+    columns below ``compress_lens[rows]``. Requests own consecutive rows,
+    ``q_lens_cpu[b]`` each, over ``lc_per_req[b]`` compressed positions.
+
+    ``publish_blocks=(topk_blocks, block_size)`` makes the caller the candidate
+    source: the returned list holds each request's kept block ids
+    (:func:`select_candidate_block_ids`), ``[0, 0]`` for a request without rows
+    or positions. ``consume_blocks=(ids, block_size)`` sinks every position
+    outside the request's published blocks to ``-inf`` before the top-k and
+    replaces selections that still landed on ``-inf`` with ``-1``.
+
+    Returns the ``int32 [num_tokens, topk]`` selections and the published ids
+    (``None`` unless publishing). Every step is per row, so the result does not
+    depend on the tiling.
+    """
+    assert publish_blocks is None or consume_blocks is None
+    device = compress_lens.device
+    selected = torch.empty((num_tokens, topk), dtype=torch.int32, device=device)
+    spans = request_spans(q_lens_cpu)
+    published: Optional[List[List[torch.Tensor]]] = None
+    columns = None
+    if publish_blocks is not None:
+        published = [[] for _ in spans]
+        columns = torch.arange(width, device=device)
+    for rows in row_tiles(num_tokens, width, FP32_BYTES, budget_bytes):
+        logits = score_rows(rows)
+        for b, (r0, r1) in enumerate(spans):
+            lo, hi = max(r0, rows.start), min(r1, rows.stop)
+            lc = lc_per_req[b]
+            if lo >= hi or lc == 0:
+                continue
+            scores = logits[lo - rows.start : hi - rows.start, :lc]
+            if consume_blocks is not None:
+                ids, block_size = consume_blocks
+                scores.masked_fill_(
+                    ~candidate_block_mask(ids[b][lo - r0 : hi - r0], block_size, lc),
+                    -torch.inf,
+                )
+            elif publish_blocks is not None:
+                topk_blocks, block_size = publish_blocks
+                lens = compress_lens[lo:hi, None]
+                # the block selection tells unreachable positions apart by -inf
+                scores.masked_fill_(columns[None, :lc] >= lens, -torch.inf)
+                published[b].append(
+                    select_candidate_block_ids(scores, lens, topk_blocks, block_size)
+                )
+        out = selected[rows]
+        topk_rows(logits, rows, out)
+        if consume_blocks is not None:
+            out.copy_(mask_topk_scores(logits, out, ks[rows]))
+    if published is None:
+        return selected, None
+    empty = torch.zeros(0, 0, dtype=torch.int32, device=device)
+    return selected, [
+        torch.cat(parts) if len(parts) > 1 else (parts[0] if parts else empty)
+        for parts in published
+    ]
