+    if counts is None:
+        n = int(getattr(layer, "num_experts", 0) or 0) or int(layer.num_local_experts)
+        dev = topk_ids.device
+        counts = torch.zeros(n + 1, dtype=torch.int64, device=dev)
+        layer._expert_hit_counts = counts
+        layer._expert_weight_sum = torch.zeros(n + 1, dtype=torch.float64, device=dev)
+        layer._expert_weight_sq = torch.zeros(n + 1, dtype=torch.float64, device=dev)
+        layer._expert_weight_max = torch.zeros(n + 1, dtype=torch.float32, device=dev)
+        layer._expert_stats_calls = 0
+    ids = topk_ids.flatten().to(torch.int64)
+    ids = torch.where(ids < 0, torch.full_like(ids, counts.numel() - 1), ids)
+    # scatter_add_ instead of bincount: bincount syncs the device to size its
+    # output (one sync per MoE layer per chunk); ids are already clamped to [0, n].
+    counts.scatter_add_(0, ids, torch.ones_like(ids))
+    if topk_weights is not None:
