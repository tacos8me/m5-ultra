index 0000000..795d796
--- /dev/null
+++ b/sglang/kernels/jit/tests/test_dsv41_lm_head_fp8.py
@@ -0,0 +1,66 @@
+"""Numerics of the block-FP8 LM head GEMV against the bf16 head on the real
+DeepSeek-V4.1-Flash shard (rank-0 half of the vocab).
+
+Run inside the SM120 image with the checkpoint at /models/ckpt:
+  python test_dsv41_lm_head_fp8.py [--rows 4096]
+Reports, for two hidden-state proxies (RMS-normalized Gaussian and RMS-normalized
+embedding rows, both scaled by the final norm weight): top-1 agreement of the fp8
+GEMV vs the production bf16 matmul, mean KL(bf16 || fp8), max |dlogit|, and the
+error of each path against an fp32 reference.
+"""
+import argparse, json, os, struct, time
+import torch
+from safetensors import safe_open
+
+from sglang.srt.layers.dsv41_lm_head_fp8 import lm_head_fp8_gemv, quantize_block_fp8
+
+ap = argparse.ArgumentParser(); ap.add_argument("--rows", type=int, default=4096); ap.add_argument("--ckpt", default="/models/ckpt")
+args = ap.parse_args()
+dev = torch.device("cuda")
+idx = json.load(open(os.path.join(args.ckpt, "model.safetensors.index.json")))["weight_map"]
+def load(name, rows=None, to_dev=True):
+    with safe_open(os.path.join(args.ckpt, idx[name]), "pt", device="cpu") as f:
+        t = f.get_slice(name)
+        t = t[:rows] if rows else t[:]
+        return t.to(dev) if to_dev else t
+V, K = 129280, 5120
+shard = V // 2
+w = load("head.weight", shard)                       # bf16 [64640, 5120], rank-0 shard
+norm_w = load("norm.weight") if "norm.weight" in idx else torch.ones(K, device=dev, dtype=torch.bfloat16)
+embed = load("embed.weight", to_dev=False)            # bf16 [V, K] on CPU (GPU is nearly full beside the server)
+print(f"head shard {tuple(w.shape)} {w.dtype}; norm.weight {'found' if 'norm.weight' in idx else 'absent'}")
+
+t0 = time.time(); fp8, sc = quantize_block_fp8(w); torch.cuda.synchronize(); print(f"quantized in {time.time()-t0:.2f}s: fp8 {tuple(fp8.shape)} scales {tuple(sc.shape)}")
+class H: pass
+lm = H(); lm.dsv41_fp8_weight = fp8; lm.dsv41_fp8_scale = sc
+
+def rmsnorm(x): return x * torch.rsqrt(x.float().pow(2).mean(-1, keepdim=True) + 1e-6).to(x.dtype)
+g = torch.Generator(device=dev).manual_seed(0)
+proxies = {
+    "gauss*norm": (rmsnorm(torch.randn(args.rows, K, device=dev, generator=g, dtype=torch.float32)) * norm_w.float()).bfloat16(),
+    "embed*norm": (rmsnorm(embed[torch.randint(0, V, (args.rows,))].to(dev).float()) * norm_w.float()).bfloat16(),
+}
+del embed
+for name, h in proxies.items():
+    ref = torch.cat([h.float() @ w[r0:r0+8192].float().T for r0 in range(0, shard, 8192)], dim=1)   # fp32 reference
+    bf = torch.matmul(h, w.T)                                                                        # production path
+    q = torch.cat([lm_head_fp8_gemv(lm, h[i:i+32]) for i in range(0, args.rows, 32)])                # GEMV path (32-row chunks)
+    top_ref, top_bf, top_q = ref.argmax(-1), bf.argmax(-1), q.argmax(-1)
+    lp_bf = torch.log_softmax(bf.float(), -1); lp_q = torch.log_softmax(q.float(), -1)
+    kl = (lp_bf.exp() * (lp_bf - lp_q)).sum(-1)
+    print(f"[{name}] rows={args.rows}")
+    print(f"  top1 agree fp8 vs bf16: {(top_q==top_bf).float().mean().item()*100:.2f}%   bf16 vs fp32: {(top_bf==top_ref).float().mean().item()*100:.2f}%   fp8 vs fp32: {(top_q==top_ref).float().mean().item()*100:.2f}%")
+    print(f"  KL(bf16||fp8): mean {kl.mean().item():.2e} max {kl.max().item():.2e}")
+    print(f"  max|dlogit| fp8-bf16 {(q.float()-bf.float()).abs().max().item():.3f}  bf16-fp32 {(bf.float()-ref).abs().max().item():.3f}  fp8-fp32 {(q.float()-ref).abs().max().item():.3f}   logit scale max|ref| {ref.abs().max().item():.1f}")
+    print(f"  rel rms err vs fp32: bf16 {((bf.float()-ref).pow(2).mean().sqrt()/ref.pow(2).mean().sqrt()).item():.2e}  fp8 {((q.float()-ref).pow(2).mean().sqrt()/ref.pow(2).mean().sqrt()).item():.2e}")
+    del ref, bf, q, lp_bf, lp_q
+# timing at decode shapes (same GPU, isolated): bf16 matmul vs GEMV
+for m in (1, 3, 4, 8, 16, 24, 32):
+    x = proxies["gauss*norm"][:m].contiguous()
+    for fn, lab in ((lambda: torch.matmul(x, w.T), "bf16 matmul"), (lambda: lm_head_fp8_gemv(lm, x), "fp8 gemv")):
+        for _ in range(3): fn()
+        torch.cuda.synchronize(); s = torch.cuda.Event(enable_timing=True); e = torch.cuda.Event(enable_timing=True)
+        s.record(); [fn() for _ in range(20)]; e.record(); torch.cuda.synchronize()
+        us = s.elapsed_time(e) / 20 * 1e3; nbytes = (shard*K*(2 if lab.startswith('bf16') else 1))
+        print(f"M={m:2d} {lab:12s} {us:8.1f} us  {nbytes/us/1e3:7.0f} GB/s")
+print("LMHEAD_TEST_DONE")
