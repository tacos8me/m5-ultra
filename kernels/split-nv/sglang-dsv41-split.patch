+    """The torch chain the kernel replaces (``mask_topk_scores`` + slot math),
+    returning ``(page_indices, masked_selected)`` as int32."""
+    columns = selected.to(torch.int64)
+    L = logits.shape[1]
+    selected_scores = logits.gather(1, columns.clamp(0, L - 1))
+    valid = (columns >= 0) & (columns < L) & (selected_scores > -torch.inf)
+    masked = selected.masked_fill(~valid, -1)
+    columns = masked.clamp_min(0).to(torch.int64)
+    slots = page_table.gather(1, columns // page_size) * page_size
+    slots = slots + columns % page_size
+    out = torch.where(masked >= 0, slots, -1).to(torch.int32)
+    return out, masked.to(torch.int32)
