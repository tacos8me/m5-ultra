diff --git a/sglang/srt/layers/quantization/mxfp4_expert_store.py b/sglang/srt/layers/quantization/mxfp4_expert_store.py
new file mode 100644
index 0000000..32602a3
--- /dev/null
+++ b/sglang/srt/layers/quantization/mxfp4_expert_store.py
@@ -0,0 +1,758 @@
+"""File-backed MXFP4 expert store for DeepSeek-V4.1 zero-CPU-compute streaming.
+
+The 269 GiB of routed-expert weights do not fit the 2x95 GiB VRAM, and they
+cannot live in host *anonymous* memory (measured: 147 GiB anon-rss/rank is
+SIGKILLed). This module stores each TP rank's already-processed FP4 experts --
+in the exact layout the SM120 FlashInfer CUTLASS kernel consumes -- as one
+contiguous file per (layer, rank) on NVMe, maps it ``MAP_SHARED`` with
+``MADV_RANDOM``, and exposes the mapping to the GPU as an HMM device-view. The
+resident footprint is then reclaimable page cache, not anonymous RSS, exactly as
+the Engram host table (``srt/layers/engram.py`` ``_HostTable``) runs 189 GiB
+without OOM. The GPU reads those host pages over PCIe through the driver's HMM
+addressing, so all expert math stays on the GPU and nothing is computed on CPU.
+
+The pack layout stores the four parameters the MXFP4 CUTLASS method consumes:
+``w13_weight`` and ``w2_weight`` (packed FP4, unchanged on SM120) and
+``w13_weight_scale_inv`` / ``w2_weight_scale_inv`` (E8M0 block scales already
+run through FlashInfer's ``block_scale_interleave``). ``prepare_v41_expert_pack``
+writes them once; ``stage_params_from_pack`` maps them back at load time with no
+GPU round-trip and no anonymous allocation.
+"""
+
+from __future__ import annotations
+
+import collections
+import json
+import logging
+import mmap
+import os
+import re
+import types
+from dataclasses import dataclass
+
+import numpy as np
+import torch
+
+logger = logging.getLogger(__name__)
+
+PACK_FORMAT = "DSV41-MXFP4-EXPERTPACK-v1"
+# Region alignment inside a pack file. 4 KiB keeps each tensor page-aligned so a
+# device-view over a region starts on a page boundary (HMM faults whole pages).
+PACK_ALIGN = 4096
+
+# Environment knobs (documented in the package README / NOTES.md).
+#   SGLANG_DSV41_EXPERT_PACK_DIR   directory holding the prebuilt pack files.
+#   SGLANG_DSV41_UVA_EXPERT_LAYERS layer set whose experts stream from the store.
+ENV_PACK_DIR = "SGLANG_DSV41_EXPERT_PACK_DIR"
+
+# The four expert parameters stored per (layer, rank). Weight tensors are packed
+# FP4 bytes; scale tensors are interleaved E8M0 bytes. dtype is recorded per
+# tensor in the header so the reader restores the exact view the kernel wants.
+EXPERT_PARAM_NAMES = (
+    "w13_weight",
+    "w2_weight",
+    "w13_weight_scale_inv",
+    "w2_weight_scale_inv",
+)
+
+
+class _CudaArrayInterface:
+    """Minimal ``__cuda_array_interface__`` carrier for a contiguous uint8 host
+    tensor, so ``torch.as_tensor(..., device="cuda")`` builds a device tensor
+    that aliases the host pointer instead of copying."""
+
+    def __init__(self, host_u8: torch.Tensor):
+        assert host_u8.dtype == torch.uint8 and host_u8.is_contiguous()
+        self._keepalive = host_u8
+        self.__cuda_array_interface__ = {
+            "shape": tuple(host_u8.shape),
+            "typestr": "|u1",
+            "data": (host_u8.data_ptr(), False),
+            "strides": None,
+            "version": 2,
+        }
+
+
+def uva_device_view(host: torch.Tensor, device: torch.device) -> torch.Tensor:
+    """CUDA tensor aliasing ``host`` memory.
+
+    With pinned memory this is classic UVA (device ptr == host ptr). With
+    pageable memory -- including a file-backed mmap -- it relies on the driver's
+    HMM addressing so the GPU faults the host pages on access; no pinning, fully
+    reclaimable. The aliasing assert fails loud if the platform did not give the
+    host pointer a device address (HMM off), rather than silently copying.
+    """
+    if not os.environ.get("SGLANG_DSV41_UVA_PAGEABLE", "") and not host.is_pinned():
+        raise AssertionError(
+            "UVA expert tensors must be pinned (set SGLANG_DSV41_UVA_PAGEABLE=1 "
+            "for HMM pageable / file-backed mappings)"
+        )
+    flat_u8 = host.contiguous().view(torch.uint8).reshape(-1)
+    dev_u8 = torch.as_tensor(_CudaArrayInterface(flat_u8), device=device)
+    assert dev_u8.data_ptr() == flat_u8.data_ptr(), (
+        "HMM device-view did not alias the host pointer; the driver lacks HMM "
+        "addressing for this mapping"
+    )
+    return dev_u8.view(host.dtype).view(host.shape)
+
+
+@dataclass(frozen=True)
+class PackRegion:
+    name: str
+    offset: int
+    nbytes: int
+    shape: tuple[int, ...]
+    dtype: str
+
+
+@dataclass(frozen=True)
+class PackLayout:
+    format: str
+    prefix: str
+    rank: int
+    world: int
+    expert_lo: int
+    expert_hi: int
+    total_bytes: int
+    regions: tuple[PackRegion, ...]
+    # Router-global routed-expert count (384 for V4.1). EP packs hold
+    # ``expert_hi - expert_lo`` experts per rank (a disjoint slice); TP packs hold
+    # all ``num_experts_total`` experts per rank, column-sharded. Used to size the
+    # cache's remap table. Older EP packs omit it; then it is world*(hi-lo).
+    num_experts_total: int = 0
+
+    def experts_total(self) -> int:
+        return self.num_experts_total or self.world * (self.expert_hi - self.expert_lo)
+
+
+_DTYPE_BY_NAME = {
+    "uint8": torch.uint8,
+    "float8_e8m0fnu": torch.float8_e8m0fnu,
+    "float8_e4m3fn": torch.float8_e4m3fn,
+    "int8": torch.int8,
+}
+
+
+def _dtype_name(dtype: torch.dtype) -> str:
+    for name, dt in _DTYPE_BY_NAME.items():
+        if dt == dtype:
+            return name
+    raise ValueError(f"unsupported pack dtype {dtype}")
+
+
+def layer_index_of(prefix: str) -> int | None:
+    """The transformer layer index embedded in a MoE layer prefix, or None."""
+    m = re.search(r"(?:^|\.)layers\.(\d+)(?:\.|$)", prefix)
+    return int(m.group(1)) if m else None
+
+
+def pack_filename(layer_idx: int, rank: int, world: int) -> str:
+    """Stable per-(layer, rank) file name keyed on the integer transformer layer
+    index, so the offline prebuild and the runtime agree without depending on
+    the exact module prefix string."""
+    return f"layer{layer_idx:03d}.r{rank}of{world}.{PACK_FORMAT}.pack"
+
+
+def pack_path_for(pack_dir: str, prefix: str, rank: int, world: int) -> str | None:
+    """Absolute pack path for a layer prefix, or None if the prefix carries no
+    layer index (non-layer MoE, never streamed)."""
+    idx = layer_index_of(prefix)
+    if idx is None:
+        return None
+    return os.path.join(pack_dir, pack_filename(idx, rank, world))
+
+
+def _align(offset: int) -> int:
+    return (offset + PACK_ALIGN - 1) // PACK_ALIGN * PACK_ALIGN
+
+
+def write_expert_pack(
+    path: str,
+    prefix: str,
+    rank: int,
+    world: int,
+    expert_lo: int,
+    expert_hi: int,
+    tensors: dict[str, torch.Tensor],
+    num_experts_total: int = 0,
+) -> PackLayout:
+    """Write ``tensors`` (the four processed expert params) to one contiguous
+    file with a JSON header sidecar and a ``.complete`` marker written last, so a
+    partially written pack is never mistaken for a finished one."""
+    regions: list[PackRegion] = []
+    offset = 0
+    ordered = [(n, tensors[n]) for n in EXPERT_PARAM_NAMES if n in tensors]
+    for name, t in ordered:
+        offset = _align(offset)
+        nbytes = t.numel() * t.element_size()
+        regions.append(
+            PackRegion(name, offset, nbytes, tuple(t.shape), _dtype_name(t.dtype))
+        )
+        offset += nbytes
+    total = _align(offset)
+    layout = PackLayout(
+        PACK_FORMAT, prefix, rank, world, expert_lo, expert_hi, total,
+        tuple(regions), num_experts_total,
+    )
+
+    os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
+    tmp = path + ".partial"
+    with open(tmp, "wb") as f:
+        f.truncate(total)
+        for region, (_, t) in zip(regions, ordered):
+            f.seek(region.offset)
+            b = t.detach().contiguous().cpu().view(torch.uint8).reshape(-1)
+            f.write(memoryview(b.numpy()))
+    os.replace(tmp, path)
+    _write_header(path, layout)
+    with open(path + ".complete", "w") as f:
+        f.write(f"{total}\n")
+    return layout
+
+
+def _header_path(path: str) -> str:
+    return path + ".hdr.json"
+
+
+def _write_header(path: str, layout: PackLayout) -> None:
+    doc = {
+        "format": layout.format,
+        "prefix": layout.prefix,
+        "rank": layout.rank,
+        "world": layout.world,
+        "expert_lo": layout.expert_lo,
+        "expert_hi": layout.expert_hi,
+        "total_bytes": layout.total_bytes,
+        "num_experts_total": layout.experts_total(),
+        "regions": [
+            {
+                "name": r.name,
+                "offset": r.offset,
+                "nbytes": r.nbytes,
+                "shape": list(r.shape),
+                "dtype": r.dtype,
+            }
+            for r in layout.regions
+        ],
+    }
+    tmp = _header_path(path) + ".partial"
+    with open(tmp, "w") as f:
+        json.dump(doc, f, indent=2, sort_keys=True)
+    os.replace(tmp, _header_path(path))
+
+
+def read_header(path: str) -> PackLayout:
+    with open(_header_path(path)) as f:
+        doc = json.load(f)
+    if doc.get("format") != PACK_FORMAT:
+        raise ValueError(f"{path}: not a {PACK_FORMAT} header")
+    regions = tuple(
+        PackRegion(r["name"], r["offset"], r["nbytes"], tuple(r["shape"]), r["dtype"])
+        for r in doc["regions"]
+    )
+    return PackLayout(
+        doc["format"],
+        doc["prefix"],
+        int(doc["rank"]),
+        int(doc["world"]),
+        int(doc["expert_lo"]),
+        int(doc["expert_hi"]),
+        int(doc["total_bytes"]),
+        regions,
+        int(doc.get("num_experts_total", 0)),
+    )
+
+
+def pack_is_complete(path: str) -> bool:
+    return os.path.exists(path) and os.path.exists(path + ".complete")
+
+
+@dataclass
+class MappedExpertPack:
+    """A live read-only mmap of one pack file and the host tensor views over its
+    regions. Hold this on the owning layer so the mapping outlives the kernel."""
+
+    layout: PackLayout
+    _fd: int
+    _mm: mmap.mmap
+    host_views: dict[str, torch.Tensor]
+
+    def close(self) -> None:
+        """Best-effort unmap. The mapping is meant to outlive the process's use
+        of the layer (like the Engram host table); call this only at teardown
+        after the device-views over it are gone. If any still export a pointer
+        into the buffer, leave the unmap to process exit -- forcing it would
+        raise and nothing else can free those pages while the views live."""
+        self.host_views.clear()
+        try:
+            self._mm.close()
+        except BufferError:
+            pass  # device-views still alias the buffer; unmapped at process exit
+        finally:
+            os.close(self._fd)
+
+
+def open_expert_pack(path: str, *, prewarm: bool = False) -> MappedExpertPack:
+    """mmap a pack ``MAP_SHARED`` read-only with ``MADV_RANDOM`` and return
+    host uint8/E8M0 tensor views over each region. File pages back the views, so
+    their resident cost is reclaimable page cache. Optionally prewarm by reading
+    the file sequentially into the page cache first."""
+    if not pack_is_complete(path):
+        raise FileNotFoundError(f"no complete expert pack at {path}")
+    layout = read_header(path)
+    size = os.path.getsize(path)
+    if size < layout.total_bytes:
+        raise ValueError(f"{path}: file {size} smaller than header {layout.total_bytes}")
+    if prewarm:
+        _prewarm(path, layout.total_bytes)
+    fd = os.open(path, os.O_RDONLY)
+    mm = mmap.mmap(fd, layout.total_bytes, flags=mmap.MAP_SHARED, prot=mmap.PROT_READ)
+    mm.madvise(mmap.MADV_RANDOM)
+    raw = torch.from_numpy(np.frombuffer(mm, dtype=np.uint8))
+    host_views: dict[str, torch.Tensor] = {}
+    for r in layout.regions:
+        seg = raw[r.offset : r.offset + r.nbytes]
+        host_views[r.name] = seg.view(_DTYPE_BY_NAME[r.dtype]).view(*r.shape)
+    return MappedExpertPack(layout, fd, mm, host_views)
+
+
+def _prewarm(path: str, nbytes: int) -> None:
+    fd = os.open(path, os.O_RDONLY)
+    try:
+        chunk = 64 << 20
+        off = 0
+        while off < nbytes:
+            os.pread(fd, min(chunk, nbytes - off), off)
+            off += chunk
+    finally:
+        os.close(fd)
+
+
+def stage_params_from_pack(
+    layer: torch.nn.Module,
+    pack: MappedExpertPack,
+    device: torch.device,
+) -> None:
+    """Point the layer's four expert parameters at HMM device-views over the
+    mapped pack, validating each against the param the method created. Fails loud
+    on any shape/dtype mismatch (wrong shard or stale pack) rather than feeding
+    the kernel the wrong bytes. Stores the mapping on the layer as a keepalive."""
+    keep = pack.host_views
+    for name in EXPERT_PARAM_NAMES:
+        prm = getattr(layer, name, None)
+        host = keep.get(name)
+        if prm is None or host is None:
+            raise ValueError(f"expert pack {pack.layout.prefix}: missing region {name}")
+        want_shape = tuple(prm.data.shape)
+        # Shape and element size must match; the byte layout then matches. The
+        # stored dtype may differ from the param's by a byte-compatible
+        # reinterpretation (e.g. packed FP4 as uint8 vs int8, both 1 byte) -- the
+        # kernel views the weights as int64 regardless. A differing element size
+        # is a real mismatch (wrong shard or stale pack) and fails loud.
+        if tuple(host.shape) != want_shape:
+            raise ValueError(
+                f"expert pack {pack.layout.prefix} region {name}: pack shape "
+                f"{tuple(host.shape)} != param shape {want_shape}"
+            )
+        if host.element_size() != prm.data.element_size():
+            raise ValueError(
+                f"expert pack {pack.layout.prefix} region {name}: pack dtype "
+                f"{host.dtype} ({host.element_size()}B) is not byte-compatible "
+                f"with param dtype {prm.data.dtype} ({prm.data.element_size()}B)"
+            )
+        dev = uva_device_view(host, device)
+        if dev.dtype != prm.data.dtype:
+            dev = dev.view(torch.uint8).view(prm.data.dtype)
+        prm.data = dev
+    layer._dsv41_expert_pack = pack  # keepalive for the lifetime of the layer
+
+
+# ---------------------------------------------------------------------------
+# VRAM hot-expert cache (coalesced DMA staging + LRU persistence).
+#
+# Reading experts straight from the mmap via HMM is fault-driven and scattered,
+# far slower than coalesced DMA. This cache holds a bounded pool of S VRAM expert
+# slots per streamed layer, backed by the mmap pack. Before a layer's MoE the
+# routed experts are made resident -- hot ones already are (no copy), cold ones
+# are copied mmap->slot with a real cudaMemcpyAsync on a copy stream (coalesced,
+# not fault-driven) -- and the kernel reads the VRAM-resident pool. The pool
+# persists across tokens with LRU eviction, pre-populated with the profiled hot
+# set, so with the measured routing skew (top-128/384 = 78% of traffic) most
+# accesses hit HBM and only the cold tail DMAs in.
+#
+# Expert-id remap: the SM120 CUTLASS kernel takes global topk ids and filters by
+# ep_rank / num_local_experts (= pool rows S). So a resident global expert g maps
+# to id ``ep_rank*S + slot``; everything else maps to a skip id (>= ep_size*S)
+# that the kernel's range check drops. At S == num_local_experts with in-order
+# slots the map is the identity, i.e. the plain resident path.
+#
+# Knobs:
+#   SGLANG_DSV41_EXPERT_CACHE_PER_LAYER  S, VRAM slots per streamed layer. Unset
+#                                        => no cache (mmap/HMM device-view path).
+#                                        "full" => S = num_local_experts.
+#   SGLANG_DSV41_EXPERT_CACHE_WARM_SET   JSON {layer_idx: [global_expert_id,...]}
+#                                        pre-staged into the pool at load.
+#   SGLANG_DSV41_EXPERT_STATS_DIR        fallback warm set: top-S by hit count
+#                                        from <dir>/<prefix>.rank<r>.pt.
+# ---------------------------------------------------------------------------
+ENV_CACHE_PER_LAYER = "SGLANG_DSV41_EXPERT_CACHE_PER_LAYER"
+ENV_CACHE_WARM_SET = "SGLANG_DSV41_EXPERT_CACHE_WARM_SET"
+ENV_EXPERT_STATS_DIR = "SGLANG_DSV41_EXPERT_STATS_DIR"
+
+
+def cache_slots_for(num_local_experts: int) -> int | None:
+    """Parse SGLANG_DSV41_EXPERT_CACHE_PER_LAYER into a slot count, or None when
+    caching is disabled. "full"/"all" or a value >= num_local map to the full
+    local count (identity pool)."""
+    spec = os.environ.get(ENV_CACHE_PER_LAYER, "").strip().lower()
+    if not spec:
+        return None
+    if spec in ("full", "all"):
+        return num_local_experts
+    return max(1, min(int(spec), num_local_experts))
+
+
+class ExpertCache:
+    """Bounded VRAM expert pool for one streamed MoE layer, backed by the mmap.
+
+    The four pool tensors (the kernel's w13/w2 weights and interleaved scales)
+    hold S experts; ``slot_of_local`` tracks which local expert occupies each
+    slot. Misses are DMA'd from the host mmap views on a copy stream; the compute
+    stream waits on that copy before the kernel runs.
+    """
+
+    def __init__(
+        self,
+        host_views: dict[str, torch.Tensor],
+        *,
+        num_local_experts: int,
+        slots: int,
+        device: torch.device,
+        ep_rank: int,
+        ep_size: int,
+        num_experts_total: int,
+        expert_lo: int,
+    ):
+        self.host = host_views
+        self.num_local = num_local_experts
+        self.slots = min(slots, num_local_experts)
+        self.device = device
+        self.ep_rank = ep_rank
+        self.ep_size = ep_size
+        self.num_experts_total = num_experts_total
+        self.expert_lo = expert_lo
+        # Skip id: any value the kernel's [ep_rank*S, (ep_rank+1)*S) range check
+        # drops. ep_size*S is >= (ep_rank+1)*S for every rank.
+        self.skip_id = max(ep_size, 1) * self.slots
+        self.pool: dict[str, torch.Tensor] = {
+            name: torch.empty((self.slots, *hv.shape[1:]), dtype=hv.dtype, device=device)
+            for name, hv in host_views.items()
+        }
+        self.slot_of_local = [-1] * num_local_experts
+        self.local_of_slot = [-1] * self.slots
+        self.free = list(range(self.slots))
+        self.lru: "collections.OrderedDict[int, None]" = collections.OrderedDict()
+        self.copy_stream = torch.cuda.Stream(device)
+        # global-id -> remapped-id table (last entry indexes padding/-1 -> skip).
+        self._remap = torch.full(
+            (num_experts_total + 1,), self.skip_id, dtype=torch.int32, device=device
+        )
+        self._remap_dirty = True
+        self._full_views: dict[str, torch.Tensor] | None = None
+        self.stats = {"hit": 0, "miss": 0, "evict": 0, "overflow": 0}
+
+    def full_device_views(self) -> dict[str, torch.Tensor]:
+        """HMM device-views over ALL local experts in the mmap pack, for the
+        overflow path: a single kernel call routing more experts than the pool
+        holds cannot use the pool, so it reads every local expert straight from
+        the mmap (the pre-cache behavior) for that call. Built once and kept."""
+        if self._full_views is None:
+            self._full_views = {
+                name: uva_device_view(hv, self.device) for name, hv in self.host.items()
+            }
+        return self._full_views
+
+    def _stage(self, local_id: int) -> None:
+        if self.free:
+            slot = self.free.pop()
+        else:
+            victim, _ = self.lru.popitem(last=False)
+            slot = self.slot_of_local[victim]
+            self.slot_of_local[victim] = -1
+            self.stats["evict"] += 1
+        for name, hv in self.host.items():
+            self.pool[name][slot].copy_(hv[local_id], non_blocking=True)
+        self.slot_of_local[local_id] = slot
+        self.local_of_slot[slot] = local_id
+        self.lru[local_id] = None  # newly staged expert is the most-recently used
+        self.stats["miss"] += 1
+        self._remap_dirty = True
+
+    def ensure_resident(self, local_ids: list[int]) -> None:
+        """Make every local expert in ``local_ids`` resident; DMA misses on the
+        copy stream, then make the compute stream wait. ``local_ids`` for one
+        kernel call must fit the pool (its unique routed experts <= slots).
+
+        Every routed expert that is already resident is moved to the MRU end
+        BEFORE any staging, so eviction for this call's misses can only reclaim a
+        slot holding an expert that is not routed this call -- never one the same
+        kernel invocation still needs."""
+        if len(local_ids) > self.slots:
+            raise RuntimeError(
+                f"{len(local_ids)} experts routed in one call exceed cache slots "
+                f"{self.slots}; raise {ENV_CACHE_PER_LAYER}"
+            )
+        misses = []
+        for l in local_ids:
+            if self.slot_of_local[l] >= 0:
+                self.lru.move_to_end(l)  # protect this call's hits from eviction
+                self.stats["hit"] += 1
+            else:
+                misses.append(l)
+        if misses:
+            compute = torch.cuda.current_stream(self.device)
+            # The copy must not overwrite a slot the previous layer's kernel is
+            # still reading (write-after-read), so the copy stream waits for the
+            # compute stream; the compute stream then waits for the copy.
+            self.copy_stream.wait_stream(compute)
+            with torch.cuda.stream(self.copy_stream):
+                for l in misses:
+                    self._stage(l)  # adds l at the MRU end, protecting it too
+            compute.wait_stream(self.copy_stream)
+
+    def _remap_table(self) -> torch.Tensor:
+        if self._remap_dirty:
+            self._remap.fill_(self.skip_id)
+            resident = [
+                (self.expert_lo + l, self.ep_rank * self.slots + s)
+                for l, s in enumerate(self.slot_of_local)
+                if s >= 0
+            ]
+            if resident:
+                g = torch.tensor([a for a, _ in resident], device=self.device)
+                v = torch.tensor(
+                    [b for _, b in resident], dtype=torch.int32, device=self.device
+                )
+                self._remap[g] = v
+            self._remap_dirty = False
+        return self._remap
+
+    def remap_topk_ids(self, topk_ids: torch.Tensor) -> torch.Tensor:
+        """Map global topk ids to pool ids; padding/out-of-range -> skip id."""
+        R = self._remap_table()
+        safe = topk_ids.to(torch.long).clamp(min=0, max=self.num_experts_total - 1)
+        out = R[safe]
+        return torch.where(
+            topk_ids < 0, torch.full_like(out, self.skip_id), out
+        )
+
+    def local_ids_in(self, topk_ids: torch.Tensor) -> list[int]:
+        """Unique local expert ids this rank owns within ``topk_ids`` (global)."""
+        flat = topk_ids.reshape(-1)
+        mask = (flat >= self.expert_lo) & (flat < self.expert_lo + self.num_local)
+        return (flat[mask] - self.expert_lo).unique().tolist()
+
+    def prewarm(self, local_ids: list[int]) -> None:
+        for l in local_ids[: self.slots]:
+            if self.slot_of_local[l] < 0:
+                self._stage(l)
+        torch.cuda.current_stream(self.device).wait_stream(self.copy_stream)
+
+
+def warm_local_ids(
+    prefix: str, expert_lo: int, expert_hi: int, slots: int, rank: int
+) -> list[int]:
+    """Profiled hot local experts to pre-stage: the explicit warm-set file if
+    present, else the top-``slots`` by hit count from the stats dir, else []."""
+    warm_path = os.environ.get(ENV_CACHE_WARM_SET, "")
+    idx = layer_index_of(prefix)
+    if warm_path and os.path.exists(warm_path) and idx is not None:
+        doc = json.loads(open(warm_path).read())
+        ids = doc.get(str(idx)) or doc.get(idx) or []
+        local = [g - expert_lo for g in ids if expert_lo <= g < expert_hi]
+        return local[:slots]
+    stats_dir = os.environ.get(ENV_EXPERT_STATS_DIR, "")
+    if stats_dir:
+        path = os.path.join(stats_dir, f"{prefix}.rank{rank}.pt")
+        if os.path.exists(path):
+            counts = torch.load(path, map_location="cpu")["counts"]
+            local_counts = counts[expert_lo:expert_hi]
+            return torch.topk(local_counts, min(slots, local_counts.numel())).indices.tolist()
+    return []
+
+
+# ---------------------------------------------------------------------------
+# Expert pruning: keep only a per-layer hot subset of routed experts, fully
+# resident in VRAM (no pack, no mmap, no HMM). The router is masked so no token
+# routes to a dropped expert; the kept experts are loaded into a [num_kept,...]
+# tensor and the global expert id remaps to its local slot -- the same
+# global->local remap the streaming cache uses, but static.
+#
+#   SGLANG_DSV41_EXPERT_KEEP_SET=/path.json   {key: [kept global ids]}
+#
+# Each key names one MoE layer: a decoder layer index ("12": target layer,
+# module prefix model.layers.12...) or "mtp.N" (DSpark drafter stage N:
+# checkpoint tensors mtp.N.*, module prefix stages.N...). A key with no
+# matching layer in the loaded model is unused (a drafter set on a boot
+# without DSpark); a key of neither form fails at load, and a set whose ids
+# do not fit the layer fails when that layer is built.
+# ---------------------------------------------------------------------------
+ENV_KEEP_SET = "SGLANG_DSV41_EXPERT_KEEP_SET"
+KeepKey = int | str
+DRAFT_KEY_PREFIX = "mtp."
+_DRAFT_KEY_RE = re.compile(r"^mtp\.(\d+)$")
+_DRAFT_PREFIX_RE = re.compile(r"(?:^|\.)stages\.(\d+)(?:\.|$)")
+_KEEP_SETS: dict[KeepKey, list[int]] | None = None
+_KEEP_SETS_LOADED = False
+
+
+
+def fuse_site_enabled(site: str) -> bool:
+    """Whether decode-step launch-fusion site ``site`` is on: SGLANG_DSV41_FUSE_ELEMENTWISE
+    and the SGLANG_DSV41_FUSE_ELEMENTWISE_SITES allowlist (comma-separated)."""
+    from sglang.srt.environ import envs
+
+    if not envs.SGLANG_DSV41_FUSE_ELEMENTWISE.get():
+        return False
+    sites = {x.strip() for x in envs.SGLANG_DSV41_FUSE_ELEMENTWISE_SITES.get().split(",")}
+    return site in sites
+
+
+def keep_key_of(prefix: str) -> KeepKey | None:
+    """Keep-set key of the MoE layer at ``prefix``: the decoder layer index for
+    ``model.layers.N...``, ``"mtp.N"`` for a DSpark drafter stage
+    (``stages.N...``), None for anything else."""
+    idx = layer_index_of(prefix)
+    if idx is not None:
+        return idx
+    m = _DRAFT_PREFIX_RE.search(prefix)
+    return f"{DRAFT_KEY_PREFIX}{m.group(1)}" if m else None
+
+
+def parse_keep_key(key: int | str) -> KeepKey:
+    """Normalize a keep-set JSON key; raises ValueError for an unknown form."""
+    if isinstance(key, int):
+        return key
+    if key.isdigit():
+        return int(key)
+    if _DRAFT_KEY_RE.match(key):
+        return key
+    raise ValueError(
+        f"{ENV_KEEP_SET}: key {key!r} is neither a decoder layer index nor mtp.<stage>"
+    )
+
+
+def load_keep_sets() -> dict[KeepKey, list[int]] | None:
+    """Parse the keep-set JSON once (see the key forms above)."""
+    global _KEEP_SETS, _KEEP_SETS_LOADED
+    if not _KEEP_SETS_LOADED:
+        _KEEP_SETS_LOADED = True
+        path = os.environ.get(ENV_KEEP_SET, "")
+        if path:
+            raw = json.loads(open(path).read())
+            _KEEP_SETS = {
+                parse_keep_key(k): sorted(int(x) for x in v) for k, v in raw.items()
+            }
+    return _KEEP_SETS
+
+
+def keep_for_layer(prefix: str) -> list[int] | None:
+    """Sorted kept global expert ids for the layer named by ``prefix``, or None
+    when pruning is off or the layer has no keep set."""
+    sets = load_keep_sets()
+    key = keep_key_of(prefix)
+    if sets is None or key is None:
+        return None
+    return sets.get(key)
+
+
+def check_keep_set(kept: list[int], num_experts: int, label: str) -> list[int]:
+    """Validate a keep set against the layer it prunes and return it sorted.
+    Raises ValueError for an empty set, a duplicate id, or an id outside
+    [0, num_experts) -- e.g. a 384-expert target set applied to a 128-expert
+    DSpark drafter stage."""
+    ids = sorted(int(g) for g in kept)
+    if not ids:
+        raise ValueError(f"expert prune {label}: empty keep set")
+    if len(set(ids)) != len(ids):
+        raise ValueError(f"expert prune {label}: duplicate ids in the keep set")
+    if ids[0] < 0 or ids[-1] >= num_experts:
+        raise ValueError(
+            f"expert prune {label}: keep set ids span [{ids[0]}, {ids[-1]}] but the "
+            f"layer has {num_experts} routed experts"
+        )
+    return ids
+
+
+def dropped_ids(kept: list[int], num_experts: int, label: str) -> list[int]:
+    """Sorted global ids of the routed experts a keep set drops (validated)."""
+    return sorted(set(range(num_experts)) - set(check_keep_set(kept, num_experts, label)))
+
+
+@dataclass
+class PrunedExperts:
+    """Static keep-set mapping for one pruned layer."""
+
+    num_experts_total: int
+    kept: tuple[int, ...]            # sorted global ids, slot i holds kept[i]
+    local_of_global: list[int]       # [num_experts_total] -> slot, or -1 if dropped
+    remap: torch.Tensor              # [num_experts_total] int32 -> slot, dropped -> skip
+    skip_id: int
+
+    @property
+    def num_kept(self) -> int:
+        return len(self.kept)
+
+    def remap_topk_ids(self, topk_ids: torch.Tensor) -> torch.Tensor:
+        """Global routed ids -> local slot ids; padding/-1 or any dropped id ->
+        skip (the kernel drops it -- should not occur once the router is masked)."""
+        # Out-of-place clamp: for int64 ids .to(long) aliases the input, and an
+        # in-place clamp would erase the -1 padding before the mask below reads it.
+        safe = topk_ids.to(torch.long).clamp(min=0, max=self.num_experts_total - 1)
+        out = self.remap[safe]
+        return torch.where(topk_ids < 0, torch.full_like(out, self.skip_id), out)
+
+
+def build_pruned_experts(
+    kept: list[int], num_experts_total: int, device: torch.device, label: str = ""
+) -> PrunedExperts:
+    kept = check_keep_set(kept, num_experts_total, label)
+    local = [-1] * num_experts_total
+    for slot, g in enumerate(kept):
+        local[g] = slot
+    skip_id = len(kept)  # >= num_kept -> the kernel's range check drops it
+    remap = torch.full((num_experts_total,), skip_id, dtype=torch.int32, device=device)
+    idx = torch.tensor(kept, dtype=torch.long, device=device)
+    remap[idx] = torch.arange(len(kept), dtype=torch.int32, device=device)
+    return PrunedExperts(num_experts_total, tuple(kept), local, remap, skip_id)
+
+
+def install_pruned_expert_map(
+    layer, kept: list[int], num_experts: int, device: torch.device, label: str
+) -> PrunedExperts:
+    """Install the static keep-set mapping on a FusedMoE layer whose expert
+    params were allocated at the kept count: override the loader's
+    ``_map_global_expert_id_to_local_expert_id`` so a kept global id maps to
+    its slot and a dropped id returns -1 (the loader skips -1), and set
+    ``layer._dsv41_prune`` for the forward-time top-k remap. Fails loud when a
+    param does not have exactly ``len(kept)`` rows or the set does not fit
+    ``num_experts``."""
+    prune = build_pruned_experts(kept, num_experts, device, label)
+    for name in EXPERT_PARAM_NAMES:
+        rows = getattr(layer, name).data.shape[0]
+        if rows != prune.num_kept:
+            raise RuntimeError(
+                f"expert prune {label}: {name} has {rows} rows, expected the kept "
+                f"count {prune.num_kept}"
+            )
+    local_of_global = prune.local_of_global
+    original_map = layer._map_global_expert_id_to_local_expert_id
+
+    def _pruned_map(_self, expert_id: int) -> int:
+        if 0 <= expert_id < len(local_of_global):
+            return local_of_global[expert_id]  # kept -> slot, dropped -> -1
+        return original_map(expert_id)  # shared / out-of-routed-range: unchanged
+
+    layer._map_global_expert_id_to_local_expert_id = types.MethodType(_pruned_map, layer)
+    layer._dsv41_prune = prune
+    return prune
