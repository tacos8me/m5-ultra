diff --git a/sglang/test/srt/layers/test_dsv41_indexer_select.py b/sglang/test/srt/layers/test_dsv41_indexer_select.py
new file mode 100644
index 0000000..3b5984b
--- /dev/null
+++ b/sglang/test/srt/layers/test_dsv41_indexer_select.py
@@ -0,0 +1,235 @@
+"""Row tiling of the DeepSeek-V4.1 dense prefill indexer is exact.
+
+Runs dsv41_indexer_select on CPU with reference scoring and top-k in place of
+the DeepGEMM / sgl_kernel ops: (1) the tile schedule follows the byte budget
+and collapses to one tile when the chunk fits; (2) the block-id candidate
+representation expands to the reference position mask; (3) dense_indexer_topk
+gives the same selections and published candidates for any tile size, with
+garbage past each row's reach never leaking in, as candidate source, as
+consumer, and without candidates.
+Run: python3 test/srt/layers/test_dsv41_indexer_select.py (pins the pytest rootdir
+to this directory; the package root's __init__ needs IPython).
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import pathlib
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+_SRC = (
+    pathlib.Path(__file__).resolve().parents[3]
+    / "srt/layers/attention/dsv4/dsv41_indexer_select.py"
+)
+_spec = importlib.util.spec_from_file_location("dsv41_indexer_select", _SRC)
+sel = importlib.util.module_from_spec(_spec)
+_spec.loader.exec_module(sel)
+
+MiB = 1 << 20
+
+
+def reference_select_candidate_blocks(logits, compress_lens, topk_blocks, block_size):
+    """DeepSeek-V4.1 inference/model.py select_candidate_blocks, verbatim."""
+    width = logits.size(-1)
+    scores = F.pad(logits, (0, -width % block_size), value=-torch.inf)
+    scores = scores.unflatten(-1, (-1, block_size)).amax(dim=-1)
+    num_blocks = scores.size(-1)
+    last = (compress_lens - 1) // block_size
+    scores = scores.masked_fill(
+        torch.arange(num_blocks, device=logits.device) == last, torch.inf
+    )
+    top = scores.topk(min(topk_blocks, num_blocks), dim=-1)
+    keep = torch.zeros_like(scores, dtype=torch.bool).scatter_(
+        -1, top.indices, top.values > -torch.inf
+    )
+    return keep.repeat_interleave(block_size, dim=-1)[..., :width]
+
+
+def test_row_tiles_follow_budget_and_collapse_when_chunk_fits():
+    # 2048 rows x 131072 positions x 4 B = 1 GiB: two 512 MiB tiles of 1024 rows.
+    tiles = sel.row_tiles(2048, 131072, 4, 512 * MiB)
+    assert tiles == [slice(0, 1024), slice(1024, 2048)]
+    # 1M-token context at ratio 1: 128 rows per 512 MiB tile, 16 tiles.
+    assert len(sel.row_tiles(2048, 1 << 20, 4, 512 * MiB)) == 16
+    # Fits the budget: one tile, the untiled call.
+    assert sel.row_tiles(2048, 16384, 4, 512 * MiB) == [slice(0, 2048)]
+    # A single row over budget still runs, one row at a time.
+    assert sel.row_tiles(3, 1 << 30, 4, 512 * MiB) == [
+        slice(0, 1),
+        slice(1, 2),
+        slice(2, 3),
+    ]
+    assert sel.row_tiles(0, 8, 4, 512 * MiB) == [slice(0, 0)]
+
+
+@pytest.mark.parametrize("width", [64, 61, 8, 5])
+def test_candidate_block_ids_expand_to_reference_mask(width):
+    torch.manual_seed(width)
+    rows, block_size, topk_blocks = 9, 8, 3
+    lens = torch.randint(1, width + 1, (rows, 1))
+    lens[0, 0] = width
+    lens[1, 0] = 1
+    logits = torch.randn(rows, width)
+    logits.masked_fill_(torch.arange(width)[None, :] >= lens, -torch.inf)
+    ids = sel.select_candidate_block_ids(logits, lens, topk_blocks, block_size)
+    assert ids.dtype == torch.int32 and ids.shape == (
+        rows,
+        min(topk_blocks, -(-width // block_size)),
+    )
+    got = sel.candidate_block_mask(ids, block_size, width)
+    want = reference_select_candidate_blocks(logits, lens, topk_blocks, block_size)
+    assert torch.equal(got, want)
+    assert torch.equal(
+        sel.select_candidate_blocks(logits, lens, topk_blocks, block_size), want
+    )
+
+
+class Chunk:
+    """One prefill chunk of ragged requests with a reference scorer and top-k."""
+
+    Q_LENS = [7, 0, 1, 12, 3, 5]
+    LC = [40, 0, 9, 100, 0, 17]
+    TOPK = 6
+    BLOCK = 8
+    TOPK_BLOCKS = 4
+
+    def __init__(self, garbage: float):
+        torch.manual_seed(0)
+        self.q_lens, self.lc = self.Q_LENS, self.LC
+        self.num_tokens = sum(self.q_lens)
+        self.width = -(-max(self.lc) // 4) * 4
+        lens, ks, start = [], [], 0
+        for t, lc in zip(self.q_lens, self.lc):
+            # each later row of a request reaches one more position, up to lc
+            lens += [max(0, lc - (t - 1 - i)) for i in range(t)]
+            ks += [start] * t
+            start += lc
+        self.compress_lens = torch.tensor(lens, dtype=torch.int32)
+        self.ks = torch.tensor(ks, dtype=torch.int32)
+        self.scores = torch.randn(self.num_tokens, self.width)
+        reach = torch.arange(self.width)[None, :] < self.compress_lens[:, None]
+        self.scores.masked_fill_(~reach, garbage)
+
+    def score_rows(self, rows: slice) -> torch.Tensor:
+        return self.scores[rows].clone()
+
+    def topk_rows(self, logits: torch.Tensor, rows: slice, out: torch.Tensor) -> None:
+        out.fill_(-1)
+        for i, (n, ks) in enumerate(
+            zip(self.compress_lens[rows].tolist(), self.ks[rows].tolist())
+        ):
+            k = min(self.TOPK, n)
+            if k:
+                out[i, :k] = logits[i, :n].topk(k).indices.to(torch.int32) + ks
+
+    def run(self, budget_bytes, **roles):
+        return sel.dense_indexer_topk(
+            score_rows=self.score_rows,
+            topk_rows=self.topk_rows,
+            num_tokens=self.num_tokens,
+            width=self.width,
+            compress_lens=self.compress_lens,
+            ks=self.ks,
+            q_lens_cpu=self.q_lens,
+            lc_per_req=self.lc,
+            topk=self.TOPK,
+            budget_bytes=budget_bytes,
+            **roles,
+        )
+
+
+def _tile_budgets(chunk: Chunk):
+    row_bytes = chunk.width * sel.FP32_BYTES
+    # whole chunk; one row; tiles that split requests at odd boundaries
+    return [row_bytes * chunk.num_tokens, row_bytes, row_bytes * 5, row_bytes * 11]
+
+
+@pytest.mark.parametrize("role", ["plain", "source", "consumer"])
+def test_dense_indexer_topk_is_tiling_invariant(role):
+    clean = Chunk(garbage=-torch.inf)
+    dirty = Chunk(garbage=1e9)
+    reach = torch.arange(clean.width)[None, :] < clean.compress_lens[:, None]
+    assert torch.equal(clean.scores[reach], dirty.scores[reach])
+    assert (dirty.scores[~reach] == 1e9).all() and (clean.scores[~reach] == -torch.inf).all()
+    publish = (Chunk.TOPK_BLOCKS, Chunk.BLOCK)
+    if role == "consumer":
+        _, ids = clean.run(1 << 40, publish_blocks=publish)
+        roles = dict(consume_blocks=(ids, Chunk.BLOCK))
+    elif role == "source":
+        roles = dict(publish_blocks=publish)
+    else:
+        roles = {}
+    want_sel, want_pub = clean.run(1 << 40, **roles)
+    assert want_sel.shape == (clean.num_tokens, Chunk.TOPK)
+    for budget in _tile_budgets(dirty):
+        got_sel, got_pub = dirty.run(budget, **roles)
+        assert torch.equal(got_sel, want_sel), budget
+        if role == "source":
+            assert len(got_pub) == len(Chunk.Q_LENS)
+            for b, (g, w) in enumerate(zip(got_pub, want_pub)):
+                assert torch.equal(g, w), (budget, b)
+                t, lc = Chunk.Q_LENS[b], Chunk.LC[b]
+                if t == 0 or lc == 0:
+                    assert g.shape == (0, 0)
+                else:
+                    assert g.shape == (t, min(Chunk.TOPK_BLOCKS, -(-lc // Chunk.BLOCK)))
+        else:
+            assert got_pub is None
+
+
+def test_source_publishes_reference_candidates_and_consumer_sinks_them():
+    chunk = Chunk(garbage=1e9)
+    publish = (Chunk.TOPK_BLOCKS, Chunk.BLOCK)
+    _, ids = chunk.run(chunk.width * sel.FP32_BYTES * 3, publish_blocks=publish)
+    for b, (r0, r1) in enumerate(sel.request_spans(Chunk.Q_LENS)):
+        lc = Chunk.LC[b]
+        if r1 == r0 or lc == 0:
+            continue
+        lens = chunk.compress_lens[r0:r1, None]
+        logits = chunk.scores[r0:r1, :lc].masked_fill(
+            torch.arange(lc)[None, :] >= lens, -torch.inf
+        )
+        want = reference_select_candidate_blocks(
+            logits, lens, Chunk.TOPK_BLOCKS, Chunk.BLOCK
+        )
+        assert torch.equal(sel.candidate_block_mask(ids[b], Chunk.BLOCK, lc), want)
+    selected, _ = chunk.run(
+        chunk.width * sel.FP32_BYTES * 2, consume_blocks=(ids, Chunk.BLOCK)
+    )
+    # every selection is a reachable candidate position; padding is -1
+    for t, (n, ks, b) in enumerate(
+        zip(
+            chunk.compress_lens.tolist(),
+            chunk.ks.tolist(),
+            [b for b, q in enumerate(Chunk.Q_LENS) for _ in range(q)],
+        )
+    ):
+        row = selected[t]
+        if n == 0:
+            assert (row == -1).all()
+            continue
+        picked = row[row >= 0] - ks
+        assert (picked < n).all()
+        mask = sel.candidate_block_mask(ids[b], Chunk.BLOCK, Chunk.LC[b])[
+            t - sel.request_spans(Chunk.Q_LENS)[b][0]
+        ]
+        assert mask[picked.long()].all()
+
+
+if __name__ == "__main__":
+    raise SystemExit(
+        pytest.main(
+            [
+                __file__,
+                "--rootdir",
+                str(pathlib.Path(__file__).resolve().parent),
+                "--import-mode=importlib",
+                "-p",
+                "no:cacheprovider",
+                "-q",
+            ]
+        )
+    )
diff --git a/sglang/test/srt/models/test_dsv41_dspark_expert_prune.py b/sglang/test/srt/models/test_dsv41_dspark_expert_prune.py
new file mode 100644
index 0000000..bdb6971
--- /dev/null
+++ b/sglang/test/srt/models/test_dsv41_dspark_expert_prune.py
@@ -0,0 +1,214 @@
+"""Expert pruning of the DSpark drafter stages (keep-set keys ``mtp.N``), on
+CPU with synthetic weights.
+
+Covers: keep-set keys resolve by module prefix (target ``model.layers.N`` vs
+drafter ``stages.N``, whose layer_id is the stage index and must not alias a
+target layer); the pruned loader map plus the top-k remap give a bit-identical
+MoE output to the full expert set restricted to the kept experts; the masked
+sqrtsoftplus + correction-bias router never selects a dropped expert and equals
+top-k over the kept experts alone; keep sets that do not fit the layer fail
+loud; and ``make_keep_set`` emits ``mtp.N`` entries next to the target ones.
+Run (inside the image, no GPU needed):
+  python3 -m pytest test/srt/models/test_dsv41_dspark_expert_prune.py
+"""
+
+from __future__ import annotations
+
+import json
+import types
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+from sglang.srt.layers.quantization import mxfp4_expert_store as store
+from sglang.srt.model_loader.expert_pack import make_keep_set
+
+CPU = torch.device("cpu")
+N_DRAFT = 128          # dspark_n_routed_experts
+TOPK_DRAFT = 3         # dspark_num_experts_per_tok
+
+
+def _use_keep_set(tmp_path, monkeypatch, doc: dict) -> None:
+    path = tmp_path / "keep.json"
+    path.write_text(json.dumps(doc))
+    monkeypatch.setenv(store.ENV_KEEP_SET, str(path))
+    monkeypatch.setattr(store, "_KEEP_SETS", None)
+    monkeypatch.setattr(store, "_KEEP_SETS_LOADED", False)
+
+
+def test_keep_keys_resolve_by_prefix(tmp_path, monkeypatch):
+    _use_keep_set(tmp_path, monkeypatch, {"3": [5, 1, 2], "mtp.0": [9, 0, 7], "mtp.2": [4]})
+    assert store.keep_key_of("model.layers.3.mlp.experts") == 3
+    assert store.keep_key_of("stages.0.mlp.experts") == "mtp.0"
+    assert store.keep_key_of("markov_head") is None
+    # FusedMoE prefix (create_weights) and MoE module prefix (router mask) agree.
+    assert store.keep_for_layer("model.layers.3.mlp.experts") == [1, 2, 5]
+    assert store.keep_for_layer("model.layers.3.mlp") == [1, 2, 5]
+    assert store.keep_for_layer("stages.0.mlp.experts") == [0, 7, 9]
+    assert store.keep_for_layer("stages.0.mlp") == [0, 7, 9]
+    assert store.keep_for_layer("stages.1.mlp") is None
+    # Drafter stage 0 (layer_id 0) does not alias target layer 0, and vice versa.
+    assert store.keep_for_layer("model.layers.0.mlp") is None
+    assert store.keep_key_of("stages.0.mlp") != store.keep_key_of("model.layers.0.mlp")
+
+
+def test_unknown_key_fails_loud(tmp_path, monkeypatch):
+    _use_keep_set(tmp_path, monkeypatch, {"draft.0": [1]})
+    with pytest.raises(ValueError, match="neither a decoder layer index nor mtp"):
+        store.load_keep_sets()
+
+
+def test_keep_set_must_fit_layer():
+    with pytest.raises(ValueError, match="128 routed experts"):
+        store.build_pruned_experts([0, 200], N_DRAFT, CPU, "stages.0.mlp.experts")
+    with pytest.raises(ValueError, match="duplicate"):
+        store.dropped_ids([0, 0], 4, "stages.0.mlp")
+    with pytest.raises(ValueError, match="empty"):
+        store.dropped_ids([], 4, "stages.0.mlp")
+    assert store.dropped_ids([3, 1], 4, "stages.0.mlp") == [0, 2]
+
+
+def _fake_moe_layer(num_rows: int, num_experts: int, inter: int, hidden: int):
+    """A FusedMoE stand-in: expert params allocated at ``num_rows`` and the
+    stock global->local map (TP: identity within the routed range, else -1)."""
+    layer = types.SimpleNamespace(
+        w13_weight=torch.nn.Parameter(torch.zeros(num_rows, 2 * inter, hidden)),
+        w2_weight=torch.nn.Parameter(torch.zeros(num_rows, hidden, inter)),
+        w13_weight_scale_inv=torch.nn.Parameter(torch.zeros(num_rows, 2 * inter)),
+        w2_weight_scale_inv=torch.nn.Parameter(torch.zeros(num_rows, hidden)),
+    )
+
+    def _stock_map(_self, expert_id: int) -> int:
+        return expert_id if 0 <= expert_id < num_experts else -1
+
+    layer._map_global_expert_id_to_local_expert_id = types.MethodType(_stock_map, layer)
+    return layer
+
+
+def test_install_map_requires_kept_rows():
+    layer = _fake_moe_layer(num_rows=5, num_experts=16, inter=4, hidden=8)
+    with pytest.raises(RuntimeError, match="w13_weight has 5 rows, expected the kept count 4"):
+        store.install_pruned_expert_map(layer, [0, 1, 2, 3], 16, CPU, "stages.0.mlp.experts")
+
+
+def _moe(w13, w2, x, topk_ids, topk_w):
+    """Dense reference SwiGLU MoE: sum_k w_k * W2[e_k] @ (silu(gate) * up)."""
+    gate_up = torch.einsum("tkih,th->tki", w13[topk_ids], x)
+    gate, up = gate_up.chunk(2, dim=-1)
+    act = F.silu(gate) * up
+    out = torch.einsum("tkhi,tki->tkh", w2[topk_ids], act)
+    return (out * topk_w[..., None]).sum(dim=1)
+
+
+def test_pruned_drafter_matches_full_restricted():
+    torch.manual_seed(0)
+    E, I, H, T = 16, 8, 32, 64
+    kept = [0, 2, 3, 5, 8, 9, 12, 15]
+    dropped = sorted(set(range(E)) - set(kept))
+    w13_full = torch.randn(E, 2 * I, H, dtype=torch.bfloat16)
+    w2_full = torch.randn(E, H, I, dtype=torch.bfloat16)
+
+    layer = _fake_moe_layer(len(kept), E, I, H)
+    prune = store.install_pruned_expert_map(layer, kept, E, CPU, "stages.1.mlp.experts")
+    assert layer._dsv41_prune is prune
+    # Loader path: the overridden map skips dropped experts and fills kept slots.
+    for e in range(E):
+        slot = layer._map_global_expert_id_to_local_expert_id(e)
+        if e in dropped:
+            assert slot == -1
+            continue
+        assert slot == kept.index(e)
+        layer.w13_weight.data[slot] = w13_full[e].float()
+        layer.w2_weight.data[slot] = w2_full[e].float()
+    # Out-of-routed-range ids (fused shared slots) still reach the stock map.
+    assert layer._map_global_expert_id_to_local_expert_id(E + 1) == -1
+
+    x = torch.randn(T, H, dtype=torch.bfloat16)
+    kept_t = torch.tensor(kept)
+    topk_ids = kept_t[torch.randint(len(kept), (T, TOPK_DRAFT))]  # the router mask's guarantee
+    topk_w = torch.rand(T, TOPK_DRAFT, dtype=torch.bfloat16)
+    ref = _moe(w13_full, w2_full, x, topk_ids, topk_w)
+    remapped = prune.remap_topk_ids(topk_ids)
+    assert remapped.max() < prune.num_kept
+    out = _moe(layer.w13_weight.data.to(torch.bfloat16), layer.w2_weight.data.to(torch.bfloat16),
+               x, remapped.long(), topk_w)
+    assert torch.equal(ref, out)
+    # Dropped or padded ids remap to the kernel's skip id.
+    ids = torch.tensor([[dropped[0], -1, kept[0]]])
+    assert prune.remap_topk_ids(ids).tolist() == [[prune.skip_id, prune.skip_id, 0]]
+
+
+def test_router_mask_excludes_dropped_drafter():
+    """sqrtsoftplus(logits) + masked bias: no dropped expert in top-3, and the
+    choice equals top-3 over the kept experts alone."""
+    torch.manual_seed(1)
+    kept = sorted(torch.randperm(N_DRAFT)[:64].tolist())
+    dropped = sorted(set(range(N_DRAFT)) - set(kept))
+    bias = torch.randn(N_DRAFT) * 0.5
+    masked = bias.clone()
+    masked[torch.tensor(dropped)] = -1e30      # what _dsv41_apply_prune_router_mask sets
+    logits = torch.randn(1024, N_DRAFT) * 3.0
+    scores = F.softplus(logits).sqrt()
+    ids = (scores + masked).topk(TOPK_DRAFT, dim=-1).indices
+    assert not torch.isin(ids, torch.tensor(dropped)).any()
+    kept_t = torch.tensor(kept)
+    restricted = kept_t[(scores[:, kept_t] + bias[kept_t]).topk(TOPK_DRAFT, dim=-1).indices]
+    assert torch.equal(ids.sort(dim=-1).values, restricted.sort(dim=-1).values)
+
+
+def _write_stats(dir_, prefix, rank, counts, weight_sum):
+    n = len(counts)
+    torch.save(
+        {
+            "prefix": prefix,
+            "calls": 1,
+            "counts": torch.tensor(counts + [0], dtype=torch.int64),
+            "weight_sum": torch.tensor(weight_sum + [0.0], dtype=torch.float64),
+            "weight_sq": torch.zeros(n + 1, dtype=torch.float64),
+            "weight_max": torch.zeros(n + 1, dtype=torch.float32),
+        },
+        dir_ / f"{prefix}.rank{rank}.pt",
+    )
+
+
+def test_make_keep_set_emits_draft_keys(tmp_path):
+    stats = tmp_path / "stats"
+    stats.mkdir()
+    for layer in (0, 1):
+        p = f"model.layers.{layer}.mlp.experts"
+        _write_stats(stats, p, 0, [5, 1, 9, 2, 7, 0, 3, 4], [0.1, 0.9, 0.2, 0.8, 0.3, 0.7, 0.4, 0.5])
+        _write_stats(stats, p, 1, [5, 1, 9, 2, 7, 0, 3, 4], [0.1, 0.9, 0.2, 0.8, 0.3, 0.7, 0.4, 0.5])
+    # Drafter stage 0: rank sums decide (per-rank rankings differ on purpose).
+    _write_stats(stats, "stages.0.mlp.experts", 0, [1, 8, 1, 1], [0.6, 0.1, 0.1, 0.4])
+    _write_stats(stats, "stages.0.mlp.experts", 1, [1, 8, 1, 1], [0.0, 0.1, 0.55, 0.3])
+    _write_stats(stats, "stages.1.mlp.experts", 0, [4, 3, 2, 1], [0.1, 0.2, 0.3, 0.4])
+
+    out = tmp_path / "keep.json"
+    assert make_keep_set.main(["--stats", str(stats), "--keep", "3", "--keep-draft", "2",
+                               "--out", str(out)]) == 0
+    doc = json.loads(out.read_text())
+    assert list(doc) == ["0", "1", "mtp.0", "mtp.1"]
+    assert doc["0"] == [1, 3, 5]            # top-3 by weight_sum, not by count
+    assert doc["mtp.0"] == [2, 3]           # summed weight_sum 0.6/0.2/0.65/0.7
+    assert doc["mtp.1"] == [2, 3]
+    by_count = tmp_path / "count.json"
+    make_keep_set.main(["--stats", str(stats), "--keep-draft", "1", "--criterion", "count",
+                        "--out", str(by_count)])
+    assert json.loads(by_count.read_text()) == {"mtp.0": [1], "mtp.1": [0]}
+
+    # --base carries the target entries; the drafter entries are recomputed.
+    out2 = tmp_path / "keep2.json"
+    make_keep_set.main(["--stats", str(stats), "--base", str(out), "--keep-draft", "1",
+                        "--out", str(out2)])
+    doc2 = json.loads(out2.read_text())
+    assert doc2["0"] == doc["0"] and doc2["1"] == doc["1"]
+    assert doc2["mtp.0"] == [3] and doc2["mtp.1"] == [3]
+
+    # A drafter request against a target-only profile fails loud.
+    target_only = tmp_path / "target_only"
+    target_only.mkdir()
+    _write_stats(target_only, "model.layers.0.mlp.experts", 0, [1, 2], [0.1, 0.2])
+    with pytest.raises(SystemExit, match="no draft layer stats"):
+        make_keep_set.main(["--stats", str(target_only), "--keep-draft", "1",
+                            "--out", str(tmp_path / "x.json")])
