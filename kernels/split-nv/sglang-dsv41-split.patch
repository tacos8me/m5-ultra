index 0000000..a19bd47
--- /dev/null
+++ b/sglang/kernels/jit/tests/test_dsv41_topk_v2_sm120.py
@@ -0,0 +1,51 @@
+"""v1 vs v2 paged top-k on SM120: selected-set equality and timing per call."""
+import torch, time, sys
+from sglang.kernels.ops.attention.dsv4.topk import topk_transform_paged, topk_transform_paged_v2, plan_topk_v2
+torch.manual_seed(0)
+dev = torch.device("cuda")
+PAGE = 64
+def run(bs, L, topk=512, ties=False, ninf_tail=False, reps=20):
+    scores = torch.randn(bs, L, device=dev, dtype=torch.float32) * 3
+    if ties:
+        scores = scores.round()  # many exact ties
+    seq_lens = torch.full((bs,), L, dtype=torch.int32, device=dev)
+    if ninf_tail:
+        scores[:, L * 3 // 4:] = float("-inf")
+    npages = (L + PAGE - 1) // PAGE
+    page_table = torch.randperm(npages * 4, device=dev, dtype=torch.int32)[:npages].unsqueeze(0).repeat(bs, 1).contiguous()
+    out1 = torch.empty(bs, topk, dtype=torch.int32, device=dev); raw1 = torch.empty_like(out1)
+    out2 = torch.empty(bs, topk, dtype=torch.int32, device=dev)
+    topk_transform_paged(scores, seq_lens, page_table, out1, PAGE, raw1)
+    meta = plan_topk_v2(seq_lens)
+    topk_transform_paged_v2(scores, seq_lens, page_table, out2, PAGE, meta)
+    torch.cuda.synchronize()
+    ok = True
+    for b in range(bs):
+        s1 = set(out1[b].tolist()); s2 = set(out2[b].tolist())
+        if s1 != s2:
+            # allow differences only among tied-at-threshold scores
+            r1 = raw1[b]; vals1 = scores[b][r1.clamp_min(0).long()]
+            thr = vals1.min().item()
+            # v2 raw indices: invert page transform
+            inv = {int(page_table[b, i].item()): i for i in range(npages)}
+            r2 = torch.tensor([inv[v >> 6] * PAGE + (v & 63) if v >= 0 else -1 for v in out2[b].tolist()], device=dev)
+            vals2 = scores[b][r2.clamp_min(0).long()]
+            d1 = sorted(vals1.tolist()); d2 = sorted(vals2.tolist())
+            if d1 != d2:
+                ok = False
+                print(f"  MISMATCH bs={bs} L={L} ties={ties} tail={ninf_tail}: diff {len(s1 ^ s2)} entries; min1={thr} min2={vals2.min().item()}")
+    def timeit(fn):
+        for _ in range(3): fn()
+        torch.cuda.synchronize(); t = time.perf_counter()
+        for _ in range(reps): fn()
+        torch.cuda.synchronize(); return (time.perf_counter() - t) / reps * 1e6
+    t1 = timeit(lambda: topk_transform_paged(scores, seq_lens, page_table, out1, PAGE, raw1))
+    t2 = timeit(lambda: topk_transform_paged_v2(scores, seq_lens, page_table, out2, PAGE, meta))
+    print(f"bs={bs} L={L:7d} ties={int(ties)} tail={int(ninf_tail)}  v1 {t1:7.1f} us  v2 {t2:7.1f} us  x{t1/t2:.2f}  {'OK' if ok else 'FAIL'}")
+    return ok
+allok = True
+for bs in (1, 3):
+    for L in (4096, 8192, 20000, 40000, 65536, 131072, 262144):
+        for ties, tail in ((False, False), (True, False), (False, True)):
+            allok &= run(bs, L, ties=ties, ninf_tail=tail)
+print("ALL OK" if allok else "FAILURES")
