+    ks: torch.Tensor,
+    ke: torch.Tensor,
+    max_seqlen_k: int,
+    chunk: int,
+) -> torch.Tensor:
+    """`_dense_fp4_mqa_logits` for a few rows against a long window, spread over
+    the SMs. The DeepGEMM kernel schedules one persistent block per q block of
+    4 rows and streams every KV block of that q block's window inside it, so a
+    bounded-replay tail (<= 16 rows) against a 100K+ window leaves one SM
+    working. Here each row is replicated once per `chunk`-column KV chunk; rows
+    that share a window start (one request) and chunk share a q block, so no
+    block streams more than its chunk; the kernel's per-row [ks, ke) window
+    makes every replica score only its chunk, and the chunk outputs are
+    gathered back into the `[rows, max_seqlen_k]` layout of the direct call.
+    Every element is the same dot product in the same head order, so the valid
+    columns are bitwise equal to the direct call."""
+    q, q_sf = q_fp4
+    rows = q.shape[0]
+    chunk = ceil_align(chunk, 128)
+    num_chunks = -(-max_seqlen_k // chunk)
+    if num_chunks <= 1:
+        return _dense_fp4_mqa_logits(q_fp4, kv_fp4, weights, ks, ke, max_seqlen_k)
+    block_q = 4
+    device = q.device
+    # Group rows by window start; pad each group to whole q blocks with copies
+    # of its last row (their output is dropped). Host-side over <= 16 rows.
+    ks_list = ks.tolist()
+    groups: dict = {}
+    for r, k in enumerate(ks_list):
+        groups.setdefault(k, []).append(r)
+    rep_rows, out_slot = [], {}  # out_slot[(row, chunk)] = replicated row index
+    for k, members in groups.items():
+        padded = members + [members[-1]] * (ceil_align(len(members), block_q) - len(members))
+        for c in range(num_chunks):
+            for r in padded:
+                out_slot.setdefault((r, c), len(rep_rows))
+                rep_rows.append((r, c))
+    rep = torch.tensor([r for r, _ in rep_rows], dtype=torch.int64, device=device)
+    chunk_start = torch.tensor(
+        [c * chunk for _, c in rep_rows], dtype=torch.int64, device=device
+    )
+    ks_rep = ks[rep].to(torch.int64) + chunk_start
+    ke_rep = torch.minimum(ke[rep].to(torch.int64), ks_rep + chunk)
+    ke_rep = torch.maximum(ke_rep, ks_rep)  # chunk past the row's end: empty
+    out = _dense_fp4_mqa_logits(
+        (q[rep], q_sf[rep]),
+        kv_fp4,
+        weights[rep],
+        ks_rep.to(torch.int32),
+        ke_rep.to(torch.int32),
+        chunk,
