+++ b/sglang/kernels/jit/tests/test_dsv41_engram_fused_commit.py
@@ -0,0 +1,321 @@
+"""Equivalence of the fused engram decode hash+commit with the kernel-plus-torch path.
+
+The fused entry point (upstream sglang#39138) advances the n-gram history inside the
+hash kernel. Every case here runs both paths on identical inputs and requires the hash
+ids to be equal and the live history rows to be equal; hash ids are integers, so the
+comparison is bitwise. Padded rows (out_cache_loc 0) must leave their slot untouched,
+including when a padded row aliases a live request's slot.
+"""
+
+import pytest
+import torch
+
+from sglang.kernels.ops.embeddings.engram_hash import (
+    MODE_DECODE,
+    engram_hash_ids,
+    engram_hash_ids_and_commit,
+)
+
+VOCAB = 512
+N = 4  # max_ngram_size
+L = 2  # layers
+H = 4  # heads (the kernel asserts N and H are powers of two)
+PAD = VOCAB - 1
+MM_PAD_SHIFT = 1 << 20
+
+
+def _tables(device, seed=0):
+    g = torch.Generator().manual_seed(seed)
+    return dict(
+        token_map=torch.randint(0, VOCAB, (MM_PAD_SHIFT + 8,), generator=g).to(device),
+        multipliers=torch.randint(1, 1 << 20, (L, N), generator=g).to(device),
+        primes=torch.randint(1 << 10, 1 << 20, (L, N - 1, H), generator=g).to(device),
+        offsets=torch.randint(0, 1 << 16, (L, (N - 1) * H), generator=g).to(device),
+        pad_id=PAD,
+    )
+
+
+def _old_path(ids, pos, history, req_slots, out_loc, tabs, pad_row):
+    """The kernel plus the five torch ops it replaces."""
+    hist = history.clone()
+    hash_ids, tokens = engram_hash_ids(
+        ids,
+        pos,
+        mode=MODE_DECODE,
+        history=hist,
+        num_real=ids.shape[0],
+        req_slots=req_slots.to(torch.int64),
+        block=1,
+        row=None,
+        starts=None,
+        mm_pad_shift=MM_PAD_SHIFT,
+        **tabs,
+    )
+    rows = req_slots.to(torch.int64)
+    rows = torch.where(out_loc == 0, torch.full_like(rows, pad_row), rows)
+    hist[rows] = tokens[:, : N - 1].flip(-1).to(hist.dtype)
+    return hash_ids, hist
+
+
+def _new_path(ids, pos, history, req_slots, out_loc, tabs):
+    hist = history.clone()
+    hash_ids = engram_hash_ids_and_commit(
+        ids,
+        pos,
+        history=hist,
+        req_slots=req_slots,
+        out_cache_loc=out_loc,
+        mm_pad_shift=MM_PAD_SHIFT,
+        **tabs,
+    )
+    return hash_ids, hist
+
+
+def _check(ids, pos, history, req_slots, out_loc, slots_total, seed=0):
+    dev = "cuda"
+    tabs = _tables(dev, seed)
+    ids, pos = ids.to(dev), pos.to(dev)
+    history, req_slots, out_loc = history.to(dev), req_slots.to(dev), out_loc.to(dev)
+    old_ids, old_hist = _old_path(
+        ids, pos, history, req_slots, out_loc, tabs, slots_total
+    )
+    new_ids, new_hist = _new_path(ids, pos, history, req_slots, out_loc, tabs)
+    assert torch.equal(old_ids, new_ids), "hash ids differ"
+    live = out_loc != 0
+    live_rows = req_slots[live].to(torch.int64).unique()
+    assert torch.equal(old_hist[live_rows], new_hist[live_rows]), "live history differs"
+    # Rows no request owns are untouched by the fused path.
+    untouched = torch.ones(new_hist.shape[0], dtype=torch.bool, device=dev)
+    untouched[req_slots.to(torch.int64)] = False
+    assert torch.equal(new_hist[untouched], history[untouched]), "stray history write"
+    return new_hist
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+@pytest.mark.parametrize("bs", [1, 2, 3, 5, 8, 17, 64])
+def test_decode_commit_matches_torch_path(bs):
+    g = torch.Generator().manual_seed(100 + bs)
+    slots = max(bs, 9)
+    ids = torch.randint(0, VOCAB, (bs,), generator=g)
+    pos = torch.randint(3, 50, (bs,), generator=g)
+    hist = torch.randint(0, VOCAB, (slots + 1, N - 1), generator=g, dtype=torch.int32)
+    req_slots = torch.randperm(slots, generator=g)[:bs]
+    out_loc = torch.arange(1, bs + 1)
+    _check(ids, pos, hist, req_slots, out_loc, slots)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+def test_padded_row_aliasing_a_live_slot_does_not_commit():
+    # Graph padding reuses a live request's slot; only the live row may advance.
+    g = torch.Generator().manual_seed(6)
+    bs, slots = 5, 9
+    ids = torch.randint(0, VOCAB, (bs,), generator=g)
+    pos = torch.randint(3, 50, (bs,), generator=g)
+    hist = torch.randint(0, VOCAB, (slots + 1, N - 1), generator=g, dtype=torch.int32)
+    req_slots = torch.tensor([7, 2, 0, 5, 2])  # row 4 is padding and aliases row 1
+    out_loc = torch.tensor([11, 12, 13, 14, 0])
+    new_hist = _check(ids, pos, hist, req_slots, out_loc, slots)
+    # Slot 2 must carry token 1's commit, not the padded token 4's.
+    tabs = _tables("cuda", 0)
+    _, tokens = engram_hash_ids(
+        ids.cuda(),
+        pos.cuda(),
+        mode=MODE_DECODE,
+        history=hist.cuda(),
+        num_real=bs,
+        req_slots=req_slots.cuda().to(torch.int64),
+        block=1,
+        row=None,
+        starts=None,
+        mm_pad_shift=MM_PAD_SHIFT,
+        **tabs,
+    )
+    want = tokens[1, : N - 1].flip(-1).to(torch.int32)
+    assert torch.equal(new_hist[2].cpu(), want.cpu())
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+def test_across_triton_programs_with_aliased_padding():
+    # 100 rows span four 32-token programs; padded rows alias live slots, so the
+    # read-before-write order has to hold across programs.
+    g = torch.Generator().manual_seed(8)
+    bs, slots, live = 100, 160, 90
+    ids = torch.randint(0, VOCAB, (bs,), generator=g)
+    pos = torch.randint(3, 50, (bs,), generator=g)
+    hist = torch.randint(0, VOCAB, (slots + 1, N - 1), generator=g, dtype=torch.int32)
+    live_slots = torch.randperm(slots, generator=g)[:live]
+    req_slots = torch.cat([live_slots, live_slots[: bs - live]])
+    out_loc = torch.cat([torch.arange(1, live + 1), torch.zeros(bs - live, dtype=torch.long)])
+    _check(ids, pos, hist, req_slots, out_loc, slots)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+@pytest.mark.parametrize("position", [0, 1, 2, 3])
+def test_first_tokens_and_empty_history(position):
+    # Positions below n - 1 block the older shifts; a zeroed history is the
+    # freshly-initialised state.
+    bs, slots = 4, 6
+    ids = torch.randint(0, VOCAB, (bs,), generator=torch.Generator().manual_seed(3))
+    pos = torch.full((bs,), position)
+    hist = torch.zeros(slots + 1, N - 1, dtype=torch.int32)
+    req_slots = torch.arange(bs)
+    out_loc = torch.arange(1, bs + 1)
+    _check(ids, pos, hist, req_slots, out_loc, slots)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+def test_every_row_padded_leaves_history_unchanged():
+    bs, slots = 6, 8
+    ids = torch.randint(0, VOCAB, (bs,), generator=torch.Generator().manual_seed(5))
+    pos = torch.full((bs,), 9)
+    hist = torch.randint(
+        0, VOCAB, (slots + 1, N - 1), generator=torch.Generator().manual_seed(5), dtype=torch.int32
+    )
+    req_slots = torch.arange(bs)
+    out_loc = torch.zeros(bs, dtype=torch.long)
+    before = hist.clone().cuda()
+    new_hist = _check(ids, pos, hist, req_slots, out_loc, slots)
+    assert torch.equal(new_hist, before)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+def test_capture_and_replay_is_bitwise():
+    # The fused hasher is one node of the decode graph: capture it, replay it with
+    # fresh inputs, and require the eager result on the same inputs.
+    bs, slots = 8, 12
+    dev = "cuda"
+    tabs = _tables(dev, 11)
+    ids = torch.randint(0, VOCAB, (bs,), device=dev)
+    pos = torch.randint(3, 50, (bs,), device=dev)
+    req_slots = torch.arange(bs, device=dev)
+    out_loc = torch.arange(1, bs + 1, device=dev)
+    hist = torch.randint(0, VOCAB, (slots + 1, N - 1), device=dev, dtype=torch.int32)
+
+    graph_hist = hist.clone()
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(s):
+        for _ in range(3):
+            engram_hash_ids_and_commit(
+                ids, pos, history=graph_hist.clone(), req_slots=req_slots,
+                out_cache_loc=out_loc, mm_pad_shift=MM_PAD_SHIFT, **tabs,
+            )
+    torch.cuda.current_stream().wait_stream(s)
+    graph_hist.copy_(hist)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        out = engram_hash_ids_and_commit(
+            ids, pos, history=graph_hist, req_slots=req_slots,
+            out_cache_loc=out_loc, mm_pad_shift=MM_PAD_SHIFT, **tabs,
+        )
+    for _ in range(3):
+        graph_hist.copy_(hist)
+        g.replay()
+        torch.cuda.synchronize()
+        eager_hist = hist.clone()
+        eager = engram_hash_ids_and_commit(
+            ids, pos, history=eager_hist, req_slots=req_slots,
+            out_cache_loc=out_loc, mm_pad_shift=MM_PAD_SHIFT, **tabs,
+        )
+        assert torch.equal(out, eager), "replayed ids differ from eager"
+        assert torch.equal(graph_hist, eager_hist), "replayed history differs"
+
+
+# --- EngramHasher.forward: the flag must not change what any caller observes ---
+
+
+class _Mode:
+    def __init__(self, kind):
+        self.kind = kind
+
+    def is_decode(self):
+        return self.kind in ("decode", "pregather_decode")
+
+    def is_target_verify(self):
+        return self.kind == "verify"
+
+    def is_extend(self):
+        return self.kind == "extend"
+
+
+class _Batch:
+    def __init__(self, kind, ids, pos, req_slots, out_loc, block=1):
+        self.forward_mode = _Mode(kind)
+        self.input_ids = ids
+        self.positions = pos
+        self.req_pool_indices = req_slots
+        self.out_cache_loc = out_loc
+        self.ngram_history = None
+        self.spec_info = type("S", (), {"draft_token_num": block})()
+
+
+def _hasher(device, slots, seed=0):
+    from sglang.srt.layers.engram import EngramHasher
+
+    h = EngramHasher.__new__(EngramHasher)
+    torch.nn.Module.__init__(h)
+    t = _tables(device, seed)
+    h.max_ngram_size = N
+    h.pad_id = t["pad_id"]
+    h.token_map = t["token_map"]
+    h.multipliers = t["multipliers"]
+    h.primes = t["primes"]
+    h.offsets = t["offsets"]
+    h.image_token_id = None
+    hg = torch.Generator().manual_seed(900 + seed)
+    h.history = torch.randint(
+        0, VOCAB, (slots + 1, N - 1), generator=hg, dtype=torch.int32
+    ).to(device)
+    h.pad_row = slots
+    return h
+
+
+def _run_forward(kind, flag, bs=6, slots=10, block=1, seed=0):
+    from sglang.srt.environ import envs
+
+    dev = "cuda"
+    g = torch.Generator().manual_seed(seed)
+    n_tok = bs * block
+    ids = torch.randint(0, VOCAB, (n_tok,), generator=g).to(dev)
+    pos = torch.randint(5, 60, (n_tok,), generator=g).to(dev)
+    req_slots = torch.randperm(slots, generator=g)[:bs].to(dev)
+    out_loc = torch.arange(1, n_tok + 1, device=dev)
+    out_loc[-1] = 0  # one padded row
+    h = _hasher(dev, slots, seed)
+    start_hist = h.history.clone()
+    batch = _Batch(kind, ids, pos, req_slots, out_loc, block)
+    old = envs.SGLANG_DSV41_ENGRAM_FUSED_COMMIT.get()
+    try:
+        envs.SGLANG_DSV41_ENGRAM_FUSED_COMMIT.set(flag)
+        hash_ids = h(ids, batch, commit=not kind.startswith("pregather"))
+    finally:
+        envs.SGLANG_DSV41_ENGRAM_FUSED_COMMIT.set(old)
+    return hash_ids, h.history, start_hist
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+@pytest.mark.parametrize("bs", [1, 4, 6, 33])
+def test_forward_decode_flag_is_transparent(bs):
+    off_ids, off_hist, _ = _run_forward("decode", False, bs=bs, slots=max(bs, 10))
+    on_ids, on_hist, _ = _run_forward("decode", True, bs=bs, slots=max(bs, 10))
+    assert torch.equal(off_ids, on_ids), "decode hash ids differ with the flag"
+    # Live rows must match; the pad row is written by the old path and skipped by
+    # the fused one, and nothing reads it.
+    assert torch.equal(off_hist[:-1], on_hist[:-1]), "decode history differs"
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+def test_pregather_call_never_commits_with_the_flag_on():
+    # The eager pre-replay hasher passes commit=False; the fused path must not
+    # take that call, or history would advance twice per step.
+    ids, hist, start = _run_forward("pregather_decode", True)
+    assert torch.equal(hist, start), "commit=False wrote history"
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+def test_forward_verify_is_untouched_by_the_flag():
+    off_ids, off_hist, off_start = _run_forward("verify", False, bs=4, block=5)
+    on_ids, on_hist, on_start = _run_forward("verify", True, bs=4, block=5)
+    assert torch.equal(off_ids, on_ids), "verify hash ids differ with the flag"
+    # Verify never commits in forward; acceptance commits afterwards.
+    assert torch.equal(off_hist, off_start) and torch.equal(on_hist, on_start)
diff --git a/sglang/kernels/jit/tests/test_dsv41_engram_pinned.py b/sglang/kernels/jit/tests/test_dsv41_engram_pinned.py
new file mode 100644
index 0000000..44c70bc
--- /dev/null
+++ b/sglang/kernels/jit/tests/test_dsv41_engram_pinned.py
@@ -0,0 +1,130 @@
+"""Pinned in-RAM engram table: in-graph gather from a cudaHostRegister'ed memfd.
+
+Run inside the SM120 image on one GPU (small VRAM):
+  python test_dsv41_engram_pinned.py            # correctness + graph replay + latency
+  python test_dsv41_engram_pinned.py --bench    # adds the 4 GiB table latency/bandwidth sweep
+Checks: (1) rows gathered straight from pinned host memory are bitwise equal to the
+disk path (rows staged to the device, same dequant kernel); (2) capture/replay of the
+host-pointer gather is bitwise equal to eager; (3) duplicate ids and every row of a
+small table; (4) VRAM charged by registering host memory (GPU page tables), scaled to
+the 2 x 94.4 GiB tables.
+"""
+import argparse, mmap, os, sys, time
+import torch
+from sglang.kernels.ops.embeddings.engram_gather import engram_gather
+
+DIM, BLK = 256, 128
+ROW = DIM + DIM // BLK  # 264 bytes: fp8 payload then e8m0 scales, table = [w | s]
+
+
+def make_table(rows: int, seed: int):
+    fd = os.memfd_create("engram-test", 0)
+    nbytes = rows * ROW
+    os.ftruncate(fd, nbytes)
+    mm = mmap.mmap(fd, nbytes, flags=mmap.MAP_SHARED, prot=mmap.PROT_READ | mmap.PROT_WRITE)
+    mm.madvise(mmap.MADV_HUGEPAGE)
+    t = torch.frombuffer(mm, dtype=torch.uint8)
+    g = torch.Generator().manual_seed(seed)
+    # fill in 256 MiB chunks so a 4 GiB table does not need 4 GiB of temporaries
+    step = 256 << 20
+    for a in range(0, nbytes, step):
+        n = min(step, nbytes - a)
+        t[a : a + n] = torch.randint(0, 256, (n,), dtype=torch.uint8, generator=g)
+    err = torch.cuda.cudart().cudaHostRegister(t.data_ptr(), nbytes, 0)
+    assert int(err) == 0, f"cudaHostRegister failed: {err}"
+    w_ptr = t.data_ptr()
+    s_ptr = w_ptr + rows * DIM
+    return t, mm, fd, w_ptr, s_ptr
+
+
+def reference_via_device(t: torch.Tensor, rows: int, ids: torch.Tensor) -> torch.Tensor:
+    """The disk path: unique rows staged to the device, then the same dequant kernel."""
+    w = t[: rows * DIM].view(rows, DIM)
+    s = t[rows * DIM :].view(rows, DIM // BLK)
+    uniq, inv = torch.unique(ids, return_inverse=True)
+    uc = uniq.cpu()
+    dw = w.index_select(0, uc).to("cuda")
+    ds = s.index_select(0, uc).to("cuda")
+    out_u = torch.empty((uniq.numel(), DIM), dtype=torch.bfloat16, device="cuda")
+    engram_gather(dw.data_ptr(), ds.data_ptr(), torch.arange(uniq.numel(), device="cuda"), out_u, DIM, BLK)
+    return out_u[inv]
+
+
+def host_gather(w_ptr: int, s_ptr: int, ids: torch.Tensor) -> torch.Tensor:
+    out = torch.empty((ids.numel(), DIM), dtype=torch.bfloat16, device="cuda")
+    engram_gather(w_ptr, s_ptr, ids, out, DIM, BLK)
+    return out
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--bench", action="store_true")
+    ap.add_argument("--rows", type=int, default=1 << 20)
+    a = ap.parse_args()
+    torch.cuda.set_device(0)
+    free0, _ = torch.cuda.mem_get_info()
+    t, mm, fd, w_ptr, s_ptr = make_table(a.rows, 1)
+    free1, _ = torch.cuda.mem_get_info()
+    nbytes = a.rows * ROW
+    print(f"table {nbytes / 2**20:.0f} MiB registered; VRAM delta {(free0 - free1) / 2**20:.1f} MiB "
+          f"= {(free0 - free1) / nbytes * 2**30 / 2**20:.2f} MiB per GiB -> "
+          f"{(free0 - free1) / nbytes * (2 * 101377628352) / 2**20:.0f} MiB for both real tables")
+    g = torch.Generator(device="cuda").manual_seed(2)
+    # (1)+(3): random ids with duplicates, then every row of a small prefix
+    ids = torch.randint(0, a.rows, (4096,), device="cuda", generator=g)
+    ids[::7] = ids[3]
+    out = host_gather(w_ptr, s_ptr, ids)
+    ref = reference_via_device(t, a.rows, ids)
+    assert torch.equal(out.view(torch.int16), ref.view(torch.int16)), "host gather != staged gather"
+    ids_all = torch.arange(min(a.rows, 65536), device="cuda")
+    assert torch.equal(host_gather(w_ptr, s_ptr, ids_all).view(torch.int16),
+                       reference_via_device(t, a.rows, ids_all).view(torch.int16))
+    # (2): graph capture / replay with a static id buffer
+    static_ids = torch.zeros(72, dtype=torch.int64, device="cuda")
+    static_out = torch.empty((72, DIM), dtype=torch.bfloat16, device="cuda")
+    s = torch.cuda.Stream()
+    with torch.cuda.stream(s):
+        for _ in range(3):
+            engram_gather(w_ptr, s_ptr, static_ids, static_out, DIM, BLK)
+    torch.cuda.current_stream().wait_stream(s)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        engram_gather(w_ptr, s_ptr, static_ids, static_out, DIM, BLK)
+    for trial in range(3):
+        static_ids.copy_(torch.randint(0, a.rows, (72,), device="cuda", generator=g))
+        graph.replay()
+        torch.cuda.synchronize()
+        eager = host_gather(w_ptr, s_ptr, static_ids.clone())
+        assert torch.equal(static_out.view(torch.int16), eager.view(torch.int16)), f"replay {trial} differs"
+    print("correctness: host-pointer gather == staged path (bitwise); graph replay == eager (bitwise)")
+    # latency at the decode shape (72 rows = 3 tokens x 24 ids), warm
+    def timeit(n_rows: int, iters: int, table_rows: int):
+        idb = torch.randint(0, table_rows, (n_rows,), device="cuda", generator=g)
+        ob = torch.empty((n_rows, DIM), dtype=torch.bfloat16, device="cuda")
+        for _ in range(10):
+            engram_gather(w_ptr, s_ptr, idb, ob, DIM, BLK)
+        torch.cuda.synchronize()
+        e0, e1 = torch.cuda.Event(enable_timing=True), torch.cuda.Event(enable_timing=True)
+        e0.record()
+        for _ in range(iters):
+            idb.copy_(torch.randint(0, table_rows, (n_rows,), device="cuda", generator=g))
+            engram_gather(w_ptr, s_ptr, idb, ob, DIM, BLK)
+        e1.record(); torch.cuda.synchronize()
+        us = e0.elapsed_time(e1) * 1e3 / iters
+        return us, n_rows * ROW / us / 1e3  # GB/s
+    for n_rows in (24, 72, 1536):
+        us, gbs = timeit(n_rows, 200, a.rows)
+        print(f"gather {n_rows:5d} rows from {nbytes / 2**30:.2f} GiB pinned table: {us:7.1f} us  ({gbs:5.2f} GB/s over PCIe)")
+    torch.cuda.cudart().cudaHostUnregister(t.data_ptr()); mm.close(); os.close(fd)
+    if a.bench:
+        rows = (4 << 30) // ROW
+        t, mm, fd, w_ptr, s_ptr = make_table(rows, 3)
+        for n_rows in (24, 72, 1536, 98304):
+            us, gbs = timeit(n_rows, 100 if n_rows < 10000 else 10, rows)
+            print(f"gather {n_rows:5d} rows from 4 GiB pinned table (cold rows): {us:8.1f} us  ({gbs:5.2f} GB/s)")
+        torch.cuda.cudart().cudaHostUnregister(t.data_ptr()); mm.close(); os.close(fd)
+    print("OK")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/sglang/kernels/jit/tests/test_dsv41_launch_fusion.py b/sglang/kernels/jit/tests/test_dsv41_launch_fusion.py
new file mode 100644
index 0000000..9f21dff
--- /dev/null
+++ b/sglang/kernels/jit/tests/test_dsv41_launch_fusion.py
@@ -0,0 +1,127 @@
+"""Decode-step launch fusion checks (NOTES-launch-fusion.md), all against the unfused paths:
+
+1. engram_fill: fill_decode_pregather_cpu produces a bit-identical pre-gather buffer to
+   fill_decode_pregather on synthetic fp8 tables with duplicate ids.
+2. router_remap: a permuted router (kept rows first) emits, through moe_fused_gate, the same
+   slot ids and bitwise the same weights as the masked router followed by the remap.
+3. GEMV PDL: the PDL build is bitwise equal to the plain build, and a captured graph
+   replays bitwise.
+Run inside the SM120 image: python -m pytest kernels/jit/tests/test_dsv41_launch_fusion.py -x -q
+"""
+from __future__ import annotations
+
+import numpy as np
+import torch
+
+DEV = torch.device("cuda")
+
+
+def _synthetic_engram(rows: int, dim: int, blk: int):
+    from sglang.srt.layers.engram import EngramEmbedding  # noqa: F401  (class under test)
+    from sglang.srt.layers import engram as eng
+
+    g = torch.Generator().manual_seed(0)
+    w = torch.randint(0, 256, (rows, dim), dtype=torch.uint8, generator=g)
+    s = torch.randint(100, 140, (rows, dim // blk), dtype=torch.uint8, generator=g)
+    cls = eng.EngramEmbedding
+    obj = cls.__new__(cls)
+    obj.dim = dim
+    obj.layer_id = 7
+    obj._disk_w_u8 = w
+    obj._disk_s_u8 = s
+    obj._staging_ring = []
+    obj._staging_next = 0
+    obj._gather_pool = None
+    obj._pregather_emb = {}
+    return obj
+
+
+def test_engram_fill_v2_bitwise():
+    from sglang.srt.layers.attention.dsv4.torch_quant import FP8_BLOCK_SIZE
+
+    dim, rows, cols, cap = 1024, 4096, 24, 3
+    obj = _synthetic_engram(rows, dim, FP8_BLOCK_SIZE)
+    obj.enable_decode_pregather(cap, cols, DEV, "decode")
+    for t in (1, 2, 3):
+        ids = torch.randint(0, rows, (t, cols), dtype=torch.int64)
+        ids[:, : cols // 2] = ids[:, :1]  # heavy duplication, like repeated n-grams
+        obj.fill_decode_pregather(ids.to(DEV), "decode")
+        torch.cuda.synchronize()
+        ref = obj._pregather_emb["decode"].clone()
+        obj._pregather_emb["decode"].fill_(float("nan"))
+        obj.fill_decode_pregather_cpu(ids, "decode")
+        torch.cuda.synchronize()
+        got = obj._pregather_emb["decode"]
+        assert torch.equal(ref.view(torch.int16), got.view(torch.int16)), f"engram fill mismatch at t={t}"
+
+
+def test_router_permutation_matches_remap():
+    from sglang.kernels.ops.moe.moe_fused_gate import moe_fused_gate
+    from sglang.srt.layers.quantization.mxfp4_expert_store import build_pruned_experts
+
+    E, H, topk, keep = 384, 512, 6, 224
+    g = torch.Generator(device=DEV).manual_seed(1)
+    W = torch.randn(E, H, device=DEV, dtype=torch.bfloat16, generator=g)
+    bias = torch.randn(E, device=DEV, dtype=torch.float32, generator=g)
+    kept = sorted(np.random.default_rng(2).choice(E, keep, replace=False).tolist())
+    dropped = sorted(set(range(E)) - set(kept))
+    prune = build_pruned_experts(kept, E, DEV, "test")
+    # masked router + remap (production path)
+    bias_m = bias.clone()
+    bias_m[torch.tensor(dropped, device=DEV)] = -1e30
+    # permuted router (fusion site)
+    perm = torch.tensor(kept + dropped, device=DEV)
+    W_p = W[perm].contiguous()
+    bias_p = bias[perm].clone()
+    bias_p[keep:] = -1e30
+    for M in (1, 3, 8):
+        x = torch.randn(M, H, device=DEV, dtype=torch.bfloat16, generator=g)
+        logits = x @ W.t()
+        logits_p = x @ W_p.t()
+        assert torch.equal(logits[:, perm], logits_p)  # same values, permuted columns
+        w_ref, ids_ref = moe_fused_gate(logits, bias_m, topk=topk, scoring_func="sqrtsoftplus",
+                                        renormalize=True, routed_scaling_factor=1.5,
+                                        apply_routed_scaling_factor_on_output=True)
+        w_new, ids_new = moe_fused_gate(logits_p, bias_p, topk=topk, scoring_func="sqrtsoftplus",
+                                        renormalize=True, routed_scaling_factor=1.5,
+                                        apply_routed_scaling_factor_on_output=True)
+        slots_ref = prune.remap_topk_ids(ids_ref.to(torch.int32))
+        assert torch.equal(slots_ref.to(torch.int64), ids_new.to(torch.int64)), f"slot ids differ at M={M}"
+        assert torch.equal(w_ref, w_new), f"topk weights differ at M={M}"
+        assert int(ids_new.max()) < keep
+
+
+def test_gemv_pdl_bitwise_and_graph():
+    from sglang.kernels.ops.gemm.sm120_block_fp8_gemv import sm120_block_fp8_gemv
+
+    N, K = 2048, 5120
+    g = torch.Generator(device=DEV).manual_seed(3)
+    w = torch.randn(N, K, device=DEV, generator=g).to(torch.float8_e4m3fn)
+    scale = (torch.rand((N + 31) // 32, K // 32, device=DEV, generator=g) + 0.5).float()
+    for M in (1, 3, 8):
+        x = torch.randn(M, K, device=DEV, dtype=torch.bfloat16, generator=g)
+        ref = sm120_block_fp8_gemv(x, w, scale, pdl=False)
+        got = sm120_block_fp8_gemv(x, w, scale, pdl=True)
+        torch.cuda.synchronize()
+        assert torch.equal(ref, got), f"PDL build differs at M={M}"
+        # two PDL launches back to back, then capture + replay
+        s = torch.cuda.Stream()
+        with torch.cuda.stream(s):
+            y1 = sm120_block_fp8_gemv(x, w, scale, pdl=True)
+            y2 = sm120_block_fp8_gemv(y1[:, :K] if N >= K else x, w, scale, pdl=True)
+        torch.cuda.synchronize()
+        graph = torch.cuda.CUDAGraph()
+        xs = x.clone()
+        with torch.cuda.graph(graph, stream=s):
+            z1 = sm120_block_fp8_gemv(xs, w, scale, pdl=True)
+            z2 = sm120_block_fp8_gemv(z1[:, :K] if N >= K else xs, w, scale, pdl=True)
+        graph.replay(); torch.cuda.synchronize()
+        assert torch.equal(z1, y1) and torch.equal(z2, y2), f"graph replay differs at M={M}"
+        graph.replay(); torch.cuda.synchronize()
+        assert torch.equal(z2, y2)
+
+
+if __name__ == "__main__":
+    test_engram_fill_v2_bitwise(); print("engram fill v2: bitwise OK")
+    test_router_permutation_matches_remap(); print("router permutation: OK")
+    test_gemv_pdl_bitwise_and_graph(); print("GEMV PDL: bitwise + graph OK")
diff --git a/sglang/kernels/jit/tests/test_dsv41_lm_head_fp8.py b/sglang/kernels/jit/tests/test_dsv41_lm_head_fp8.py
