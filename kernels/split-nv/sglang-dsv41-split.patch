+        logits.stride(0),
+        page_table.stride(0),
+        page_indices.stride(0),
+        raw_stride,
+        L,
+        P,
+        K=K,
+        PAGE=page_size,
+        HAS_RAW=raw_indices is not None,
+        BLOCK=block,
+        ENABLE_PDL=enable_pdl,
+        num_warps=4 if block <= 512 else 8,
+        **extra,
+    )
