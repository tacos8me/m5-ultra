index 0000000..828aaaf
--- /dev/null
+++ b/sglang/test/srt/models/test_dsv41_expert_prune.py
@@ -0,0 +1,144 @@
+"""Correctness of expert pruning: the kept-subset MoE == the full MoE restricted
+to those experts, and the router mask never selects a dropped expert.
+
+Proves, on real layer-0 experts, that (1) loading only the kept experts into a
+[num_kept,...] tensor and remapping global->slot gives bit-identical CUTLASS MoE
+output to the full tensor when routing hits only kept experts, and (2) masking
+the correction bias (sqrtsoftplus scores + bias) excludes dropped experts from
+top-k. Requires SM120 + FlashInfer + the checkpoint; self-skips otherwise.
+Run: SGLANG_DSV41_UVA_PAGEABLE=1 python3 test/srt/models/test_dsv41_expert_prune.py
+"""
+
+from __future__ import annotations
+
+import os
+import pathlib
+
+import pytest
+import torch
+import torch.nn.functional as F
+
+CKPT = os.environ.get("SGLANG_DSV41_TEST_CHECKPOINT", "/home/ian/models/DeepSeek-V4.1-Flash")
+LAYER = 0
+N_TOTAL = 16                    # experts[0:16] of layer 0 (reference)
+KEEP = [0, 1, 3, 4, 6, 7, 9, 10, 12, 15]   # 10 kept, 6 dropped
+TOPK = 6
+HIDDEN = 5120
+STEPS = 12
+
+
+def _available() -> bool:
+    if not torch.cuda.is_available():
+        return False
+    if not os.path.isfile(os.path.join(CKPT, "model.safetensors.index.json")):
+        return False
+    try:
+        import flashinfer  # noqa: F401
+        import safetensors  # noqa: F401
+    except Exception:
+        return False
+    return True
+
+
+def _run_moe(w13, w2, w13s, w2s, x, topk_ids, topk_w, dev):
+    from flashinfer import mxfp8_quantize
+    from flashinfer.fused_moe import cutlass_fused_moe
+    from flashinfer.fused_moe.core import ActivationType
+
+    E = w13.shape[0]
+    gscale = torch.ones(E, dtype=torch.float32, device=dev)
+    slimit = torch.full((E,), 10.0, dtype=torch.float32, device=dev)
+    xq, input_sf = mxfp8_quantize(x, is_sf_swizzled_layout=True, alignment=32)
+    out = torch.empty(x.shape[0], HIDDEN, dtype=torch.bfloat16, device=dev)
+    cutlass_fused_moe(
+        input=xq, token_selected_experts=topk_ids.to(torch.int32),
+        token_final_scales=topk_w, fc1_expert_weights=w13.view(torch.int64),
+        fc2_expert_weights=w2.view(torch.int64), output_dtype=torch.bfloat16,
+        quant_scales=[w13s.view(torch.int32), gscale, w2s.view(torch.int32), gscale],
+        input_sf=input_sf, swiglu_limit=slimit, tp_size=1, tp_rank=0, ep_size=1,
+        ep_rank=0, use_w4_group_scaling=False, use_mxfp8_act_scaling=True,
+        activation_type=ActivationType.Swiglu, tune_max_num_tokens=8, output=out,
+    )
+    return out
+
+
+def _host_full(dev):
+    from sglang.srt.model_loader.expert_pack.prepare_v41_expert_pack import (
+        _CheckpointReader, _build_rank_tensors,
+    )
+    reader = _CheckpointReader(pathlib.Path(CKPT))
+    return {k: v.contiguous().cpu()
+            for k, v in _build_rank_tensors(reader, LAYER, 0, N_TOTAL, dev, N_TOTAL).items()}
+
+
+def _weight_compare():
+    from sglang.srt.layers.quantization.mxfp4_expert_store import (
+        EXPERT_PARAM_NAMES, build_pruned_experts,
+    )
+    dev = torch.device("cuda", 0)
+    torch.manual_seed(0)
+    host = _host_full(dev)
+    full = {n: host[n].to(dev) for n in EXPERT_PARAM_NAMES}
+    keep_idx = torch.tensor(KEEP)
+    pruned = {n: host[n][keep_idx].to(dev) for n in EXPERT_PARAM_NAMES}  # [10,...]
+    prune = build_pruned_experts(KEEP, N_TOTAL, dev)
+    mism = 0
+    for _ in range(STEPS):
+        x = torch.randn(1, HIDDEN, device=dev, dtype=torch.bfloat16) * 0.1
+        # route only to kept globals (what the router mask guarantees)
+        sel = torch.tensor(KEEP, device=dev)[torch.randperm(len(KEEP), device=dev)[:TOPK]]
+        topk_ids = sel[None, :]
+        topk_w = torch.rand(1, TOPK, device=dev)
+        topk_w = (topk_w / topk_w.sum(-1, keepdim=True)).to(torch.float32)
+        out_full = _run_moe(full["w13_weight"], full["w2_weight"],
+                            full["w13_weight_scale_inv"], full["w2_weight_scale_inv"],
+                            x, topk_ids, topk_w, dev)
+        remapped = prune.remap_topk_ids(topk_ids)
+        out_prune = _run_moe(pruned["w13_weight"], pruned["w2_weight"],
+                             pruned["w13_weight_scale_inv"], pruned["w2_weight_scale_inv"],
+                             x, remapped, topk_w, dev)
+        torch.cuda.synchronize()
+        mism += 0 if torch.equal(out_full, out_prune) else 1
+    return mism
+
+
+def _router_mask_excludes_dropped():
+    """sqrtsoftplus(logits) + masked bias never puts a dropped expert in top-k."""
+    dev = torch.device("cuda", 0)
+    torch.manual_seed(1)
+    dropped = sorted(set(range(N_TOTAL)) - set(KEEP))
+    bias = torch.randn(N_TOTAL, device=dev) * 0.5
+    masked = bias.clone()
+    masked[torch.tensor(dropped, device=dev)] = -1e30
+    logits = torch.randn(256, N_TOTAL, device=dev) * 3.0  # large -> big scores
+    scores = F.softplus(logits).sqrt()
+    choice = scores + masked
+    ids = choice.topk(TOPK, dim=-1).indices
+    dropped_set = set(dropped)
+    leaked = int(sum(1 for v in ids.flatten().tolist() if v in dropped_set))
+    return leaked
+
+
+@pytest.mark.skipif(not _available(), reason="needs SM120 GPU, FlashInfer, and the V4.1 checkpoint")
+def test_pruned_moe_matches_full_restricted():
+    assert _weight_compare() == 0
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="needs CUDA")
+def test_router_mask_excludes_dropped():
+    assert _router_mask_excludes_dropped() == 0
+
+
+if __name__ == "__main__":
+    if not _available():
+        print("SKIP: needs SM120 GPU, FlashInfer, and the V4.1 checkpoint")
+        raise SystemExit(0)
+    print("\n==================== EXPERT PRUNE ====================")
+    mism = _weight_compare()
+    print(f"pruned MoE vs full-restricted ({len(KEEP)}/{N_TOTAL} kept), {STEPS} forwards: "
+          f"{'OK bit-exact' if mism == 0 else f'FAIL {mism}'}")
+    leaked = _router_mask_excludes_dropped()
+    print(f"router mask (256 tokens x top-{TOPK}): "
+          f"{'OK, 0 dropped selected' if leaked == 0 else f'FAIL {leaked} leaked'}")
+    print("=====================================================")
+    raise SystemExit(0 if mism == 0 and leaked == 0 else 1)
