@@ -0,0 +1,150 @@
+"""SGLang-level test of the flag-gated flat MoE path.
+
+Builds the FlashInfer SM120 MXFP4 method object and a layer holding random
+quantized experts in the production layout (uint8 packed e2m1 rows, e8m0
+scales after ``block_scale_interleave``), then checks that ``apply()`` routes a
+small-M call through ``_apply_flat`` and reproduces the standalone kernel and
+the fp32 reference, and that the call captures and replays inside a CUDA graph
+with programmatic dependent launch (the mode SGLang's decode graphs use).
+
+Run inside the SM120 image (see test_sm120_flat_mxfp4_moe.py for the command).
+"""
+
+from __future__ import annotations
+
+import os
+import sys
+from types import SimpleNamespace
+
+import torch
+from torch.nn.parameter import Parameter
+
+sys.path.insert(0, os.path.dirname(__file__))
+from test_sm120_flat_mxfp4_moe import (  # noqa: E402
+    DEV,
+    dequant_mxfp8,
+    errors,
+    make_experts,
+    reference,
+)
+
+from sglang.kernels.ops.moe.sm120_flat_mxfp4_moe import (  # noqa: E402
+    flat_mxfp4_moe_quantized,
+    quantize_activations,
+)
+
+
+def build_method(limit: float, clamp: bool, pdl: bool, max_m: int = 64):
+    from sglang.srt.layers.quantization.mxfp4_flashinfer_cutlass_moe import (
+        Mxfp4FlashinferCutlassMoEMethod,
+    )
+
+    method = object.__new__(Mxfp4FlashinferCutlassMoEMethod)
+    method._use_mxfp8_act_scaling = True
+    method._flat_moe = True
+    method._flat_moe_max_m = max_m
+    method._flat_moe_pdl = pdl
+    method._flat_moe_clamp = clamp
+    method._flat_moe_limit = limit
+    method.prefix = "model.layers.3.mlp.experts"
+    return method
+
+
+def build_layer(w13, w13_swz, w2, w2_swz):
+    # Production keeps the scales as float8_e8m0fnu parameters whose bytes are
+    # the swizzled ue8m0 codes.
+    return SimpleNamespace(
+        w13_weight=Parameter(w13, requires_grad=False),
+        w13_weight_scale_inv=Parameter(w13_swz.view(torch.float8_e8m0fnu), requires_grad=False),
+        w2_weight=Parameter(w2, requires_grad=False),
+        w2_weight_scale_inv=Parameter(w2_swz.view(torch.float8_e8m0fnu), requires_grad=False),
+    )
+
+
+def dispatch_for(x, ids, weights):
+    from sglang.srt.layers.moe.token_dispatcher.standard import StandardDispatchOutput
+    from sglang.srt.layers.moe.topk import StandardTopKOutput
+
+    return StandardDispatchOutput(
+        hidden_states=x,
+        hidden_states_scale=None,
+        topk_output=StandardTopKOutput(topk_weights=weights, topk_ids=ids, router_logits=None),
+    )
+
+
+def main():
+    hidden, inter, num_experts, topk = 5120, 1152, 8, 6
+    gen = torch.Generator(device=DEV)
+    gen.manual_seed(7)
+    w13, w13_sf, w13_swz, w2, w2_sf, w2_swz = make_experts(num_experts, inter, hidden, gen)
+    layer = build_layer(w13, w13_swz, w2, w2_swz)
+    ok = True
+
+    for m in (1, 6, 24, 64):
+        x = torch.randn((m, hidden), dtype=torch.float32, device=DEV, generator=gen).bfloat16()
+        ids = torch.stack([torch.randperm(num_experts, device=DEV, generator=gen)[:topk] for _ in range(m)])
+        ids = ids.to(torch.int64)  # SGLang topk ids may arrive as int64; the path casts
+        weights = torch.rand((m, topk), dtype=torch.float32, device=DEV, generator=gen) + 0.1
+        method = build_method(limit=10.0, clamp=True, pdl=True)
+        out = method.apply(layer, dispatch_for(x, ids, weights)).hidden_states
+        xq, xsf = quantize_activations(x)
+        direct = flat_mxfp4_moe_quantized(
+            xq, xsf, ids.to(torch.int32), weights, w13, w13_swz, w2, w2_swz, limit=10.0, clamp=True, use_pdl=True
+        )
+        same = torch.equal(out, direct)
+        ref = reference(dequant_mxfp8(xq, xsf), ids.to(torch.int32), weights, w13, w13_sf, w2, w2_sf, inter, 10.0, True)
+        mx, mean, scale = errors(out, ref)
+        good = same and mx <= 0.02 * scale + 1e-3
+        ok &= good
+        print(
+            ("PASS " if good else "FAIL ")
+            + f"apply() M={m}: bitwise-equal to direct kernel={same}, max_err={mx:.4f} mean_err={mean:.5f} ref_max={scale:.3f}",
+            flush=True,
+        )
+
+    # M above the cap must not take the flat path (the method would then need
+    # its runner, which this test does not build).
+    method = build_method(limit=10.0, clamp=True, pdl=True, max_m=4)
+    x = torch.randn((8, hidden), dtype=torch.float32, device=DEV, generator=gen).bfloat16()
+    ids = torch.stack([torch.randperm(num_experts, device=DEV, generator=gen)[:topk] for _ in range(8)]).int()
+    weights = torch.rand((8, topk), dtype=torch.float32, device=DEV, generator=gen)
+    try:
+        method.apply(layer, dispatch_for(x, ids, weights))
+        gate_ok = False
+    except AttributeError:
+        gate_ok = True  # fell through to self.runner, which does not exist here
+    ok &= gate_ok
+    print(("PASS " if gate_ok else "FAIL ") + "M > SGLANG_DSV41_FLAT_MOE_MAX_M falls through to the CUTLASS path", flush=True)
+
+    # CUDA graph capture with PDL, like SGLang's decode graphs.
+    m = 6
+    x = torch.randn((m, hidden), dtype=torch.float32, device=DEV, generator=gen).bfloat16()
+    ids = torch.stack([torch.randperm(num_experts, device=DEV, generator=gen)[:topk] for _ in range(m)]).int()
+    weights = torch.rand((m, topk), dtype=torch.float32, device=DEV, generator=gen)
+    method = build_method(limit=10.0, clamp=True, pdl=True)
+    d = dispatch_for(x, ids, weights)
+    s = torch.cuda.Stream()
+    s.wait_stream(torch.cuda.current_stream())  # the workspace is shared: order the streams
+    with torch.cuda.stream(s):
+        for _ in range(2):
+            method.apply(layer, d)
+    torch.cuda.current_stream().wait_stream(s)
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g):
+        captured = method.apply(layer, d).hidden_states
+    x.copy_(torch.randn((m, hidden), dtype=torch.float32, device=DEV, generator=gen).bfloat16())
+    ids.copy_(torch.stack([torch.randperm(num_experts, device=DEV, generator=gen)[:topk] for _ in range(m)]).int())
+    g.replay()
+    torch.cuda.synchronize()
+    eager = method.apply(layer, d).hidden_states
+    diff = (captured.float() - eager.float()).abs().max().item()
+    graph_ok = diff == 0.0
+    ok &= graph_ok
+    print(("PASS " if graph_ok else "FAIL ") + f"cuda-graph replay through apply() with PDL: max |replay - eager| = {diff:.5f}", flush=True)
+
+    print("ALL PASS" if ok else "SOME FAILED", flush=True)
+    sys.exit(0 if ok else 1)
+
+
+if __name__ == "__main__":
+    main()
