diff --git a/sglang/kernels/ops/gemm/sm120_block_fp8_gemv.py b/sglang/kernels/ops/gemm/sm120_block_fp8_gemv.py
new file mode 100644
index 0000000..f969faf
--- /dev/null
+++ b/sglang/kernels/ops/gemm/sm120_block_fp8_gemv.py
@@ -0,0 +1,127 @@
+"""SM120 few-token block-scaled FP8 GEMV (see csrc/gemm/sm120_block_fp8_gemv.cuh).
+
+Serves ``y[m, n] = x_bf16[m, :] . (W_fp8[n, :] * S[n // 32, k // 32])`` for the
+[32, 32]-block ue8m0 dense linears of DeepSeek-V4.1 at decode. The FlashInfer
+CUTLASS MXFP8 GEMM pads M to a 128-row tile and launches only N / tile_N CTAs, so
+at small M it streams the weight at ~18% of HBM bandwidth and pays a separate
+activation-quantize kernel per call. This kernel reads the weight once per call
+with one warp per row, consumes the bf16 activations directly (no quantize
+launch) and applies the block scales in fp32.
+
+The row count is a runtime argument bounded by a compile-time bucket
+(``BUCKETS``), so one build per (shape, bucket) serves every M: a decode step
+whose M varies per call (DSpark draft-extend / verify: any M in 1..6 * bs) never
+compiles mid-decode. ``prebuild_sm120_block_fp8_gemv`` builds the buckets a layer
+can reach at weight-load time; builds persist in the JIT cache
+(``SGLANG_JIT_CACHE_DIR``, default ``~/.cache/sglang/jit``).
+
+Measured on RTX PRO 6000 Blackwell (benchmark/bench_sm120_block_fp8_dense.py,
+weights rotated past L2): 4.8-14.7 us per call at M = 1 (68-90% of 1.6 TB/s)
+against 20-73 us for the quantize + CUTLASS pair; still ~2x ahead at M = 12 and
+break-even near M = 24, where the per-byte fp32 FMAs bound it.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, List, Optional
+
+import torch
+
+from sglang.kernels.jit.utils import cache_once, load_jit, make_cpp_args
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+BUCKETS = (1, 2, 4, 8, 16, 32)
+MAX_M = BUCKETS[-1]  # kernel limit; SGLANG_DSV41_DECODE_DENSE_GEMV_MAX_M caps the dispatch
+_MAX_N = 65536
+# (rows_per_warp, k_unroll, num_warps). The sweep over rows {1,2,4} x unroll
+# {1,2,4} x warps {4,8} at M = 1 was flat (every shape's best within 3% of this).
+DEFAULT_CONFIG = (1, 1, 8)
+
+
+def bucket_for(m: int) -> int:
+    """The smallest bucket holding ``m`` rows."""
+    for b in BUCKETS:
+        if m <= b:
+            return b
+    raise ValueError(f"M={m} exceeds the GEMV limit {MAX_M}")
+
+
+@cache_once
+def _jit_module(
+    n: int, k: int, max_m: int, rows: int, unroll: int, warps: int, pdl: bool = False
+) -> Module:
+    args = make_cpp_args(n, k, max_m, rows, unroll, warps, pdl)
+    return load_jit(
+        "sm120_block_fp8_gemv",
+        *args,
+        cuda_files=["gemm/sm120_block_fp8_gemv.cuh"],
+        cuda_wrappers=[("run", f"sglang::Sm120BlockFp8GemvKernel<{args}>::run")],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+def use_sm120_block_fp8_gemv(
+    m: int, n: int, k: int, weight_block_size: Optional[List[int]]
+) -> bool:
+    """Whether the GEMV serves this call: 1 <= M <= MAX_M, [32, 32] blocks and
+    K a multiple of 32."""
+    return (
+        1 <= m <= MAX_M
+        and weight_block_size is not None
+        and tuple(weight_block_size) == (32, 32)
+        and k % 32 == 0
+        and 32 <= n <= _MAX_N
+    )
+
+
+def prebuild_sm120_block_fp8_gemv(
+    n: int,
+    k: int,
+    max_m: int,
+    config: Optional[tuple[int, int, int]] = None,
+    pdl: bool = False,
+) -> None:
+    """Build (or load from the JIT cache) every bucket up to ``bucket_for(max_m)``
+    for one weight shape, so no call compiles during decode.
+
+    :param n: out_features of the weight.
+    :param k: in_features of the weight.
+    :param max_m: the largest M the dispatch may send.
+    :param config: (rows_per_warp, k_unroll, num_warps) override.
+    :param pdl: build the programmatic-dependent-launch variant.
+    """
+    rows, unroll, warps = config if config is not None else DEFAULT_CONFIG
+    top = bucket_for(max_m)
+    for b in BUCKETS:
+        if b > top:
+            break
+        _jit_module(n, k, b, rows, unroll, warps, pdl)
+
+
+def sm120_block_fp8_gemv(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    config: Optional[tuple[int, int, int]] = None,
+    pdl: bool = False,
+) -> torch.Tensor:
+    """y[M, N] = x[M, K] @ dequant(weight[N, K], weight_scale[ceil(N/32), K/32]).T.
+
+    :param x: bf16 activations, contiguous [M, K], 1 <= M <= MAX_M.
+    :param weight: fp8 e4m3 weight, contiguous [N, K].
+    :param weight_scale: fp32 block scales [ceil(N / 32), K / 32] (``weight_scale_inv``).
+    :param config: (rows_per_warp, k_unroll, num_warps) override for tuning.
+    :param pdl: launch with programmatic dependent launch (weight prefetch
+        before griddepcontrol.wait); output is identical either way.
+    :returns: bf16 [M, N].
+    """
+    m, k = x.shape
+    n = weight.shape[0]
+    out = torch.empty((m, n), dtype=torch.bfloat16, device=x.device)
+    rows, unroll, warps = config if config is not None else DEFAULT_CONFIG
+    _jit_module(n, k, bucket_for(m), rows, unroll, warps, pdl).run(
+        x, weight, weight_scale, out
+    )
+    return out
