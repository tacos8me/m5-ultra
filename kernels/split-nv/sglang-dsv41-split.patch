+        w = torch.where(ids == counts.numel() - 1, torch.zeros_like(w), w)
+        layer._expert_weight_sum.scatter_add_(0, ids, w.to(torch.float64))
+        layer._expert_weight_sq.scatter_add_(0, ids, (w * w).to(torch.float64))
+        layer._expert_weight_max.scatter_reduce_(0, ids, w, reduce="amax")
+    layer._expert_stats_calls += 1
+    if layer._expert_stats_calls % _EXPERT_STATS_EVERY == 0:
+        try:
+            from sglang.srt.runtime_context import get_parallel
+
