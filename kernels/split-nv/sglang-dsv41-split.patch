@@ -0,0 +1,209 @@
+"""Single-layer correctness proof for the DeepSeek-V4.1 file-backed expert store.
+
+Proves that routed experts read from an NVMe pack over a file-backed mmap +
+HMM device-view produce bit-identical CUTLASS MXFP4 MoE output to the same
+experts resident in VRAM -- with zero CPU math and zero expert VRAM. This is the
+correctness contract the zero-CPU-compute streaming deployment relies on.
+
+Requires real hardware (SM120 + HMM-addressing driver), the FlashInfer build the
+server uses, and the DeepSeek-V4.1-Flash checkpoint. It self-skips otherwise, so
+it is inert in keyless CI. Point it at the checkpoint with
+``SGLANG_DSV41_TEST_CHECKPOINT`` (default ``/home/ian/models/DeepSeek-V4.1-Flash``)
+and a writable pack dir with ``SGLANG_DSV41_TEST_PACKDIR``.
+
+Run directly for the human-readable verdict:
+  SGLANG_DSV41_UVA_PAGEABLE=1 python3 test/srt/models/test_dsv41_expert_stream_mmap.py
+"""
+
+from __future__ import annotations
+
+import os
+
+import pytest
+import torch
+
+CKPT = os.environ.get("SGLANG_DSV41_TEST_CHECKPOINT", "/home/ian/models/DeepSeek-V4.1-Flash")
+PACKDIR = os.environ.get("SGLANG_DSV41_TEST_PACKDIR", "/mnt/nvme-1/dsv41-expert-pack-verify")
+LAYER = 0
+WORLD = 24            # 384 / 24 = 16 experts in rank 0: keeps reference VRAM < 2 GiB
+RANK = 0
+N_LOCAL = 16
+TOPK = 6
+N_TOKENS = 16
+HIDDEN = 5120
+INTER = 2304
+
+
+def _available() -> bool:
+    if not torch.cuda.is_available():
+        return False
+    if not os.path.isfile(os.path.join(CKPT, "model.safetensors.index.json")):
+        return False
+    try:
+        import flashinfer  # noqa: F401
+        import safetensors  # noqa: F401
+    except Exception:
+        return False
+    return True
+
+
+def _run_moe(w13, w2, w13s, w2s, x, topk_ids, topk_w, gscale, slimit, dev):
+    from flashinfer import mxfp8_quantize
+    from flashinfer.fused_moe import cutlass_fused_moe
+    from flashinfer.fused_moe.core import ActivationType
+
+    xq, input_sf = mxfp8_quantize(x, is_sf_swizzled_layout=True, alignment=32)
+    out = torch.empty(x.shape[0], HIDDEN, dtype=torch.bfloat16, device=dev)
+    quant_scales = [w13s.view(torch.int32), gscale, w2s.view(torch.int32), gscale]
+    cutlass_fused_moe(
+        input=xq,
+        token_selected_experts=topk_ids.to(torch.int32),
+        token_final_scales=topk_w,
+        fc1_expert_weights=w13.view(torch.int64),
+        fc2_expert_weights=w2.view(torch.int64),
+        output_dtype=torch.bfloat16,
+        quant_scales=quant_scales,
+        input_sf=input_sf,
+        swiglu_limit=slimit,
+        tp_size=1, tp_rank=0, ep_size=1, ep_rank=0,
+        use_w4_group_scaling=False,
+        use_mxfp8_act_scaling=True,
+        activation_type=ActivationType.Swiglu,
+        tune_max_num_tokens=16,
+        output=out,
+    )
+    return out
+
+
+def _ensure_pack(dev) -> str:
+    from sglang.srt.layers.quantization.mxfp4_expert_store import (
+        pack_filename,
+        pack_is_complete,
+        write_expert_pack,
+    )
+    from sglang.srt.model_loader.expert_pack.prepare_v41_expert_pack import (
+        _CheckpointReader,
+        _build_rank_tensors,
+    )
+
+    path = os.path.join(PACKDIR, pack_filename(LAYER, RANK, WORLD))
+    if not pack_is_complete(path):
+        reader = _CheckpointReader(__import__("pathlib").Path(CKPT))
+        tensors = _build_rank_tensors(reader, LAYER, 0, N_LOCAL, dev, N_LOCAL)
+        write_expert_pack(
+            path, f"layers.{LAYER}.ffn.experts", RANK, WORLD, 0, N_LOCAL, tensors
+        )
+    return path
+
+
+def _reference_tensors(dev):
+    """Experts 0..15 of layer 0 straight from the checkpoint, processed the same
+    way (w13=[up;gate], scales block-interleaved) -- independent of the pack."""
+    from sglang.srt.model_loader.expert_pack.prepare_v41_expert_pack import (
+        _CheckpointReader,
+        _build_rank_tensors,
+    )
+    reader = _CheckpointReader(__import__("pathlib").Path(CKPT))
+    t = _build_rank_tensors(reader, LAYER, 0, N_LOCAL, dev, N_LOCAL)
+    return {k: v.to(dev) for k, v in t.items()}
+
+
+def _stage_from_pack(path, dev, ref_shapes):
+    """Load the pack through the shipped store and stage it onto a fake layer,
+    exercising open_expert_pack + stage_params_from_pack + HMM device-views."""
+    from sglang.srt.layers.quantization.mxfp4_expert_store import (
+        EXPERT_PARAM_NAMES,
+        open_expert_pack,
+        stage_params_from_pack,
+    )
+
+    layer = torch.nn.Module()
+    for name in EXPERT_PARAM_NAMES:
+        # CPU placeholders with the shapes the method would have created; the
+        # store validates against these and replaces .data with device-views.
+        layer.register_parameter(
+            name,
+            torch.nn.Parameter(
+                torch.empty(ref_shapes[name][0], dtype=ref_shapes[name][1]),
+                requires_grad=False,
+            ),
+        )
+    pack = open_expert_pack(path)
+    stage_params_from_pack(layer, pack, dev)
+    return layer, pack
+
+
+def _compare():
+    os.environ.setdefault("SGLANG_DSV41_UVA_PAGEABLE", "1")
+    dev = torch.device("cuda", 0)
+    torch.manual_seed(0)
+
+    ref = _reference_tensors(dev)
+    path = _ensure_pack(dev)
+
+    x = torch.randn(N_TOKENS, HIDDEN, device=dev, dtype=torch.bfloat16) * 0.1
+    g = torch.rand(N_TOKENS, N_LOCAL, device=dev)
+    topk_w, topk_ids = torch.topk(g, TOPK, dim=-1)
+    topk_w = (topk_w / topk_w.sum(-1, keepdim=True)).to(torch.float32)
+    gscale = torch.ones(N_LOCAL, dtype=torch.float32, device=dev)
+    slimit = torch.full((N_LOCAL,), 10.0, dtype=torch.float32, device=dev)
+
+    torch.cuda.reset_peak_memory_stats(dev)
+    out_ref = _run_moe(
+        ref["w13_weight"], ref["w2_weight"],
+        ref["w13_weight_scale_inv"], ref["w2_weight_scale_inv"],
+        x, topk_ids, topk_w, gscale, slimit, dev,
+    )
+    torch.cuda.synchronize()
+    ref_peak = torch.cuda.max_memory_allocated(dev) // 2**20
+
+    ref_shapes = {
+        k: (tuple(v.shape), v.dtype) for k, v in ref.items()
+    }
+    del ref
+    torch.cuda.empty_cache()
+
+    base = torch.cuda.memory_allocated(dev)
+    layer, pack = _stage_from_pack(path, dev, ref_shapes)
+    staged_vram = (torch.cuda.memory_allocated(dev) - base) // 2**20
+    out_pack = _run_moe(
+        layer.w13_weight, layer.w2_weight,
+        layer.w13_weight_scale_inv, layer.w2_weight_scale_inv,
+        x, topk_ids, topk_w, gscale, slimit, dev,
+    )
+    torch.cuda.synchronize()
+
+    exact = torch.equal(out_ref, out_pack)
+    maxdiff = (out_ref.float() - out_pack.float()).abs().max().item()
+    pack.close()
+    return {
+        "exact": exact, "maxdiff": maxdiff, "ref_peak": ref_peak,
+        "staged_vram": staged_vram, "path": path,
+        "ref_finite": bool(torch.isfinite(out_ref).all()),
+        "pack_finite": bool(torch.isfinite(out_pack).all()),
+    }
+
+
+@pytest.mark.skipif(not _available(), reason="needs SM120 GPU, FlashInfer, and the V4.1 checkpoint")
+def test_filebacked_expert_stream_matches_vram():
+    r = _compare()
+    assert r["ref_finite"] and r["pack_finite"]
+    assert r["staged_vram"] == 0, f"staged experts took {r['staged_vram']} MiB VRAM"
+    assert r["exact"], f"streamed output diverged (max abs diff {r['maxdiff']:.3e})"
+
+
+if __name__ == "__main__":
+    if not _available():
+        print("SKIP: needs SM120 GPU, FlashInfer, and the V4.1 checkpoint")
+        raise SystemExit(0)
+    r = _compare()
+    print("\n==================== RESULT ====================")
+    print(f"pack file                 : {r['path']}")
+    print(f"reference output finite   : {r['ref_finite']}")
+    print(f"streamed  output finite   : {r['pack_finite']}")
+    print(f"bit-exact (torch.equal)   : {r['exact']}")
+    print(f"max abs diff              : {r['maxdiff']:.3e}")
+    print(f"reference peak VRAM       : {r['ref_peak']} MiB (experts resident)")
+    print(f"staged expert VRAM        : {r['staged_vram']} MiB (mmap host pages, HMM)")
+    print("================================================")
+    raise SystemExit(0 if r["exact"] and r["staged_vram"] == 0 else 1)
