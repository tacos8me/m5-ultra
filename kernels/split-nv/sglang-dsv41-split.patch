diff --git a/sglang/srt/environ.py b/sglang/srt/environ.py
index d5dd933..8476874 100644
--- a/sglang/srt/environ.py
+++ b/sglang/srt/environ.py
@@ -1403,6 +1403,81 @@ class Envs:
     # Run the DeepSeek-V4.1 ratio-1/2 prefill indexer on the torch path instead
     # of the DeepGEMM dense fp4 logits kernel (test oracle / fallback).
     SGLANG_DSV41_TORCH_PREFILL_INDEXER = EnvBool(False)
+    # MiB budget for one fp32 logits tile of the DeepSeek-V4.1 dense prefill
+    # indexer. A chunk whose [rows, ctx / ratio] logits exceed it is scored in
+    # row tiles that fit (512 MiB -> 1024 rows at a 128K-position width), so
+    # peak logits memory stays under the budget at any context depth.
+    SGLANG_DSV41_INDEXER_LOGITS_BUDGET_MB = EnvInt(512)
+    # Serve the [32, 32]-block ue8m0 fp8 dense linears (wqkv_a, wq_b, wo_b,
+    # shared-expert w13/w2, indexer wq_b) with the SM120 streaming GEMV when the
+    # call has at most SGLANG_DSV41_DECODE_DENSE_GEMV_MAX_M rows, instead of the
+    # activation-quantize + CUTLASS MXFP8 GEMM pair. Prefill keeps the GEMM.
+    SGLANG_DSV41_DECODE_DENSE_GEMV = EnvBool(False)
+    SGLANG_DSV41_DECODE_DENSE_GEMV_MAX_M = EnvInt(4)
+    # Serve the routed experts of a call with at most SGLANG_DSV41_FLAT_MOE_MAX_M
+    # tokens (decode, DSpark verify) with the SM120 flat persistent MXFP4 MoE
+    # kernels (block-scaled tensor-core MMA, e4m3 activations x e2m1 weights,
+    # three launches per layer) instead of the FlashInfer CUTLASS grouped GEMM.
+    # Larger calls keep the CUTLASS path.
+    # Serve the LM head at decode with the SM120 block-FP8 GEMV: the bf16 vocab
+    # shard is quantized at load to e4m3 + fp32 [32, 32] block scales (halves the
+    # bytes per step; ~45 cuBLAS gemvx launches become one per 32-row chunk).
+    # Weight-only quantization, so logits change slightly.
+    SGLANG_DSV41_LMHEAD_FP8_GEMV = EnvBool(False)
+    SGLANG_DSV41_LMHEAD_FP8_GEMV_MAX_M = EnvInt(8)
+    SGLANG_DSV41_LMHEAD_FP8_GEMV_KEEP_BF16 = EnvBool(False)
+    # Serve bf16-at-decode linears through the SM120 block-FP8 GEMV. Sites
+    # (comma-separated): wo_a = the attention output absorb, whose checkpoint fp8
+    # weight ([32, 32]-block ue8m0) is otherwise dequantized to bf16 at load and
+    # run by cuBLAS. Same numerics as the bf16 path (exact scales), half the bytes.
+    SGLANG_DSV41_LINEARS_FP8_GEMV = EnvBool(False)
+    SGLANG_DSV41_LINEARS_FP8_GEMV_SITES = EnvStr("wo_a")
+    SGLANG_DSV41_LINEARS_FP8_GEMV_MAX_M = EnvInt(8)
+    SGLANG_DSV41_LINEARS_FP8_GEMV_KEEP_BF16 = EnvBool(False)
+    SGLANG_DSV41_LINEARS_FP8_GEMV_PDL = EnvBool(True)
+    # Decode-step launch fusion (see NOTES-launch-fusion.md). Sites, comma-separated
+    # in SGLANG_DSV41_FUSE_ELEMENTWISE_SITES: router_remap = permute the router
+    # gate rows and correction biases at the first forward so the top-k emits
+    # kept-slot ids directly (deletes the six per-layer remap launches; exact);
+    # engram_fill = one host copy of the step's hash ids, host-side dedupe, and a
+    # single dequant gather straight into the pre-gather buffer per engram layer
+    # (replaces two GPU unique()+sync round trips and the thread-pool gather;
+    # bit-exact rows).
+    SGLANG_DSV41_FUSE_ELEMENTWISE = EnvBool(False)
+    SGLANG_DSV41_FUSE_ELEMENTWISE_SITES = EnvStr("router_remap,engram_fill")
+    # Log the engram pre-gather fill's host phases every N fills (0 = off).
+    SGLANG_DSV41_ENGRAM_FILL_TIMING = EnvInt(0)
+    # Programmatic dependent launch for the SM120 dense block-FP8 GEMV: the kernel
+    # prefetches its first weight chunk before griddepcontrol.wait, so its launch
+    # and weight-stream ramp overlap the previous kernel's tail.
+    SGLANG_DSV41_PDL_ALL = EnvBool(False)
+    # Decode indexer: replace the 18-launch post-top-k torch chain of every
+    # candidate-consuming layer (mask_topk_scores + page-slot arithmetic + copies)
+    # with one Triton launch writing the sparse page indices in place (exact).
+    SGLANG_DSV41_FUSE_TOPK_SLOTS = EnvBool(False)
+    # Fold the engram decode history commit into the hash kernel (upstream
+    # sglang#39138): one Triton launch replaces the kernel plus five torch ops
+    # (req_pool_indices cast, out_cache_loc compare, where, flip, index_put) in
