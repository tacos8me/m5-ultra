@@ -0,0 +1,249 @@
+"""Correctness of the VRAM hot-expert cache vs the full-tensor CUTLASS path.
+
+The cache holds a bounded pool of S VRAM expert slots per layer, backed by the
+host mmap, with coalesced DMA staging + LRU eviction + topk-id remap. This test
+proves that, for real layer-0 experts, the kernel reading the remapped pool
+returns bit-identical output to the kernel reading the full [E,...] tensor, over
+many single-token forwards that exercise staging and eviction (S < routed
+diversity over time). Also checks the identity case S == num_local.
+
+Requires SM120 + FlashInfer + the checkpoint; self-skips otherwise. Run:
+  SGLANG_DSV41_UVA_PAGEABLE=1 python3 test/srt/models/test_dsv41_expert_cache.py
+"""
+
+from __future__ import annotations
+
+import os
+import pathlib
+
+import pytest
+import torch
+
+CKPT = os.environ.get("SGLANG_DSV41_TEST_CHECKPOINT", "/home/ian/models/DeepSeek-V4.1-Flash")
+LAYER = 0
+N_LOCAL = 16          # experts[0:16] of layer 0 (keeps reference VRAM < 2 GiB)
+TOPK = 6
+HIDDEN = 5120
+STEPS = 12
+
+
+def _available() -> bool:
+    if not torch.cuda.is_available():
+        return False
+    if not os.path.isfile(os.path.join(CKPT, "model.safetensors.index.json")):
+        return False
+    try:
+        import flashinfer  # noqa: F401
+        import safetensors  # noqa: F401
+    except Exception:
+        return False
+    return True
+
+
+def _run_moe(w13, w2, w13s, w2s, x, topk_ids, topk_w, dev):
+    from flashinfer import mxfp8_quantize
+    from flashinfer.fused_moe import cutlass_fused_moe
+    from flashinfer.fused_moe.core import ActivationType
+
+    E = w13.shape[0]
+    gscale = torch.ones(E, dtype=torch.float32, device=dev)
+    slimit = torch.full((E,), 10.0, dtype=torch.float32, device=dev)
+    xq, input_sf = mxfp8_quantize(x, is_sf_swizzled_layout=True, alignment=32)
+    out = torch.empty(x.shape[0], HIDDEN, dtype=torch.bfloat16, device=dev)
+    cutlass_fused_moe(
+        input=xq,
+        token_selected_experts=topk_ids.to(torch.int32),
+        token_final_scales=topk_w,
+        fc1_expert_weights=w13.view(torch.int64),
+        fc2_expert_weights=w2.view(torch.int64),
+        output_dtype=torch.bfloat16,
+        quant_scales=[w13s.view(torch.int32), gscale, w2s.view(torch.int32), gscale],
+        input_sf=input_sf,
+        swiglu_limit=slimit,
+        tp_size=1, tp_rank=0, ep_size=1, ep_rank=0,
+        use_w4_group_scaling=False,
+        use_mxfp8_act_scaling=True,
+        activation_type=ActivationType.Swiglu,
+        tune_max_num_tokens=8,
+        output=out,
+    )
+    return out
+
+
+def _host_views(dev):
+    from sglang.srt.model_loader.expert_pack.prepare_v41_expert_pack import (
+        _CheckpointReader,
+        _build_rank_tensors,
+    )
+    reader = _CheckpointReader(pathlib.Path(CKPT))
+    t = _build_rank_tensors(reader, LAYER, 0, N_LOCAL, dev, N_LOCAL)
+    return {k: v.contiguous().cpu() for k, v in t.items()}
+
+
+def _compare(slots):
+    os.environ.setdefault("SGLANG_DSV41_UVA_PAGEABLE", "1")
+    from sglang.srt.layers.quantization.mxfp4_expert_store import (
+        EXPERT_PARAM_NAMES,
+        ExpertCache,
+    )
+    dev = torch.device("cuda", 0)
+    torch.manual_seed(0)
+    host = _host_views(dev)
+    full = {n: host[n].to(dev) for n in EXPERT_PARAM_NAMES}  # reference [N_LOCAL,...]
+    cache = ExpertCache(
+        host, num_local_experts=N_LOCAL, slots=slots, device=dev,
+        ep_rank=0, ep_size=1, num_experts_total=N_LOCAL, expert_lo=0,
+    )
+    mismatches, maxdiff = 0, 0.0
+    for step in range(STEPS):
+        x = torch.randn(1, HIDDEN, device=dev, dtype=torch.bfloat16) * 0.1
+        g = torch.rand(1, N_LOCAL, device=dev)
+        topk_w, topk_ids = torch.topk(g, TOPK, dim=-1)
+        topk_w = (topk_w / topk_w.sum(-1, keepdim=True)).to(torch.float32)
+
+        out_ref = _run_moe(
+            full["w13_weight"], full["w2_weight"],
+            full["w13_weight_scale_inv"], full["w2_weight_scale_inv"],
+            x, topk_ids, topk_w, dev,
+        )
+        cache.ensure_resident(cache.local_ids_in(topk_ids))
+        remapped = cache.remap_topk_ids(topk_ids)
+        out_cache = _run_moe(
+            cache.pool["w13_weight"], cache.pool["w2_weight"],
+            cache.pool["w13_weight_scale_inv"], cache.pool["w2_weight_scale_inv"],
+            x, remapped, topk_w, dev,
+        )
+        torch.cuda.synchronize()
+        if not torch.equal(out_ref, out_cache):
+            mismatches += 1
+            maxdiff = max(maxdiff, (out_ref.float() - out_cache.float()).abs().max().item())
+    pool_vram = sum(p.numel() * p.element_size() for p in cache.pool.values()) // 2**20
+    return {"slots": slots, "mismatches": mismatches, "maxdiff": maxdiff,
+            "stats": dict(cache.stats), "pool_mib": pool_vram}
+
+
+def _compare_overflow(slots):
+    """A call routing more experts than slots must fall back to the full HMM
+    device-views (pre-cache path) and match the full-tensor reference exactly."""
+    os.environ.setdefault("SGLANG_DSV41_UVA_PAGEABLE", "1")
+    from sglang.srt.layers.quantization.mxfp4_expert_store import (
+        EXPERT_PARAM_NAMES,
+        ExpertCache,
+    )
+    dev = torch.device("cuda", 0)
+    torch.manual_seed(1)
+    host = _host_views(dev)
+    full = {n: host[n].to(dev) for n in EXPERT_PARAM_NAMES}
+    cache = ExpertCache(
+        host, num_local_experts=N_LOCAL, slots=slots, device=dev,
+        ep_rank=0, ep_size=1, num_experts_total=N_LOCAL, expert_lo=0,
+    )
+    T = 8  # 8 tokens x top-6 among 16 -> far more than `slots` unique experts
+    x = torch.randn(T, HIDDEN, device=dev, dtype=torch.bfloat16) * 0.1
+    g = torch.rand(T, N_LOCAL, device=dev)
+    topk_w, topk_ids = torch.topk(g, TOPK, dim=-1)
+    topk_w = (topk_w / topk_w.sum(-1, keepdim=True)).to(torch.float32)
+    local_ids = cache.local_ids_in(topk_ids)
+    assert len(local_ids) > slots, "test did not produce an overflow batch"
+    fv = cache.full_device_views()
+    out_over = _run_moe(
+        fv["w13_weight"], fv["w2_weight"],
+        fv["w13_weight_scale_inv"], fv["w2_weight_scale_inv"],
+        x, topk_ids, topk_w, dev,
+    )
+    out_ref = _run_moe(
+        full["w13_weight"], full["w2_weight"],
+        full["w13_weight_scale_inv"], full["w2_weight_scale_inv"],
+        x, topk_ids, topk_w, dev,
+    )
+    torch.cuda.synchronize()
+    return {"n_routed": len(local_ids), "exact": torch.equal(out_over, out_ref)}
+
+
+def _compare_tp_shard():
+    """TP column-shards, summed, must match the full unsharded MoE. Validates the
+    prebuild's --shard-mode tp split (+ sharded-scale interleave). TP is a
+    different numeric reduction than the full GEMM, so this is allclose, not
+    bit-exact (the pool path over a TP shard is separately bit-exact)."""
+    os.environ.setdefault("SGLANG_DSV41_UVA_PAGEABLE", "1")
+    import pathlib
+    from sglang.srt.layers.quantization.mxfp4_expert_store import EXPERT_PARAM_NAMES
+    from sglang.srt.model_loader.expert_pack.prepare_v41_expert_pack import (
+        _CheckpointReader,
+        _build_tp_rank_tensors,
+    )
+    dev = torch.device("cuda", 0)
+    torch.manual_seed(2)
+    full = {n: v.to(dev) for n, v in _host_views(dev).items()}  # 16 full experts
+    reader = _CheckpointReader(pathlib.Path(CKPT))
+    shards = [
+        {n: t.to(dev) for n, t in
+         _build_tp_rank_tensors(reader, LAYER, 0, N_LOCAL, r, 2, dev, N_LOCAL).items()}
+        for r in (0, 1)
+    ]
+    x = torch.randn(4, HIDDEN, device=dev, dtype=torch.bfloat16) * 0.1
+    g = torch.rand(4, N_LOCAL, device=dev)
+    topk_w, topk_ids = torch.topk(g, TOPK, dim=-1)
+    topk_w = (topk_w / topk_w.sum(-1, keepdim=True)).to(torch.float32)
+
+    def run(w):
+        return _run_moe(
+            w["w13_weight"], w["w2_weight"],
+            w["w13_weight_scale_inv"], w["w2_weight_scale_inv"],
+            x, topk_ids, topk_w, dev,
+        )
+
+    out_full = run(full)
+    out_tp = run(shards[0]) + run(shards[1])  # each shard is a partial; sum = full
+    torch.cuda.synchronize()
+    diff = (out_full.float() - out_tp.float()).abs().max().item()
+    scale = out_full.float().abs().max().item() + 1e-6
+    return {"maxdiff": diff, "rel": diff / scale,
+            "close": torch.allclose(out_full, out_tp, rtol=2e-2, atol=2e-2),
+            "w13_shape": tuple(shards[0]["w13_weight"].shape),
+            "w2_shape": tuple(shards[0]["w2_weight"].shape)}
+
+
+@pytest.mark.skipif(not _available(), reason="needs SM120 GPU, FlashInfer, and the V4.1 checkpoint")
+def test_tp_shard_sum_matches_full():
+    r = _compare_tp_shard()
+    assert r["close"], f"TP shard sum diverged from full (rel {r['rel']:.3e})"
+
+
+@pytest.mark.skipif(not _available(), reason="needs SM120 GPU, FlashInfer, and the V4.1 checkpoint")
+@pytest.mark.parametrize("slots", [N_LOCAL, 8, 6])
+def test_expert_cache_matches_full_tensor(slots):
+    r = _compare(slots)
+    assert r["mismatches"] == 0, f"S={slots}: {r['mismatches']} mismatched (max {r['maxdiff']:.3e})"
+
+
+@pytest.mark.skipif(not _available(), reason="needs SM120 GPU, FlashInfer, and the V4.1 checkpoint")
+def test_expert_cache_overflow_matches_full_tensor():
+    r = _compare_overflow(6)
+    assert r["exact"], f"overflow ({r['n_routed']} experts) diverged from full path"
+
+
+if __name__ == "__main__":
+    if not _available():
+        print("SKIP: needs SM120 GPU, FlashInfer, and the V4.1 checkpoint")
+        raise SystemExit(0)
+    ok = True
+    print("\n==================== VRAM EXPERT CACHE ====================")
+    for slots in (N_LOCAL, 8, 6):
+        r = _compare(slots)
+        tag = "identity" if slots == N_LOCAL else "bounded"
+        status = "OK" if r["mismatches"] == 0 else f"FAIL({r['mismatches']}, {r['maxdiff']:.2e})"
+        print(f"S={slots:2d} ({tag:8s}) over {STEPS} forwards: {status}  "
+              f"pool={r['pool_mib']}MiB  hit/miss/evict={r['stats']['hit']}/"
+              f"{r['stats']['miss']}/{r['stats']['evict']}")
+        ok = ok and r["mismatches"] == 0
+    ov = _compare_overflow(6)
+    print(f"overflow S=6, {ov['n_routed']} experts routed > slots: "
+          f"{'OK' if ov['exact'] else 'FAIL'} (full HMM fallback == full path)")
+    ok = ok and ov["exact"]
+    tp = _compare_tp_shard()
+    print(f"TP shard sum vs full (allclose): {'OK' if tp['close'] else 'FAIL'}  "
+          f"rel={tp['rel']:.2e}  w13{tp['w13_shape']} w2{tp['w2_shape']} (half-width)")
+    ok = ok and tp["close"]
+    print("==========================================================")
+    raise SystemExit(0 if ok else 1)
diff --git a/sglang/test/srt/models/test_dsv41_expert_prune.py b/sglang/test/srt/models/test_dsv41_expert_prune.py
