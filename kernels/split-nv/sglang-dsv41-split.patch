+        single intra-op thread. Every row is written exactly once from the same
+        source row, so the result is bit-identical to one index_select."""
+        n = int(ids.numel())
+        threads = max(1, int(envs.SGLANG_DSV41_ENGRAM_GATHER_THREADS.get()))
+        k = min(threads, n)
+        if k <= 1:
+            torch.index_select(self._disk_w_u8, 0, ids, out=w_out)
+            torch.index_select(self._disk_s_u8, 0, ids, out=s_out)
+            return
+        if self._gather_pool is None:
+            self._gather_pool = ThreadPoolExecutor(
+                max_workers=threads,
+                thread_name_prefix=f"engram-gather-{self.layer_id}",
+            )
+
+        def part(lo: int, hi: int) -> None:
+            sub = ids[lo:hi]
+            torch.index_select(self._disk_w_u8, 0, sub, out=w_out[lo:hi])
+            torch.index_select(self._disk_s_u8, 0, sub, out=s_out[lo:hi])
+
+        bounds = [(i * n // k, (i + 1) * n // k) for i in range(k)]
+        # Draining the map re-raises a worker's exception here instead of
+        # dropping it.
+        list(self._gather_pool.map(lambda b: part(*b), bounds))
+
+    def _start_prewarm(self, layer_id: int) -> None:
+        """Fault the disk-backed table in, in the background, once the checkpoint
+        stream has finished so it cannot evict the rows again. Every rank runs
+        MADV_POPULATE_READ on its own mapping: one kernel pass fills the shared
+        page cache and this process's own page tables. If the kernel refuses
+        (< 5.14), rank 0 alone falls back to a sequential pread, which only
+        fills the shared page cache."""
+        import threading
+
+        host_table = self.host_table
+        path, nbytes = host_table.backing_path, host_table.nbytes
+        rank0 = get_tp_group().rank_in_group == 0
+
+        def run():
+            t0 = time.time()
+            if host_table.populate():
+                logger.info(
+                    "engram host table layer %d: populated %.0f GiB into the page "
+                    "cache and page tables in %.1f s (MADV_POPULATE_READ)",
+                    layer_id,
+                    nbytes / 2**30,
+                    time.time() - t0,
+                )
+                return
+            if not rank0:
+                return
+            fd = os.open(path, os.O_RDONLY)
+            try:
+                chunk = 64 << 20
+                off = 0
+                while off < nbytes:
+                    os.pread(fd, min(chunk, nbytes - off), off)
+                    off += chunk
+            finally:
+                os.close(fd)
+            logger.info(
+                "engram host table layer %d: pread prewarm complete in %.1f s (%s)",
+                layer_id,
+                time.time() - t0,
+                path,
+            )
+
+        threading.Thread(
+            target=run, name=f"engram-prewarm-{layer_id}", daemon=True
+        ).start()
+
     def _lookup(self, indices: torch.Tensor) -> torch.Tensor:
         """Lookup when every TP rank holds the same indices: the device and
         private host shards zero unowned rows and the all-reduce reassembles."""
