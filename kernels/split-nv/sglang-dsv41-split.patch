new file mode 100644
index 0000000..0a6047e
--- /dev/null
+++ b/sglang/kernels/ops/attention/dsv4/topk_slots.py
@@ -0,0 +1,158 @@
+"""One-launch replacement for the decode indexer's post-top-k chain.
+
+After ``topk_transform_paged_v2`` writes the raw selected compressed positions of a
+candidate-consuming layer, the reference path spends 18 torch launches per layer
+turning them into extra-cache slots (``mask_topk_scores`` gather/compare/mask,
+``clamp_min``, ``//`` and ``%`` by the index page size, a page-table gather, a
+``where`` and two copies). This kernel does the same arithmetic per row in one
+program and writes the slots (and optionally the masked raw indices) in place.
+
+Exact by construction: every operation is integer or a comparison, and the score
+gather reads the same fp32 values; results are bitwise equal to the torch chain.
+"""
+
+from __future__ import annotations
+
+from typing import Optional
+
+import torch
+import triton
+import triton.language as tl
+
+from sglang.kernels.jit.utils import is_arch_support_pdl
+
+
+@triton.jit
+def _topk_page_slots_kernel(
+    sel_ptr,
+    logits_ptr,
+    pt_ptr,
+    out_ptr,
+    raw_ptr,
+    sel_stride,
+    logits_stride,
+    pt_stride,
+    out_stride,
+    raw_stride,
+    L,
+    P,
+    K: tl.constexpr,
+    PAGE: tl.constexpr,
+    HAS_RAW: tl.constexpr,
+    BLOCK: tl.constexpr,
+    ENABLE_PDL: tl.constexpr,
+):
+    b = tl.program_id(0)
+    offs = tl.arange(0, BLOCK)
+    m = offs < K
+    if ENABLE_PDL:
+        tl.extra.cuda.gdc_wait()
+    sel = tl.load(sel_ptr + b * sel_stride + offs, mask=m, other=-1).to(tl.int64)
+    # mask_topk_scores: gather the score at the clamped column, drop selections
+    # whose column is out of range or whose score is -inf.
+    col = tl.minimum(tl.maximum(sel, 0), L - 1)
+    sc = tl.load(logits_ptr + b * logits_stride + col, mask=m, other=float("-inf"))
+    valid = (sel >= 0) & (sel < L) & (sc > float("-inf"))
+    sel2 = tl.where(valid, sel, -1)
+    # columns = selected.clamp_min(0); slots = page_table[b, columns // PAGE] * PAGE
+    # + columns % PAGE; page_indices = where(selected >= 0, slots, -1)
+    cols = tl.maximum(sel2, 0)
+    pidx = cols // PAGE
+    pidx = tl.minimum(pidx, P - 1)  # never past the row; -1 rows resolve to page 0
+    pg = tl.load(pt_ptr + b * pt_stride + pidx, mask=m, other=0).to(tl.int64)
+    slot = pg * PAGE + cols % PAGE
+    out = tl.where(sel2 >= 0, slot, -1)
+    if ENABLE_PDL:
+        tl.extra.cuda.gdc_launch_dependents()
+    tl.store(out_ptr + b * out_stride + offs, out.to(tl.int32), mask=m)
+    if HAS_RAW:
+        tl.store(raw_ptr + b * raw_stride + offs, sel2.to(tl.int32), mask=m)
+
+
+def topk_page_slots(
+    selected: torch.Tensor,
+    logits: torch.Tensor,
+    page_table: torch.Tensor,
+    page_size: int,
+    page_indices: torch.Tensor,
+    raw_indices: Optional[torch.Tensor] = None,
+    enable_pdl: Optional[bool] = None,
+) -> None:
+    """Write ``page_indices[b, k]`` (and ``raw_indices``) from the raw top-k.
+
+    ``selected``: int32 ``[bs, K]`` raw compressed positions, ``-1`` padded.
+    ``logits``: fp32 ``[bs, L]`` indexer scores the selections were drawn from.
+    ``page_table``: int32 ``[bs, P]`` index-pool page ids (already expanded to
+    ``page_size`` slots per page). Every ``bs`` row is written. Shapes and dtypes
+    are checked; a mismatch raises rather than falling back.
+    """
+    bs, K = selected.shape
+    assert selected.dtype == torch.int32, selected.dtype
+    assert logits.dtype == torch.float32, logits.dtype
+    assert page_table.dtype == torch.int32, page_table.dtype
+    assert page_indices.dtype == torch.int32, page_indices.dtype
+    assert logits.shape[0] >= bs and page_table.shape[0] >= bs, (
+        logits.shape,
+        page_table.shape,
+        bs,
+    )
+    assert page_indices.shape[0] >= bs and page_indices.shape[1] == K, (
+        page_indices.shape,
+        (bs, K),
+    )
+    assert selected.stride(1) == 1 and logits.stride(1) == 1
+    assert page_table.stride(1) == 1 and page_indices.stride(1) == 1
+    L = logits.shape[1]
+    P = page_table.shape[1]
+    assert L > 0 and P > 0 and page_size > 0
+    if raw_indices is not None:
+        assert raw_indices.dtype == torch.int32 and raw_indices.shape[1] == K
