index 0000000..926848a
--- /dev/null
+++ b/sglang/kernels/jit/tests/test_dsv41_topk_slots.py
@@ -0,0 +1,105 @@
+"""Fused decode top-k page-slot kernel: bitwise equality with the torch chain it
+replaces, over padding, out-of-range and -inf selections, and inside a CUDA graph."""
+
+import torch
+
+from sglang.kernels.ops.attention.dsv4.topk_slots import (
+    topk_page_slots,
+    topk_page_slots_reference,
+)
+
+PAGE = 64
+K = 512
+
+
+def _case(bs, L, gen, device):
+    P = -(-L // PAGE) + 3
+    logits = torch.randn(bs, L, generator=gen, device=device, dtype=torch.float32)
+    # some -inf columns (masked candidates)
+    inf_mask = torch.rand(bs, L, generator=gen, device=device) < 0.15
+    logits.masked_fill_(inf_mask, -torch.inf)
+    page_table = torch.randint(
+        0, 1_000_000, (bs, P), generator=gen, device=device, dtype=torch.int32
+    )
+    # selections: valid columns, -1 pads, a few past L (out of range)
+    sel = torch.randint(0, L, (bs, K), generator=gen, device=device, dtype=torch.int32)
+    pad = torch.rand(bs, K, generator=gen, device=device) < 0.2
+    sel.masked_fill_(pad, -1)
+    oob = torch.rand(bs, K, generator=gen, device=device) < 0.03
+    sel.masked_fill_(oob, L + 7)
+    return logits, page_table, sel
+
+
+def run_case(bs, L, seed, enable_pdl):
+    device = torch.device("cuda")
+    gen = torch.Generator(device=device).manual_seed(seed)
+    logits, page_table, sel = _case(bs, L, gen, device)
+    ref_pi, ref_raw = topk_page_slots_reference(sel, logits, page_table, PAGE)
+    pi = torch.full((bs, K), 7, dtype=torch.int32, device=device)
+    raw = torch.full((bs, K), 7, dtype=torch.int32, device=device)
+    topk_page_slots(sel, logits, page_table, PAGE, pi, raw, enable_pdl=enable_pdl)
+    torch.cuda.synchronize()
+    assert torch.equal(pi, ref_pi), (bs, L, seed, (pi != ref_pi).sum().item())
+    assert torch.equal(raw, ref_raw), (bs, L, seed, (raw != ref_raw).sum().item())
+    # raw=None variant leaves page_indices identical
+    pi2 = torch.full((bs, K), 7, dtype=torch.int32, device=device)
+    topk_page_slots(sel, logits, page_table, PAGE, pi2, None, enable_pdl=enable_pdl)
+    torch.cuda.synchronize()
+    assert torch.equal(pi2, ref_pi)
+
+
+def test_bitwise_matrix():
+    for enable_pdl in (False, True):
+        for bs in (1, 2, 3, 4):
+            for L in (1, 63, 64, 65, 700, 4096, 16384):
+                for seed in (0, 1):
+                    run_case(bs, L, seed, enable_pdl)
+
+
+def test_all_padding_and_all_inf():
+    device = torch.device("cuda")
+    bs, L = 3, 512
+    logits = torch.full((bs, L), -torch.inf, device=device)
+    page_table = torch.arange(bs * 12, device=device, dtype=torch.int32).view(bs, 12)
+    sel = torch.randint(0, L, (bs, K), device=device, dtype=torch.int32)
+    pi = torch.zeros(bs, K, dtype=torch.int32, device=device)
+    raw = torch.zeros(bs, K, dtype=torch.int32, device=device)
+    topk_page_slots(sel, logits, page_table, PAGE, pi, raw)
+    torch.cuda.synchronize()
+    assert (pi == -1).all() and (raw == -1).all()
+    sel.fill_(-1); logits.zero_()
+    topk_page_slots(sel, logits, page_table, PAGE, pi, raw)
+    torch.cuda.synchronize()
+    assert (pi == -1).all() and (raw == -1).all()
+
+
+def test_cuda_graph_replay_bitwise():
+    device = torch.device("cuda")
+    bs, L = 3, 4096
+    gen = torch.Generator(device=device).manual_seed(5)
+    logits, page_table, sel = _case(bs, L, gen, device)
+    pi = torch.zeros(bs, K, dtype=torch.int32, device=device)
+    raw = torch.zeros(bs, K, dtype=torch.int32, device=device)
+    s = torch.cuda.Stream()
+    with torch.cuda.stream(s):
+        for _ in range(2):
+            topk_page_slots(sel, logits, page_table, PAGE, pi, raw)
+    torch.cuda.synchronize()
+    g = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(g, stream=s):
+        topk_page_slots(sel, logits, page_table, PAGE, pi, raw)
+    for seed in (11, 12, 13):
+        gen2 = torch.Generator(device=device).manual_seed(seed)
+        l2, p2, s2 = _case(bs, L, gen2, device)
+        logits.copy_(l2); page_table.copy_(p2); sel.copy_(s2)
+        g.replay()
+        torch.cuda.synchronize()
+        ref_pi, ref_raw = topk_page_slots_reference(sel, logits, page_table, PAGE)
+        assert torch.equal(pi, ref_pi) and torch.equal(raw, ref_raw), seed
+
+
+if __name__ == "__main__":
+    test_bitwise_matrix()
+    test_all_padding_and_all_inf()
+    test_cuda_graph_replay_bitwise()
+    print("topk_slots: all tests passed")
diff --git a/sglang/kernels/jit/tests/test_dsv41_topk_v2_sm120.py b/sglang/kernels/jit/tests/test_dsv41_topk_v2_sm120.py
