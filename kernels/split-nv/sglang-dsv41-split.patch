+// ---------------------------------------------------------------------------
+// host
+// ---------------------------------------------------------------------------
+template <uint32_t H, uint32_t I, uint32_t kBK1, uint32_t kBK2, bool kClamp>
+struct FlatMxfp4Moe {
+  static constexpr uint32_t kChunk1 = 128;
+  static constexpr uint32_t kChunk2 = 64;
+  static_assert(H % kBK1 == 0 && I % kBK2 == 0, "K splits must tile the reductions");
+  static_assert(I % 32 == 0 && H % kTileN == 0 && H % 128 == 0, "tile shapes");
+  static_assert(kBK1 % kChunk1 == 0 && kBK2 % kChunk2 == 0, "chunks");
+  using S1 = ItemSmem<kBK1, kChunk1>;
+  using S2 = ItemSmem<kBK2, kChunk2>;
+  static constexpr uint32_t kTiles1 = I / 32;
+  static constexpr uint32_t kOutTiles = H / kTileN;
+  static constexpr uint32_t kSplits1 = H / kBK1;
+  static constexpr uint32_t kSplits2 = I / kBK2;
+
+  static uint32_t grid_for(int per_sm) {
+    int device = 0;
+    cudaGetDevice(&device);
+    int sms = 0;
+    cudaDeviceGetAttribute(&sms, cudaDevAttrMultiProcessorCount, device);
+    if (per_sm < 1) {
+      per_sm = 1;
+    }
+    return static_cast<uint32_t>(sms * per_sm);
+  }
+
+  // Resident blocks per SM for the streaming kernels: 0 = gate/up, 1 = down.
+  static int64_t occupancy(int64_t which) {
+    int per_sm = 0;
+    if (which == 0) {
+      cudaOccupancyMaxActiveBlocksPerMultiprocessor(
+          &per_sm, gateup_kernel<H, I, kBK1, kChunk1, kClamp>, kThreads, S1::kTotal);
+    } else {
+      cudaOccupancyMaxActiveBlocksPerMultiprocessor(&per_sm, down_kernel<H, I, kBK2, kChunk2>, kThreads, S2::kTotal);
+    }
+    return per_sm;
+  }
+
+  static int64_t smem_bytes(int64_t which) {
+    return which == 0 ? S1::kTotal : S2::kTotal;
+  }
+
+  static void run(
+      const tvm::ffi::TensorView xq,            // [M, H] uint8 (e4m3 bits)
+      const tvm::ffi::TensorView xsf,           // [M, H/32] uint8
+      const tvm::ffi::TensorView topk_ids,      // [M, topk] int32
+      const tvm::ffi::TensorView topk_weights,  // [M, topk] fp32
+      const tvm::ffi::TensorView w13,           // [E, 2I, H/2] uint8
+      const tvm::ffi::TensorView w13_sf,        // [E, 2I, H/32] uint8 (swizzled)
+      const tvm::ffi::TensorView w2,            // [E, H, I/2] uint8
+      const tvm::ffi::TensorView w2_sf,         // [E, H, I/32] uint8 (swizzled)
+      const tvm::ffi::TensorView out,           // [M, H] bf16
+      const tvm::ffi::TensorView ws1,           // [H/kBK1, kMaxPairs, 2I] fp32 partials
+      const tvm::ffi::TensorView hq,            // [kMaxPairs, I] uint8
+      const tvm::ffi::TensorView hsf,           // [kMaxPairs, I/32] uint8
+      const tvm::ffi::TensorView outp,          // [I/kBK2, kMaxPairs, H] fp32 partials
+      const tvm::ffi::TensorView tables,        // int32 workspace, see layout below
+      double limit,
+      bool use_pdl) {
+    using namespace host;
+    auto M = SymbolicSize{"num_tokens"};
+    auto TK = SymbolicSize{"topk"};
+    auto E = SymbolicSize{"num_experts"};
+    auto device = SymbolicDevice{};
+    device.set_options<kDLCUDA>();
+    TensorMatcher({M, H}).with_dtype<uint8_t>().with_device(device).verify(xq);
+    TensorMatcher({M, H / 32}).with_dtype<uint8_t>().with_device(device).verify(xsf);
+    TensorMatcher({M, TK}).with_dtype<int32_t>().with_device(device).verify(topk_ids);
+    TensorMatcher({M, TK}).with_dtype<fp32_t>().with_device(device).verify(topk_weights);
+    TensorMatcher({E, 2 * I, H / 2}).with_dtype<uint8_t>().with_device(device).verify(w13);
+    TensorMatcher({E, 2 * I, H / 32}).with_dtype<uint8_t>().with_device(device).verify(w13_sf);
+    TensorMatcher({E, H, I / 2}).with_dtype<uint8_t>().with_device(device).verify(w2);
+    TensorMatcher({E, H, I / 32}).with_dtype<uint8_t>().with_device(device).verify(w2_sf);
+    TensorMatcher({M, H}).with_dtype<bf16_t>().with_device(device).verify(out);
+    TensorMatcher({kSplits1, kMaxPairs, 2 * I}).with_dtype<fp32_t>().with_device(device).verify(ws1);
+    TensorMatcher({kMaxPairs, I}).with_dtype<uint8_t>().with_device(device).verify(hq);
+    TensorMatcher({kMaxPairs, I / 32}).with_dtype<uint8_t>().with_device(device).verify(hsf);
+    TensorMatcher({kSplits2, kMaxPairs, H}).with_dtype<fp32_t>().with_device(device).verify(outp);
+    TensorMatcher({tables_size()}).with_dtype<int32_t>().with_device(device).verify(tables);
+    const auto m = static_cast<uint32_t>(M.unwrap());
+    const auto topk = static_cast<uint32_t>(TK.unwrap());
+    const auto e = static_cast<uint32_t>(E.unwrap());
+    CHECK_HOST(m >= 1 && m <= kMaxTokens) << "tokens " << m << " outside 1.." << kMaxTokens;
+    CHECK_HOST(topk >= 1 && topk <= kMaxTopK) << "topk " << topk << " outside 1.." << kMaxTopK;
+    CHECK_HOST(e >= 1 && e <= kMaxExperts) << "experts " << e << " outside 1.." << kMaxExperts;
+    CHECK_HOST((H / 32) % 4 == 0 && (I / 32) % 4 == 0) << "swizzled scale rows need K/32 % 4 == 0";
+
+    static const uint32_t grid1 = grid_for(static_cast<int>(occupancy(0)));
+    static const uint32_t grid2 = grid_for(static_cast<int>(occupancy(1)));
+    Tables t = carve(static_cast<int32_t*>(tables.data_ptr()));
+    const DLDevice dev = device.unwrap();
+
+    LaunchKernel(kSetupBlocks, kSetupThreads, dev).enable_pdl(use_pdl)(
+        build_jobs_kernel<H, I>,
+        static_cast<const int32_t*>(topk_ids.data_ptr()),
+        static_cast<const float*>(topk_weights.data_ptr()),
+        t,
+        m,
+        topk,
+        e,
+        kSplits2);
+    LaunchKernel(grid1, kThreads, dev, S1::kTotal).enable_pdl(use_pdl)(
+        gateup_kernel<H, I, kBK1, kChunk1, kClamp>,
+        static_cast<const uint8_t*>(xq.data_ptr()),
+        static_cast<const uint8_t*>(xsf.data_ptr()),
+        static_cast<const uint8_t*>(w13.data_ptr()),
+        static_cast<const uint8_t*>(w13_sf.data_ptr()),
+        t,
+        static_cast<float*>(ws1.data_ptr()),
+        static_cast<uint8_t*>(hq.data_ptr()),
+        static_cast<uint8_t*>(hsf.data_ptr()),
+        static_cast<float>(limit));
+    LaunchKernel(grid2, kThreads, dev, S2::kTotal).enable_pdl(use_pdl)(
+        down_kernel<H, I, kBK2, kChunk2>,
+        static_cast<const uint8_t*>(hq.data_ptr()),
+        static_cast<const uint8_t*>(hsf.data_ptr()),
+        static_cast<const uint8_t*>(w2.data_ptr()),
+        static_cast<const uint8_t*>(w2_sf.data_ptr()),
+        t,
+        static_cast<float*>(outp.data_ptr()),
+        static_cast<bf16_t*>(out.data_ptr()),
+        topk);
+  }
+
+  // int32 workspace layout (contiguous, in this order):
+  //   job_expert[kMaxPairs] | job_rows[kMaxPairs*16] | pair_token[kMaxPairs] |
+  //   pair_weight[kMaxPairs] (fp32 bits) | pair_valid[kMaxPairs] | token_target[kMaxTokens] |
+  //   num_jobs (padded to 64) | tile_cnt[kMaxPairs * I/32] | out_cnt[kMaxTokens * H/64]
+  static constexpr int64_t tables_size() {
+    return kMaxPairs + kMaxPairs * kJobRows + kMaxPairs + kMaxPairs + kMaxPairs + kMaxTokens + 64 +
+           kMaxPairs * kTiles1 + kMaxTokens * kOutTiles;
+  }
+  static Tables carve(int32_t* base) {
+    Tables t;
+    t.job_expert = base;
+    base += kMaxPairs;
+    t.job_rows = base;
+    base += kMaxPairs * kJobRows;
+    t.pair_token = base;
+    base += kMaxPairs;
+    t.pair_weight = reinterpret_cast<float*>(base);
+    base += kMaxPairs;
+    t.pair_valid = base;
+    base += kMaxPairs;
+    t.token_target = base;
+    base += kMaxTokens;
+    t.num_jobs = base;
+    base += 64;
+    t.tile_cnt = base;
+    base += kMaxPairs * kTiles1;
+    t.out_cnt = base;
+    return t;
+  }
+};
