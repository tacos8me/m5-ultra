index 0000000..decad49
--- /dev/null
+++ b/sglang/kernels/ops/gemm/sm120_block_fp8_grouped_gemv.py
@@ -0,0 +1,92 @@
+"""SM120 grouped few-token block-scaled FP8 GEMV (csrc/gemm/sm120_block_fp8_grouped_gemv.cuh).
+
+Serves ``y[m, g, n] = x_bf16[m, g, :] . (W_fp8[g * N + n, :] * S[(g * N + n) // 32, k // 32])``:
+G independent [N, K] block-FP8 linears applied to the G contiguous K-slices of
+each activation row. This is DeepSeek-V4.1's attention output absorb ``wo_a``
+(``einsum("tgd,grd->tgr")``, G = local groups, N = o_lora_rank, K = D), whose
+checkpoint weight is [32, 32]-block ue8m0 fp8 and which the production path
+dequantizes to bf16 at load and runs through cuBLAS at decode. Reading the fp8
+weight directly halves the bytes per step; the fp32 block scales are the exact
+checkpoint scales (powers of two), so the result equals the bf16 einsum up to
+summation order. Same buckets and JIT-cache policy as ``sm120_block_fp8_gemv``.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Optional
+
+import torch
+
+from sglang.kernels.jit.utils import cache_once, load_jit, make_cpp_args
+from sglang.kernels.ops.gemm.sm120_block_fp8_gemv import (
+    BUCKETS,
+    DEFAULT_CONFIG,
+    MAX_M,
+    bucket_for,
+)
+
+if TYPE_CHECKING:
+    from tvm_ffi.module import Module
+
+
+@cache_once
+def _jit_module(
+    g: int, n: int, k: int, max_m: int, rows: int, unroll: int, warps: int
+) -> Module:
+    args = make_cpp_args(g, n, k, max_m, rows, unroll, warps)
+    return load_jit(
+        "sm120_block_fp8_grouped_gemv",
+        *args,
+        cuda_files=["gemm/sm120_block_fp8_grouped_gemv.cuh"],
+        cuda_wrappers=[("run", f"sglang::Sm120BlockFp8GroupedGemvKernel<{args}>::run")],
+        extra_cuda_cflags=["-O3"],
+    )
+
+
+def prebuild_sm120_block_fp8_grouped_gemv(
+    g: int, n: int, k: int, max_m: int, config: Optional[tuple[int, int, int]] = None
+) -> None:
+    """Build (or load from the JIT cache) every bucket up to ``bucket_for(max_m)``.
+
+    :param g: number of groups.
+    :param n: rows per group (out_features of one group).
+    :param k: in_features of one group.
+    :param max_m: the largest M the dispatch may send.
+    :param config: (rows_per_warp, k_unroll, num_warps) override.
+    """
+    rows, unroll, warps = config if config is not None else DEFAULT_CONFIG
+    top = bucket_for(max_m)
+    for b in BUCKETS:
+        if b > top:
+            break
+        _jit_module(g, n, k, b, rows, unroll, warps)
+
+
+def sm120_block_fp8_grouped_gemv(
+    x: torch.Tensor,
+    weight: torch.Tensor,
+    weight_scale: torch.Tensor,
+    groups: int,
+    use_pdl: bool = True,
+    config: Optional[tuple[int, int, int]] = None,
+) -> torch.Tensor:
+    """y[M, G, N] = per-group x[M, G, K] @ dequant(weight[G * N, K], weight_scale).T.
+
+    :param x: bf16 activations, contiguous [M, G, K], 1 <= M <= MAX_M.
+    :param weight: fp8 e4m3 weight, contiguous [G * N, K] (group g at rows g * N).
+    :param weight_scale: fp32 block scales [G * N / 32, K / 32].
+    :param groups: G.
+    :param use_pdl: launch with programmatic dependent launch.
+    :param config: (rows_per_warp, k_unroll, num_warps) override for tuning.
+    :returns: bf16 [M, G, N].
+    """
+    m, g, k = x.shape
+    if g != groups:
+        raise ValueError(f"x has {g} groups, expected {groups}")
+    n = weight.shape[0] // groups
+    out = torch.empty((m, groups, n), dtype=torch.bfloat16, device=x.device)
+    rows, unroll, warps = config if config is not None else DEFAULT_CONFIG
+    _jit_module(groups, n, k, bucket_for(m), rows, unroll, warps).run(
+        x, weight, weight_scale, out, bool(use_pdl)
+    )
+    return out
